				N: XIC(RtoDS_PlacedConfirm)ONS(ONS_STACK.4)[XIO(DStoR_DropInShoot) [MOV(5,Data_Item[UStoR_PickSeqNumber].Status) ,COP(Data_Item[RtoDS_PlaceSeqNumber],Downstack_Layer[DwnStack_Layer_Current].Row[DwnStack_Row_Current].Column[DwnStack_Column_Current],1) ] OTU(DStoR_OpenLocation) ,MOV(6,Data_Item[UStoR_PickSeqNumber].Status) OTU(DStoR_DropInShoot) ];
		END_ROUTINE

