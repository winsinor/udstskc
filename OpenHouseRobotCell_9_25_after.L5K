		ROUTINE R100_UpAxis 
				N: CPS(IAI_UpStacker:I,UpStack_Inputs,1);
				N: SCON_Status(UpAxis_Sts,UpAxis_Position,UpAxis_Speed,UpAxis_AlarmActive,UpAxis_AlarmCode,UpAxis_BatteryAlarm,UpAxis_CommandCurrent,UpAxis_HomeComplete,UpAxis_Homing,UpAxis_EStop,UpAxis_InPushZone,UpAxis_InPZone,UpAxis_InZone1,UpAxis_InZone2,UpAxis_LoadReached,UpAxis_DriveManualMode,UpAxis_Moving,UpAxis_PositionComplete,UpAxis_PushFailed,UpAxis_DriveReady,UpAxis_ServoOn,UpAxis_TorqueReached,UpAxis_TotalMoveCount,UpAxis_TotalMoveDistance,UpStack_Inputs);
				N: XIC(POWER_OK_24VB)XIO(Unlock_Doors)[OTE(UpAxis_Cmd_ServoOn) ,OTE(CR614) ];
				N: LEQ(UpAxis_Position,28604)GEQ(UpAxis_Position,2560)OTE(UpStacker_Within_Soft_Limits);
				RC: "Need to add software limits to stop movement Up$N"
				    "";
				N: XIC(Motion_Control_OK)XIC(System_ManualMode)XIC(UpAxis_Cmd_ServoOn)XIC(UpStacker_Within_Soft_Limits)OTE(UpStacker_Permit_Up);
				RC: "Need to add software limits to stop movement Down";
				N: XIC(Motion_Control_OK)XIC(System_ManualMode)XIC(UpAxis_Cmd_ServoOn)XIC(UpStacker_Within_Soft_Limits)OTE(UpStacker_Permit_Dn);
				N: XIC(UpStacker_Permit_Up)XIC(HMI_UpStack_GO_PB)OTE(IAI_UpStacker_CMD_Manual_Move);
				RC: "Change the Up Stacker buttons Colors";
				N: [[XIO(UpStacker_Permit_Up) XIO(UpAxis_Homing) XIO(UpAxis_Moving) XIO(UpAxis_AlarmActive) XIC(Motion_Control_OK) MOV(0,UpStacker_Raise.Button_Color) ,XIC(UpStacker_Permit_Up) [XIO(UpAxis_AlarmActive) XIC(UpAxis_DriveReady) MOV(1,UpStacker_Raise.Button_Color) ,XIC(UpAxis_PositionComplete) MOV(4,UpStacker_Raise.Button_Color) ,[XIC(UpAxis_Homing) ,XIC(UpAxis_Moving) ] MOV(3,UpStacker_Raise.Button_Color) ] ,[XIO(UpAxis_DriveReady) ,XIC(UpAxis_AlarmActive) ,XIO(Motion_Control_OK) ] MOV(2,UpStacker_Raise.Button_Color) ] ,[XIO(UpStacker_Permit_Dn) XIO(UpAxis_Homing) XIO(UpAxis_Moving) XIO(UpAxis_AlarmActive) XIC(Motion_Control_OK) MOV(0,UpStacker_Lower.Button_Color) ,XIC(UpStacker_Permit_Dn) [XIO(UpAxis_AlarmActive) XIC(UpAxis_DriveReady) MOV(1,UpStacker_Lower.Button_Color) ,[XIC(UpAxis_Homing) ,XIC(UpAxis_Moving) ] MOV(3,UpStacker_Lower.Button_Color) ,XIC(UpAxis_PositionComplete) MOV(4,UpStacker_Lower.Button_Color) ] ,[XIO(UpAxis_DriveReady) ,XIC(UpAxis_AlarmActive) ,XIO(Motion_Control_OK) ] MOV(2,UpStacker_Lower.Button_Color) ] ];
				N: SCON_Operations(UpAxis_Ops,UpAxis_Cmd_ServoOn,UpAxis_Cmd_Pause,UpAxis_Cmd_Inch,UpAxis_Cmd_JogFwd,UpAxis_Cmd_JogRev,UpAxis_Cmd_Reset,UpAxis_Cmd_BrakeRelease,UpStack_Outputs);
				N: SCON_Moves(UpAxis_Mov,UpAxis_Cmd_Home,UpAxis_Cmd_StartMove,UpAxis_Target,UpStack_Target_Speed,UpStack_Output_Acceleration,UpStack_Output_Deceleration,UpAxis_Band,UpAxis_Increment_Select,UpAxis_Push_Select,UpAxis_Push_Direction,UpAxis_Push_Percent,UpAxis_Load_Threshold,UpAxis_PZone_Upper,UpAxis_PZone_Lower,UpStack_Inputs,UpStack_Outputs);
				RC: "Write the Outputs$N"
				    "";
				N: CPS(UpStack_Outputs,IAI_UpStacker:O,1);
				N: XIC(UpAxis_ServoOn)XIC(UpAxis_DriveReady)XIC(UpAxis_HomeComplete)XIO(UpAxis_AlarmActive)XIO(UpAxis_EStop)OTE(UpAxis_ReadyToMove);
				N: XIC(System_ManualMode)XIC(UpAxis_ReadyToMove)LIM(1,UpAxis_LayerRequest,13)XIC(IAI_UpStacker_CMD_Manual_Move)MOV(UpAxis_LayerRequest,UpAxis_LayerTarget);
				N: [XIC(UpStacker_Permit_Up) XIC(UpAxis_IncrementLayer) XIO(UpAxis_DecrementLayer) LES(UpAxis_CurrentLayer,13) ADD(UpAxis_CurrentLayer,1,UpAxis_LayerTarget) ,XIC(UpStacker_Permit_Dn) XIC(UpAxis_DecrementLayer) XIO(UpAxis_IncrementLayer) GRT(UpAxis_CurrentLayer,1) SUB(UpAxis_CurrentLayer,1,UpAxis_LayerTarget) ]OTE(UpAxis_MoveToLayerTarget);
				N: GEQ(UpAxis_CurrentLayer,11)OTU(UpAxis_IncrementLayer);
				N: LEQ(UpAxis_CurrentLayer,1)OTU(UpAxis_DecrementLayer);
				RC: "Move to layer$N"
				    "";
				N: [[XIC(UpAxis_MoveToLayerTarget) ,NEQ(UpAxis_LayerTarget,UpAxis_CurrentLayer) ,XIC(IAI_UpStacker_CMD_Manual_Move) ] ,XIC(UpAxis_Cmd_StartMove) XIO(UpAxis_PositionComplete) ]XIO(UpAxis_Moving)XIC(UpAxis_ReadyToMove)XIO(UpAxis_MoveFailedTON.DN)[ONS(LayerMoveONS) ,]MOV(UpAxis_Positions[UpAxis_LayerTarget],UpAxis_Target)[OTE(UpAxis_Cmd_StartMove) ,TON(UpAxis_MoveFailedTON,?,?) ,OTU(UpAxis_IncrementLayer) OTU(UpAxis_DecrementLayer) ];
				RC: "Confirm position move successful, update current position$N"
				    "$N"
				    "";
				N: [XIC(UpAxis_PositionComplete) [ONS(PositionCompleteONS) ,] ,XIC(UpdateCurrentPosition) ][ADD(UpAxis_Positions[0],PosLim,UpAxis_PositionsPosLim[0]) SUB(UpAxis_Positions[0],NegLim,UpAxis_PositionsNegLim[0]) LIM(UpAxis_PositionsNegLim[0],UpAxis_Position,UpAxis_PositionsPosLim[0]) MOV(0,UpAxis_CurrentLayer) ,ADD(UpAxis_Positions[1],PosLim,UpAxis_PositionsPosLim[1]) SUB(UpAxis_Positions[1],NegLim,UpAxis_PositionsNegLim[1]) LIM(UpAxis_PositionsNegLim[1],UpAxis_Position,UpAxis_PositionsPosLim[1]) MOV(1,UpAxis_CurrentLayer) ,ADD(UpAxis_Positions[2],PosLim,UpAxis_PositionsPosLim[2]) SUB(UpAxis_Positions[2],NegLim,UpAxis_PositionsNegLim[2]) LIM(UpAxis_PositionsNegLim[2],UpAxis_Position,UpAxis_PositionsPosLim[2]) MOV(2,UpAxis_CurrentLayer) ,ADD(UpAxis_Positions[3],PosLim,UpAxis_PositionsPosLim[3]) SUB(UpAxis_Positions[3],NegLim,UpAxis_PositionsNegLim[3]) LIM(UpAxis_PositionsNegLim[3],UpAxis_Position,UpAxis_PositionsPosLim[3]) MOV(3,UpAxis_CurrentLayer) ,ADD(UpAxis_Positions[4],PosLim,UpAxis_PositionsPosLim[4]) SUB(UpAxis_Positions[4],NegLim,UpAxis_PositionsNegLim[4]) LIM(UpAxis_PositionsNegLim[4],UpAxis_Position,UpAxis_PositionsPosLim[4]) MOV(4,UpAxis_CurrentLayer) ,ADD(UpAxis_Positions[5],PosLim,UpAxis_PositionsPosLim[5]) SUB(UpAxis_Positions[5],NegLim,UpAxis_PositionsNegLim[5]) LIM(UpAxis_PositionsNegLim[5],UpAxis_Position,UpAxis_PositionsPosLim[5]) MOV(5,UpAxis_CurrentLayer) ,ADD(UpAxis_Positions[6],PosLim,UpAxis_PositionsPosLim[6]) SUB(UpAxis_Positions[6],NegLim,UpAxis_PositionsNegLim[6]) LIM(UpAxis_PositionsNegLim[6],UpAxis_Position,UpAxis_PositionsPosLim[6]) MOV(6,UpAxis_CurrentLayer) ,ADD(UpAxis_Positions[7],PosLim,UpAxis_PositionsPosLim[7]) SUB(UpAxis_Positions[7],NegLim,UpAxis_PositionsNegLim[7]) LIM(UpAxis_PositionsNegLim[7],UpAxis_Position,UpAxis_PositionsPosLim[7]) MOV(7,UpAxis_CurrentLayer) ,ADD(UpAxis_Positions[8],PosLim,UpAxis_PositionsPosLim[8]) SUB(UpAxis_Positions[8],NegLim,UpAxis_PositionsNegLim[8]) LIM(UpAxis_PositionsNegLim[8],UpAxis_Position,UpAxis