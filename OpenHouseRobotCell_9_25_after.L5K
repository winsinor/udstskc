		ROUTINE Routine060500_Operation 
				N: [[XIC(S:FS) ,XIC(POWER_OK_24VC) ONS(ONS.1) ] ,XIC(FIrst_Scan_TMR.TT) OTU(Fire_The_Laser) ]TON(FIrst_Scan_TMR,?,?);
				N: XIC(amp_Test_Bits.31)XIC(POWER_OK_24VC)XIC(POWER_OK_24VB)[GSV(Module,PLC25,FaultCode,HARDWARE_FAULTS[3]) NEQ(HARDWARE_FAULTS[3],0) OTL(AENTR_Com_Fault) ,GSV(Module,MDX2,FaultCode,HARDWARE_FAULTS[4]) NEQ(HARDWARE_FAULTS[4],0) OTL(Laser_Com_Fault) ,GSV(Module,IV3,FaultCode,HARDWARE_FAULTS[5]) NEQ(HARDWARE_FAULTS[5],0) OTL(Keyence_Com_Fault) ,GSV(Module,Weiss,FaultCode,HARDWARE_FAULTS[6]) NEQ(HARDWARE_FAULTS[6],0) OTL(Weiss_Com_Fault) ,XIC(Reset_Hold_TMR.DN) OTU(Weiss_Com_Fault) OTU(Keyence_Com_Fault) OTU(Laser_Com_Fault) OTU(AENTR_Com_Fault) ];
				RC: "***********************************************$N"
				    "NEW ITEM$N"
				    "IN TURN TABLE STATION 1$N"
				    "VFD and DATA  MOVE $N"
				    "$N"
				    "***********************************************";
				N: NOP();
				N: XIC(RtoTT_PlacedConfirm)ONS(ONS_DOCK.4)NEQ(RtoTT_PlaceSeqNumber,0)NEQ(RtoTT_PlaceSeqNumber,TurnTable[1].Seq_Num)COP(Data_Item[RtoTT_PlaceSeqNumber],TurnTable[1],1)OTE(TurnTable_New_Seq_Num);
				N: GRT(Data_Item[TurnTable_2_SeqNum].Status,0)GRT(Data_Item[TurnTable_3_SeqNum].Status,0)OTL(Turn_Table_Full);
				N: NOP()XIC(TurnTable_Move_ONS)COP(TurnTable[4],TurnTable[0],1)COP(TurnTable[3],TurnTable[4],1)COP(TurnTable[2],TurnTable[3],1)COP(TurnTable[1],TurnTable[2],1)COP(TurnTable[0],TurnTable[1],1);
				RC: "***********************************************$N"
				    "PART PRESENT LOGIC$N"
				    "TURN TABLE STATION 2$N"
				    "$N"
				    "***********************************************";
				N: NOP();
				N: XIC(TurnTable_Move_ONS)GRT(TurnTable[2].Seq_Num,0)NEQ(TurnTable[2].Seq_Num,TurnTable_2_SeqNum)MOV(TurnTable[2].Seq_Num,TurnTable_2_SeqNum)[[OTU(Data_Item[TurnTable_2_SeqNum].TurnTable_1_Pres) XIO(PE202) OTL(Data_Item[TurnTable_2_SeqNum].TurnTable_1_Pres) ,OTU(Data_Item[TurnTable_2_SeqNum].TurnTable_2_Pres) XIO(PE203) OTL(Data_Item[TurnTable_2_SeqNum].TurnTable_2_Pres) ] COP(Data_Item[TurnTable_2_SeqNum],TurnTable[2],1) ,XIC(PE202) XIC(PE203) COP(Data_Item_Initialize,TurnTable[2],1) ];
				RC: "***********************************************$N"
				    "LASER LOGIC$N"
				    "TURN TABLE STATION 3$N"
				    "$N"
				    "***********************************************";
				N: NOP();
				N: XIC(TurnTable_Move_ONS)GRT(TurnTable[3].Seq_Num,0)NEQ(TurnTable[3].Seq_Num,TurnTable_3_SeqNum)MOV(TurnTable[3].Seq_Num,TurnTable_3_SeqNum)COP(Data_Item[TurnTable_3_SeqNum],TurnTable[3],1)XIC(Data_Item[TurnTable_3_SeqNum].TurnTable_1_Pres)XIC(Data_Item[TurnTable_3_SeqNum].TurnTable_2_Pres)XIC(amp_Test_Bits.31)OTL(Fire_The_Laser);
				N: [XIC(Fire_The_Laser) XIC(MDX2:I.Data[4].0) TOF(Laser_Clear_TMR,?,?) ,XIC(Laser_Clear_TMR.DN) ]OTE(MDX2:O.Data[7].0)OTE(MDX2:O.Data[6].0)OTU(Fire_The_Laser);
				N: [XIC(MDX2:I.Data[0].1) TON(Laser_Error_TMR,?,?) XIC(Laser_Error_TMR.DN) RES(Laser_Error_TMR) ,GRT(Laser_Error_TMR.ACC,500) OTE(MDX2:O.Data[0].3) ];
				RC: "***********************************************$N"
				    "IV3 CAMERA LOGIC$N"
				    "$N"
				    "***********************************************";
				N: NOP();
				N: XIC(TurnTable_Move_ONS)GRT(TurnTable[4].Seq_Num,0)NEQ(TurnTable[4].Seq_Num,TurnTable_4_SeqNum)MOV(TurnTable[4].Seq_Num,TurnTable_4_SeqNum)OTL(Trigger_IV3);
				N: XIC(IV3:I.Data[1].4)XIC(IV3:I.Data[1].5)XIO(IV3:I.Data[1].2)OTE(Keyence_IV3_Ready);
				RC: "Trigger Sequence";
				N: [XIC(Trigger_IV3) ONS(ONS_DOCK.2) ,XIC(IV3:O.Data[0].0) XIO(IV3:I.Data[0].0) ]XIO(IV3:I.Data[0].0)XIO(IV3:I.Data[0].7)OTE(IV3:O.Data[0].0);
				RC: "Result Data for Alarms";
				N: XIO(IV3:I.Data[1].2)XIC(IV3:I.Data[1].0)ONS(ONS_DOCK.6)OTU(Trigger_IV3)GRT(TurnTable_4_SeqNum,0)[OTU(Data_Item[TurnTable_4_SeqNum].Inspect_1_Status) XIC(IV3:I.Data[3].0) OTL(Data_Item[TurnTable_4_SeqNum].Inspect_1_Status) ,OTU(Data_Item[TurnTable_4_SeqNum].Inspect_2_Status) XIC(IV3:I.Data[3].1) OTL(Data_Item[TurnTable_4_SeqNum].Inspect_2_Status) ]COP(Data_Item[TurnTable_4_SeqNum],TurnTable[4],1);
				RC: "***********************************************$N"
				    "PICKUP LOGIC$N"
				    "TURN TABLE STATION 1$N"
				    "$N"
				    "***********************************************";
				N: NOP();
				N: [XIC(RtoTT_PickConfirm) ,XIC(Optix_TTpickConfirmButton) ]ONS(ONS_DOCK.7)GRT(TurnTable[1].Seq_Num,0)ADD(TEST_DINT[1],1,TEST_DINT[1])OTU(Turn_Table_Full)OTU(TTtoR_ReqToPickGood)OTU(TTtoR_ReqToPickBad)OTU(Optix_TTpickConfirmButton)MOV(4,Data_Item[TurnTable_1_SeqNum].Status)[COP(Data_Item_Initialize,TurnTable[1],1) ,COP(Data_Item_Initialize,TurnTable[0],1) ];
		END_ROUTINE

		ROUTINE Routine060600_AutoSequence1_OLD_Code 
				N: NOP();
				N: [XIC(Fire_The_Laser) XIC(Josh_test.26) XIO(Run_VFD) XIC(PRX200) OTL(CR301) OTL(CR400) ,XIO(Fire_The_Laser) ONS(ONS_DOCK.5) OTU(CR301) OTU(CR400) ];
				N: NOP()[XIC(TurnTable_New_Seq_Num) OTL(VFD_Index_REQUEST) ,XIC(PRX200) ONS(ONS_DOCK.1) XIO(FIrst_Scan_TMR.TT) XIO(AENTR_Com_Fault) [OTU(VFD_Index_REQUEST) ,OTE(TurnTable_Move_ONS) ] ];
				N: NOP()[XIC(VFD_Index_REQUEST) XIC(POWER_OK_24VC) XIO(Hood_Lowered) XIC(VFD_Weiss_READY) XIO(VFD_Weiss_FAULTED) OTE(Run_VFD) ,XIC(Run_VFD) OTE(CR504) OTE(VFD_Weiss_RUN) ,XIO(Run_VFD) OTE(VFD_Weiss_STOP) ,MOV(Weiss:O.FreqCommand,Weiss:O.FreqCommand) XIC(VFD_Weiss_AT_FREQ) NOP() ,XIC(Weiss:I.Active) OTE(TTtoR_TurnTableCycle) ,XIC(VFD_Weiss_FAULTED) [XIO(Reset_Hold_TMR.DN) XIC(CRM_S) ONS(ONS_DOCK.3) ,XIC(Reset_Hold_TMR.DN) ,XIC(RtoPLC_Started) ,XIC(GlobalAck_TOF.TT) ] OTE(VFD_Weiss_RESET) ];
		END_ROUTINE

