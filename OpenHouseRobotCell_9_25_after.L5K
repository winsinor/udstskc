		ROUTINE Routine060100_Main 
				N: JSR(_03_Inputs,0);
				N: JSR(_04_Outputs,0);
				N: JSR(_05_Indexer_Auto_Sequence,0);
				N: JSR(_06_Laser_Auto_Sequence,0);
