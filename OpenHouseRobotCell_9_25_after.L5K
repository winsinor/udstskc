			EnableIn : BOOL (Description := "Enable Input - System Defined Parameter",
			                    Usage := Input,
			                    RADIX := Decimal,
			                    Required := No,
			                    Visible := No,
			                    ExternalAccess := Read Only);
			EnableOut : BOOL (Description := "Enable Output - System Defined Parameter",
			                     Usage := Output,
			                     RADIX := Decimal,
			                     Required := No,
			                     Visible := No,
			                     ExternalAccess := Read Only);
			TimeOn : DINT (Description := "mSec Time Output is ON",
			                  Usage := Input,
			                  RADIX := Decimal,
			                  Required := Yes,
			                  Visible := Yes,
			                  DefaultData := 0);
			TimeOff : DINT (Description := "mSec Time Output is OFF",
			                   Usage := Input,
			                   RADIX := Decimal,
			                   Required := Yes,
			                   Visible := Yes,
			                   DefaultData := 0);
		END_PARAMETERS

		LOCAL_TAGS
			PulseTimer : TIMER (ExternalAccess := None,
			                     DefaultData := "[0,500,0]");
			PulseTimer2 : TIMER (ExternalAccess := None,
			                      DefaultData := "[0,500,0]");
		END_LOCAL_TAGS

		ROUTINE Logic 
				N: XIC(EnableIn)[MOV(TimeOn,PulseTimer.PRE) ,MOV(TimeOff,PulseTimer2.PRE) ];
				N: XIC(EnableIn)[XIO(PulseTimer2.DN) TON(PulseTimer,?,?) ,XIC(PulseTimer.DN) TON(PulseTimer2,?,?) ];
				N: XIC(PulseTimer.DN)OTE(EnableOut);
		END_ROUTINE

	END_ADD_ON_INSTRUCTION_DEFINITION

	ADD_ON_INSTRUCTION_DEFINITION SCON_Moves (Class := Standard,
