				RC: "Find Closest Position$N"
				    "$N"
				    "$N"
				    "";
				N: [XIC(UpdateClosestPosition) ,XIC(UpstackCheckAutoSeq.2) ,XIC(UpstackCheckAutoSeq.3) ]ONS(ClosestPosONS)[ADD(UpAxis_Positions[1],ClosestPosLim,UpAxis_PositionsClosestPosLim[1]) SUB(UpAxis_Positions[1],ClosestNegLim,UpAxis_PositionsClosestNegLim[1]) LIM(UpAxis_PositionsClosestNegLim[1],UpAxis_Position,UpAxis_PositionsClosestPosLim[1]) MOV(1,UpAxis_ClosestLayer) ,ADD(UpAxis_Positions[2],ClosestPosLim,UpAxis_PositionsClosestPosLim[2]) SUB(UpAxis_Positions[2],ClosestNegLim,UpAxis_PositionsClosestNegLim[2]) LIM(UpAxis_PositionsClosestNegLim[2],UpAxis_Position,UpAxis_PositionsClosestPosLim[2]) MOV(2,UpAxis_ClosestLayer) ,ADD(UpAxis_Positions[3],ClosestPosLim,UpAxis_PositionsClosestPosLim[3]) SUB(UpAxis_Positions[3],ClosestNegLim,UpAxis_PositionsClosestNegLim[3]) LIM(UpAxis_PositionsClosestNegLim[3],UpAxis_Position,UpAxis_PositionsClosestPosLim[3]) MOV(3,UpAxis_ClosestLayer) ,ADD(UpAxis_Positions[4],ClosestPosLim,UpAxis_PositionsClosestPosLim[4]) SUB(UpAxis_Positions[4],ClosestNegLim,UpAxis_PositionsClosestNegLim[4]) LIM(UpAxis_PositionsClosestNegLim[4],UpAxis_Position,UpAxis_PositionsClosestPosLim[4]) MOV(4,UpAxis_ClosestLayer) ,ADD(UpAxis_Positions[5],ClosestPosLim,UpAxis_PositionsClosestPosLim[5]) SUB(UpAxis_Positions[5],ClosestNegLim,UpAxis_PositionsClosestNegLim[5]) LIM(UpAxis_PositionsClosestNegLim[5],UpAxis_Position,UpAxis_PositionsClosestPosLim[5]) MOV(5,UpAxis_ClosestLayer) ,ADD(UpAxis_Positions[6],ClosestPosLim,UpAxis_PositionsClosestPosLim[6]) SUB(UpAxis_Positions[6],ClosestNegLim,UpAxis_PositionsClosestNegLim[6]) LIM(UpAxis_PositionsClosestNegLim[6],UpAxis_Position,UpAxis_PositionsClosestPosLim[6]) MOV(6,UpAxis_ClosestLayer) ,ADD(UpAxis_Positions[7],ClosestPosLim,UpAxis_PositionsClosestPosLim[7]) SUB(UpAxis_Positions[7],ClosestNegLim,UpAxis_PositionsClosestNegLim[7]) LIM(UpAxis_PositionsClosestNegLim[7],UpAxis_Position,UpAxis_PositionsClosestPosLim[7]) MOV(7,UpAxis_ClosestLayer) ,ADD(UpAxis_Positions[8],ClosestPosLim,UpAxis_PositionsClosestPosLim[8]) SUB(UpAxis_Positions[8],ClosestNegLim,UpAxis_PositionsClosestNegLim[8]) LIM(UpAxis_PositionsClosestNegLim[8],UpAxis_Position,UpAxis_PositionsClosestPosLim[8]) MOV(8,UpAxis_ClosestLayer) ,ADD(UpAxis_Positions[9],ClosestPosLim,UpAxis_PositionsClosestPosLim[9]) SUB(UpAxis_Positions[9],ClosestNegLim,UpAxis_PositionsClosestNegLim[9]) LIM(UpAxis_PositionsClosestNegLim[9],UpAxis_Position,UpAxis_PositionsClosestPosLim[9]) MOV(9,UpAxis_ClosestLayer) ,ADD(UpAxis_Positions[10],ClosestPosLim,UpAxis_PositionsClosestPosLim[10]) SUB(UpAxis_Positions[10],ClosestNegLim,UpAxis_PositionsClosestNegLim[10]) LIM(UpAxis_PositionsClosestNegLim[10],UpAxis_Position,UpAxis_PositionsClosestPosLim[10]) MOV(10,UpAxis_ClosestLayer) ,ADD(UpAxis_Positions[11],ClosestPosLim,UpAxis_PositionsClosestPosLim[11]) SUB(UpAxis_Positions[11],ClosestNegLim,UpAxis_PositionsClosestNegLim[11]) LIM(UpAxis_PositionsClosestNegLim[11],UpAxis_Position,UpAxis_PositionsClosestPosLim[11]) MOV(11,UpAxis_ClosestLayer) ,ADD(UpAxis_Positions[12],ClosestPosLim,UpAxis_PositionsClosestPosLim[12]) SUB(UpAxis_Positions[12],ClosestNegLim,UpAxis_PositionsClosestNegLim[12]) LIM(UpAxis_PositionsClosestNegLim[12],UpAxis_Position,UpAxis_PositionsClosestPosLim[12]) MOV(12,UpAxis_ClosestLayer) ,ADD(UpAxis_Positions[13],ClosestPosLim,UpAxis_PositionsClosestPosLim[13]) SUB(UpAxis_Positions[13],ClosestNegLim,UpAxis_PositionsClosestNegLim[13]) LIM(UpAxis_PositionsClosestNegLim[13],UpAxis_Position,UpAxis_PositionsClosestPosLim[13]) MOV(13,UpAxis_ClosestLayer) ,OTE(UpAxis_ClosestLayerFound) ];
