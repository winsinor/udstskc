	PROGRAM Program030000_System (Description := "This program manages start up fuctions, and overall systems status",
	                              Class := Standard,
	                              MAIN := "Routine030100_Main",
	                              MODE := 0,
	                              DisableFlag := 0,
	                              UseAsFolder := 0)
		TAG
		END_TAG

		ROUTINE Robot_IO_Mapping 
				N: XIC(Robot_Workspace_Loc.0)OTE(RobotAtLaser);
				N: XIC(Robot_Workspace_Loc.1)OTE(RobotAtStacker);
				N: XIC(Robot_Workspace_Loc.2)OTE(RobotAtIMM);
				N: XIO(Robot_Sts_State.2)OTE(RtoIMM_MoldAreaFree);
				RC: "robot status and start signals for starting different routines, for monitoring$N"
				    "";
				N: NOP();
				RC: "Robot Start / Stop$N"
				    "";
				N: XIC(PLCtoR_Start)XIC(PLCtoR_Stop)NOP();
				RC: "Robot Pick From Upstacker$N"
				    "";
				N: XIC(UStoR_ReqToPick)MOV(UStoR_PickColumnNumber,UStoR_PickColumnNumber)MOV(UStoR_PickRowNumber,UStoR_PickRowNumber)MOV(UStoR_PickSeqNumber,UStoR_PickSeqNumber)NOP();
				RC: "Robot Slide Layer at Upstacker$N"
				    "$N"
				    "";
				N: XIC(UStoR_ReqToMoveLayer)NOP();
				RC: "Robot Place Part at Laser Table$N"
				    "";
				N: XIC(TTtoR_ReqToPlace)NOP();
				RC: "Robot Pick Part from Laser Table$N"
				    "";
				N: [XIC(TTtoR_ReqToPickGood) ,XIC(TTtoR_ReqToPickBad) ]NOP();
				RC: "Robot Pick in IMM$N"
				    "$N"
				    "";
				N: XIC(IMMtoR_OpEnable)XIO(RtoIMM_RobotWithIMM)XIC(IMMtoR_EjectPosBck)XIC(IMMtoR_MoldOpen)XIO(IMMtoR_MoldClosed)[XIC(IMMtoR_PartInjected) ,NEQ(RtoIMM_SeqNumber,0) ]NOP();
				N: XIC(Good_Part_Pick_From_IMM)MOV(56,RtoIMM_SeqNumber);
				N: XIC(Place_In_IMM)MOV(0,RtoIMM_SeqNumber);
				RC: "Robot Place in IMM$N"
				    "$N"
				    "";
				N: XIC(IMMtoR_OpEnable)XIO(RtoIMM_RobotWithIMM)XIC(IMMtoR_EjectPosBck)XIC(IMMtoR_MoldOpen)XIO(IMMtoR_MoldClosed)[XIO(IMMtoR_PartInjected) ,EQU(RtoIMM_SeqNumber,0) ]NOP();
		END_ROUTINE

		ROUTINE Routine030100_Main 
				N: AFI()JSR(Routine030300_InputStatus,0);
				N: JSR(Routine030600_RobotAutoSequence_New,0);
				N: JSR(Routine030700_Outputs,0);
				N: JSR(Routine030200_Mode_Control,0);
				N: JSR(_01_System_Faults,0);
				N: JSR(Robot_IO_Mapping,0);
				N: JSR(_03_Main_Inputs,0);
				RC: "Predefined pulses";
				N: [Pulse(Pulse150c,150,150) OTE(Pulse_150) ,Pulse(Pulse500c,500,500) OTE(Pulse_500) ,Pulse(Pulse750c,750,750) OTE(Pulse_750) ,Pulse(Pulse1000c,1000,1000) OTE(Pulse_1000) ,Pulse(Pulse2000c,2000,2000) OTE(Pulse_2000) ];
				N: [[XIC(System_InCycle) ,] ,XIO(System_InCycle) XIC(System_CycleStop_Requested) XIO(CycleStopped) ]RTO(Machine_Overall_CycleTime,?,?);
				N: XIO(System_InCycle)XIO(System_CycleStop_Requested)XIC(amp_Test_Bits.29)RES(Machine_Overall_CycleTime);
				N: XIC(amp_Test_Bits.7)OTE(Finished_Part_Placed);
				N: DTOS(Machine_Overall_CycleTime.ACC,Machine_Overall_CycleTime_String)STOR(Machine_Overall_CycleTime_String,Machine_Overall_CycleTime_Real)CPT(Machine_Overall_CycleTime_Current,Machine_Overall_CycleTime_Real/1000);
				N: XIC(Finished_Part_Placed)ONS(ONS.0)[MOV(Machine_Overall_CycleTime.ACC,Machine_Overall_LastCycleTime_Real) DIV(Machine_Overall_CycleTime.ACC,1000,Machine_Last_CycleTime_DINT) CPT(Machine_Overall_LastCycleTime_Real,Machine_Overall_LastCycleTime_Real/1000) ,ADD(2,Machine_Total_Part_Counter,Machine_Total_Part_Counter) ,MOV(Machine_Overall_LastCycleTime_Real,Machine_Last_10_CycleTimes[CycleTimer_Increment]) ,ADD(1,CycleTimer_Increment,CycleTimer_Increment) ,GRT(CycleTimer_Increment,9) MOV(0,CycleTimer_Increment) ,DIV(Machine_Overall_CycleTime.ACC,1000,Machine_Overall_CycleTime.ACC) ,MOV(0,CycleTime_Min_FIFO[FIFO_Control.POS]) ,FFL(Machine_Overall_CycleTime.ACC,CycleTime_Sec_FIFO[0],FIFO_Control,?,?) ,XIC(FIFO_Control.DN) MOV(0,FIFO_Control.POS) ,RES(Machine_Overall_CycleTime) ];
				RC: "Calculate average cycle time over last 10 parts$N"
				    "Add all of the cycle times and divide them by 10";
				N: [MOV(0,CycleTime_AverageMin) ,CPT(CycleTime_TotalMin,CycleTime_Min_FIFO[0]+CycleTime_Min_FIFO[1]+CycleTime_Min_FIFO[2]+CycleTime_Min_FIFO[3]+CycleTime_Min_FIFO[4]+CycleTime_Min_FIFO[5]+CycleTime_Min_FIFO[6]+CycleTime_Min_FIFO[7]+CycleTime_Min_FIFO[8]+CycleTime_Min_FIFO[9]) ,CPT(CycleTime_TotalSec,CycleTime_Sec_FIFO[0]+CycleTime_Sec_FIFO[1]+CycleTime_Sec_FIFO[2]+CycleTime_Sec_FIFO[3]+CycleTime_Sec_FIFO[4]+CycleTime_Sec_FIFO[5]+CycleTime_Sec_FIFO[6]+CycleTime_Sec_FIFO[7]+CycleTime_Sec_FIFO[8]+CycleTime_Sec_FIFO[9]) ,CPT(CycleTime_AverageSec,(CycleTime_TotalMin*60+CycleTime_TotalSec)/10) ];
				RC: "Convert raw cycle time in seconds to min/sec";
				N: Pulse(CycleTime_Pulse,10,10)ONS(ONS.3)[GEQ(CycleTime_AverageSec,60) [ADD(CycleTime_AverageMin,1,CycleTime_AverageMin) ,SUB(CycleTime_AverageSec,60,CycleTime_AverageSec) ] ,GEQ(CycleTime_Sec_FIFO[0],60) [ADD(CycleTime_Min_FIFO[0],1,CycleTime_Min_FIFO[0]) ,SUB(CycleTime_Sec_FIFO[0],60,CycleTime_Sec_FIFO[0]) ] ,GEQ(CycleTime_Sec_FIFO[1],60) [ADD(CycleTime_Min_FIFO[1],1,CycleTime_Min_FIFO[1]) ,SUB(CycleTime_Sec_FIFO[1],60,CycleTime_Sec_FIFO[1]) ] ,GEQ(CycleTime_Sec_FIFO[2],60) [ADD(CycleTime_Min_FIFO[2],1,CycleTime_Min_FIFO[2]) ,SUB(CycleTime_Sec_FIFO[2],60,CycleTime_Sec_FIFO[2]) ] ,GEQ(CycleTime_Sec_FIFO[3],60) [ADD(CycleTime_Min_FIFO[3],1,CycleTime_Min_FIFO[3]) ,SUB(CycleTime_Sec_FIFO[3],60,CycleTime_Sec_FIFO[3]) ] ,GEQ(CycleTime_Sec_FIFO[4],60) [ADD(CycleTime_Min_FIFO[4],1,CycleTime_Min_FIFO[4]) ,SUB(CycleTime_Sec_FIFO[4],60,CycleTime_Sec_FIFO[4]) ] ,GEQ(CycleTime_Sec_FIFO[5],60) [ADD(CycleTime_Min_FIFO[5],1,CycleTime_Min_FIFO[5]) ,SUB(CycleTime_Sec_FIFO[5],60,CycleTime_Sec_FIFO[5]) ] ,GEQ(CycleTime_Sec_FIFO[6],60) [ADD(CycleTime_Min_FIFO[6],1,CycleTime_Min_FIFO[6]) ,SUB(CycleTime_Sec_FIFO[6],60,CycleTime_Sec_FIFO[6]) ] ,GEQ(CycleTime_Sec_FIFO[7],60) [ADD(CycleTime_Min_FIFO[7],1,CycleTime_Min_FIFO[7]) ,SUB(CycleTime_Sec_FIFO[7],60,CycleTime_Sec_FIFO[7]) ] ,GEQ(CycleTime_Sec_FIFO[8],60) [ADD(CycleTime_Min_FIFO[8],1,CycleTime_Min_FIFO[8]) ,SUB(CycleTime_Sec_FIFO[8],60,CycleTime_Sec_FIFO[8]) ] ,GEQ(CycleTime_Sec_FIFO[9],60) [ADD(CycleTime_Min_FIFO[9],1,CycleTime_Min_FIFO[9]) ,SUB(CycleTime_Sec_FIFO[9],60,CycleTime_Sec_FIFO[9]) ] ];
				N: XIO(System_AutoMode)XIC(amp_Test_Bits.3)RES(Machine_Overall_CycleTime);
				N: MOV(10,RangeToAverage);
				N: CPT(Avg_Last_10_CycleTimes,(Machine_Last_10_CycleTimes[0]+Machine_Last_10_CycleTimes[1]+Machine_Last_10_CycleTimes[2]+Machine_Last_10_CycleTimes[3]+Machine_Last_10_CycleTimes[4]+Machine_Last_10_CycleTimes[5]+Machine_Last_10_CycleTimes[6]+Machine_Last_10_CycleTimes[7]+Machine_Last_10_CycleTimes[8]+Machine_Last_10_CycleTimes[9])/RangeToAverage);
				RC: "Keeping track of parts that the cell has made";
				N: [NEQ(Robot_Good_Part_Unload_Request,0) ONS(ONS.4) CTU(Good_Parts_Produced,?,?) ,NEQ(Robot_Bad_Part_Unload_Request,0) ONS(ONS.5) CTU(Bad_Parts_Produced,?,?) ];
				N: XIC(HMI_Reset_Counters)ONS(ONS.6)RES(Good_Parts_Produced)RES(Bad_Parts_Produced);
				RC: "Time spent in cycle$N"
				    "Time spent not in cycle with no fault $N"
				    "Time in faulted state$N"
				    "Timer for a fault active in each station";
				N: [XIC(System_InCycle) RTO(In_Cycle_Timer,?,?) ,[XIC(System_ManualMode) ,XIC(System_No_Mode) ] RTO(Manual_Timer,?,?) ,XIO(System_InCycle) XIC(System_Fault_Present) RTO(Not_In_Cycle_WithFault_Timer,?,?) ,XIO(System_InCycle) XIO(System_Fault_Present) RTO(Not_In_Cycle_WithoutFault_Timer,?,?) ,XIC(System_Fault_Present) RTO(FaultTimer_Main,?,?) ,XIC(Robot_Fault_Present) RTO(FaultTimer_Robot,?,?) ,XIC(Laser_Station_Fault_Present) RTO(FaultTimer_Laser_Station,?,?) ,XIC(Up_Stacker_Fault_Present) RTO(FaultTimer_UpStacker,?,?) ,XIC(Down_Stacker_Fault_Present) RTO(FaultTimer_DownStacker,?,?) ];
				N: [XIC(S:FS) ,XIC(HMI_Reset_UpTime_Timers) ONS(ONS.7) ,XIC(NewDay_Flag) ONS(ONS.8) ]RES(In_Cycle_Timer)RES(Manual_Timer)RES(Not_In_Cycle_WithFault_Timer)RES(Not_In_Cycle_WithoutFault_Timer)RES(FaultTimer_Main)RES(FaultTimer_Robot)RES(FaultTimer_Laser_Station)RES(FaultTimer_UpStacker)RES(FaultTimer_DownStacker)OTU(NewDay_Flag);
				N: NEQ(LocDateTime.Day,PreviousScan_Day)OTL(NewDay_Flag);
				N: XIC(NewDay_Flag)[TON(NewDay_Reset_TMR,?,?) ,XIC(NewDay_Reset_TMR.DN) OTU(NewDay_Flag) ];
				N: MOV(LocDateTime.Day,PreviousScan_Day);
				N: GSV(WallClockTime,?,LocalDateTime,LocDateTime.Year);
		END_ROUTINE

		ROUTINE Routine030200_Mode_Control 
				RC: "*****************************************************************$N"
				    "MODE CONTROL & SAFETY MONITORING$N"
				    "*****************************************************************$N"
				    "";
				N: NOP();
				N: OTE(AlwaysOn);
				N: XIO(AlwaysOn)OTE(AlwaysOff);
				RC: "Control Relay Secondary $N"
				    " $N"
				    "CRM_S  Engauges when Rung is TRUE and,  IMM ESTOP OK,  Reset PB Pressed$N"
				    " $N"
				    " ";
				N: XIC(CRM_P)XIC(CRM_DS)XIO(DOOR_1)XIO(DOOR_2)XIO(DOOR_3)XIO(DOOR_4)NOP()XIC(CRM_S)NOP();
				RC: "!!!!!!!!!!!!!!!!!   THIS NEEDS FINISHED AND CONNECTED TO THE SAFETY PROGRAM  !!!!!!!!!!!!!!!!!!!!!!!!!!!";
				N: XIC(CRM_P)OTE(CR415)OTE(CR414)OTE(EStop_OK);
				N: XIC(CRM_S)OTE(Motion_Control_OK);
				RC: "This rung Acknowledges Faults$N"
				    "";
				N: XIC(HMI_Reset)TOF(GlobalAck_TOF,?,?);
				RC: "System Manual Mode comes on with the HMI and the Safetys satisfied. On the operator HMIs. ";
				N: EQU(HMI_System_Control_PB,1)XIO(System_CycleStop_Requested)XIC(EStop_OK)OTE(System_ManualMode);
				N: EQU(HMI_System_Control_PB,2)XIC(EStop_OK)OTE(System_AutoMode);
				N: XIC(RtoPLC_RobotReachedStop)OTE(Robot_Stopped);
				N: [XIC(IndexTable_In_Position) ,AFI() XIO(Weiss:I.Active) ]OTE(Weiss_Indexer_Stopped);
				N: XIO(UpStack_Inputs.Moving)OTE(UpStacker_Stopped);
				N: XIO(DwnStack_Inputs.Moving)OTE(DownStacker_Stopped);
				N: XIO(MDX2:I.Data[4].0)OTE(Laser_Stopped);
				N: XIO(System_ManualMode)XIO(System_AutoMode)OTE(System_No_Mode);
				RC: "THis rung needs to be finished add in stopped steps in each routine";
				N: XIC(Robot_Stopped)XIC(Laser_Stopped)XIC(Weiss_Indexer_Stopped)XIC(UpStacker_Stopped)XIC(DownStacker_Stopped)TON(Machine_Stopped_Delay,?,?)XIC(Machine_Stopped_Delay.DN)OTE(System_At_Home);
				RC: "Cycle Stopped$N"
				    "";
				N: XIC(System_CycleStop_Requested)[XIC(Robot_Stopped) ,XIC(amp_Test_Bits.1) ]XIC(Laser_Stopped)XIC(Weiss_Indexer_Stopped)XIC(UpStacker_Stopped)XIC(DownStacker_Stopped)[OTE(CycleStopped) ,OTU(System_CycleStop_Requested) ];
				RC: "System in Cycle";
				N: XIC(System_AutoMode)[XIC(HMI_Reset) TON(HMI_Cycle_Start_Dly,?,?) XIC(HMI_Cycle_Start_Dly.DN) OTU(System_CycleStop_Requested) [XIO(System_Fault_Present) ,XIC(System_CycleStop_Requested) ] [XIC(System_At_Home) ,] ,XIC(System_InCycle) XIO(Sequence_Timeout_Timer.DN) ]XIO(CycleStopped)OTE(System_InCycle);
				RC: "Cycle Stop Request$N"
				    "";
				N: [XIC(System_AutoMode) ,XIC(General_RTE) ][XIC(General_RTE) ,XIC(Station_Purge_Mode) XIC(Stations_Data_Empty) ,[XIC(System_Fault_Present) XIO(Machine_Stopped_Delay.DN) ,XIC(System_CycleStop_Requested) ] TON(Sequence_Timeout_Timer,?,?) ONS(Cycle_Control_ONS.3) ,XIC(HMI_Cycle_Stop) ]OTL(System_CycleStop_Requested);
				N: XIC(HMI_Doors_Lock)OTL(HMI_Doors_Lock_Request);
				N: XIC(HMI_Doors_Lock_Request)OTU(General_RTE)OTE(O0410);
				N: XIC(HMI_Doors_UnLock)[XIO(System_InCycle) OTU(HMI_Doors_Lock_Request) ,XIC(System_InCycle) OTL(General_RTE) ];
				N: XIO(HMI_Doors_Lock_Request)[OTE(DR1_DR2) ,OTE(DR3_DR4) ];
				RC: "HMI annimations";
				N: [[XIO(Motion_Control_OK) XIC(System_InCycle) ,XIC(System_InCycle) XIO(System_Fault_Present) ] OTE(HMI_blink) ,XIO(System_Fault_Present) OTE(HMI_Cell_Color) ,[XIC(CRM_P) XIC(System_AutoMode) ,XIC(System_No_Mode) ] OTE(HMI_Visible) ,XIO(System_Fault_Present) [XIO(DOOR_1) OTE(PLC_To_PC_DINT[5].4) ,XIO(DOOR_2) OTE(PLC_To_PC_DINT[5].5) ,XIO(DOOR_3) OTE(PLC_To_PC_DINT[5].6) ,XIO(DOOR_4) OTE(PLC_To_PC_DINT[5].7) ] ,XIC(HMI_IMM_Visible) OTE(HMI_IMM_Visible) ,XIC(HMI_IMM_Blink) OTE(HMI_IMM_Blink) ,XIC(HMI_IMM_Color) OTE(HMI_IMM_Color) ];
		END_ROUTINE

		ROUTINE Routine030300_InputStatus 
				N: AFI()[[XIC(PB109) ,XIC(PC_Door_Open_Request) ] OTL(Door_Open_Request) ,[[XIC(PB110) ,XIC(Optix_DoorLockRequest) ONS(Optix_DoorLockRequestONS) ,XIC(Reset_Hold_TMR.DN) ] [OTE(FaultReset) ,RES(Door_Open_Wait) ] ,XIC(Door_Reset_Delay.EN) XIO(Door_Reset_Delay.DN) ] XIC(CRM_S) XIO(PB109) XIO(PC_Door_Open_Request) OTU(Unlock_Doors) TON(Door_Reset_Delay,?,?) [XIC(Door_Reset_Delay.DN) OTU(Door_Open_Request) ,XIC(Door_Reset_Delay.TT) XIC(RtoPLC_InAuto) OTL(StartRobotCycle) ] ,[XIC(Station100Robot._Active_Fault) ,XIC(Door_Open_Request) ] XIC(RtoPLC_InAuto) OTE(PLCtoR_Stop) ,XIC(Door_Open_Request) XIC(Door_Open_Permission) TON(Door_Open_Wait,?,?) XIC(Door_Open_Wait.DN) OTL(Unlock_Doors) ,[XIC(EM78_C7_C1) ,] XIO(Weiss:I.Active) XIO(MDX2:I.Data[4].0) XIO(Hood_Lowered) XIO(UpStack_Inputs.Moving) XIO(DwnStack_Inputs.Moving) [XIC(RtoPLC_RobotReachedStop) ,XIO(RtoPLC_InAuto) ] OTE(Door_Open_Permission) ,XIC(Unlock_Doors) OTE(DR1_DR2) OTE(DR3_DR4) ,XIO(Unlock_Doors) OTU(Optix_DoorLockRequest) ];
				N: AFI()[XIC(PB110) ,XIC(Optix_DoorLockRequest) ,XIC(Reset_Hold_TMR.TT) ]TON(Reset_Hold_TMR,?,?);
				N: AFI()[[XIC(Optix_IMMDoorAknowledge) ,XIC(Reset_Hold_TMR2.TT) ] TON(Reset_Hold_TMR2,?,?) ,XIO(Reset_Hold_TMR2.TT) OTU(Optix_IMMDoorAknowledge) OTE(EM78_A4) ];
				N: XIC(EM78_C9_C3)NOP();
				RC: "Control Relay Master$N"
				    " $N"
				    "CRM  Engauges when Rung is TRUE and IMM Doors are TRUE$N"
				    " $N"
				    " ";
				N: XIC(CRM_S)NOP()XIC(CRM)NOP();
				RC: "Control Relay Secondary $N"
				    " $N"
				    "CRM_S  Engauges when Rung is TRUE and,  IMM ESTOP OK,  Reset PB Pressed$N"
				    " $N"
				    " ";
				N: XIC(CRM_P)XIC(CRM_DS)XIO(DOOR_1)XIO(DOOR_2)XIO(DOOR_3)XIO(DOOR_4)NOP()XIC(CRM_S)NOP();
				RC: "Control Relay Primary$N"
				    " $N"
				    "CRM_P  Engauges when Kuka Controller, Kuka Estop, and Panel Estop  is TRUE$N"
				    " $N"
				    " ";
				N: XIO(ESPB104)NOP()XIC(CRM_P)NOP();
				RC: "Control Relay Docking Station$N"
				    " $N"
				    "CRM_DS  Docking Station PRX is TRUE and Reset PB Pressed$N"
				    " ";
				N: XIC(CRM_DS)NOP();
		END_ROUTINE

		ROUTINE Routine030400_Operation_Old 
				N: NOP();
				RC: "Unswitch Power 24VA $N"
				    "$N"
				    "Timer may be necessary on First Scan";
				N: [OTE(POWER_OK_24VA) ,OTE(CR414) ,OTE(CR415) XIC(CRM_S) XIO(CRM_JB) NOP() ,XIC(POWER_OK_24VC) OTE(CR508) OTE(CR512) ,XIC(POWER_OK_24VC) OTE(CR515) OTE(CR509) ];
		END_ROUTINE

		ROUTINE Routine030600_RobotAutoSequence_New 
				RC: "*****************************$N"
				    "IMM ROBOT$N"
				    "*****************************";
				N: NOP();
				RC: "Robot Auto Sequence$N"
				    "$N"
				    "Moves The Next Sequence Cycle Step Into The Current Cycle Step. This Can Be Used To Step The Code Through The AutoCycle One Step At A Time.$N"
				    "This Can Be Done By Putting A Toggle Bit Infront Of The Move Instruction";
				N: [[XIO(System_AutoMode) ,XIC(S:FS) ] [MOV(0,Robot_Auto.Routine_CurrentCycleStep) ,MOV(0,Robot_Auto.Routine_NextCycleStep) ] ,[XIC(System_InCycle) ,XIO(System_InCycle) [XIC(System_CycleStop_Requested) ,XIC(Auto_Initialization) ] ] MOV(Robot_Auto.Routine_NextCycleStep,Robot_Auto.Routine_CurrentCycleStep) ];
				RC: "Robot Auto sequence Decision step$N"
				    "";
				N: EQU(Robot_Auto.Routine_CurrentCycleStep,0)XIC(System_InCycle)XIC(IndexTable_In_Position)[XIC(IndexTable_New_Part_Requested) MOV(10,Robot_Auto.Routine_NextCycleStep) ,NEQ(Robot_Good_Part_Unload_Request,0) MOV(100,Robot_Auto.Routine_NextCycleStep) ,XIC(IMM_Load_Request) MOV(200,Robot_Auto.Routine_NextCycleStep) ,XIC(Tray_Transfer_Request) MOV(300,Robot_Auto.Routine_NextCycleStep) ,NEQ(Robot_Bad_Part_Unload_Request,0) MOV(1000,Robot_Auto.Routine_NextCycleStep) ];
				RC: "Robot Auto sequence$N"
				    "$N"
				    "Index table New Part Requested$N"
				    "";
				N: EQU(Robot_Auto.Routine_CurrentCycleStep,10)XIC(System_InCycle)[OTE(Robot_Load_New_Part) ,XIC(IndexTable_In_Position) XIC(Index_Table_Part_Data[1].Inside_Part_Data_Present) MOV(0,Robot_Auto.Routine_NextCycleStep) ];
				RC: "Robot Auto sequence$N"
				    "$N"
				    "Unload good Part$N"
				    "";
				N: EQU(Robot_Auto.Routine_CurrentCycleStep,100)XIC(System_InCycle)[OTE(Robot_Unload_Good_Part) ,XIC(IndexTable_In_Position) XIC(Index_Table_Part_Data[1].Inside_Part_Data_Present) MOV(0,Robot_Auto.Routine_NextCycleStep) ];
				RC: "Robot Auto sequence$N"
				    "$N"
				    "IMM Load / unload Parts$N"
				    "";
				N: EQU(Robot_Auto.Routine_CurrentCycleStep,200)XIC(System_InCycle)[XIC(IMM_Open) OTE(Robot_LoadUnload_Imm_Parts) ,XIO(Robot_Blank_Side_Part_Data.Inside_Part_Data_Present) XIC(Robot_Finished_Side_Part_Data.Inside_Part_Data_Present) MOV(0,Robot_Auto.Routine_NextCycleStep) ];
				RC: "Robot Auto sequence$N"
				    "$N"
				    "Transfer trays from upsatacker to down stacker$N"
				    "";
				N: EQU(Robot_Auto.Routine_CurrentCycleStep,300)XIC(System_InCycle)[OTE(Robot_Transfer_Trays) ,XIC(RtoUS_LayerMovedConfirm) MOV(0,Robot_Auto.Routine_NextCycleStep) ];
		END_ROUTINE

		ROUTINE Routine030700_Outputs 
				N: NOP();
				RC: "Reset Safety Relays";
				N: XIC(GlobalAck_TOF.TT)[OTE(CR411) ,OTE(CR412) ];
				N: XIC(CRM_DS)TON(POWER_TMR_24VC,?,?)XIC(POWER_TMR_24VC.DN)OTE(POWER_OK_24VC);
				N: XIC(CRM_S)TON(POWER_TMR_24VB,?,?)XIC(POWER_TMR_24VB.DN)OTE(POWER_OK_24VB);
				N: XIC(CRM_P)XIC(CRM_S)XIC(CRM)XIO(Door_Open_Request)OTE(System_Clear)OTE(Local:4:O.Data.5);
				N: XIO(CRM)OTE(LT403);
				N: [XIC(Upstack_Complete) ,XIC(System_InCycle) ]TON(Horn_TMR,?,?)XIO(Horn_TMR.DN)OTE(AH402);
				N: [[TON(Flash_TMR,?,?) ,XIC(Flash_TMR.DN) RES(Flash_TMR) ] [XIC(Door_Open_Request) MOV(3000,Flash_TMR.PRE) GRT(Flash_TMR.ACC,1000) ,XIO(CRM) MOV(1000,Flash_TMR.PRE) GRT(Flash_TMR.ACC,500) ,XIO(CRM_S) MOV(500,Flash_TMR.PRE) GRT(Flash_TMR.ACC,250) ,XIO(CRM_P) MOV(250,Flash_TMR.PRE) GRT(Flash_TMR.ACC,125) ] OTE(LT404) ,XIC(System_Clear) ]OTE(LT400);
		END_ROUTINE

		ROUTINE _01_System_Faults 
				RC: "*****************************************************$N"
				    "Automation System Fault Present$N"
				    "*****************************************************";
				N: [NEQ(Main_Alarms,0) ,XIC(Robot_Faulted) ,XIC(Laser_Station_Faulted) ,XIC(Cutter_Fault_Present) ,XIC(amp_Test_Bits.2) ]OTE(System_Fault_Present);
				N: XIC(amp_Test_Bits.5)OTE(System_Warning_Present);
				RC: "RESETS ALARM FILE [0] FAULTS";
				N: XIC(GlobalAck_TOF.TT)CLR(Main_Alarms);
				RC: "AENTR communications fault";
				N: XIC(Pulse_1000)XIC(POWER_OK_24VC)XIC(POWER_OK_24VB)GSV(Module,PLC25,FaultCode,HARDWARE_FAULTS[3])NEQ(HARDWARE_FAULTS[3],0)OTL(Main_Alarms.0);
				RC: "AENTR Communication Fault";
				N: XIC(Main_Alarms.0)ALMD(MAIN_ALMD_00,HMI_FaultAck_All,HMI_FaultReset_All,0,0);
				RC: "MDX Laser communications fault";
				N: XIC(Pulse_1000)XIC(POWER_OK_24VC)XIC(POWER_OK_24VB)GSV(Module,MDX2,FaultCode,HARDWARE_FAULTS[4])NEQ(HARDWARE_FAULTS[4],0)OTL(Main_Alarms.1);
				RC: "MDX Laser Communication Fault";
				N: XIC(Main_Alarms.1)ALMD(MAIN_ALMD_01,HMI_FaultAck_All,HMI_FaultReset_All,0,0);
				RC: "Weiss Drive communications fault";
				N: XIC(Pulse_1000)XIC(POWER_OK_24VC)XIC(POWER_OK_24VB)GSV(Module,Weiss,FaultCode,HARDWARE_FAULTS[6])NEQ(HARDWARE_FAULTS[6],0)OTL(Main_Alarms.2);
				RC: "Power Flex 525 Communication Fault (Weiss)";
				N: XIC(Main_Alarms.2)ALMD(MAIN_ALMD_02,HMI_FaultAck_All,HMI_FaultReset_All,0,0);
				RC: "Main system E_Stop CRM_P OFF";
				N: XIO(CRM_P)[TON(Main_Alarm_Delay[0],?,?) ,XIC(Main_Alarm_Delay[0].DN) OTL(Main_Alarms.3) ];
				RC: "E-Stop CRM_P not reset Fault";
				N: XIC(Main_Alarms.3)ALMD(MAIN_ALMD_03,HMI_FaultAck_All,HMI_FaultReset_All,0,0);
				RC: "Main system CRM_S OFF (Motion) Doors not reset";
				N: XIO(CRM_S)[TON(Main_Alarm_Delay[1],?,?) ,XIC(Main_Alarm_Delay[1].DN) OTL(Main_Alarms.4) ];
				RC: "Main System CRM_S OFF Doors Not reset";
				N: XIC(Main_Alarms.4)ALMD(MAIN_ALMD_04,HMI_FaultAck_All,HMI_FaultReset_All,0,0);
				RC: "Main system Robot Safety CRM OFF ";
				N: XIO(CRM)[TON(Main_Alarm_Delay[2],?,?) ,XIC(Main_Alarm_Delay[2].DN) OTL(Main_Alarms.5) ];
				RC: "Robot Safety CRM Not Reset";
				N: XIC(Main_Alarms.5)ALMD(MAIN_ALMD_05,HMI_FaultAck_All,HMI_FaultReset_All,0,0);
				RC: "Main system Laser Docking Station CRM-DS OFF ";
				N: XIC(AlwaysOff)XIO(CRM_DS)[TON(Main_Alarm_Delay[3],?,?) ,XIC(Main_Alarm_Delay[3].DN) OTL(Main_Alarms.6) ];
				RC: "Laser Docking Station CRM_DS Not Reset";
				N: XIC(Main_Alarms.6)ALMD(MAIN_ALMD_06,HMI_FaultAck_All,HMI_FaultReset_All,0,0);
				RC: "Laser Station Hood Lowered CRM-JB OFF ";
				N: XIC(Hood_Lowered)XIO(Weiss_Hood_Raised)XIO(CRM_JB)[TON(Main_Alarm_Delay[4],?,?) ,XIC(Main_Alarm_Delay[4].DN) OTL(Main_Alarms.7) ];
				RC: "Laser Hood Safety CRM_JB Fault";
				N: XIC(Main_Alarms.7)ALMD(MAIN_ALMD_07,HMI_FaultAck_All,HMI_FaultReset_All,0,0);
				RC: "Air Pressure Alarm";
				N: XIC(CRM_P)XIC(CRM_S)XIO(Air_Pressure_Switch)[TON(Main_Alarm_Delay[5],?,?) ,XIC(Main_Alarm_Delay[5].DN) OTL(Main_Alarms.8) ];
				RC: "Air Pressure Switch Fault";
				N: XIC(Main_Alarms.8)ALMD(MAIN_ALMD_08,HMI_FaultAck_All,HMI_FaultReset_All,0,0);
		END_ROUTINE

		ROUTINE _03_Main_Inputs 
				RC: "Input Mapping";
				N: NOP();
				N: OTE(Air_Pressure_Switch);
		END_ROUTINE

		CHILD_PROGRAMS
		END_CHILD_PROGRAMS

	END_PROGRAM

	PROGRAM Program040000_Station100_Robot (Class := Standard,
	                                        MAIN := "Routine040100_Main",
	                                        MODE := 0,
	                                        DisableFlag := 0,
	                                        UseAsFolder := 0)
		TAG
			Cmd_Done : BOOL (Description := "Latched by the handshake on success, unlatched by the step that advances.",
			            RADIX := Decimal) := 0;
			Cmd_Request : DINT (Description := "Routine the sequencer is requesting to run",
			            RADIX := Decimal) := 0;
			HS_AcceptTmr : TIMER (Description := "Robot must accept a command within 5 s.") := [0,5000,0];
			HS_RunTmr : TIMER (Description := "Longest allowed routine cuycle time.") := [0,120000,0];
			HS_Step : DINT (Description := "Handshake state.$N0 idle$N10 wait accept$N20 wait result$N30 release$N90 fault.",
			            RADIX := Decimal) := 0;
			Seq_Reset : BOOL (Description := "Clears a fault and returns the cycle to idle.",
			            RADIX := Decimal) := 0;
			Seq_Run : BOOL (Description := "Cell in Auto and started.",
			            RADIX := Decimal) := 0;
		END_TAG

		ROUTINE Routine040100_Main 
				N: JSR(Routine040300_InputStatus,0);
				N: JSR(Routine040400_Operation_Empty,0);
				N: JSR(Routine040600_Robot_Startup,0);
				N: JSR(Routine040700_OutputActions,0);
				N: JSR(Routine049999_Alarms,0);
				N: JSR(_01_Robot_Comms,0)JSR(_03_RobotSequencer,0);
				N: JSR(_02_Robot_Faults,0);
				N: JSR(_08_HMI_Animations,0);
		END_ROUTINE

		ROUTINE Routine040300_InputStatus 
				N: COP(Station100_Robot:I.Data[32],RtoTT_PlaceSeqNumber,4);
				N: COP(Station100_Robot:I.Data[36],RtoDS_PlaceSeqNumber,4);
				N: COP(Station100_Robot:I.Data[40],RtoIMM_SeqNumber,4);
				N: COP(Station100_Robot:I.Data[44],RtoPLC_ToolBlnkSeqNumber,4);
				N: COP(Station100_Robot:I.Data[48],RtoPLC_ToolFinSeqNumber,4);
				N: COP(PLCtoR_MoveAccel,Station100_Robot:O.Data[56],4);
				N: XIC(VG524)OTE(PLCtoR_BlankCupAVacOn);
				N: XIC(VG526)OTE(PLCtoR_BlankCupBVacOn);
				N: XIC(VG528)OTE(PLCtoR_FinishCupAVacOn);
				N: XIC(VG530)OTE(PLCtoR_FinishCupBVacOn);
				RC: "$N"
				    "$N"
				    "Robot to injectiojn molding machine EuroMap signals $N"
				    "$N"
				    "";
				N: XIC(RtoIMM_MoldAreaFree)OTE(IEM67_A3_C3);
				N: XIC(RtoIMM_MoldCloseEnable)OTE(IEM67_A6);
				N: XIC(RtoIMM_MoldOpenEnable)OTE(IEM67_A7);
				N: XIC(RtoIMM_RobotWithIMM)OTE(IEM67_B2);
				N: XIC(RtoIMM_MoldEjectBack)OTE(IEM67_B3);
				N: XIC(RtoIMM_MoldEjectFrw)OTE(IEM67_B4);
				N: XIC(RtoIMM_MoldCorePL1Pos1)OTE(IEM67_B5);
				N: XIC(RtoIMM_MoldCorePL1Pos2)OTE(IEM67_B6);
