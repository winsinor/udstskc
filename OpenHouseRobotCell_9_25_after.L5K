	                                          EditedBy := "ATLANTA-E-PC\Atlanta Engineer",
	                                          SoftwareRevision := "v20.01")
		PARAMETERS
			EnableIn : BOOL (Description := "Enable Input - System Defined Parameter",
			                    Usage := Input,
			                    RADIX := Decimal,
			                    Required := No,
			                    Visible := No,
			                    ExternalAccess := Read Only);
			EnableOut : BOOL (Description := "Enable Output - System Defined Parameter",
			                     Usage := Output,
			                     RADIX := Decimal,
			                     Required := No,
			                     Visible := No,
			                     ExternalAccess := Read Only);
			EN : BOOL (Usage := Output,
			              RADIX := Decimal,
			              Required := No,
			              Visible := Yes,
			              ExternalAccess := Read Only,
			              DefaultData := 0);
			Home : BOOL (Usage := Input,
			                RADIX := Decimal,
			                Required := Yes,
			                Visible := Yes,
			                DefaultData := 0);
			Start_Move : BOOL (Usage := Input,
			                      RADIX := Decimal,
			                      Required := Yes,
			                      Visible := Yes,
			                      DefaultData := 0);
			Target_Position : DINT (Usage := Input,
			                           RADIX := Decimal,
			                           Required := Yes,
			                           Visible := Yes,
			                           DefaultData := 0);
			Target_Speed : DINT (Usage := Input,
			                        RADIX := Decimal,
			                        Required := Yes,
			                        Visible := Yes,
			                        DefaultData := 0);
			Accel : INT (Usage := Input,
			                 RADIX := Decimal,
			                 Required := Yes,
			                 Visible := Yes,
			                 DefaultData := 0);
			Decel : INT (Usage := Input,
			                 RADIX := Decimal,
			                 Required := Yes,
			                 Visible := Yes,
			                 DefaultData := 0);
			Position_Band : DINT (Usage := Input,
			                         RADIX := Decimal,
			                         Required := Yes,
			                         Visible := Yes,
			                         DefaultData := 0);
			Increment_Select : BOOL (Usage := Input,
			                            RADIX := Decimal,
			                            Required := Yes,
			                            Visible := Yes,
			                            DefaultData := 0);
			Push_Select : BOOL (Usage := Input,
			                       RADIX := Decimal,
			                       Required := Yes,
			                       Visible := Yes,
			                       DefaultData := 0);
			Push_Direction : BOOL (Usage := Input,
			                          RADIX := Decimal,
			                          Required := Yes,
			                          Visible := Yes,
			                          DefaultData := 0);
			Push_Percent : INT (Usage := Input,
			                        RADIX := Decimal,
			                        Required := Yes,
			                        Visible := Yes,
			                        DefaultData := 0);
			Load_Threshold_Percent : INT (Usage := Input,
			                                  RADIX := Decimal,
			                                  Required := Yes,
			                                  Visible := Yes,
			                                  DefaultData := 0);
			PZone_Upper_Limit : DINT (Usage := Input,
			                             RADIX := Decimal,
			                             Required := Yes,
			                             Visible := Yes,
			                             DefaultData := 0);
			PZone_Lower_Limit : DINT (Usage := Input,
			                             RADIX := Decimal,
			                             Required := Yes,
			                             Visible := Yes,
			                             DefaultData := 0);
			Map_Axis_Inputs : SCON_Inputs (Usage := InOut,
			                           Required := Yes,
			                           Visible := Yes);
			Map_Axis_Outputs : SCON_Outputs (Usage := InOut,
			                            Required := Yes,
			                            Visible := Yes);
		END_PARAMETERS

		LOCAL_TAGS
			One_shot : SINT (RADIX := Decimal,
			                   ExternalAccess := None,
			                   DefaultData := 0);
		END_LOCAL_TAGS

		ROUTINE EnableInFalse (Description := "Executes when the rung is false")
				N: OTU(EN);
		END_ROUTINE

		ROUTINE Logic 
				N: OTL(EN);
				N: XIC(Increment_Select)OTE(Map_Axis_Outputs.Increment_Select);
				N: XIC(Push_Select)OTE(Map_Axis_Outputs.Push_Select);
				N: XIC(Push_Direction)OTE(Map_Axis_Outputs.Push_Direction);
				N: XIC(Home)ONS(One_shot.0)XIC(Map_Axis_Inputs.Servo_is_On)XIO(Map_Axis_Outputs.Start_Move)OTL(Map_Axis_Outputs.Home);
				N: XIC(Map_Axis_Outputs.Home)XIC(Map_Axis_Inputs.Homing)OTU(Map_Axis_Outputs.Home);
				RC: "When The AOI is told to Go to Position all the data that relates to the move will be read in and the move request will be started";
				N: XIC(Start_Move)ONS(One_shot.1)[MOV(Target_Position,Map_Axis_Outputs.Target_Position) MOV(Target_Speed,Map_Axis_Outputs.Target_Speed) ,MOV(Accel,Map_Axis_Outputs.Acceleration) MOV(Decel,Map_Axis_Outputs.Deceleration) MOV(Position_Band,Map_Axis_Outputs.Position_Band) ,MOV(PZone_Lower_Limit,Map_Axis_Outputs.Zone_Boundary_Neg) MOV(PZone_Upper_Limit,Map_Axis_Outputs.Zone_Boundary_Pos) ,XIC(Push_Select) CPT(Map_Axis_Outputs.Push_Percent,(Push_Percent * 255) * .01) CPT(Map_Axis_Outputs.Load_Threshold_Percent,(Load_Threshold_Percent * 255) * .01) ,XIO(Push_Select) CLR(Map_Axis_Outputs.Push_Percent) CLR(Map_Axis_Outputs.Load_Threshold_Percent) ]OTL(Map_Axis_Outputs.Start_Move);
				N: [XIC(Map_Axis_Outputs.Start_Move) XIO(Map_Axis_Inputs.Position_Complete) XIO(Map_Axis_Inputs.Push_Failed) ,XIO(Map_Axis_Inputs.Home_Complete) ,XIC(Map_Axis_Inputs.Alarm_Active) ]OTU(Map_Axis_Outputs.Start_Move);
		END_ROUTINE

	END_ADD_ON_INSTRUCTION_DEFINITION

