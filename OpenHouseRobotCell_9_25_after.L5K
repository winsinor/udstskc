				N: [XIC(MDX2:I.Data[0].0) OTE(PLC_To_PC_DINT[13].0) ,XIC(MDX2:I.Data[0].1) OTE(PLC_To_PC_DINT[13].1) ,XIC(MDX2:I.Data[1].1) OTE(PLC_To_PC_DINT[13].2) ,XIC(PRX102) OTE(PLC_To_PC_DINT[13].3) ,XIC(PRX103) OTE(PLC_To_PC_DINT[13].4) ,XIC(O0410) OTE(PLC_To_PC_DINT[13].5) ,XIC(I0308) OTE(PLC_To_PC_DINT[13].6) ,XIC(I0300) OTE(PLC_To_PC_DINT[13].7) ,XIC(IV3:I.Data[1].5) OTE(PLC_To_PC_DINT[13].8) ,XIC(Keyence_Com_Fault) OTE(PLC_To_PC_DINT[13].9) ,XIC(VFD_Weiss_FAULTED) OTE(PLC_To_PC_DINT[13].10) ,XIC(Weiss:I.Active) OTE(PLC_To_PC_DINT[13].11) ,XIC(Weiss_Com_Fault) OTE(PLC_To_PC_DINT[13].12) ,XIC(TTtoR_ReqToPickGood) OTE(PLC_To_PC_DINT[13].14) ,XIC(TTtoR_ReqToPickBad) OTE(PLC_To_PC_DINT[13].15) ,XIC(TurnTable[1].TurnTable_1_Pres) OTE(PLC_To_PC_DINT[13].16) ,XIC(TurnTable[1].TurnTable_2_Pres) OTE(PLC_To_PC_DINT[13].17) ,XIC(TurnTable[2].TurnTable_1_Pres) OTE(PLC_To_PC_DINT[13].18) ,XIC(TurnTable[2].TurnTable_2_Pres) OTE(PLC_To_PC_DINT[13].19) ,XIC(TurnTable[3].TurnTable_1_Pres) OTE(PLC_To_PC_DINT[13].20) ,XIC(TurnTable[3].TurnTable_2_Pres) OTE(PLC_To_PC_DINT[13].21) ,XIC(TurnTable[4].TurnTable_1_Pres) OTE(PLC_To_PC_DINT[13].22) ,XIC(TurnTable[4].TurnTable_2_Pres) OTE(PLC_To_PC_DINT[13].23) ,XIC(TurnTable[4].Inspect_1_Status) OTE(PLC_To_PC_DINT[13].24) ,XIC(TurnTable[4].Inspect_2_Status) OTE(PLC_To_PC_DINT[13].25) ,XIC(TTtoR_TurnTableCycle) OTE(PLC_To_PC_DINT[13].26) ,XIC(AENTR_Com_Fault) OTE(PLC_To_PC_DINT[13].27) ,XIC(Laser_Com_Fault) OTE(PLC_To_PC_DINT[13].28) ];
