		ROUTINE Routine040600_Robot_Startup 
				N: [LES(PLCtoR_MoveAccel,10) MOV(10,PLCtoR_MoveAccel) ,GRT(PLCtoR_MoveAccel,100) MOV(100,PLCtoR_MoveAccel) ];
				N: [XIC(StartRobotCycle) ,XIC(System_InCycle) [XIC(amp_Test_Bits.4) ,XIC(RtoPLC_InAuto) XIO(RtoPLC_Started) ] ][XIO(StartRobotCycleRepeatTimer1[1].DN) [TON(StartRobotCycleRepeatTimer1[0],?,?) ,XIC(StartRobotCycleRepeatTimer1[0].DN) [TON(StartRobotCycleRepeatTimer1[1],?,?) ,CTU(StartRobotCycleRepeatCounter,?,?) ,OTE(PLCtoR_Start) ] ] ,XIC(StartRobotCycleRepeatCounter.DN) RES(StartRobotCycleRepeatCounter) OTU(StartRobotCycle) ];
				N: XIC(RtoPLC_Started)OTU(PLCtoR_ExtStart);
				N: XIC(PLCtoR_MoveEnable)OTE(PLCtoR_DrivesOff);
				N: XIC(RtoPLC_InAuto)XIO(RtoPLC_Started)XIC(PLCtoR_DrivesOff)XIC(PLCtoR_Start)ONS(RobotEXTstartONS.1)OTL(PLCtoR_DrivesOn)OTU(PLCtoR_ConfMess);
				N: XIC(RtoPLC_InAuto)XIC(PLCtoR_DrivesOn)XIC(RtoPLC_PeriRdy)OTU(PLCtoR_DrivesOn);
				N: XIO(PLCtoR_Start)XIC(RtoPLC_InAuto)XIO(PLCtoR_DrivesOn)XIC(RtoPLC_PeriRdy)XIC(RtoPLC_StopMess)ONS(RobotEXTstartONS.2)OTL(PLCtoR_ConfMess);
				N: XIC(RtoPLC_InAuto)XIC(RtoPLC_PeriRdy)XIO(RtoPLC_StopMess)[ONS(RobotEXTstartONS.3) OTU(PLCtoR_ConfMess) ,XIC(PLCtoR_Start) [ONS(RobotEXTstartONS.4) ,] OTL(PLCtoR_ExtStart) ];
		END_ROUTINE

		ROUTINE Routine040700_OutputActions 
				N: COP(UStoR_PickRowNumber,Station100_Robot:O.Data[32],4);
				N: COP(UStoR_PickColumnNumber,Station100_Robot:O.Data[36],4);
				N: COP(UStoR_PickSeqNumber,Station100_Robot:O.Data[40],4);
				N: COP(TTtoR_PickSeqNumber,Station100_Robot:O.Data[44],4);
				N: COP(DStoR_PickRowNumber,Station100_Robot:O.Data[48],4);
				N: COP(DStoR_PickColumnNumber,Station100_Robot:O.Data[52],4);
				N: XIC(System_ManualMode)OTE(Rob_Permit_Gripper);
				RC: "Change the Robot Gripper vacuum buttons Colors";
				N: [XIO(Rob_Permit_Gripper) [XIO(CR708) MOV(0,Rob_Gripper_Close.Button_Color) ,XIO(CR709) MOV(0,Rob_Gripper_Open.Button_Color) ] ,XIC(Rob_Permit_Gripper) [[XIO(CR708) MOV(1,Rob_Gripper_Close.Button_Color) ,XIO(CR709) MOV(1,Rob_Gripper_Open.Button_Color) ] ,XIC(CR709) MOV(3,Rob_Gripper_Close.Button_Color) ,XIC(CR708) MOV(3,Rob_Gripper_Open.Button_Color) ,AFI() MOV(2,Rob_Gripper_Close.Button_Color) ,AFI() MOV(2,Rob_Gripper_Open.Button_Color) ,XIC(CR708) MOV(4,Rob_Gripper_Close.Button_Color) ,XIC(CR709) MOV(4,Rob_Gripper_Open.Button_Color) ] ];
				N: XIC(System_ManualMode)OTE(Spru_Cutter_Permit);
				N: [[XIC(RtoPLC_SprueCut1) ,XIC(System_ManualMode) XIC(Spru_Cutter_Permit) XIC(HMI_Spru_Cutter_Close) ] OTE(CR408) ,XIC(System_AutoMode) OTU(HMI_Spru_Cutter_Close) ];
				N: [[XIC(RtoPLC_SprueCut2) ,XIC(System_ManualMode) XIC(Spru_Cutter_Permit) XIC(HMI_Spru_Cutter_Close) ] OTE(CR409) ,XIC(System_AutoMode) OTU(HMI_Spru_Cutter_Open) ];
				N: XIC(System_ManualMode)OTE(Rob_Permit_Vac_A_Blank);
				N: [[XIC(RtoPLC_BlankCupAVac) ,XIC(System_ManualMode) XIC(Rob_Permit_Vac_A_Blank) XIC(HMI_Vac_A_Blank_Cup_ON) OTU(HMI_Blow_A_Blank_Cup_ON) ] OTE(CR700) ,XIC(System_AutoMode) OTU(HMI_Vac_A_Blank_Cup_ON) ];
				N: [[XIC(RtoPLC_BlankCupABlow) ,XIC(System_ManualMode) XIC(Rob_Permit_Vac_A_Blank) XIC(HMI_Blow_A_Blank_Cup_ON) OTU(HMI_Vac_A_Blank_Cup_ON) ] OTE(CR701) ,XIC(System_AutoMode) OTU(HMI_Blow_A_Blank_Cup_ON) ];
				N: [[XIC(RtoPLC_BlankCupBVac) ,XIC(System_ManualMode) XIC(Rob_Permit_Vac_A_Blank) XIC(HMI_Vac_B_Blank_Cup_ON) OTU(HMI_Blow_B_Blank_Cup_ON) ] OTE(CR702) ,XIC(System_AutoMode) OTU(HMI_Vac_B_Blank_Cup_ON) ];
				N: [[XIC(RtoPLC_BlankCupBBlow) ,XIC(System_ManualMode) XIC(Rob_Permit_Vac_A_Blank) XIC(HMI_Blow_B_Blank_Cup_ON) OTU(HMI_Vac_B_Blank_Cup_ON) ] OTE(CR703) ,XIC(System_AutoMode) OTU(HMI_Blow_B_Blank_Cup_ON) ];
				N: XIC(System_ManualMode)OTE(Rob_Permit_Vac_A_Finished);
				N: [[XIC(RtoPLC_FinishCupAVac) ,XIC(System_ManualMode) XIC(Rob_Permit_Vac_A_Finished) XIC(HMI_Vac_A_Finished_Cup_ON) OTU(HMI_Blow_A_Finished_Cup_ON) ] OTE(CR704) ,XIC(System_AutoMode) OTU(HMI_Vac_A_Finished_Cup_ON) ];
				N: [[XIC(RtoPLC_FinishCupABlow) ,XIC(System_ManualMode) XIC(Rob_Permit_Vac_A_Finished) XIC(HMI_Blow_A_Finished_Cup_ON) OTU(HMI_Vac_A_Finished_Cup_ON) ] OTE(CR705) ,XIC(System_AutoMode) OTU(HMI_Blow_A_Finished_Cup_ON) ];
				N: [[XIC(RtoPLC_FinishCupBVac) ,XIC(System_ManualMode) XIC(Rob_Permit_Vac_A_Finished) XIC(HMI_Vac_B_Finished_Cup_ON) OTU(HMI_Blow_B_Finished_Cup_ON) ] OTE(CR706) ,XIC(System_AutoMode) OTU(HMI_Vac_B_Finished_Cup_ON) ];
				N: [[XIC(RtoPLC_FinishCupBBlow) ,XIC(System_ManualMode) XIC(Rob_Permit_Vac_A_Finished) XIC(HMI_Blow_B_Finished_Cup_ON) OTU(HMI_Vac_B_Finished_Cup_ON) ] OTE(CR707) ,XIC(System_AutoMode) OTU(HMI_Blow_B_Finished_Cup_ON) ];
				N: [[XIC(RtoPLC_FinishGripClose) ,XIC(System_ManualMode) XIC(Rob_Permit_Gripper) XIC(HMI_Rob_Grip_Close) ] OTE(CR708) ,XIC(System_AutoMode) OTU(HMI_Rob_Grip_Close) ];
				N: [[XIC(RtoPLC_FinishGripOpen) ,XIC(System_ManualMode) XIC(Rob_Permit_Gripper) XIC(HMI_Rob_Grip_Open) ] OTE(CR709) ,XIC(System_AutoMode) OTU(HMI_Rob_Grip_Open) ];
				RC: "This is for removing a reject fromn the IMM";
				N: [XIC(EM67_ZA5) ,XIC(amp_Test_Bits.28) ,[XIC(Good_Part_Pick_From_IMM) ,XIC(Bad_Part_Pick_From_IMM) ] XIO(Place_In_IMM) ]OTE(IMMtoR_PartInjected);
				RC: "$N"
				    "$N"
				    "Injectiojn molding machine to robot EuroMap signals $N"
				    "$N"
				    "";
				N: XIC(EM67_ZA6)OTE(IMMtoR_MoldClosed);
				N: [[XIC(EM67_ZA7) ,XIC(MOLD_OPEN_TEST_BIT) ] ,XIC(Good_Part_Pick_From_IMM) ,XIC(Bad_Part_Pick_From_IMM) ,XIC(Place_In_IMM) ]OTE(IMM_Open)OTE(IMMtoR_MoldOpen);
				N: [XIC(EM67_ZA8) ,XIC(ROB_INTERMEDIATE_POS_OPEN_TEST) ]OTE(IMMtoR_MoldInterOpen);
				N: [XIC(EM67_ZB2) ,XIC(ROB_OPERATION_ENABLE_TEST) ,XIC(Good_Part_Pick_From_IMM) ,XIC(Bad_Part_Pick_From_IMM) ,XIC(Place_In_IMM) ]OTE(IMMtoR_OpEnable);
				N: [XIC(EM67_ZB3) ,XIC(ROB_OPERATION_EJECT_BACK_TEST) ,XIC(Good_Part_Pick_From_IMM) ,XIC(Bad_Part_Pick_From_IMM) ,XIC(Place_In_IMM) ]OTE(IMMtoR_EjectPosBck);
				N: [XIC(EM67_ZB4) ,XIO(Ejector_Test_Bit) ]OTE(IMMtoR_EjectPosFrw);
				N: XIC(EM67_ZB5)OTE(IMMtoR_CorePL1Pos1);
				N: XIC(EM67_ZB6)OTE(IMMtoR_CorePL1Pos2);
				N: XIC(EM67_ZB7)OTE(IMMtoR_CorePL2Pos1);
				N: XIC(EM67_ZB8)OTE(IMMtoR_CorePL2Pos2);
				N: [XIC(EM67_ZC8) ,XIC(amp_Test_Bits.30) ]OTE(IMMtoR_PartRejected);
				N: [XIC(EM78_C9_C3) ,XIC(ROBOT_DOOR_OPENED_TEST) ]OTE(IMMtoR_InidicateDrReq);
				N: [XIC(EM78_C7_C1) ,XIC(ROBOT_DOOR_OPEN_ENABLE_TEST) ]OTE(IMMtoR_DrOpenEnable);
				N: [XIC(CRM) XIC(O0410) ,XIC(Optix_RobotMoveEnable) ]OTE(PLCtoR_MoveEnable);
				N: NEQ(Robot_Good_Part_Unload_Request,0)OTL(TTtoR_ReqToPickGood);
				N: NEQ(Robot_Bad_Part_Unload_Request,0)OTL(TTtoR_ReqToPickBad);
				N: XIO(PE307)[TON(PE307_Delay,?,?) ,XIC(PE307_Delay.DN) OTE(PLCtoR_DrawerFull) ];
				N: XIC(PRX315)OTE(PLCtoR_DrawerInPos);
		END_ROUTINE

