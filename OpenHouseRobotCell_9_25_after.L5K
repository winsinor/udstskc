				N: NOP();
				N: XIC(RtoTT_PickConfirm)OTU(TTtoR_ReqToPickGood)OTU(Index_Table_Part_Data[1].Inside_Part_Data_Present)OTU(Index_Table_Part_Data[1].Outside_Part_Data_Present)OTU(Index_Table_Part_Data[1].Inside_Good_Part)OTU(Index_Table_Part_Data[1].Outside_Good_Part);
				N: XIC(RtoTT_PlacedConfirm)OTL(Index_Table_Part_Data[1].Inside_Part_Data_Present)OTL(Index_Table_Part_Data[1].Outside_Part_Data_Present);
				N: XIC(PE202)OTE(Index_Table_Inside_Part_Present);
				N: XIC(PE203)OTE(Index_Table_Outside_Part_Present);
				N: XIC(HMI_PartTracking_Clear_1)COP(Index_Table_Part_Data_Clear[1],Index_Table_Part_Data[1],1);
				N: XIC(HMI_PartTracking_Clear_2)COP(Index_Table_Part_Data_Clear[2],Index_Table_Part_Data[2],1);
				N: XIC(HMI_PartTracking_Clear_3)COP(Index_Table_Part_Data_Clear[3],Index_Table_Part_Data[3],1);
				N: XIC(HMI_PartTracking_Clear_4)COP(Index_Table_Part_Data_Clear[4],Index_Table_Part_Data[4],1);
				RC: "Laser Marker";
				N: NOP();
				N: XIC(MDX2:I.Data[0].0)OTE(Laser_Marker_Ready);
				N: [XIC(MDX2:I.Data[0].1) ,XIC(MDX2:I.Data[0].3) AFI() ,XIO(MDX2:I.Data[0].5) ,XIC(MDX2:I.Data[0].10) ,XIC(MDX2:I.Data[0].11) ,NEQ(HARDWARE_FAULTS[4],0) ]OTE(Laser_Error);
				N: XIC(MDX2:I.Data[0].2)OTE(Laser_Warning);
				N: XIC(MDX2:I.Data[0].6)OTE(Laser_Ready_For_Job_Change);
				N: XIC(MDX2:I.Data[0].8)OTE(MDX2:I.Data[0].8);
				N: XIC(MDX2:I.Data[0].9)OTE(Laser_Shutter_Control_Status);
				N: XIC(MDX2:I.Data[0].12)OTE(MDX2:I.Data[0].12);
				N: XIC(MDX2:I.Data[0].13)OTE(MDX2:I.Data[0].13);
				N: XIC(MDX2:I.Data[4].0)OTE(Laser_Marking_Complete);
				N: XIC(MDX2:I.Data[0].4)OTE(Laser_Shutter_Open);
				N: [NEQ(MDX2:I.Data[16],MDX2:O.Data[10]) XIC(MDX2:I.Data[5].0) ,XIC(MDX2:I.Data[9].0) ]OTE(Job_Change_Request_Error);
		END_ROUTINE

		ROUTINE _04_Outputs 
				N: XIC(System_ManualMode)XIC(Motion_Control_OK)XIC(PRX200)XIO(Weiss_Manual_Run_VFD)OTE(Laser_Hood_Lower_Permit);
				N: XIC(System_ManualMode)XIC(Motion_Control_OK)XIC(MDX2:I.Data[0].8)OTE(Laser_Hood_Raise_Permit);
				N: XIC(System_ManualMode)XIC(Motion_Control_OK)OTE(Fume_Permit);
				N: XIC(VFD_Weiss_FAULTED)[XIO(Reset_Hold_TMR.DN) XIC(CRM_S) ONS(ONS_DOCK.3) ,XIC(Reset_Hold_TMR.DN) ,XIC(RtoPLC_Started) ,XIC(GlobalAck_TOF.TT) ]OTE(VFD_Weiss_RESET);
				N: [XIC(System_ManualMode) XIC(Laser_Hood_Lower_Permit) XIC(HMI_Hood_Lower_PB) ,XIC(System_AutoMode) OTU(HMI_Hood_Lower_PB) NEQ(Weiss_Hood_Lower_Auto_Req,0) ]OTL(CR301);
				N: [XIC(System_ManualMode) XIC(Laser_Hood_Raise_Permit) XIC(HMI_Hood_Raise_PB) ,XIC(System_AutoMode) OTU(HMI_Hood_Raise_PB) NEQ(Weiss_Hood_Raise_Auto_Req,0) ]OTU(CR301);
				N: [XIC(System_ManualMode) XIC(Fume_Permit) XIC(HMI_Fume_ON_PB) ,XIC(System_AutoMode) OTU(HMI_Fume_ON_PB) XIC(Start_Fume_Extraction_Auto_Req) ]OTL(CR400);
				RC: "Turn Fume extraction off after XXX time";
				N: XIO(System_InCycle)XIC(Start_Fume_Extraction_Auto_Req)TON(Fume_Off_Idle_Tmr,?,?)XIC(Fume_Off_Idle_Tmr.DN)OTU(Start_Fume_Extraction_Auto_Req);
				N: [XIC(System_ManualMode) XIC(Fume_Permit) XIC(HMI_Fume_OFF_PB) ,XIO(EStop_OK) ,XIC(System_AutoMode) OTU(HMI_Fume_ON_PB) XIO(Start_Fume_Extraction_Auto_Req) ]OTU(CR400);
				N: XIC(EStop_OK)OTE(CR508);
				RC: "Start of Robot Outputs";
				N: NOP();
				N: AFI()XIC(TurnTable_Move_ONS)GRT(TurnTable[1].Seq_Num,0)NEQ(TurnTable[1].Seq_Num,TurnTable_1_SeqNum)MOV(TurnTable[1].Seq_Num,TurnTable_1_SeqNum)MOV(TurnTable_1_SeqNum,TTtoR_PickSeqNumber)MOV(3,Data_Item[TurnTable_1_SeqNum].Status)[XIC(Data_Item[TurnTable_1_SeqNum].Inspect_1_Status) XIC(Data_Item[TurnTable_1_SeqNum].Inspect_2_Status) OTL(TTtoR_ReqToPickGood) ,[XIO(Data_Item[TurnTable_1_SeqNum].Inspect_1_Status) ,XIO(Data_Item[TurnTable_1_SeqNum].Inspect_2_Status) ] OTL(TTtoR_ReqToPickBad) ];
				N: XIC(System_AutoMode)NEQ(Index_Table_New_Part_Requested,0)XIC(amp_Test_Bits.23)OTL(TTtoR_ReqToPlace);
				N: XIC(System_AutoMode)XIC(TTtoR_ReqToPlace)XIC(Index_Table_Part_Data[1].Inside_Part_Data_Present)XIC(Index_Table_Part_Data[1].Outside_Part_Data_Present)OTU(TTtoR_ReqToPlace);
				N: [XIC(System_ManualMode) XIC(Laser_Marking_Permit) XIC(HMI_Start_Marking_PB) ,XIC(System_AutoMode) XIC(amp_Test_Bits.24) NEQ(Laser_Start_Auto_Req,0) ]OTE(MDX2:O.Data[0].0);
				RC: "Manul index request";
				N: XIC(System_ManualMode)[[XIC(HMI_Index_Request) XIC(Weiss_Index_Permit) OTL(Weiss_Manual_IndexRequest) ,XIC(Weiss_Manual_IndexRequest) XIC(POWER_OK_24VC) XIO(Hood_Lowered) XIC(VFD_Weiss_READY) XIO(VFD_Weiss_FAULTED) OTE(Weiss_Manual_Run_VFD) ] ,XIC(PRX200) ONS(Weiss_ONS.0) OTU(HMI_Index_Request) OTU(Weiss_Manual_IndexRequest) ];
				RC: "Indexer brake release";
				N: [XIC(System_ManualMode) [XIC(HMI_Indexer_Brake_OFF_PB) AFI() ,XIC(Weiss_Manual_Run_VFD) ] XIC(Weiss_Index_Permit) ,XIC(System_AutoMode) NEQ(Weiss_VFD_Break_Release_Auto_Req,0) ]OTL(CR504);
				RC: "Indexer brake Apply";
				N: [XIC(System_ManualMode) [XIC(HMI_Indexer_Brake_ON_PB) AFI() ,XIO(Weiss_Manual_Run_VFD) ONS(Manual_RUN_ONS) ] XIC(Weiss_Index_Permit) ,XIC(System_AutoMode) NEQ(Weiss_VFD_Break_Apply_Auto_Req,0) ]OTU(CR504);
				RC: "Indexer Run";
				N: [XIC(System_ManualMode) [XIC(HMI_Indexer_Jog_PB) XIO(Weiss_Manual_Run_VFD) ,XIC(Weiss_Manual_Run_VFD) ] XIC(Weiss_Index_Permit) ,XIC(System_AutoMode) NEQ(Weiss_VFD_Run_Auto_Req,0) ]OTL(VFD_Weiss_RUN);
				RC: "Indexer Run";
				N: [XIC(System_ManualMode) [XIO(Weiss_Manual_Run_VFD) XIC(Weiss_Index_Permit) ,XIO(Weiss_Manual_Run_VFD) ] ,XIC(System_AutoMode) NEQ(Weiss_VFD_Stop_Auto_Req,0) ]OTU(VFD_Weiss_RUN);
				N: AFI()XIC(Weiss:I.Active)OTE(TTtoR_TurnTableCycle);
				N: XIO(MDX2:I.Data[9].0)[XIC(System_ManualMode) [XIC(HMI_Load_Laser_Program) XIO(MDX2:I.Data[1].4) ,XIO(MDX2:I.Data[5].0) XIC(ChangeJob_Requested) ] ,XIC(System_AutoMode) NEQ(Laser_Marker_Auto_Job_Change_Request,0) ]OTE(ChangeJob_Requested);
				N: [,MOV(MDX2:I.Data[16],HMI_Current_Laser_Program) NEQ(HMI_Laser_Job_Requested_Num,MDX2:I.Data[16]) ]XIC(ChangeJob_Requested)MOV(HMI_Laser_Job_Requested_Num,MDX2:O.Data[10])OTE(MDX2:O.Data[1].0);
		END_ROUTINE

		ROUTINE _05_Indexer_Auto_Sequence 
				RC: "Indexer Auto Sequence$N"
				    "Moves The Next Sequence Cycle Step Into The Current Cycle Step. This Can Be Used To Step The Code Through The AutoCycle One Step At A Time.$N"
				    "This Can Be Done By Putting A Toggle Bit Infront Of The Move Instruction";
				N: [[XIO(System_InCycle) ,XIC(S:FS) ] [MOV(0,Indexer_Auto.Routine_CurrentCycleStep) ,MOV(0,Indexer_Auto.Routine_NextCycleStep) ] ,[XIC(System_InCycle) ,XIO(System_InCycle) [XIC(System_CycleStop_Requested) ,XIC(Auto_Initialization) ] ] MOV(Indexer_Auto.Routine_NextCycleStep,Indexer_Auto.Routine_CurrentCycleStep) ,XIO(System_InCycle) NOP() ];
				N: XIC(IndexTable_In_Position)[EQU(Weiss_VFD_Run_Auto_Req,0) ONS(Indexer_Auto.ONS_Dint.0) COP(Index_Table_Part_Data[4],Index_Table_Part_Data[0],1) COP(Index_Table_Part_Data[3],Index_Table_Part_Data[4],1) COP(Index_Table_Part_Data[2],Index_Table_Part_Data[3],1) COP(Index_Table_Part_Data[1],Index_Table_Part_Data[2],1) COP(Index_Table_Part_Data[0],Index_Table_Part_Data[1],1) ,TON(Index_Table_InPos_Tmr,?,?) XIC(Index_Table_InPos_Tmr.DN) [XIC(Index_Table_Inside_Part_Present) OTU(Index_Table_Part_Data[2].Inside_Part_Data_Present) ,XIC(Index_Table_Outside_Part_Present) OTU(Index_Table_Part_Data[2].Outside_Part_Data_Present) ] ];
				RC: "This lines are for information only";
				N: [XIC(Index_Table_Part_Data[1].Inside_Part_Data_Present) XIC(Index_Table_Part_Data[1].Inside_Good_Part) XIC(Index_Table_Part_Data[1].Outside_Bad_Part) ,XIC(Index_Table_Part_Data[1].Outside_Part_Data_Present) XIC(Index_Table_Part_Data[1].Outside_Good_Part) XIC(Index_Table_Part_Data[1].Outside_Bad_Part) ]MOV(Index_Table_Part_Data[1].Assembly_Number,Index_Table_Part_Data[1].Assembly_Number)NOP();
				RC: "This lines are for information only";
				N: [XIC(Index_Table_Part_Data[2].Inside_Part_Data_Present) XIC(Index_Table_Part_Data[2].Inside_Good_Part) XIC(Index_Table_Part_Data[2].Outside_Bad_Part) ,XIC(Index_Table_Part_Data[2].Outside_Part_Data_Present) XIC(Index_Table_Part_Data[2].Outside_Good_Part) XIC(Index_Table_Part_Data[2].Outside_Bad_Part) ]MOV(Index_Table_Part_Data[2].Assembly_Number,Index_Table_Part_Data[2].Assembly_Number)NOP();
				RC: "This lines are for information only";
				N: [XIC(Index_Table_Part_Data[3].Inside_Part_Data_Present) XIC(Index_Table_Part_Data[3].Inside_Good_Part) XIC(Index_Table_Part_Data[3].Outside_Bad_Part) ,XIC(Index_Table_Part_Data[3].Outside_Part_Data_Present) XIC(Index_Table_Part_Data[3].Outside_Good_Part) XIC(Index_Table_Part_Data[3].Outside_Bad_Part) ]MOV(Index_Table_Part_Data[3].Assembly_Number,Index_Table_Part_Data[3].Assembly_Number)NOP();
				RC: "This lines are for information only";
				N: [XIC(Index_Table_Part_Data[4].Inside_Part_Data_Present) XIC(Index_Table_Part_Data[4].Inside_Good_Part) XIC(Index_Table_Part_Data[4].Outside_Bad_Part) ,XIC(Index_Table_Part_Data[4].Outside_Part_Data_Present) XIC(Index_Table_Part_Data[4].Outside_Good_Part) XIC(Index_Table_Part_Data[4].Outside_Bad_Part) ]MOV(Index_Table_Part_Data[4].Assembly_Number,Index_Table_Part_Data[4].Assembly_Number)NOP();
				RC: "Set VFD move speed and Accel Rate";
				N: MOV(Weiss:O.FreqCommand,Weiss:O.FreqCommand)OTE(Weiss:O.AccelRate1);
				RC: "Indexer Auto sequence Decision step$N"
				    "$N"
				    "!!!!!!   Need to modify the part data UDT to add Laser Marking started, Laser marking Finished. !!!!!!!$N"
				    "";
				N: EQU(Indexer_Auto.Routine_CurrentCycleStep,0)XIC(System_InCycle)[XIC(IndexTable_In_Position) [XIO(Weiss_Hood_Raised) XIC(Hood_Lowered) [[XIC(Index_Table_Part_Data[1].Inside_Part_Data_Present) ,XIC(Index_Table_Part_Data[1].Outside_Part_Data_Present) ] XIC(Index_Table_Part_Data[3].Laser_Marking_Started) XIC(Index_Table_Part_Data[3].Laser_Marking_Finished) MOV(80,Indexer_Auto.Routine_NextCycleStep) ,XIO(Index_Table_Part_Data[1].Inside_Part_Data_Present) XIO(Index_Table_Part_Data[1].Outside_Part_Data_Present) [XIO(TTtoR_ReqToPlace) MOV(10,Indexer_Auto.Routine_NextCycleStep) ,XIC(TTtoR_ReqToPlace) XIO(Index_Table_Part_Data[3].Laser_Marking_Started) XIO(Index_Table_Part_Data[3].Laser_Marking_Finished) MOV(50,Indexer_Auto.Routine_NextCycleStep) ] ] ,XIC(Weiss_Hood_Raised) XIO(Hood_Lowered) [XIO(Index_Table_Part_Data[1].Inside_Part_Data_Present) XIO(Index_Table_Part_Data[1].Outside_Part_Data_Present) MOV(10,Indexer_Auto.Routine_NextCycleStep) ,XIC(Index_Table_Part_Data[1].Inside_Part_Data_Present) XIC(Index_Table_Part_Data[1].Outside_Part_Data_Present) XIO(Index_Table_Part_Data[1].Laser_Marking_Started) XIO(Index_Table_Part_Data[1].Laser_Marking_Finished) MOV(20,Indexer_Auto.Routine_NextCycleStep) ] ,[XIC(Index_Table_Part_Data[1].Inside_Part_Data_Present) ,XIC(Index_Table_Part_Data[1].Outside_Part_Data_Present) ] XIC(Index_Table_Part_Data[1].Laser_Marking_Started) XIC(Index_Table_Part_Data[1].Laser_Marking_Finished) MOV(100,Indexer_Auto.Routine_NextCycleStep) ] ,COP(Indexer_Step_String[1],Indexer_Auto.Step_Description,1) ];
				RC: "Indexer Auto sequence $N"
				    "$N"
				    "Request a new part loaded into index table nest wait for new blanks to be loaded$N"
				    "";
				N: EQU(Indexer_Auto.Routine_CurrentCycleStep,10)XIC(System_InCycle)[OTE(Index_Table_New_Part_Requested.0) ,XIC(Index_Table_Part_Data[1].Inside_Part_Data_Present) XIC(Index_Table_Part_Data[1].Outside_Part_Data_Present) XIO(Index_Table_Part_Data[1].Inside_Good_Part) XIO(Index_Table_Part_Data[1].Outside_Good_Part) XIO(Index_Table_Part_Data[1].Inside_Bad_Part) XIO(Index_Table_Part_Data[1].Outside_Bad_Part) MOV(20,Indexer_Auto.Routine_NextCycleStep) ,COP(Indexer_Step_String[2],Indexer_Auto.Step_Description,1) ];
				RC: "Indexer Auto sequence $N"
				    "$N"
				    "Release the Break and Index$N"
				    "";
				N: EQU(Indexer_Auto.Routine_CurrentCycleStep,20)XIC(Weiss_OK_To_Index)[[XIC(Index_Table_Part_Data[3].Inside_Part_Data_Present) XIC(Index_Table_Part_Data[3].Outside_Part_Data_Present) XIC(Index_Table_Part_Data[3].Laser_Marking_Finished) ,XIO(Index_Table_Part_Data[3].Inside_Part_Data_Present) XIO(Index_Table_Part_Data[3].Outside_Part_Data_Present) ] [OTE(Weiss_VFD_Break_Release_Auto_Req.0) ,OTE(Weiss_VFD_Run_Auto_Req.0) ,XIC(Weiss_VFD_Break_Release_Auto_Req.0) XIC(Weiss_VFD_Run_Auto_Req.0) XIO(IndexTable_In_Position) MOV(30,Indexer_Auto.Routine_NextCycleStep) ,COP(Indexer_Step_String[3],Indexer_Auto.Step_Description,1) ] ,XIC(Index_Table_Part_Data[3].Inside_Part_Data_Present) XIC(Index_Table_Part_Data[3].Outside_Part_Data_Present) XIO(Index_Table_Part_Data[3].Laser_Marking_Finished) MOV(50,Indexer_Auto.Routine_NextCycleStep) ];
				RC: "Indexer Auto sequence $N"
				    "$N"
				    "Stop the indexer$N"
				    "$N"
				    "Transfer data to next positions";
				N: EQU(Indexer_Auto.Routine_CurrentCycleStep,30)XIC(IndexTable_In_Position)[OTE(Weiss_VFD_Stop_Auto_Req.0) OTE(Weiss_VFD_Break_Apply_Auto_Req.0) ,XIC(Weiss_VFD_Stop_Auto_Req.0) [XIC(Index_Table_Part_Data[3].Inside_Part_Data_Present) XIC(Index_Table_Part_Data[3].Outside_Part_Data_Present) MOV(50,Indexer_Auto.Routine_NextCycleStep) ,XIO(Index_Table_Part_Data[3].Inside_Part_Data_Present) XIO(Index_Table_Part_Data[3].Outside_Part_Data_Present) MOV(0,Indexer_Auto.Routine_NextCycleStep) ] ,COP(Indexer_Step_String[4],Indexer_Auto.Step_Description,1) ];
				RC: "Indexer Auto sequence $N"
				    "$N"
				    "Lower the hood$N"
				    "";
				N: EQU(Indexer_Auto.Routine_CurrentCycleStep,50)XIC(System_InCycle)XIC(amp_Test_Bits.21)[OTE(Weiss_Hood_Lower_Auto_Req.0) ,OTL(Start_Fume_Extraction_Auto_Req) ,XIC(Hood_Lowered) XIO(Weiss_Hood_Raised) MOV(60,Indexer_Auto.Routine_NextCycleStep) ,COP(Indexer_Step_String[5],Indexer_Auto.Step_Description,1) ];
				RC: "Indexer Auto sequence $N"
				    "Check Laser Hood is lowered before starting Laser$N"
				    "$N"
				    "";
				N: EQU(Indexer_Auto.Routine_CurrentCycleStep,60)XIC(System_InCycle)[XIC(CRM_JB) TON(Laser_Hood_Lowered_Dly,?,?) ,XIC(Laser_Hood_Lowered_Dly.DN) MOV(70,Indexer_Auto.Routine_NextCycleStep) ,COP(Indexer_Step_String[6],Indexer_Auto.Step_Description,1) ];
				RC: "Indexer Auto sequence $N"
				    "$N"
				    "Wait for Laser marking to be complete$N"
				    "$N"
				    "Request for more parts at loading position from robot while waiting for laser";
				N: EQU(Indexer_Auto.Routine_CurrentCycleStep,70)XIC(System_InCycle)[XIC(Index_Table_Part_Data[3].Inside_Part_Data_Present) XIC(Index_Table_Part_Data[3].Outside_Part_Data_Present) XIO(Index_Table_Part_Data[3].Inside_Bad_Part) XIO(Index_Table_Part_Data[3].Outside_Bad_Part) OTE(Indexer_Start_Laser_Marking_Auto_Req.0) ,XIO(Index_Table_Part_Data[1].Inside_Part_Data_Present) XIO(Index_Table_Part_Data[1].Outside_Part_Data_Present) OTE(Index_Table_New_Part_Requested.1) ,XIC(Index_Table_Part_Data[1].Inside_Part_Data_Present) XIC(Index_Table_Part_Data[1].Outside_Part_Data_Present) [XIC(Index_Table_Part_Data[1].Inside_Good_Part) XIC(Index_Table_Part_Data[1].Outside_Good_Part) OTE(Robot_Good_Part_Unload_Request.0) ,[XIC(Index_Table_Part_Data[1].Inside_Bad_Part) ,XIC(Index_Table_Part_Data[1].Outside_Bad_Part) ] OTE(Robot_Bad_Part_Unload_Request.0) ] ,XIC(Laser_Marking_Auto_Seq_Complete) MOV(80,Indexer_Auto.Routine_NextCycleStep) ,COP(Indexer_Step_String[7],Indexer_Auto.Step_Description,1) ];
				RC: "Indexer Auto sequence $N"
				    "$N"
				    "Raise the hood$N"
				    "";
				N: EQU(Indexer_Auto.Routine_CurrentCycleStep,80)XIC(System_InCycle)[OTE(Weiss_Hood_Raise_Auto_Req.1) ,XIC(Weiss_Hood_Raised) XIO(Hood_Lowered) MOV(0,Indexer_Auto.Routine_NextCycleStep) ,COP(Indexer_Step_String[8],Indexer_Auto.Step_Description,1) ];
				RC: "Indexer Auto sequence $N"
				    "$N"
				    "Robot unload request$N"
				    "$N"
				    "Is part a good part of a Bad Part";
				N: EQU(Indexer_Auto.Routine_CurrentCycleStep,100)XIC(System_InCycle)[[XIC(Index_Table_Part_Data[1].Inside_Part_Data_Present) ,XIC(Index_Table_Part_Data[1].Outside_Part_Data_Present) ] [XIC(Index_Table_Part_Data[1].Inside_Good_Part) XIC(Index_Table_Part_Data[1].Outside_Good_Part) XIC(Index_Table_Part_Data[1].Laser_Marking_Finished) MOV(110,Indexer_Auto.Routine_NextCycleStep) ,[XIC(Index_Table_Part_Data[1].Inside_Bad_Part) ,XIC(Index_Table_Part_Data[1].Outside_Bad_Part) ,XIC(Index_Table_Part_Data[1].Laser_Marking_Started) XIO(Index_Table_Part_Data[1].Laser_Marking_Finished) ,XIO(Index_Table_Part_Data[1].Laser_Marking_Finished) XIO(Index_Table_Part_Data[1].Laser_Marking_Started) ] MOV(1000,Indexer_Auto.Routine_NextCycleStep) ] ,COP(Indexer_Step_String[10],Indexer_Auto.Step_Description,1) ];
				RC: "Indexer Auto sequence $N"
				    "$N"
				    "Robot unload request$N"
				    "$N"
				    "Good Part ready for robot unload$N"
				    "$N"
				    "Transfer data to robot clear out index table loading/unloading data";
				N: EQU(Indexer_Auto.Routine_CurrentCycleStep,110)XIC(System_InCycle)[OTE(Robot_Good_Part_Unload_Request.1) ,XIO(Index_Table_Part_Data[1].Inside_Part_Data_Present) XIO(Index_Table_Part_Data[1].Outside_Part_Data_Present) COP(Index_Table_Part_Data[1],Robot_Part_Data[1],1) COP(Index_Table_Part_Data_Clear[1],Index_Table_Part_Data[1],1) MOV(0,Indexer_Auto.Routine_NextCycleStep) ,COP(Indexer_Step_String[11],Indexer_Auto.Step_Description,1) ];
				RC: "Indexer Auto sequence $N"
				    "$N"
				    "Robot unload request$N"
				    "$N"
				    "Bad Part ready for robot unload$N"
				    "$N"
				    "Transfer data to robot";
				N: EQU(Indexer_Auto.Routine_CurrentCycleStep,1000)XIC(System_InCycle)[OTE(Robot_Bad_Part_Unload_Request.1) ,XIO(Index_Table_Part_Data[1].Inside_Part_Data_Present) XIO(Index_Table_Part_Data[1].Outside_Part_Data_Present) COP(Index_Table_Part_Data[1],Robot_Part_Data[1],1) MOV(0,Indexer_Auto.Routine_NextCycleStep) ,COP(Indexer_Step_String[12],Indexer_Auto.Step_Description,1) ];
		END_ROUTINE

		ROUTINE _06_Laser_Auto_Sequence 
				RC: "Laser Auto Sequence$N"
				    "Moves The Next Sequence Cycle Step Into The Current Cycle Step. This Can Be Used To Step The Code Through The AutoCycle One Step At A Time.$N"
				    "This Can Be Done By Putting A Toggle Bit Infront Of The Move Instruction";
				N: [[XIO(System_InCycle) ,XIC(S:FS) ] [MOV(0,Laser_Marker_Auto.Routine_CurrentCycleStep) ,MOV(0,Laser_Marker_Auto.Routine_NextCycleStep) ] ,[XIC(System_InCycle) ,XIO(System_InCycle) [XIC(System_CycleStop_Requested) ,XIC(Auto_Initialization) ] ] MOV(Laser_Marker_Auto.Routine_NextCycleStep,Laser_Marker_Auto.Routine_CurrentCycleStep) ,XIO(System_InCycle) NOP() ];
				RC: "Information only";
				N: XIC(MDX2:I.Data[0].10)XIC(MDX2:I.Data[0].0)XIC(MDX2:I.Data[0].6)XIC(MDX2:I.Data[5].0)XIC(MDX2:I.Data[0].9)XIC(MDX2:I.Data[1].4)XIC(MDX2:I.Data[1].0)XIC(MDX2:I.Data[9].0)XIC(MDX2:O.Data[1].0)EQU(MDX2:I.Data[16],MDX2:I.Data[16])EQU(MDX2:O.Data[10],MDX2:O.Data[10])NOP();
				RC: "Laser Auto sequence $N"
				    "$N"
				    "Decision step$N"
				    "$N"
				    "";
				N: EQU(Laser_Marker_Auto.Routine_CurrentCycleStep,0)XIC(System_InCycle)[NEQ(7,HMI_Current_Laser_Program) MOV(100,Laser_Marker_Auto.Routine_NextCycleStep) ,EQU(7,HMI_Current_Laser_Program) MOV(10,Laser_Marker_Auto.Routine_NextCycleStep) ,COP(Laser_Step_String[0],Laser_Marker_Auto.Step_Description,1) ];
				RC: "Laser Auto sequence $N"
				    "$N"
				    "Generate data to be marked by laser$N"
				    "$N"
				    "";
				N: EQU(Laser_Marker_Auto.Routine_CurrentCycleStep,10)XIC(System_InCycle)NEQ(Indexer_Start_Laser_Marking_Auto_Req,0)XIC(amp_Test_Bits.25)[OTE(Generate_Laser_Marking_Data) ,XIC(Generate_Laser_Marking_Data) MOV(20,Laser_Marker_Auto.Routine_NextCycleStep) ,COP(Laser_Step_String[0],Laser_Marker_Auto.Step_Description,1) ];
				RC: "Laser Auto sequence $N"
				    "$N"
				    "Send Data to laser$N"
				    "$N"
				    "";
				N: EQU(Laser_Marker_Auto.Routine_CurrentCycleStep,20)XIC(System_InCycle)[OTE(Send_Laser_Marking_Data) ,XIC(Send_Laser_Marking_Data) MOV(40,Laser_Marker_Auto.Routine_NextCycleStep) ,COP(Laser_Step_String[1],Laser_Marker_Auto.Step_Description,1) ];
				RC: "Laser Auto sequence $N"
				    "$N"
				    "Open Laser Shutter$N"
				    "$N"
				    "";
				N: EQU(Laser_Marker_Auto.Routine_CurrentCycleStep,30)XIC(System_InCycle)[OTE(Open_Laser_Shutter_Auto_Req.0) ,XIC(Laser_Shutter_Open) MOV(40,Laser_Marker_Auto.Routine_NextCycleStep) ,COP(Laser_Step_String[2],Laser_Marker_Auto.Step_Description,1) ];
				RC: "Laser Auto sequence $N"
				    "$N"
				    "Start the laser marking$N"
				    "$N"
				    "";
				N: EQU(Laser_Marker_Auto.Routine_CurrentCycleStep,40)XIC(System_InCycle)NEQ(Indexer_Start_Laser_Marking_Auto_Req,0)[OTE(Laser_Start_Auto_Req.0) OTL(Index_Table_Part_Data[3].Laser_Marking_Started) ,XIC(MDX2:I.Data[0].0) [XIC(Laser_Marking_Complete) ,XIC(amp_Test_Bits.26) TON(amp_test_Tmr,?,?) XIC(amp_test_Tmr.DN) ] MOV(50,Laser_Marker_Auto.Routine_NextCycleStep) ,COP(Laser_Step_String[3],Laser_Marker_Auto.Step_Description,1) ];
				RC: "Laser Auto sequence $N"
				    "$N"
				    "Close the laser Shutter$N"
				    "$N"
				    "";
				N: EQU(Laser_Marker_Auto.Routine_CurrentCycleStep,50)XIC(System_InCycle)[OTE(Laser_Shutter_Close_Auto_Req.0) ,XIO(Laser_Shutter_Open) MOV(60,Laser_Marker_Auto.Routine_NextCycleStep) ,COP(Laser_Step_String[4],Laser_Marker_Auto.Step_Description,1) ];
				RC: "Laser Auto sequence $N"
				    "$N"
				    "LaserSequence complete to Index table sequence$N"
				    "$N"
				    "";
				N: EQU(Laser_Marker_Auto.Routine_CurrentCycleStep,60)XIC(System_InCycle)[OTL(Index_Table_Part_Data[3].Laser_Marking_Finished) OTL(Index_Table_Part_Data[3].Inside_Good_Part) OTL(Index_Table_Part_Data[3].Outside_Good_Part) OTE(Laser_Marking_Auto_Seq_Complete) ,EQU(Indexer_Start_Laser_Marking_Auto_Req,0) MOV(0,Laser_Marker_Auto.Routine_NextCycleStep) ,COP(Laser_Step_String[5],Laser_Marker_Auto.Step_Description,1) ];
				RC: "Laser Auto sequence $N"
				    "$N"
				    "Change the job over to the requested job number$N"
				    "$N"
				    "";
				N: EQU(Laser_Marker_Auto.Routine_CurrentCycleStep,100)[NEQ(7,MDX2:O.Data[10]) OTE(Laser_Marker_Auto_Job_Change_Request.0) ,EQU(7,MDX2:O.Data[10]) XIO(MDX2:I.Data[9].0) MOV(0,Laser_Marker_Auto.Routine_NextCycleStep) ,NEQ(7,MDX2:O.Data[10]) XIC(MDX2:I.Data[9].0) MOV(110,Laser_Marker_Auto.Routine_NextCycleStep) ,COP(Laser_Step_String[6],Laser_Marker_Auto.Step_Description,1) ];
				RC: "Laser Auto sequence $N"
				    "$N"
				    "Laser job change error auto reset$N"
				    "$N"
				    "";
				N: EQU(Laser_Marker_Auto.Routine_CurrentCycleStep,110)[OTE(Laser_Marker_Auto_Reset_Request.0) ,XIC(Laser_Marker_Auto_Reset_Request.0) XIO(MDX2:I.Data[9].0) MOV(100,Laser_Marker_Auto.Routine_NextCycleStep) ,COP(Laser_Step_String[7],Laser_Marker_Auto.Step_Description,1) ];
		END_ROUTINE

		ROUTINE _07_Laser_Station_Faults 
				N: [XIC(HMI_Reset) ,XIC(GlobalAck_TOF.TT) ,NEQ(Laser_Marker_Auto_Reset_Request,0) ][MOV(0,Laser_Station_Alarm) MOV(0,Laser_Station_Notification) ,OTE(MDX2:O.Data[7].0) OTE(MDX2:O.Data[8].2) OTE(MDX2:O.Data[9].8) OTE(MDX2:O.Data[6].0) OTE(MDX2:O.Data[6].4) OTE(MDX2:O.Data[0].3) ];
				N: AFI()NEQ(Laser_Station_Alarm,0)OTE(Laser_Station_Faulted);
				RC: "Laser Station Alarm #1 Weiss indexer is faulted$N"
				    "$N"
				    "";
				N: XIO(HMI_Reset)XIC(System_InCycle)XIC(EStop_OK)XIC(VFD_Weiss_FAULTED)[TON(Laser_Station_Alarm_Delay[0],?,?) ,XIC(Laser_Station_Alarm_Delay[0].DN) OTL(Laser_Station_Alarm.0) ];
				N: XIC(Laser_Station_Alarm.0)ALMD(LASER_ALMD_00,HMI_FaultAck_All,HMI_FaultReset_All,0,0);
				RC: "Laser Station Alarm #2 Laser is faulted$N"
				    "$N"
				    "";
				N: XIO(HMI_Reset)XIC(System_InCycle)XIC(EStop_OK)XIC(Laser_Error)[TON(Laser_Station_Alarm_Delay[1],?,?) ,XIC(Laser_Station_Alarm_Delay[1].DN) OTL(Laser_Station_Alarm.1) ];
				N: XIC(Laser_Station_Alarm.1)ALMD(LASER_ALMD_01,HMI_FaultAck_All,HMI_FaultReset_All,0,0);
				RC: "Laser Station Alarm #3 Laser Hood NOT Raised$N"
				    "";
				N: XIO(HMI_Reset)XIC(System_InCycle)XIC(EStop_OK)NEQ(Weiss_Hood_Raise_Auto_Req,0)XIO(Weiss_Hood_Raised)[TON(Laser_Station_Alarm_Delay[2],?,?) ,XIC(Laser_Station_Alarm_Delay[2].DN) OTL(Laser_Station_Alarm.2) ];
				N: XIC(Laser_Station_Alarm.2)ALMD(LASER_ALMD_02,HMI_FaultAck_All,HMI_FaultReset_All,0,0);
				RC: "Laser Station Alarm #4 Laser Error/Alarm";
				N: XIO(HMI_Reset)XIC(System_InCycle)XIC(EStop_OK)NEQ(MDX2:I.Data[12],0)NEQ(MDX2:I.Data[13],0)[TON(Laser_Station_Alarm_Delay[3],?,?) ,XIC(Laser_Station_Alarm_Delay[3].DN) OTL(Laser_Station_Alarm.3) ];
				N: XIC(Laser_Station_Alarm.3)ALMD(LASER_ALMD_03,HMI_FaultAck_All,HMI_FaultReset_All,0,0);
				RC: "Laser Station Alarm #4 Laser Command Error";
				N: XIO(HMI_Reset)XIC(System_InCycle)XIC(EStop_OK)NEQ(MDX2:I.Data[14],0)[TON(Laser_Station_Alarm_Delay[4],?,?) ,XIC(Laser_Station_Alarm_Delay[4].DN) OTL(Laser_Station_Alarm.4) ];
				N: XIC(Laser_Station_Alarm.4)ALMD(LASER_ALMD_04,HMI_FaultAck_All,HMI_FaultReset_All,0,0);
		END_ROUTINE

		ROUTINE _08_HMI_Animations 
				RC: "Weiss Permits";
				N: XIC(Motion_Control_OK)XIC(System_ManualMode)XIO(Hood_Lowered)XIO(VFD_Weiss_FAULTED)XIC(Robot_Clear_Of_Indexer)OTE(Weiss_Index_Permit);
				RC: "Change the Index buttons Colors";
				N: [XIO(VFD_Weiss_FAULTED) [XIO(Weiss_Index_Permit) XIO(PRX200) XIO(VFD_Weiss_READY) XIO(Weiss_Manual_IndexRequest) MOV(0,Weiss_Index_Button.Button_Color) ,XIC(Weiss_Index_Permit) [XIC(VFD_Weiss_READY) XIC(Weiss_Manual_IndexRequest) MOV(1,Weiss_Index_Button.Button_Color) ,XIC(Weiss_Manual_IndexRequest) XIO(PRX200) MOV(3,Weiss_Index_Button.Button_Color) ,XIC(PRX200) XIO(Weiss_Manual_IndexRequest) MOV(4,Weiss_Index_Button.Button_Color) ] ] ,XIC(VFD_Weiss_FAULTED) MOV(2,Weiss_Index_Button.Button_Color) ];
				RC: "Change the Indexer Brake buttons Colors";
				N: [XIO(VFD_Weiss_FAULTED) [XIO(HMI_Indexer_Brake_OFF_PB) XIO(HMI_Indexer_Brake_ON_PB) XIO(Weiss_Manual_IndexRequest) XIC(CR504) MOV(0,Weiss_Brake_Button.Button_Color) ,[XIC(VFD_Weiss_READY) XIC(Weiss_Manual_IndexRequest) MOV(1,Weiss_Brake_Button.Button_Color) ,[XIC(CR504) ,XIC(Weiss_Manual_IndexRequest) XIC(CR504) ] MOV(3,Weiss_Brake_Button.Button_Color) ,XIO(CR504) MOV(4,Weiss_Brake_Button.Button_Color) ] ] ,XIC(VFD_Weiss_FAULTED) MOV(2,Weiss_Index_Button.Button_Color) ];
				RC: "Change the Fume buttons Colors";
				N: [XIO(Fume_Permit) XIO(CR400) XIC(Motion_Control_OK) MOV(0,Fume.Button_Color) ,XIC(Fume_Permit) XIC(Motion_Control_OK) [XIO(CR400) XIO(FUMEX_RUNNING) MOV(1,Fume.Button_Color) ,AFI() XIO(CR400) MOV(3,Fume.Button_Color) ,XIC(CR400) MOV(4,Fume.Button_Color) ] ,XIO(Motion_Control_OK) MOV(2,Fume.Button_Color) ];
				RC: "Change the Fume buttons Colors";
				N: [XIO(Laser_Hood_Raise_Permit) XIO(CR301) [MOV(0,Laser_Hood_Raise.Button_Color) ,MOV(0,Laser_Hood_Lower.Button_Color) ] ,XIC(Laser_Hood_Raise_Permit) [[XIO(PRX102) MOV(1,Laser_Hood_Raise.Button_Color) ,XIO(PRX103) MOV(1,Laser_Hood_Lower.Button_Color) ] ,XIO(PRX102) XIO(PRX103) [MOV(3,Laser_Hood_Raise.Button_Color) ,MOV(3,Laser_Hood_Lower.Button_Color) ] ,AFI() [MOV(2,Laser_Hood_Raise.Button_Color) ,MOV(2,Laser_Hood_Lower.Button_Color) ] ,[XIC(PRX102) MOV(4,Laser_Hood_Raise.Button_Color) ,XIC(PRX103) MOV(4,Laser_Hood_Lower.Button_Color) ] ] ];
				RC: "Change the Part tracking buttons Colors";
				N: [XIO(Index_Table_Part_Data[1].Inside_Part_Data_Present) MOV(0,Index_PartTracking_Inside[1].Button_Color) ,XIC(Index_Table_Part_Data[1].Inside_Part_Data_Present) [AFI() MOV(1,Index_PartTracking_Inside[1].Button_Color) ,XIC(Index_Table_Part_Data[1].Inside_Part_Data_Present) XIO(Index_Table_Part_Data[1].Inside_Bad_Part) XIO(Index_Table_Part_Data[1].Inside_Good_Part) MOV(3,Index_PartTracking_Inside[1].Button_Color) ,XIC(Index_Table_Part_Data[1].Inside_Bad_Part) MOV(2,Index_PartTracking_Inside[1].Button_Color) ,XIC(Index_Table_Part_Data[1].Inside_Good_Part) MOV(4,Index_PartTracking_Inside[1].Button_Color) ] ,XIO(Index_Table_Part_Data[1].Outside_Part_Data_Present) MOV(0,Index_PartTracking_Outside[1].Button_Color) ,XIC(Index_Table_Part_Data[1].Outside_Part_Data_Present) [AFI() MOV(1,Index_PartTracking_Outside[1].Button_Color) ,XIC(Index_Table_Part_Data[1].Outside_Part_Data_Present) XIO(Index_Table_Part_Data[1].Outside_Bad_Part) XIO(Index_Table_Part_Data[1].Outside_Good_Part) MOV(3,Index_PartTracking_Outside[1].Button_Color) ,XIC(Index_Table_Part_Data[1].Outside_Bad_Part) MOV(2,Index_PartTracking_Outside[1].Button_Color) ,XIC(Index_Table_Part_Data[1].Outside_Good_Part) MOV(4,Index_PartTracking_Outside[1].Button_Color) ] ,XIO(Index_Table_Part_Data[2].Inside_Part_Data_Present) MOV(0,Index_PartTracking_Inside[2].Button_Color) ,XIC(Index_Table_Part_Data[2].Inside_Part_Data_Present) [AFI() MOV(1,Index_PartTracking_Inside[2].Button_Color) ,XIC(Index_Table_Part_Data[2].Inside_Part_Data_Present) XIO(Index_Table_Part_Data[2].Inside_Bad_Part) XIO(Index_Table_Part_Data[2].Inside_Good_Part) MOV(3,Index_PartTracking_Inside[2].Button_Color) ,XIC(Index_Table_Part_Data[2].Inside_Bad_Part) MOV(2,Index_PartTracking_Inside[2].Button_Color) ,XIC(Index_Table_Part_Data[2].Inside_Good_Part) MOV(4,Index_PartTracking_Inside[2].Button_Color) ] ,XIO(Index_Table_Part_Data[2].Outside_Part_Data_Present) MOV(0,Index_PartTracking_Outside[2].Button_Color) ,XIC(Index_Table_Part_Data[2].Outside_Part_Data_Present) [AFI() MOV(1,Index_PartTracking_Outside[2].Button_Color) ,XIC(Index_Table_Part_Data[2].Outside_Part_Data_Present) XIO(Index_Table_Part_Data[2].Outside_Bad_Part) XIO(Index_Table_Part_Data[2].Outside_Good_Part) MOV(3,Index_PartTracking_Outside[2].Button_Color) ,XIC(Index_Table_Part_Data[2].Outside_Bad_Part) MOV(2,Index_PartTracking_Outside[2].Button_Color) ,XIC(Index_Table_Part_Data[2].Outside_Good_Part) MOV(4,Index_PartTracking_Outside[2].Button_Color) ] ,XIO(Index_Table_Part_Data[3].Inside_Part_Data_Present) MOV(0,Index_PartTracking_Inside[3].Button_Color) ,XIC(Index_Table_Part_Data[3].Inside_Part_Data_Present) [AFI() MOV(1,Index_PartTracking_Inside[3].Button_Color) ,XIC(Index_Table_Part_Data[3].Inside_Part_Data_Present) XIO(Index_Table_Part_Data[3].Inside_Bad_Part) XIO(Index_Table_Part_Data[3].Inside_Good_Part) MOV(3,Index_PartTracking_Inside[3].Button_Color) ,XIC(Index_Table_Part_Data[3].Inside_Bad_Part) MOV(2,Index_PartTracking_Inside[3].Button_Color) ,XIC(Index_Table_Part_Data[3].Inside_Good_Part) MOV(4,Index_PartTracking_Inside[3].Button_Color) ] ,XIO(Index_Table_Part_Data[3].Outside_Part_Data_Present) MOV(0,Index_PartTracking_Outside[3].Button_Color) ,XIC(Index_Table_Part_Data[3].Outside_Part_Data_Present) [AFI() MOV(1,Index_PartTracking_Outside[3].Button_Color) ,XIC(Index_Table_Part_Data[3].Outside_Part_Data_Present) XIO(Index_Table_Part_Data[3].Outside_Bad_Part) XIO(Index_Table_Part_Data[3].Outside_Good_Part) MOV(3,Index_PartTracking_Outside[3].Button_Color) ,XIC(Index_Table_Part_Data[3].Outside_Bad_Part) MOV(2,Index_PartTracking_Outside[3].Button_Color) ,XIC(Index_Table_Part_Data[3].Outside_Good_Part) MOV(4,Index_PartTracking_Outside[3].Button_Color) ] ,XIO(Index_Table_Part_Data[4].Inside_Part_Data_Present) MOV(0,Index_PartTracking_Inside[4].Button_Color) ,XIC(Index_Table_Part_Data[4].Inside_Part_Data_Present) [AFI() MOV(1,Index_PartTracking_Inside[4].Button_Color) ,XIC(Index_Table_Part_Data[4].Inside_Part_Data_Present) XIO(Index_Table_Part_Data[4].Inside_Bad_Part) XIO(Index_Table_Part_Data[4].Inside_Good_Part) MOV(3,Index_PartTracking_Inside[4].Button_Color) ,XIC(Index_Table_Part_Data[4].Inside_Bad_Part) MOV(2,Index_PartTracking_Inside[4].Button_Color) ,XIC(Index_Table_Part_Data[4].Inside_Good_Part) MOV(4,Index_PartTracking_Inside[4].Button_Color) ] ,XIO(Index_Table_Part_Data[4].Outside_Part_Data_Present) MOV(0,Index_PartTracking_Outside[4].Button_Color) ,XIC(Index_Table_Part_Data[4].Outside_Part_Data_Present) [AFI() MOV(1,Index_PartTracking_Outside[4].Button_Color) ,XIC(Index_Table_Part_Data[4].Outside_Part_Data_Present) XIO(Index_Table_Part_Data[4].Outside_Bad_Part) XIO(Index_Table_Part_Data[4].Outside_Good_Part) MOV(3,Index_PartTracking_Outside[4].Button_Color) ,XIC(Index_Table_Part_Data[4].Outside_Bad_Part) MOV(2,Index_PartTracking_Outside[4].Button_Color) ,XIC(Index_Table_Part_Data[4].Outside_Good_Part) MOV(4,Index_PartTracking_Outside[4].Button_Color) ] ];
