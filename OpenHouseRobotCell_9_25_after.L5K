		ROUTINE R101_DownAxis (Description := "The whole axis. Six rungs.")
				N: CPS(IAI_DwnStacker:I,DwnStack_Inputs,1);
				N: SCON_Status(DnAxis_Sts,DnAxis_Position,DnAxis_Speed,DnAxis_AlarmActive,DnAxis_AlarmCode,DnAxis_BatteryAlarm,DnAxis_CommandCurrent,DnAxis_HomeComplete,DnAxis_Homing,DnAxis_EStop,DnAxis_InPushZone,DnAxis_InPZone,DnAxis_InZone1,DnAxis_InZone2,DnAxis_LoadReached,DnAxis_DriveManualMode,DnAxis_Moving,DnAxis_PositionComplete,DnAxis_PushFailed,DnAxis_DriveReady,DnAxis_ServoOn,DnAxis_TorqueReached,DnAxis_TotalMoveCount,DnAxis_TotalMoveDistance,DwnStack_Inputs);
				N: XIC(POWER_OK_24VB)XIO(Unlock_Doors)[OTE(DnAxis_Cmd_ServoOn) ,OTE(CR615) ];
				RC: "Need to add software limits to stop movement Up";
				N: XIC(Motion_Control_OK)XIC(System_ManualMode)XIC(DnAxis_Cmd_ServoOn)OTE(DnStacker_Permit_Up);
				RC: "Need to add software limits to stop movement Down";
				N: XIC(Motion_Control_OK)XIC(System_ManualMode)XIC(DnAxis_Cmd_ServoOn)OTE(DnStacker_Permit_Dn);
				N: XIC(DnStacker_Permit_Dn)XIC(HMI_DnStack_GO_PB)OTE(IAI_DnStacker_CMD_Manual_Move);
				RC: "Change the Down Stacker buttons Colors";
				N: [[XIO(DnStacker_Permit_Dn) XIO(DnAxis_Homing) XIO(DnAxis_Moving) XIO(DnAxis_AlarmActive) XIC(Motion_Control_OK) MOV(0,DnStacker_Raise.Button_Color) ,XIC(DnStacker_Permit_Dn) [XIO(DnAxis_AlarmActive) XIC(DnAxis_DriveReady) MOV(1,DnStacker_Raise.Button_Color) ,[XIC(DnAxis_Homing) ,XIC(DnAxis_Moving) ] MOV(3,DnStacker_Raise.Button_Color) ,XIC(DnAxis_PositionComplete) MOV(4,DnStacker_Raise.Button_Color) ] ,[XIO(DnAxis_DriveReady) ,XIC(DnAxis_AlarmActive) ,XIO(Motion_Control_OK) ] MOV(2,DnStacker_Raise.Button_Color) ] ,[XIO(DnStacker_Permit_Up) XIO(DnAxis_Homing) XIO(DnAxis_Moving) XIO(DnAxis_AlarmActive) XIC(Motion_Control_OK) MOV(0,DnStacker_Lower.Button_Color) ,XIC(DnStacker_Permit_Up) [XIO(DnAxis_AlarmActive) XIC(DnAxis_DriveReady) MOV(1,DnStacker_Lower.Button_Color) ,[XIC(DnAxis_Homing) ,XIC(DnAxis_Moving) ] MOV(3,DnStacker_Lower.Button_Color) ,XIC(DnAxis_PositionComplete) MOV(4,DnStacker_Lower.Button_Color) ] ,[XIO(DnAxis_DriveReady) ,XIC(DnAxis_AlarmActive) ,XIO(Motion_Control_OK) ] MOV(2,DnStacker_Lower.Button_Color) ] ];
				N: SCON_Operations(DnAxis_Ops,DnAxis_Cmd_ServoOn,DnAxis_Cmd_Pause,DnAxis_Cmd_Inch,DnAxis_Cmd_JogFwd,DnAxis_Cmd_JogRev,DnAxis_Cmd_Reset,DnAxis_Cmd_BrakeRelease,DwnStack_Outputs);
				N: SCON_Moves(DnAxis_Mov,DnAxis_Cmd_Home,DnAxis_Cmd_StartMove,DnAxis_Target,DwnStack_Target_Speed,DwnStack_Output_Acceleration,DwnStack_Output_Deceleration,DnAxis_Band,DnAxis_Increment_Select,DnAxis_Push_Select,DnAxis_Push_Direction,DnAxis_Push_Percent,DnAxis_Load_Threshold,DnAxis_PZone_Upper,DnAxis_PZone_Lower,DwnStack_Inputs,DwnStack_Outputs);
				N: CPS(DwnStack_Outputs,IAI_DwnStacker:O,1);
				N: XIC(DnAxis_ServoOn)XIC(DnAxis_DriveReady)XIC(DnAxis_HomeComplete)XIO(DnAxis_AlarmActive)XIO(DnAxis_EStop)OTE(DnAxis_ReadyToMove);
				N: XIC(System_ManualMode)XIC(DnAxis_ReadyToMove)LIM(1,DnAxis_LayerRequest,13)XIC(IAI_DnStacker_CMD_Manual_Move)MOV(DnAxis_LayerRequest,DnAxis_LayerTarget);
				N: [XIC(DnStacker_Permit_Up) XIC(DnAxis_IncrementLayer) XIO(DnAxis_DecrementLayer) LES(DnAxis_CurrentLayer,13) ADD(DnAxis_CurrentLayer,1,DnAxis_LayerTarget) ,XIC(DnStacker_Permit_Dn) XIC(DnAxis_DecrementLayer) XIO(DnAxis_IncrementLayer) GRT(DnAxis_CurrentLayer,1) SUB(DnAxis_CurrentLayer,1,DnAxis_LayerTarget) ]OTE(DnAxis_MoveToLayerTarget);
				N: GEQ(DnAxis_CurrentLayer,11)OTU(DnAxis_IncrementLayer);
				N: LEQ(DnAxis_CurrentLayer,1)OTU(DnAxis_DecrementLayer);
				RC: "Move to layer$N"
				    "";
				N: [[XIC(DnAxis_MoveToLayerTarget) ,NEQ(DnAxis_LayerTarget,DnAxis_CurrentLayer) ,XIC(IAI_DnStacker_CMD_Manual_Move) ] ,XIC(DnAxis_Cmd_StartMove) XIO(DnAxis_PositionComplete) ]XIO(DnAxis_Moving)XIC(DnAxis_ReadyToMove)XIO(DnAxis_MoveFailedTON.DN)[ONS(LayerMoveONS) ,]MOV(DnAxis_Positions[DnAxis_LayerTarget],DnAxis_Target)[OTE(DnAxis_Cmd_StartMove) ,TON(DnAxis_MoveFailedTON,?,?) ,OTU(DnAxis_IncrementLayer) OTU(DnAxis_DecrementLayer) ];
				RC: "Confirm position move successful, update current position$N"
				    "$N"
				    "";
				N: [XIC(DnAxis_PositionComplete) [ONS(PositionCompleteONS) ,] ,XIC(DnStackerUpdateCurrentPosition) ][ADD(DnAxis_Positions[1],PosLim,DnAxis_PositionsPosLim[1]) SUB(DnAxis_Positions[1],NegLim,DnAxis_PositionsNegLim[1]) LIM(DnAxis_PositionsNegLim[1],DnAxis_Position,DnAxis_PositionsPosLim[1]) MOV(1,DnAxis_CurrentLayer) ,ADD(DnAxis_Positions[2],PosLim,DnAxis_PositionsPosLim[2]) SUB(DnAxis_Positions[2],NegLim,DnAxis_PositionsNegLim[2]) LIM(DnAxis_PositionsNegLim[2],DnAxis_Position,DnAxis_PositionsPosLim[2]) MOV(2,DnAxis_CurrentLayer) ,ADD(DnAxis_Positions[3],PosLim,DnAxis_PositionsPosLim[3]) SUB(DnAxis_Positions[3],NegLim,DnAxis_PositionsNegLim[3]) LIM(DnAxis_PositionsNegLim[3],DnAxis_Position,DnAxis_PositionsPosLim[3]) MOV(3,DnAxis_CurrentLayer) ,ADD(DnAxis_Positions[4],PosLim,DnAxis_PositionsPosLim[4]) SUB(DnAxis_Positions[4],NegLim,DnAxis_PositionsNegLim[4]) LIM(DnAxis_PositionsNegLim[4],DnAxis_Position,DnAxis_PositionsPosLim[4]) MOV(4,DnAxis_CurrentLayer) ,ADD(DnAxis_Positions[5],PosLim,DnAxis_PositionsPosLim[5]) SUB(DnAxis_Positions[5],NegLim,DnAxis_PositionsNegLim[5]) LIM(DnAxis_PositionsNegLim[5],DnAxis_Position,DnAxis_PositionsPosLim[5]) MOV(5,DnAxis_CurrentLayer) ,ADD(DnAxis_Positions[6],PosLim,DnAxis_PositionsPosLim[6]) SUB(DnAxis_Positions[6],NegLim,DnAxis_PositionsNegLim[6]) LIM(DnAxis_PositionsNegLim[6],DnAxis_Position,DnAxis_PositionsPosLim[6]) MOV(6,DnAxis_CurrentLayer) ,ADD(DnAxis_Positions[7],PosLim,DnAxis_PositionsPosLim[7]) SUB(DnAxis_Positions[7],NegLim,DnAxis_PositionsNegLim[7]) LIM(DnAxis_PositionsNegLim[7],DnAxis_Position,DnAxis_PositionsPosLim[7]) MOV(7,DnAxis_CurrentLayer) ,ADD(DnAxis_Positions[8],PosLim,DnAxis_PositionsPosLim[8]) SUB(DnAxis_Positions[8],NegLim,DnAxis_PositionsNegLim[8]) LIM(DnAxis_PositionsNegLim[8],DnAxis_Position,DnAxis_PositionsPosLim[8]) MOV(8,DnAxis_CurrentLayer) ,ADD(DnAxis_Positions[9],PosLim,DnAxis_PositionsPosLim[9]) SUB(DnAxis_Positions[9],NegLim,DnAxis_PositionsNegLim[9]) LIM(DnAxis_PositionsNegLim[9],DnAxis_Position,DnAxis_PositionsPosLim[9]) MOV(9,DnAxis_CurrentLayer) ,ADD(DnAxis_Positions[10],PosLim,DnAxis_PositionsPosLim[10]) SUB(DnAxis_Positions[10],NegLim,DnAxis_PositionsNegLim[10]) LIM(DnAxis_PositionsNegLim[10],DnAxis_Position,DnAxis_PositionsPosLim[10]) MOV(10,DnAxis_CurrentLayer) ,ADD(DnAxis_Positions[11],PosLim,DnAxis_PositionsPosLim[11]) SUB(DnAxis_Positions[11],NegLim,DnAxis_PositionsNegLim[11]) LIM(DnAxis_PositionsNegLim[11],DnAxis_Position,DnAxis_PositionsPosLim[11]) MOV(11,DnAxis_CurrentLayer) ,ADD(DnAxis_Positions[12],PosLim,DnAxis_PositionsPosLim[12]) SUB(DnAxis_Positions[12],NegLim,DnAxis_PositionsNegLim[12]) LIM(DnAxis_PositionsNegLim[12],DnAxis_Position,DnAxis_PositionsPosLim[12]) MOV(12,DnAxis_CurrentLayer) ];
		END_ROUTINE

		ROUTINE R200_Tray_Positions_and_Data (Description := "Data and memory for parts on the trays")
				N: [XIC(S:FS) ,XIC(DOOR_1) ]OTL(CheckUpstackerTrays);
				N: [XIC(S:FS) ,XIC(DOOR_2) ]OTL(CheckDownstackerTrays);
				RC: "Reset memory after picking$N"
				    "";
				N: [XIC(RtoUS_PickConfirm) ,XIC(RobotAtStacker) [XIC(RtoUS_PickErrorVG524) ,XIC(RtoUS_PickErrorVG526) ] ]OSF(PickCompleteOffsetONS,PickComplete);
				N: XIC(PickComplete)OTU(UpAxis_Memory[UpAxis_CurrentLayer].[UpAxis_NextValidPos]);
				RC: "Find next valid position$N"
				    "";
				N: [XIC(UpAxis_Memory[UpAxis_CurrentLayer].0) [MOV(0,UpAxis_NextValidPos) ,MOV(1,UStoR_PickColumnNumber) ,MOV(1,UStoR_PickRowNumber) ] ,XIO(UpAxis_Memory[UpAxis_CurrentLayer].0) XIC(UpAxis_Memory[UpAxis_CurrentLayer].1) [MOV(1,UpAxis_NextValidPos) ,MOV(2,UStoR_PickColumnNumber) ,MOV(1,UStoR_PickRowNumber) ] ,XIO(UpAxis_Memory[UpAxis_CurrentLayer].0) XIO(UpAxis_Memory[UpAxis_CurrentLayer].1) XIC(UpAxis_Memory[UpAxis_CurrentLayer].2) [MOV(2,UpAxis_NextValidPos) ,MOV(3,UStoR_PickColumnNumber) ,MOV(1,UStoR_PickRowNumber) ] ,XIO(UpAxis_Memory[UpAxis_CurrentLayer].0) XIO(UpAxis_Memory[UpAxis_CurrentLayer].1) XIO(UpAxis_Memory[UpAxis_CurrentLayer].2) XIC(UpAxis_Memory[UpAxis_CurrentLayer].3) [MOV(3,UpAxis_NextValidPos) ,MOV(4,UStoR_PickColumnNumber) ,MOV(1,UStoR_PickRowNumber) ] ,XIO(UpAxis_Memory[UpAxis_CurrentLayer].0) XIO(UpAxis_Memory[UpAxis_CurrentLayer].1) XIO(UpAxis_Memory[UpAxis_CurrentLayer].2) XIO(UpAxis_Memory[UpAxis_CurrentLayer].3) XIC(UpAxis_Memory[UpAxis_CurrentLayer].4) [MOV(4,UpAxis_NextValidPos) ,MOV(1,UStoR_PickColumnNumber) ,MOV(2,UStoR_PickRowNumber) ] ,XIO(UpAxis_Memory[UpAxis_CurrentLayer].0) XIO(UpAxis_Memory[UpAxis_CurrentLayer].1) XIO(UpAxis_Memory[UpAxis_CurrentLayer].2) XIO(UpAxis_Memory[UpAxis_CurrentLayer].3) XIO(UpAxis_Memory[UpAxis_CurrentLayer].4) XIC(UpAxis_Memory[UpAxis_CurrentLayer].5) [MOV(5,UpAxis_NextValidPos) ,MOV(2,UStoR_PickColumnNumber) ,MOV(2,UStoR_PickRowNumber) ] ,XIO(UpAxis_Memory[UpAxis_CurrentLayer].0) XIO(UpAxis_Memory[UpAxis_CurrentLayer].1) XIO(UpAxis_Memory[UpAxis_CurrentLayer].2) XIO(UpAxis_Memory[UpAxis_CurrentLayer].3) XIO(UpAxis_Memory[UpAxis_CurrentLayer].4) XIO(UpAxis_Memory[UpAxis_CurrentLayer].5) XIC(UpAxis_Memory[UpAxis_CurrentLayer].6) [MOV(6,UpAxis_NextValidPos) ,MOV(3,UStoR_PickColumnNumber) ,MOV(2,UStoR_PickRowNumber) ] ,XIO(UpAxis_Memory[UpAxis_CurrentLayer].0) XIO(UpAxis_Memory[UpAxis_CurrentLayer].1) XIO(UpAxis_Memory[UpAxis_CurrentLayer].2) XIO(UpAxis_Memory[UpAxis_CurrentLayer].3) XIO(UpAxis_Memory[UpAxis_CurrentLayer].4) XIO(UpAxis_Memory[UpAxis_CurrentLayer].5) XIO(UpAxis_Memory[UpAxis_CurrentLayer].6) XIC(UpAxis_Memory[UpAxis_CurrentLayer].7) [MOV(7,UpAxis_NextValidPos) ,MOV(4,UStoR_PickColumnNumber) ,MOV(2,UStoR_PickRowNumber) ] ];
				N: XIC(Manual_Load_Tray_Data)ONS(Manual_Load_Tray_Data_ONS)COP(UpAxis_Memory_Load[0],UpAxis_Memory[0],13);
				N: MOV(0,UpAxis_Memory[0]);
				N: XIO(UpAxis_Memory[UpAxis_CurrentLayer].0)XIO(UpAxis_Memory[UpAxis_CurrentLayer].1)XIO(UpAxis_Memory[UpAxis_CurrentLayer].2)XIO(UpAxis_Memory[UpAxis_CurrentLayer].3)XIO(UpAxis_Memory[UpAxis_CurrentLayer].4)XIO(UpAxis_Memory[UpAxis_CurrentLayer].5)XIO(UpAxis_Memory[UpAxis_CurrentLayer].6)XIO(UpAxis_Memory[UpAxis_CurrentLayer].7)OTE(RequestLayerShift);
				N: XIC(System_AutoMode)XIO(RequestLayerShift)[XIO(TTtoR_ReqToPickBad) XIO(TTtoR_ReqToPickGood) ,]XIO(Index_Table_Part_Data[1].Inside_Part_Data_Present)XIO(Index_Table_Part_Data[1].Outside_Part_Data_Present)XIO(TraySlideAutoSeq_Start)OTE(UStoR_ReqToPick);
				RC: "Send Position + global offset to Robot$N"
				    "";
				N: XIC(RobotPickStart)ADD(UpAxis_PickPos[UpAxis_NextValidPos].Column,UpAxis_RobotOffset.Column,UpAxis_CurrentPos.Column)ADD(UpAxis_PickPos[UpAxis_NextValidPos].Row,UpAxis_RobotOffset.Row,UpAxis_CurrentPos.Row);
		END_ROUTINE

		ROUTINE R201_Data_Fill_Loop 
				N: MOV(255,UpAxis_Memory[R201_Index]);
		END_ROUTINE

		ROUTINE R202_Data_Clear_Loop 
		END_ROUTINE

		ROUTINE R300_Auto_Sequence 
				N: XIC(System_AutoMode)XIO(RobotAtStacker)XIC(RtoUS_LayerMovedConfirm)XIC(RtoUS_PickConfirm)XIC(RtoUS_PickErrorVG524)XIC(RtoUS_PickErrorVG526)XIC(CheckUpstackerTrays)XIC(CheckDownstackerTrays)XIC(RequestLayerShift)NOP();
				N: XIC(I0302)TON(Upstack_TraySensorTON,?,?);
				N: XIC(I0302)TOF(Upstack_TraySensorTOF,?,?);
				N: XIC(I0310)TON(Downstack_TraySensorTON,?,?);
				N: XIC(I0310)TOF(Downstack_TraySensorTOF,?,?);
				RC: "Main Actions: $N"
				    "Supply next Col/Row of Next part to pick$N"
				    "request tray slide$N"
				    "request reload$N"
				    "";
				N: EQU(UpAxis_Memory[13],0)EQU(UpAxis_Memory[12],0)EQU(UpAxis_Memory[11],0)EQU(UpAxis_Memory[10],0)EQU(UpAxis_Memory[9],0)EQU(UpAxis_Memory[8],0)EQU(UpAxis_Memory[7],0)EQU(UpAxis_Memory[6],0)EQU(UpAxis_Memory[5],0)EQU(UpAxis_Memory[4],0)EQU(UpAxis_Memory[3],0)EQU(UpAxis_Memory[2],0)EQU(UpAxis_Memory[1],0)OTL(Upstacker_Reload_Needed);
				RC: "Check Upstacker Tray Count Auto Sequence$N"
				    "0/1: Decide jog direction$N"
				    "2/3: jog until sensor changes state$N"
				    "4: $N"
				    "$N"
				    "";
				N: XIC(AlwaysOff)XIC(System_AutoMode)XIO(RequestReload)XIO(RobotAtStacker)[XIC(CheckUpstackerTrays) ,XIC(UpstackCheckAutoSeq_Start) ][LIM(1,UpAxis_CurrentLayer,12) [OTE(UpstackCheckAutoSeq_Start) ,ADD(UpAxis_CurrentLayer,1,UpStackCheck_FillStartLevel) ] ,[LES(UpAxis_CurrentLayer,1) ,GRT(UpAxis_CurrentLayer,11) ,XIO(UpStacker_Within_Soft_Limits) ] XIC(WinComeBack) OTE(UpStack_Level_Alarm) ];
				N: XIC(UpstackCheckAutoSeq_Start)[[XIC(Upstack_TraySensorTON.DN) ,XIC(UpstackCheckAutoSeq.0) ] XIO(UpstackCheckAutoSeq.1) OTE(UpstackCheckAutoSeq.0) ,[XIC(Upstack_TraySensorTOF.DN) ,XIC(UpstackCheckAutoSeq.1) ] XIO(UpstackCheckAutoSeq.0) OTE(UpstackCheckAutoSeq.1) ];
				RC: "jog axis until sensor changes, get closest position$N"
				    "";
				N: XIC(UpstackCheckAutoSeq.0)[XIC(Upstack_TraySensorTOF.DN) XIO(UpstackCheckAutoSeq.2) OTE(UpAxis_Cmd_JogFwd) ,[XIC(Upstack_TraySensorTON.DN) ,XIC(UpstackCheckAutoSeq.2) ] OTE(UpstackCheckAutoSeq.2) ];
				RC: "jog axis until sensor changes, get closest position$N"
				    "";
				N: XIC(UpstackCheckAutoSeq.1)[XIC(Upstack_TraySensorTON.DN) XIO(UpstackCheckAutoSeq.3) OTE(UpAxis_Cmd_JogRev) ,[XIC(Upstack_TraySensorTOF.DN) ,XIC(UpstackCheckAutoSeq.3) ] OTE(UpstackCheckAutoSeq.3) ];
				RC: "Run closest tray level check and fill memory to that point$N"
				    "";
				N: [XIC(UpstackCheckAutoSeq.2) ,XIC(UpstackCheckAutoSeq.3) ]XIC(UpAxis_ClosestLayerFound)[XIO(UpstackCheckAutoSeq.4) FOR(R201_Data_Fill_Loop,R201_Index,UpStackCheck_FillStartLevel,UpAxis_ClosestLayer,1) ,OTE(UpstackCheckAutoSeq.4) ];
				N: XIC(UpstackCheckAutoSeq.4)OTU(CheckUpstackerTrays)OTU(UpstackCheckAutoSeq_Start);
				RC: "Tray Slide Auto Sequence$N"
				    "conditions: robot not at up/down stack, auto, memory empty for current layer, more parts below, room for empty tray, slide request on, down stack at correct position$N"
				    "$N"
				    "$N"
				    "0: raise up stacker$N"
				    "1: set slide request on$N"
				    "2: slide complete -> lower downstacker$N"
				    "3. turn pick request from upstacker back on $N"
				    "";
				N: XIC(System_AutoMode)XIO(RequestReload)[XIC(RequestLayerShift) GEQ(UpAxis_CurrentLayer,0) LEQ(DnAxis_CurrentLayer,12) XIO(RobotAtStacker) ,XIC(TraySlideAutoSeq_Start) ][OTE(TraySlideAutoSeq_Start) ,ONS(LayerOldONS) [SUB(UpAxis_CurrentLayer,1,UpAxis_LayerNeeded) ,ADD(DnAxis_CurrentLayer,1,DownAxis_LayerNeeded) ] ];
				N: XIC(TraySlideAutoSeq_Start)[OTE(TraySlideAutoSeq.0) ,[ONS(trayslideons0) ,] MOV(UpAxis_LayerNeeded,UpAxis_LayerTarget) ];
				N: XIC(TraySlideAutoSeq.0)EQU(UpAxis_LayerNeeded,UpAxis_CurrentLayer)[XIO(TraySlideAutoSeq.2) OTE(UStoR_ReqToMoveLayer) ,OTE(TraySlideAutoSeq.1) ];
				N: XIC(TraySlideAutoSeq.1)[XIC(RtoUS_LayerMovedConfirm) ,XIC(TraySlideAutoSeq.2) ][OTE(TraySlideAutoSeq.2) ,[ONS(trayslideons2) ,] MOV(DownAxis_LayerNeeded,DnAxis_LayerTarget) ];
				N: XIC(TraySlideAutoSeq.2)EQU(DownAxis_LayerNeeded,DnAxis_CurrentLayer)OTU(TraySlideAutoSeq_Start);
				RC: "Request Reload Auto $QSequence$Q$N"
				    "";
				N: XIC(System_AutoMode)EQU(UpAxis_CurrentLayer,0)XIO(TraySlideAutoSeq_Start)ONS(RequestReloadONS)[MOV(12,DnAxis_LayerTarget) ,MOV(12,UpAxis_LayerTarget) ,OTL(RequestReload) ];
		END_ROUTINE

		ROUTINE _01_IAI_Faults 
				RC: "*****************************************************$N"
				    "Robot System Fault Present$N"
				    "*****************************************************";
				N: NEQ(IAI_Alarms,0)OTE(IAI_Fault_Present);
				RC: "RESETS ALARM FILE [0] FAULTS";
				N: XIC(GlobalAck_TOF.TT)CLR(IAI_Alarms);
				RC: "IAI UpAxis Battery Alarm";
				N: XIC(System_InCycle)XIC(UpAxis_BatteryAlarm)[TON(IAI_Alarm_Delay[0],?,?) ,XIC(IAI_Alarm_Delay[0].DN) OTL(IAI_Alarms.0) ];
				N: XIC(IAI_Alarms.0)ALMD(IAI_ALMD_00,HMI_FaultAck_All,HMI_FaultReset_All,0,0);
				RC: "IAI Down Axis Battery Alarm";
				N: XIC(System_InCycle)XIC(DnAxis_BatteryAlarm)[TON(IAI_Alarm_Delay[1],?,?) ,XIC(IAI_Alarm_Delay[1].DN) OTL(IAI_Alarms.1) ];
				N: XIC(IAI_Alarms.1)ALMD(IAI_ALMD_01,HMI_FaultAck_All,HMI_FaultReset_All,0,0);
				RC: "Up Axis Homing Required";
				N: XIC(POWER_OK_24VC)XIC(POWER_OK_24VB)XIO(UpAxis_HomeComplete)[TON(IAI_Alarm_Delay[2],?,?) ,XIC(IAI_Alarm_Delay[2].DN) OTL(IAI_Alarms.2) ];
				N: XIC(IAI_Alarms.2)ALMD(IAI_ALMD_02,HMI_FaultAck_All,HMI_FaultReset_All,0,0);
				RC: "Down Axis Homing Required";
				N: XIC(POWER_OK_24VC)XIC(POWER_OK_24VB)XIO(DnAxis_HomeComplete)[TON(IAI_Alarm_Delay[3],?,?) ,XIC(IAI_Alarm_Delay[3].DN) OTL(IAI_Alarms.3) ];
				N: XIC(IAI_Alarms.3)ALMD(IAI_ALMD_03,HMI_FaultAck_All,HMI_FaultReset_All,0,0);
		END_ROUTINE

		CHILD_PROGRAMS
		END_CHILD_PROGRAMS

	END_PROGRAM

	PROGRAM Program050000_Station200_UpStacker (Class := Standard,
	                                            MAIN := "Routine050100_Main",
	                                            MODE := 0,
	                                            DisableFlag := 0,
	                                            UseAsFolder := 0)
		TAG
		END_TAG

		ROUTINE Routine050100_Main 
				N: JSR(Routine050300_InputStatus,0);
				N: JSR(Routine050500_Operation,0);
				N: JSR(Routine050600_AutoSequence,0);
				N: JSR(Routine050700_OutputActions,0);
				N: JSR(Routine059999_Alarms,0);
		END_ROUTINE

		ROUTINE Routine050300_InputStatus 
				N: NOP();
		END_ROUTINE

		ROUTINE Routine050500_Operation 
				N: [CPS(IAI_UpStacker:I,UpStack_Inputs,1) CPS(UpStack_Outputs,IAI_UpStacker:O,1) XIC(POWER_OK_24VB) XIO(Unlock_Doors) OTE(UpStack_Outputs.Servo_On) OTE(CR614) ,GSV(Module,IS3800,FaultCode,HARDWARE_FAULTS[0]) NEQ(HARDWARE_FAULTS[0],0) [XIO(Cognex_Bypass) OTL(Cognex_Com_Fault) ,XIC(Cognex_Bypass) OTU(Cognex_Com_Fault) ] ,GSV(Module,IAI_UpStacker,FaultCode,HARDWARE_FAULTS[1]) NEQ(HARDWARE_FAULTS[1],0) OTL(Upstack_Com_Fault) ,XIC(Reset_Hold_TMR.DN) OTU(Cognex_Com_Fault) OTU(Upstack_Com_Fault) OTU(Upstack_Jam) XIC(UpStack_Inputs.Alarm_Active) OTE(UpStack_Outputs.Reset) ];
				N: [MOV(UpStack_HMI_Tray_Qty,UpStack_HMI_Tray_Qty) ,MOV(Cfg_UpStack_LowMax_POS,Cfg_UpStack_LowMax_POS) ,MOV(Cfg_UpStack_HighMax_POS,Cfg_UpStack_HighMax_POS) ,MOV(Cfg_UpStack_TrayHeight,Cfg_UpStack_TrayHeight) ]XIO(UpStack_Inputs.Alarm_Active)XIO(DwnStack_Inputs.Alarm_Active)[XIC(Door_Open_Request) RES(Data_Delay_TMR) MOV(Cfg_UpStack_LowMax_POS,UpStack_Target_Position) MOV(13,Upstack_Layer_Current) AFI() OTU(UStoR_ReqToMoveLayer) ,XIO(Door_Open_Request) TON(Layer_Last_TMR,?,?) XIC(Layer_Last_TMR.DN) [ONS(ONS_STACK.0) XIO(Upstack_Complete) MOV(Upstack_Layer_Last,Upstack_Layer_Current) ,CPT(UpStack_Target_Position,Cfg_UpStack_HighMax_POS-(Upstack_Layer_Current*Cfg_UpStack_TrayHeight)) MOV(Upstack_Layer_Current,Upstack_Layer_Last) ] ];
				N: GEQ(UpStack_Target_Position,Cfg_UpStack_LowMax_POS)LEQ(UpStack_Target_Position,Cfg_UpStack_HighMax_POS)[MOV(UpStack_Target_Position,UpStack_Outputs.Target_Position) ,MOV(UpStack_Target_Speed,UpStack_Outputs.Target_Speed) ][MOV(UpStack_Output_Acceleration,UpStack_Outputs.Acceleration) ,MOV(UpStack_Output_Deceleration,UpStack_Outputs.Deceleration) ];
				RC: "***********************************************$N"
				    "Moves IAI Upstack$N"
				    "$N"
				    "*********************************************";
				N: XIO(UpStack_Inputs.Alarm_Active)[NEQ(Upstack_Layer_Current,Upstack_Layer_Temp) MOV(Upstack_Layer_Current,Upstack_Layer_Temp) TOF(Upstack_Start_HLD_TMR,?,?) ,XIC(Upstack_Start_HLD_TMR.DN) ]XIO(UpStack_Inputs.Moving)OTE(UpStack_Outputs.Start_Move);
				RC: "***********************************************$N"
				    "Cognex Trigger Logic$N"
				    "$N"
				    "Triggers on Downstack Move and Jam Clear$N"
				    "$N"
				    "Monitors If Trays are in position based on 0-100 score. Anything les than 50 will flag Jam$N"
				    "$N"
				    "Resets the Tigger Request and Item Location count on new trigger$N"
				    "$N"
				    "*********************************************";
				N: [XIC(Trigger_Cognex) OTL(IS3800:O.Control.TriggerEnable) RES(Data_Delay_TMR) OTU(Trigger_Cognex) ,XIC(Cognex_Hold_TMR.DN) OTU(IS3800:O.Control.TriggerEnable) ,XIO(IS3800:O.Control.Trigger) NEQ(IS3800:I.Status.AcquisitionID,Cognex_Acc_ID) MOV(IS3800:I.Status.AcquisitionID,Cognex_Acc_ID) OTL(UpStack_Status_Fill) OTL(UpStack_Fill_Trays) ,XIO(UpStack_Inputs.Moving) XIO(UpStack_Outputs.Start_Move) XIO(UStoR_ReqToMoveLayer) [XIC(IS3800:O.Control.TriggerEnable) TON(Cognex_Hold_TMR,?,?) GRT(Cognex_Hold_TMR.ACC,500) OTE(IS3800:O.Control.Trigger) ,TON(Data_Delay_TMR,?,?) XIC(Data_Delay_TMR.DN) ONS(ONS.2) [[LES(IS3800:I.InspectionResults[96],50) NEQ(Upstack_Layer_Current,0) OTL(Upstack_Jam) ,LES(IS3800:I.InspectionResults[97],50) NEQ(DwnStack_Layer_Current,0) OTL(DwnStack_Jam) ] ,MOV(1,Upstack_Row_Current) MOV(0,Upstack_Column_Current) OTL(New_Layer_Cognex) OTU(UStoR_ReqToPick) ] ] ];
				RC: "***********************************************$N"
				    "Positions to Fill the Arrays either Ocupied or Empty$N"
				    "$N"
				    "***********************************************";
				N: XIC(UpStack_Status_Fill)[XIC(UpStack_Empty_Trays) ,XIC(UpStack_Fill_Trays) MOV(Upstack_Layer_Current,UpStack_Layer_Fill) ][ADD(UpStack_Column_Fill,1,UpStack_Column_Fill) LEQ(UpStack_Column_Fill,Cfg_Column_Max) [XIC(UpStack_Empty_Trays) COP(Data_Item_Initialize,Upstack_Layer[UpStack_Layer_Fill].Row[UpStack_Row_Fill].Column[UpStack_Column_Fill],1) ,XIC(UpStack_Fill_Trays) OTE(New_Fill_Item) ] ,GRT(UpStack_Column_Fill,Cfg_Column_Max) [ADD(UpStack_Row_Fill,1,UpStack_Row_Fill) LEQ(UpStack_Row_Fill,Cfg_Row_Max) CLR(UpStack_Column_Fill) ,GRT(UpStack_Row_Fill,Cfg_Row_Max) [[XIC(UpStack_Empty_Trays) ADD(UpStack_Layer_Fill,1,UpStack_Layer_Fill) LEQ(UpStack_Layer_Fill,Cfg_Layer_Max) ,XIC(UpStack_Fill_Trays) OTU(UpStack_Status_Fill) OTU(UpStack_Fill_Trays) ] [CLR(UpStack_Column_Fill) ,MOV(1,UpStack_Row_Fill) ] ,XIC(UpStack_Empty_Trays) GRT(UpStack_Layer_Fill,Cfg_Layer_Max) OTU(UpStack_Status_Fill) [CLR(UpStack_Column_Fill) ,MOV(1,UpStack_Row_Fill) ,MOV(1,UpStack_Layer_Fill) ] ] ] ];
				RC: "***********************************************$N"
				    "Moves Cognex X, Y, and Angle Calcs into Tray Locations$N"
				    "$N"
				    "Fills an Ocupied status or clears based on an X value present$N"
				    "$N"
				    "***********************************************";
				N: XIC(New_Fill_Item)XIC(UpStack_Fill_Trays)[EQU(UpStack_Row_Fill,1) [EQU(UpStack_Column_Fill,1) MOV(0,Cognex_Control_X1) ,EQU(UpStack_Column_Fill,2) MOV(6,Cognex_Control_X1) ,EQU(UpStack_Column_Fill,3) MOV(24,Cognex_Control_X1) ,EQU(UpStack_Column_Fill,4) MOV(30,Cognex_Control_X1) ] ,EQU(UpStack_Row_Fill,2) [EQU(UpStack_Column_Fill,1) MOV(48,Cognex_Control_X1) ,EQU(UpStack_Column_Fill,2) MOV(54,Cognex_Control_X1) ,EQU(UpStack_Column_Fill,3) MOV(72,Cognex_Control_X1) ,EQU(UpStack_Column_Fill,4) MOV(78,Cognex_Control_X1) ] ,MOV(Cognex_Control_X1,Cognex_Control_X1) MOV(IS3800:I.InspectionResults[Cognex_Control_X1],Upstack_Layer[UpStack_Layer_Fill].Row[UpStack_Row_Fill].Column[UpStack_Column_Fill].Orig_X_1) ,CPT(Cognex_Control_X2,Cognex_Control_X1+12) MOV(IS3800:I.InspectionResults[Cognex_Control_X2],Upstack_Layer[UpStack_Layer_Fill].Row[UpStack_Row_Fill].Column[UpStack_Column_Fill].Orig_X_2) [[GRT(IS3800:I.InspectionResults[Cognex_Control_X1],0) ,GRT(IS3800:I.InspectionResults[Cognex_Control_X2],0) ] MOV(Cfg_Status_Ocupied,Upstack_Layer[UpStack_Layer_Fill].Row[UpStack_Row_Fill].Column[UpStack_Column_Fill].Status) ,EQU(IS3800:I.InspectionResults[Cognex_Control_X1],0) EQU(IS3800:I.InspectionResults[Cognex_Control_X2],0) COP(Data_Item_Initialize,Upstack_Layer[UpStack_Layer_Fill].Row[UpStack_Row_Fill].Column[UpStack_Column_Fill],1) ] ,CPT(Cognex_Control_Y1,Cognex_Control_X1+1) MOV(IS3800:I.InspectionResults[Cognex_Control_Y1],Upstack_Layer[UpStack_Layer_Fill].Row[UpStack_Row_Fill].Column[UpStack_Column_Fill].Orig_Y_1) ,CPT(Cognex_Control_Y2,Cognex_Control_Y1+12) MOV(IS3800:I.InspectionResults[Cognex_Control_Y2],Upstack_Layer[UpStack_Layer_Fill].Row[UpStack_Row_Fill].Column[UpStack_Column_Fill].Orig_Y_2) ,CPT(Cognex_Control_A1,Cognex_Control_X1+2) MOV(IS3800:I.InspectionResults[Cognex_Control_A1],Upstack_Layer[UpStack_Layer_Fill].Row[UpStack_Row_Fill].Column[UpStack_Column_Fill].Orig_Angle_1) ,CPT(Cognex_Control_A2,Cognex_Control_A1+12) MOV(IS3800:I.InspectionResults[Cognex_Control_A2],Upstack_Layer[UpStack_Layer_Fill].Row[UpStack_Row_Fill].Column[UpStack_Column_Fill].Orig_Angle_2) ];
				N: GEQ(UStoR_PickSeqNumber,490)MOV(1,UStoR_PickSeqNumber);
				N: XIO(Door_Open_Request)XIO(UpStack_Outputs.Start_Move)XIO(UpStack_Inputs.Moving)XIO(UStoR_ReqToMoveLayer)XIO(Upstack_Jam)XIO(Upstack_Complete)XIC(Data_Delay_TMR.DN)XIO(UStoR_ReqToPick)OTE(Upstack_Count_Permission);
				N: [XIO(Turn_Table_Full) ,XIC(New_Layer_Cognex) ,XIC(RtoUS_PickConfirm) EQU(Upstack_Row_Current,Cfg_Row_Max) EQU(Upstack_Column_Current,Cfg_Column_Max) ,[XIC(TurnTable_Move_ONS) ,XIC(RtoTT_PickConfirm) ] [EQU(TurnTable[1].Seq_Num,0) ,EQU(TurnTable[4].Seq_Num,0) ] ]OTE(Upstack_Count_Request);
				RC: "***********************************************$N"
				    "Requests to Pick based on first Ocupied status$N"
				    "$N"
				    "Requests a layer move based on a finished tray$N"
				    "$N"
				    "Requests to Open Door based on Upstack Complete$N"
				    "$N"
				    "Cfg_Colum_Max, Cfg_Row_Max should be set to size of tray$N"
				    "$N"
				    "***********************************************";
				N: XIC(Upstack_Count_Permission)[XIC(Upstack_Count_Request) ADD(Upstack_Column_Current,1,Upstack_Column_Current) LEQ(Upstack_Column_Current,Cfg_Column_Max) EQU(Upstack_Layer[Upstack_Layer_Current].Row[Upstack_Row_Current].Column[Upstack_Column_Current].Status,1) ADD(1,UStoR_PickSeqNumber,UStoR_PickSeqNumber) [OTL(UStoR_ReqToPick) ,OTU(New_Layer_Cognex) ] ,GRT(Upstack_Column_Current,Cfg_Column_Max) [ADD(Upstack_Row_Current,1,Upstack_Row_Current) LEQ(Upstack_Row_Current,Cfg_Row_Max) MOV(0,Upstack_Column_Current) ,GRT(Upstack_Row_Current,Cfg_Row_Max) [SUB(Upstack_Layer_Current,1,Upstack_Layer_Current) GEQ(Upstack_Layer_Current,0) OTL(UStoR_ReqToMoveLayer) ,LEQ(Upstack_Layer_Current,0) XIC(WinTest.0) OTL(Upstack_Complete) ] ] ];
				RC: "***********************************************$N"
				    "Clears MoveLayer based on LayerMovedConfirm from Robot$N"
				    "$N"
				    "Clears MoveLayer based on Upstack complete and Reset of the Doors$N"
				    "$N"
				    "Moves Upstack_HMI_Tray_Qty into set number of trays$N"
				    "$N"
				    "***********************************************";
				N: [XIC(RtoUS_LayerMovedConfirm) ONS(ONS_STACK.5) OTU(UStoR_ReqToMoveLayer) ,XIO(UStoR_ReqToMoveLayer) XIC(Upstack_Complete) [XIO(UpStack_Outputs.Start_Move) XIO(UpStack_Inputs.Moving) XIO(DwnStack_Outputs.Start_Move) XIO(DwnStack_Inputs.Moving) ONS(ONS_STACK.8) OTL(Door_Open_Request) ,[XIO(Door_Open_Request) ONS(ONS_STACK.9) ,XIC(Upstack_Complete_TMR.EN) XIO(Upstack_Complete_TMR.DN) ] TON(Upstack_Complete_TMR,?,?) XIC(Upstack_Complete_TMR.DN) [MOV(UpStack_HMI_Tray_Qty,Upstack_Layer_Last) ,MOV(UpStack_HMI_Tray_Qty,Upstack_Layer_Current) ] [MOV(DwnStack_HMI_Tray_Qty,DwnStack_Layer_Last) ,MOV(DwnStack_HMI_Tray_Qty,DwnStack_Layer_Current) ] OTU(Upstack_Complete) ] ];
				RC: "Passes Location of Part to Robot";
				N: XIC(UStoR_ReqToPick)[MOV(Upstack_Layer_Current,Upstack_Layer_Current) MOV(Upstack_Row_Current,UStoR_PickRowNumber) MOV(Upstack_Column_Current,UStoR_PickColumnNumber) ,MOV(UStoR_PickSeqNumber,Upstack_Layer[Upstack_Layer_Current].Row[Upstack_Row_Current].Column[Upstack_Column_Current].Seq_Num) ];
				RC: "Clears Part Present in Location from Robot$N"
				    "";
				N: XIC(RtoUS_PickConfirm)ONS(ONS_STACK.1)COP(Data_Item_Initialize,Data_Item[UStoR_PickSeqNumber],1)[COP(Upstack_Layer[Upstack_Layer_Current].Row[Upstack_Row_Current].Column[Upstack_Column_Current],Data_Item[UStoR_PickSeqNumber],1) ,MOV(2,Data_Item[UStoR_PickSeqNumber].Status) ,MOV(Cfg_Status_Complete,Upstack_Layer[Upstack_Layer_Current].Row[Upstack_Row_Current].Column[Upstack_Column_Current].Status) ]OTU(UStoR_ReqToPick);
		END_ROUTINE

