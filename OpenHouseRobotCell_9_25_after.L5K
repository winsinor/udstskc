	PROGRAM Program080000_Station500_SprueCutter (Class := Standard,
	                                              MAIN := "Routine080100_Main",
	                                              MODE := 0,
	                                              DisableFlag := 0,
	                                              UseAsFolder := 0)
		TAG
		END_TAG

		ROUTINE Routine080100_Main 
				N: JSR(_01_SprueCutter_Faults,0);
				N: JSR(_04_Auto_Sequence,0);
		END_ROUTINE

		ROUTINE _01_SprueCutter_Faults 
				RC: "*****************************************************$N"
				    "Cutter System Fault Present$N"
				    "*****************************************************";
				N: NEQ(Cutter_Alarms,0)OTE(Cutter_Fault_Present);
				RC: "RESETS ALARM FILE [0] FAULTS";
				N: XIC(GlobalAck_TOF.TT)CLR(Cutter_Alarms);
				RC: "Scrap Bin Full Please Empty";
				N: XIC(System_InCycle)XIC(POWER_OK_24VC)XIC(POWER_OK_24VB)XIO(PE307)[TON(Cutter_Alarm_Delay[0],?,?) ,XIC(Cutter_Alarm_Delay[0].DN) OTL(Cutter_Alarms.0) ];
				N: XIC(Cutter_Alarms.0)ALMD(CUTTER_ALMD_00,HMI_FaultAck_All,HMI_FaultReset_All,0,0);
				RC: "Please Reinstall the scrap bin";
				N: XIC(POWER_OK_24VC)XIC(POWER_OK_24VB)XIO(PRX315)[TON(Cutter_Alarm_Delay[1],?,?) ,XIC(Cutter_Alarm_Delay[1].DN) OTL(Cutter_Alarms.1) ];
				N: XIC(Cutter_Alarms.1)ALMD(CUTTER_ALMD_01,HMI_FaultAck_All,HMI_FaultReset_All,0,0);
		END_ROUTINE

		ROUTINE _04_Auto_Sequence 
				N: NOP();
		END_ROUTINE

		CHILD_PROGRAMS
		END_CHILD_PROGRAMS

	END_PROGRAM

	PROGRAM Program090000_Station600_DownStacker (Class := Standard,
	                                              MAIN := "Routine090100_Main",
	                                              MODE := 0,
	                                              DisableFlag := 0,
	                                              UseAsFolder := 0)
		TAG
		END_TAG

		ROUTINE Routine090100_Main 
				N: JSR(Routine090300_InputStatus,0);
				N: JSR(Routine090500_Operation,0);
				N: JSR(Routine090600_AutoSequence1,0);
				N: JSR(Routine090700_OutputActions,0);
				N: JSR(Routine099999_Alarms,0);
		END_ROUTINE

		ROUTINE Routine090300_InputStatus 
				N: NOP();
		END_ROUTINE

		ROUTINE Routine090500_Operation 
				N: [CPS(IAI_DwnStacker:I,DwnStack_Inputs,1) CPS(DwnStack_Outputs,IAI_DwnStacker:O,1) XIC(POWER_OK_24VB) XIO(Unlock_Doors) OTE(DwnStack_Outputs.Servo_On) OTE(CR615) ,GSV(Module,IAI_DwnStacker,FaultCode,HARDWARE_FAULTS[2]) NEQ(HARDWARE_FAULTS[2],0) OTL(DwnStack_Com_Fault) ,XIC(Reset_Hold_TMR.DN) OTU(DwnStack_Jam) OTU(DwnStack_Com_Fault) XIC(DwnStack_Inputs.Alarm_Active) OTE(DwnStack_Outputs.Reset) ];
				N: [MOV(DwnStack_HMI_Tray_Qty,DwnStack_HMI_Tray_Qty) ,MOV(Cfg_DwnStack_LowMax_POS,Cfg_DwnStack_LowMax_POS) ,MOV(Cfg_DwnStack_HighMax_POS,Cfg_DwnStack_HighMax_POS) ,MOV(Cfg_DwnStack_TrayHeight,Cfg_DwnStack_TrayHeight) ]XIO(DwnStack_Inputs.Alarm_Active)[XIC(Door_Open_Request) MOV(Cfg_DwnStack_LowMax_POS,DwnStack_Target_Position) MOV(13,DwnStack_Layer_Current) ,XIO(Door_Open_Request) XIC(Layer_Last_TMR.DN) [ONS(ONS_STACK.11) XIO(Upstack_Complete) MOV(DwnStack_Layer_Last,DwnStack_Layer_Current) ,CPT(DwnStack_Target_Position,Cfg_DwnStack_HighMax_POS-(DwnStack_Layer_Current*Cfg_DwnStack_TrayHeight)) MOV(DwnStack_Layer_Current,DwnStack_Layer_Last) ] ];
				N: GEQ(DwnStack_Target_Position,Cfg_DwnStack_LowMax_POS)LEQ(DwnStack_Target_Position,Cfg_DwnStack_HighMax_POS)[MOV(DwnStack_Target_Position,DwnStack_Outputs.Target_Position) ,MOV(DwnStack_Target_Speed,DwnStack_Outputs.Target_Speed) ][MOV(DwnStack_Output_Acceleration,DwnStack_Outputs.Acceleration) ,MOV(DwnStack_Output_Deceleration,DwnStack_Outputs.Deceleration) ];
				N: XIO(DwnStack_Inputs.Alarm_Active)[NEQ(DwnStack_Layer_Current,DwnStack_Layer_Temp) MOV(DwnStack_Layer_Current,DwnStack_Layer_Temp) TOF(DwnStack_Start_HLD_TMR,?,?) ,XIC(DwnStack_Start_HLD_TMR.DN) ]XIO(DwnStack_Inputs.Moving)OTE(DwnStack_Outputs.Start_Move);
				N: [XIO(Upstack_Complete) XIO(UStoR_ReqToMoveLayer) XIO(Door_Open_Request) XIO(DwnStack_Inputs.Moving) XIO(UpStack_Inputs.Moving) ONS(ONS_STACK.6) OTL(Trigger_Cognex) ,EQU(DwnStack_Layer_Current,0) OTU(DStoR_OpenLocation) ];
				N: XIO(DwnStack_Outputs.Start_Move)XIO(DwnStack_Inputs.Moving)[XIO(DwnStack_Jam) ,]XIO(DwnStack_Complete)XIO(DwnStack_Full_Layer)XIO(DStoR_OpenLocation)NEQ(DwnStack_Layer_Current,0)OTE(DwnStack_Count_Permission);
				N: XIC(DwnStack_Count_Permission)[ADD(DwnStack_Column_Current,1,DwnStack_Column_Current) LEQ(DwnStack_Column_Current,Cfg_Column_Max) OTL(DStoR_OpenLocation) ,GRT(DwnStack_Column_Current,Cfg_Column_Max) [ADD(DwnStack_Row_Current,1,DwnStack_Row_Current) LEQ(DwnStack_Row_Current,Cfg_Row_Max) MOV(0,DwnStack_Column_Current) ,GRT(DwnStack_Row_Current,Cfg_Row_Max) [LEQ(DwnStack_Layer_Current,12) OTL(DwnStack_Full_Layer) ,GEQ(DwnStack_Layer_Current,13) AFI() OTL(DwnStack_Complete) OTL(Door_Open_Request) ] ] ];
				N: [XIC(RtoUS_LayerMovedConfirm) ONS(ONS_STACK.2) ADD(DwnStack_Layer_Current,1,DwnStack_Layer_Current) ,AFI() XIO(RtoUS_LayerMovedConfirm) [XIC(Upstack_Complete) ,XIC(DwnStack_Complete) ] XIO(Door_Open_Request) ONS(ONS_STACK.3) OTU(DwnStack_Complete) ][MOV(1,DwnStack_Row_Current) ,MOV(0,DwnStack_Column_Current) ][OTU(DStoR_OpenLocation) ,OTU(DwnStack_Full_Layer) ];
				RC: "Passes Location of Part to Robot";
				N: XIC(DStoR_OpenLocation)[MOV(DwnStack_Layer_Current,DwnStack_Layer_Current) MOV(DwnStack_Row_Current,DStoR_PickRowNumber) MOV(DwnStack_Column_Current,DStoR_PickColumnNumber) ,MOV(RtoDS_PlaceSeqNumber,Downstack_Layer[DwnStack_Layer_Current].Row[DwnStack_Row_Current].Column[DwnStack_Column_Current].Seq_Num) ];
				RC: "Clears Part Present in Location from Robot$N"
