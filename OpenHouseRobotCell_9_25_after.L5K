		ROUTINE Logic 
				N: OTL(EN);
				N: XIC(Map_Axis_Inputs.Ready)OTE(Ready);
				N: XIC(Map_Axis_Inputs.E_Stop_Active)OTE(E_Stop_Active);
				N: XIC(Map_Axis_Inputs.Alarm_Active)OTE(Alarm_Active);
				N: XIC(Map_Axis_Inputs.Servo_is_On)OTE(Servo_On);
				N: XIC(Map_Axis_Inputs.Homing)OTE(Homing);
				N: XIC(Map_Axis_Inputs.Home_Complete)OTE(Home_Complete);
				N: XIC(Map_Axis_Inputs.Moving)OTE(Moving);
				N: XIC(Map_Axis_Inputs.Position_Complete)OTE(Position_Complete);
				N: XIC(Map_Axis_Inputs.Manual_Mode)OTE(Manual_Mode);
				N: XIC(Map_Axis_Inputs.In_PZone)OTE(In_PZone);
				N: XIC(Map_Axis_Inputs.In_Zone_1)OTE(In_Zone_1);
				N: XIC(Map_Axis_Inputs.In_Zone_2)OTE(In_Zone_2);
				N: XIC(Map_Axis_Inputs.Torque_Level_Reached)OTE(Torque_Reached);
				N: XIC(Map_Axis_Inputs.Load_Output_Reached)OTE(Load_Output_Reached);
				N: XIC(Map_Axis_Inputs.In_Push_Zone)OTE(In_Push_Zone);
				N: XIC(Map_Axis_Inputs.Push_Failed)OTE(Push_Failed);
				N: MOV(Map_Axis_Inputs.Actual_Position,Actual_Position)MOV(Map_Axis_Inputs.Actual_Speed,Actual_Speed)MOV(Map_Axis_Inputs.Command_Current,Command_Current)MOV(Map_Axis_Inputs.Alarm_Code,Alarm_Code);
		END_ROUTINE

	END_ADD_ON_INSTRUCTION_DEFINITION

