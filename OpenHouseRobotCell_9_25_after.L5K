				N: [XIC(PlaceHolderBit) ,XIO(FaultReset) XIC(Station100Robot._Fault[19]) ][TON(Station100Robot._Fault_Delay_Timer[19],?,?) ,XIC(Station100Robot._Fault_Delay_Timer[19].DN) OTE(Station100Robot._Fault[19]) ];
				N: [XIC(PlaceHolderBit) ,XIO(FaultReset) XIC(Station100Robot._Fault[20]) ][TON(Station100Robot._Fault_Delay_Timer[20],?,?) ,XIC(Station100Robot._Fault_Delay_Timer[20].DN) OTE(Station100Robot._Fault[20]) ];
				N: [XIC(PlaceHolderBit) ,XIO(FaultReset) XIC(Station100Robot._Fault[21]) ][TON(Station100Robot._Fault_Delay_Timer[21],?,?) ,XIC(Station100Robot._Fault_Delay_Timer[21].DN) OTE(Station100Robot._Fault[21]) ];
				N: [XIC(PlaceHolderBit) ,XIO(FaultReset) XIC(Station100Robot._Fault[22]) ][TON(Station100Robot._Fault_Delay_Timer[22],?,?) ,XIC(Station100Robot._Fault_Delay_Timer[22].DN) OTE(Station100Robot._Fault[22]) ];
				N: [XIC(PlaceHolderBit) ,XIO(FaultReset) XIC(Station100Robot._Fault[23]) ][TON(Station100Robot._Fault_Delay_Timer[23],?,?) ,XIC(Station100Robot._Fault_Delay_Timer[23].DN) OTE(Station100Robot._Fault[23]) ];
				N: [XIC(PlaceHolderBit) ,XIO(FaultReset) XIC(Station100Robot._Fault[24]) ][TON(Station100Robot._Fault_Delay_Timer[24],?,?) ,XIC(Station100Robot._Fault_Delay_Timer[24].DN) OTE(Station100Robot._Fault[24]) ];
				N: [XIC(PlaceHolderBit) ,XIO(FaultReset) XIC(Station100Robot._Fault[25]) ][TON(Station100Robot._Fault_Delay_Timer[25],?,?) ,XIC(Station100Robot._Fault_Delay_Timer[25].DN) OTE(Station100Robot._Fault[25]) ];
				N: [XIC(PlaceHolderBit) ,XIO(FaultReset) XIC(Station100Robot._Fault[26]) ][TON(Station100Robot._Fault_Delay_Timer[26],?,?) ,XIC(Station100Robot._Fault_Delay_Timer[26].DN) OTE(Station100Robot._Fault[26]) ];
				N: [XIC(PlaceHolderBit) ,XIO(FaultReset) XIC(Station100Robot._Fault[27]) ][TON(Station100Robot._Fault_Delay_Timer[27],?,?) ,XIC(Station100Robot._Fault_Delay_Timer[27].DN) OTE(Station100Robot._Fault[27]) ];
				N: [XIC(PlaceHolderBit) ,XIO(FaultReset) XIC(Station100Robot._Fault[28]) ][TON(Station100Robot._Fault_Delay_Timer[28],?,?) ,XIC(Station100Robot._Fault_Delay_Timer[28].DN) OTE(Station100Robot._Fault[28]) ];
				N: [XIC(PlaceHolderBit) ,XIO(FaultReset) XIC(Station100Robot._Fault[29]) ][TON(Station100Robot._Fault_Delay_Timer[29],?,?) ,XIC(Station100Robot._Fault_Delay_Timer[29].DN) OTE(Station100Robot._Fault[29]) ];
				N: [XIC(PlaceHolderBit) ,XIO(FaultReset) XIC(Station100Robot._Fault[30]) ][TON(Station100Robot._Fault_Delay_Timer[30],?,?) ,XIC(Station100Robot._Fault_Delay_Timer[30].DN) OTE(Station100Robot._Fault[30]) ];
				N: [XIC(PlaceHolderBit) ,XIO(FaultReset) XIC(Station100Robot._Fault[31]) ][TON(Station100Robot._Fault_Delay_Timer[31],?,?) ,XIC(Station100Robot._Fault_Delay_Timer[31].DN) OTE(Station100Robot._Fault[31]) ];
				N: [XIC(Station100Robot._Warning[0]) ,XIC(Station100Robot._Warning[1]) ,XIC(Station100Robot._Warning[2]) ,XIC(Station100Robot._Warning[3]) ,XIC(Station100Robot._Warning[4]) ,XIC(Station100Robot._Warning[5]) ,XIC(Station100Robot._Warning[6]) ,XIC(Station100Robot._Warning[7]) ,XIC(Station100Robot._Warning[8]) ,XIC(Station100Robot._Warning[9]) ,XIC(Station100Robot._Warning[10]) ,XIC(Station100Robot._Warning[11]) ,XIC(Station100Robot._Warning[12]) ,XIC(Station100Robot._Warning[13]) ,XIC(Station100Robot._Warning[14]) ,XIC(Station100Robot._Warning[15]) ,XIC(Station100Robot._Warning[16]) ,XIC(Station100Robot._Warning[17]) ,XIC(Station100Robot._Warning[18]) ,XIC(Station100Robot._Warning[19]) ,XIC(Station100Robot._Warning[20]) ,XIC(Station100Robot._Warning[21]) ,XIC(Station100Robot._Warning[22]) ,XIC(Station100Robot._Warning[23]) ,XIC(Station100Robot._Warning[24]) ,XIC(Station100Robot._Warning[25]) ,XIC(Station100Robot._Warning[26]) ,XIC(Station100Robot._Warning[27]) ,XIC(Station100Robot._Warning[28]) ,XIC(Station100Robot._Warning[29]) ,XIC(Station100Robot._Warning[30]) ,XIC(Station100Robot._Warning[31]) ]OTE(Station100Robot._Active_Warning);
				N: [XIC(Station100Robot._Fault[0]) ,XIC(Station100Robot._Fault[1]) ,XIC(Station100Robot._Fault[2]) ,XIC(Station100Robot._Fault[3]) ,XIC(Station100Robot._Fault[4]) ,XIC(Station100Robot._Fault[5]) ,XIC(Station100Robot._Fault[6]) ,XIC(Station100Robot._Fault[7]) ,XIC(Station100Robot._Fault[8]) ,XIC(Station100Robot._Fault[9]) ,XIC(Station100Robot._Fault[10]) ,XIC(Station100Robot._Fault[11]) ,XIC(Station100Robot._Fault[12]) ,XIC(Station100Robot._Fault[13]) ,XIC(Station100Robot._Fault[14]) ,XIC(Station100Robot._Fault[15]) ,XIC(Station100Robot._Fault[16]) ,XIC(Station100Robot._Fault[17]) ,XIC(Station100Robot._Fault[18]) ,XIC(Station100Robot._Fault[19]) ,XIC(Station100Robot._Fault[20]) ,XIC(Station100Robot._Fault[21]) ,XIC(Station100Robot._Fault[22]) ,XIC(Station100Robot._Fault[23]) ,XIC(Station100Robot._Fault[24]) ,XIC(Station100Robot._Fault[25]) ,XIC(Station100Robot._Fault[26]) ,XIC(Station100Robot._Fault[27]) ,XIC(Station100Robot._Fault[28]) ,XIC(Station100Robot._Fault[29]) ,XIC(Station100Robot._Fault[30]) ,XIC(Station100Robot._Fault[31]) ]OTE(Station100Robot._Active_Fault);
				N: [XIC(PlaceHolderBit) XIC(Station100Robot._Fault[0]) ,XIC(PlaceHolderBit) XIC(Station100Robot._Fault[1]) ,XIC(PlaceHolderBit) XIC(Station100Robot._Fault[2]) ,XIC(PlaceHolderBit) XIC(Station100Robot._Fault[3]) ,XIC(PlaceHolderBit) XIC(Station100Robot._Fault[4]) ,XIC(PlaceHolderBit) XIC(Station100Robot._Fault[5]) ,XIC(PlaceHolderBit) XIC(Station100Robot._Fault[6]) ,XIC(PlaceHolderBit) XIC(Station100Robot._Fault[7]) ,XIC(PlaceHolderBit) XIC(Station100Robot._Fault[8]) ,XIC(PlaceHolderBit) XIC(Station100Robot._Fault[9]) ,XIC(PlaceHolderBit) XIC(Station100Robot._Fault[10]) ,XIC(PlaceHolderBit) XIC(Station100Robot._Fault[11]) ,XIC(PlaceHolderBit) XIC(Station100Robot._Fault[12]) ,XIC(PlaceHolderBit) XIC(Station100Robot._Fault[13]) ,XIC(PlaceHolderBit) XIC(Station100Robot._Fault[14]) ,XIC(PlaceHolderBit) XIC(Station100Robot._Fault[15]) ,XIC(PlaceHolderBit) XIC(Station100Robot._Fault[16]) ,XIC(PlaceHolderBit) XIC(Station100Robot._Fault[17]) ,XIC(PlaceHolderBit) XIC(Station100Robot._Fault[18]) ,XIC(PlaceHolderBit) XIC(Station100Robot._Fault[19]) ,XIC(PlaceHolderBit) XIC(Station100Robot._Fault[20]) ,XIC(PlaceHolderBit) XIC(Station100Robot._Fault[21]) ,XIC(PlaceHolderBit) XIC(Station100Robot._Fault[22]) ,XIC(PlaceHolderBit) XIC(Station100Robot._Fault[23]) ,XIC(PlaceHolderBit) XIC(Station100Robot._Fault[24]) ,XIC(PlaceHolderBit) XIC(Station100Robot._Fault[25]) ,XIC(PlaceHolderBit) XIC(Station100Robot._Fault[26]) ,XIC(PlaceHolderBit) XIC(Station100Robot._Fault[27]) ,XIC(PlaceHolderBit) XIC(Station100Robot._Fault[28]) ,XIC(PlaceHolderBit) XIC(Station100Robot._Fault[29]) ,XIC(PlaceHolderBit) XIC(Station100Robot._Fault[30]) ,XIC(PlaceHolderBit) XIC(Station100Robot._Fault[31]) ]OTE(Station100Robot._ShutdownSystem_Fault);
		END_ROUTINE

		ROUTINE _01_Robot_Comms 
				RC: "PLC <-> Robot $N"
				    "Communication$N"
				    "";
				N: COP(Robot_Cmd_RoutineID,Station100_Robot:O.Data[64],4);
				N: COP(Station100_Robot:I.Data[52],Robot_Sts_State,1)COP(Station100_Robot:I.Data[56],Robot_Sts_RoutineID,1);
				RC: "Robot position workspace monitoring$N"
				    "";
				N: COP(Station100_Robot:I.Data[64],Robot_Workspace_Loc,1);
		END_ROUTINE

		ROUTINE _02_Robot_Faults 
				RC: "*****************************************************$N"
				    "Robot System Fault Present$N"
				    "*****************************************************";
				N: NEQ(Robot_Alarms,0)OTE(Robot_Fault_Present);
				RC: "RESETS ALARM FILE [0] FAULTS";
				N: XIC(GlobalAck_TOF.TT)CLR(Robot_Alarms);
				RC: "Robot NOT IN Auto (EXT mode)";
				N: XIC(System_InCycle)XIO(RtoPLC_InAuto)XIO(System_CycleStop_Requested)[TON(Robot_Alarm_Delay[0],?,?) ,XIC(Robot_Alarm_Delay[0].DN) OTL(Robot_Alarms.0) ];
				N: XIC(Robot_Alarms.0)ALMD(ROBOT_ALMD_00,HMI_FaultAck_All,HMI_FaultReset_All,0,0);
				RC: "Robot Drives NOT ON";
				N: XIC(POWER_OK_24VC)XIC(RtoPLC_InAuto)XIC(PLCtoR_Start)XIO(PLCtoR_DrivesOn)[TON(Robot_Alarm_Delay[1],?,?) ,XIC(Robot_Alarm_Delay[1].DN) OTL(Robot_Alarms.1) ];
				N: XIC(Robot_Alarms.1)ALMD(ROBOT_ALMD_01,HMI_FaultAck_All,HMI_FaultReset_All,0,0);
		END_ROUTINE

		ROUTINE _03_RobotSequencer 
				RC: "ROBOT COMMAND HANDSHAKE: the only logic that writes Robot_Cmd_RoutineID. The sequencer below talks to it through Cmd_Request / Cmd_Done only.";
				N: NOP();
				RC: "IMM SIM$N"
				    "";
				N: XIC(Good_Part_Pick_From_IMM)ONS(goodONS)OTU(Bad_Part_Pick_From_IMM)OTU(Place_In_IMM);
				RC: "IMM SIM$N"
				    "";
				N: XIC(Bad_Part_Pick_From_IMM)ONS(badONS)OTU(Good_Part_Pick_From_IMM)OTU(Place_In_IMM);
				N: XIC(Place_In_IMM)ONS(placeONS)OTU(Good_Part_Pick_From_IMM)OTU(Bad_Part_Pick_From_IMM);
				RC: "tie HMI reset into robot reset and sequence reset$N"
				    "";
				N: XIC(HMI_Reset)OTE(Seq_Reset);
				RC: "tie AutoMode into robot sequence run$N"
				    "";
				N: XIC(System_AutoMode)XIC(Win_Test.9)OTE(Seq_Run);
				RC: "Robot must be idle before a new command goes out.";
				N: EQU(HS_Step,0)NEQ(Cmd_Request,0)EQU(Robot_Sts_State,0)MOV(Cmd_Request,Robot_Cmd_RoutineID)MOV(10,HS_Step);
				RC: "Accept routine timer set to 5 sec$N"
				    "";
				N: EQU(HS_Step,10)TON(HS_AcceptTmr,?,?);
				RC: "Robot accepted the command and is running it.";
				N: EQU(HS_Step,10)EQU(Robot_Sts_State,1)EQU(Robot_Sts_RoutineID,Cmd_Request)MOV(20,HS_Step);
				RC: "Robot never accepted.$N"
				    "Main is not selected or$N"
				    "not in external auto (EXT)$N"
				    "or drives are off$N"
				    "check pendant!$N"
				    "";
				N: EQU(HS_Step,10)XIC(HS_AcceptTmr.DN)MOV(90,HS_Step);
				RC: "Run timer";
				N: EQU(HS_Step,20)TON(HS_RunTmr,?,?);
				RC: "Routine complete";
				N: EQU(HS_Step,20)EQU(Robot_Sts_State,2)MOV(30,HS_Step);
				RC: "Robot faulted, should rehome itself (hopefully)$N"
				    "";
				N: EQU(HS_Step,20)EQU(Robot_Sts_State,3)MOV(90,HS_Step);
				RC: "Routine stuck or ran too long$N"
				    "";
				N: EQU(HS_Step,20)XIC(HS_RunTmr.DN)MOV(90,HS_Step);
				RC: "Release. The robot holds state 2 or 3 until the command goes to 0.";
				N: EQU(HS_Step,30)MOV(0,Robot_Cmd_RoutineID);
				RC: "Routine COmplete$N"
				    "";
				N: EQU(HS_Step,30)EQU(Robot_Sts_State,0)OTE(Cmd_Done)MOV(0,Cmd_Request)MOV(0,HS_Step);
				RC: "Faulted. Hold here until Seq_Reset";
				N: EQU(HS_Step,90)MOV(0,Robot_Cmd_RoutineID);
				RC: "ROUTINES: Rearrange to set priority$N"
				    "";
				N: NOP();
				RC: "0: Idle$N"
				    "";
				N: XIC(Seq_Reset)MOV(0,HS_Step)MOV(0,Cmd_Request)MOV(0,Robot_Cmd_RoutineID);
				RC: "71: Reject Blank$N"
				    "";
				N: XIC(Seq_Run)EQU(HS_Step,0)EQU(Cmd_Request,0)XIC(RejectBlankRequest)MOV(71,Cmd_Request);
				RC: "72: Reject Finished Side$N"
				    "";
				N: XIC(Seq_Run)EQU(HS_Step,0)EQU(Cmd_Request,0)XIC(RejectFinishedRequest)MOV(72,Cmd_Request);
				RC: "73: Reject both Blank and Finished Side$N"
				    "$N"
				    "";
				N: XIC(Seq_Run)EQU(HS_Step,0)EQU(Cmd_Request,0)XIC(RejectBothSidesRequest)MOV(73,Cmd_Request);
				RC: "60: Downstacker (will be unused, probably)$N"
				    "";
				N: XIC(Seq_Run)EQU(HS_Step,0)EQU(Cmd_Request,0)XIC(RtoPLC_ToolFinHasParts)XIC(SprueCutDone)[XIC(DStoR_DropInShoot) ,XIC(DStoR_PlaceInTray) ]MOV(60,Cmd_Request);
				RC: "50: Sprue Cut$N"
				    "";
				N: XIC(Seq_Run)EQU(HS_Step,0)EQU(Cmd_Request,0)XIC(RtoPLC_ToolFinHasParts)XIO(SprueCutDone)MOV(50,Cmd_Request);
				RC: "40: IMM (need to split pick/place)$N"
				    "";
				N: XIC(Seq_Run)EQU(HS_Step,0)EQU(Cmd_Request,0)[[XIC(Good_Part_Pick_From_IMM) ,XIC(Bad_Part_Pick_From_IMM) ] XIO(RtoPLC_ToolFinHasParts) XIC(IMMtoR_PartInjected) ,XIC(Place_In_IMM) XIC(RtoPLC_ToolBlnkMrked) XIO(IMMtoR_PartInjected) ][XIO(RtoPLC_ToolBlnkMrked) ,XIC(RtoPLC_ToolBlnkMrked) [XIC(Good_Part_Pick_From_IMM) ,] ]XIC(IMMtoR_MoldOpen)XIC(IMMtoR_OpEnable)MOV(40,Cmd_Request);
				RC: "30: LaserMarker (still need to split up pick/place)$N"
				    "";
				N: XIC(Seq_Run)EQU(HS_Step,0)EQU(Cmd_Request,0)XIC(TTtoR_ReqToPlace)XIC(RtoPLC_ToolBlnkHasParts)XIO(RtoPLC_ToolBlnkMrked)MOV(30,Cmd_Request);
				RC: "30: LaserMarker (still need to split up pick/place)$N"
				    "";
				N: XIC(Seq_Run)EQU(HS_Step,0)EQU(Cmd_Request,0)[XIC(TTtoR_ReqToPickGood) ,XIC(TTtoR_ReqToPickBad) ]MOV(30,Cmd_Request);
				RC: "20: UpStacker (Still need to split up the slide and pick)$N"
				    "";
				N: XIC(Seq_Run)EQU(HS_Step,0)EQU(Cmd_Request,0)XIC(UStoR_ReqToMoveLayer)MOV(20,Cmd_Request);
				RC: "20: UpStacker (Still need to split up the slide and pick)$N"
				    "";
				N: XIC(Seq_Run)EQU(HS_Step,0)EQU(Cmd_Request,0)XIC(UStoR_ReqToPick)XIO(RtoPLC_ToolBlnkHasParts)MOV(20,Cmd_Request);
				N: EQU(HS_Step,30)EQU(Robot_Sts_RoutineID,50)OTL(SprueCutDone);
				N: EQU(HS_Step,30)EQU(Robot_Sts_RoutineID,60)OTU(SprueCutDone);
		END_ROUTINE

		ROUTINE _08_HMI_Animations 
				RC: "Change the Robot Blank side vacuum buttons Colors";
				N: [XIO(Rob_Permit_Vac_A_Blank) [XIO(PLCtoR_BlankCupAVacOn) [XIO(CR700) MOV(0,Rob_Vac_Blank_A.Button_Color) ,XIO(CR701) MOV(0,Rob_Blow_Blank_A.Button_Color) ] ,XIO(PLCtoR_BlankCupBVacOn) [XIO(CR702) MOV(0,Rob_Vac_Blank_B.Button_Color) ,XIO(CR703) MOV(0,Rob_Blow_Blank_B.Button_Color) ] ] ,XIC(Rob_Permit_Vac_A_Blank) [[XIO(PLCtoR_BlankCupAVacOn) MOV(1,Rob_Vac_Blank_A.Button_Color) ,XIO(PLCtoR_BlankCupBVacOn) MOV(1,Rob_Vac_Blank_B.Button_Color) ,XIO(CR701) MOV(1,Rob_Blow_Blank_A.Button_Color) ,XIO(CR703) MOV(1,Rob_Blow_Blank_B.Button_Color) ] ,[XIC(CR700) MOV(3,Rob_Vac_Blank_A.Button_Color) ,XIC(CR702) MOV(3,Rob_Vac_Blank_B.Button_Color) ,AFI() MOV(3,Rob_Blow_Blank_A.Button_Color) ,AFI() MOV(3,Rob_Blow_Blank_B.Button_Color) ] ,AFI() [MOV(2,Rob_Vac_Blank_A.Button_Color) ,MOV(2,Rob_Vac_Blank_B.Button_Color) ,MOV(2,Rob_Blow_Blank_A.Button_Color) ,MOV(2,Rob_Blow_Blank_B.Button_Color) ] ,[XIC(PLCtoR_BlankCupAVacOn) MOV(4,Rob_Vac_Blank_A.Button_Color) ,XIC(PLCtoR_BlankCupBVacOn) MOV(4,Rob_Vac_Blank_B.Button_Color) ,XIC(CR701) MOV(4,Rob_Blow_Blank_A.Button_Color) ,XIC(CR703) MOV(4,Rob_Blow_Blank_B.Button_Color) ] ] ];
				RC: "Change the Robot Finished side vacuum buttons Colors";
				N: [XIO(Rob_Permit_Vac_A_Finished) [XIO(PLCtoR_FinishCupAVacOn) [XIO(CR704) MOV(0,Rob_Vac_Finished_A.Button_Color) ,XIO(CR705) MOV(0,Rob_Blow_Finished_A.Button_Color) ] ,XIO(PLCtoR_FinishCupBVacOn) [XIO(CR706) MOV(0,Rob_Vac_Finished_B.Button_Color) ,XIO(CR707) MOV(0,Rob_Blow_Finished_B.Button_Color) ] ] ,XIC(Rob_Permit_Vac_A_Finished) [[XIO(PLCtoR_FinishCupAVacOn) MOV(1,Rob_Vac_Finished_A.Button_Color) ,XIO(PLCtoR_FinishCupBVacOn) MOV(1,Rob_Vac_Finished_B.Button_Color) ,XIO(CR705) MOV(1,Rob_Blow_Finished_A.Button_Color) ,XIO(CR707) MOV(1,Rob_Blow_Finished_B.Button_Color) ] ,[XIC(CR704) MOV(3,Rob_Vac_Finished_A.Button_Color) ,XIC(CR706) MOV(3,Rob_Vac_Finished_B.Button_Color) ,AFI() MOV(3,Rob_Blow_Finished_A.Button_Color) ,AFI() MOV(3,Rob_Blow_Finished_B.Button_Color) ] ,AFI() [MOV(2,Rob_Vac_Finished_A.Button_Color) ,MOV(2,Rob_Vac_Finished_B.Button_Color) ,MOV(2,Rob_Blow_Finished_A.Button_Color) ,MOV(2,Rob_Blow_Finished_B.Button_Color) ] ,[XIC(PLCtoR_FinishCupAVacOn) MOV(4,Rob_Vac_Finished_A.Button_Color) ,XIC(PLCtoR_FinishCupBVacOn) MOV(4,Rob_Vac_Finished_B.Button_Color) ,XIC(CR705) MOV(4,Rob_Blow_Finished_A.Button_Color) ,XIC(CR707) MOV(4,Rob_Blow_Finished_B.Button_Color) ] ] ];
				RC: "Change the Spru Cutter buttons Colors";
				N: [XIO(Spru_Cutter_Permit) [XIO(CR409) MOV(0,Spru_Cutter_Close.Button_Color) ,XIO(CR409) MOV(0,Spru_Cutter_Open.Button_Color) ] ,XIC(Spru_Cutter_Permit) [[XIO(CR409) MOV(1,Spru_Cutter_Close.Button_Color) ,XIO(CR409) MOV(1,Spru_Cutter_Open.Button_Color) ] ,XIO(CR409) MOV(3,Spru_Cutter_Close.Button_Color) ,XIC(CR409) MOV(3,Spru_Cutter_Open.Button_Color) ,AFI() MOV(2,Spru_Cutter_Close.Button_Color) ,AFI() MOV(2,Spru_Cutter_Open.Button_Color) ,XIC(CR409) MOV(4,Spru_Cutter_Close.Button_Color) ,XIO(CR409) MOV(4,Spru_Cutter_Open.Button_Color) ] ];
		END_ROUTINE

		CHILD_PROGRAMS
		END_CHILD_PROGRAMS

	END_PROGRAM

	PROGRAM Program050000_Station200_UpDownStackers (Class := Standard,
	                                                 MAIN := "R000_Main",
	                                                 MODE := 0,
	                                                 DisableFlag := 0,
	                                                 UseAsFolder := 0)
		TAG
			CheckNextPos : BOOL (RADIX := Decimal) := 0;
			CheckNextPosONS : BOOL (RADIX := Decimal) := 0;
			ClosestNegLim : DINT (RADIX := Decimal,
			            ExternalAccess := None) := 1000;
			ClosestPosLim : DINT (RADIX := Decimal,
			            ExternalAccess := None) := 1000;
			ClosestPosONS : BOOL (RADIX := Decimal,
			            ExternalAccess := None) := 0;
			DnAxis_AlarmActive : BOOL (Description := "Drive alarm active (ALM)",
			            RADIX := Decimal) := 0;
			DnAxis_AlarmCode : INT (Description := "Drive alarm code",
			            RADIX := Decimal) := 105;
			DnAxis_Band : DINT (Description := "In-position band, 0.01mm",
			            RADIX := Decimal) := 50;
			DnAxis_BatteryAlarm : BOOL (Description := "Battery alarm (BALM)",
			            RADIX := Decimal) := 0;
			DnAxis_Cmd_BrakeRelease : BOOL (Description := "Brake release (BKRL)",
			            RADIX := Decimal) := 0;
			DnAxis_Cmd_Home : BOOL (Description := "Rising edge homes the axis",
			            RADIX := Decimal) := 0;
			DnAxis_Cmd_Inch : BOOL (Description := "Inch select (JISL). Leave off for continuous jog",
			            RADIX := Decimal) := 0;
			DnAxis_Cmd_JogFwd : BOOL (Description := "Jog forward (JOG+), runs while held",
			            RADIX := Decimal) := 0;
			DnAxis_Cmd_JogRev : BOOL (Description := "Jog reverse (JOG-), runs while held",
			            RADIX := Decimal) := 0;
			DnAxis_Cmd_Pause : BOOL (Description := "Pause the drive (STP)",
			            RADIX := Decimal) := 0;
			DnAxis_Cmd_Reset : BOOL (Description := "Alarm reset (RES)",
			            RADIX := Decimal) := 0;
			DnAxis_Cmd_ServoOn : BOOL (Description := "Servo enable",
			            RADIX := Decimal) := 0;
			DnAxis_Cmd_StartMove : BOOL (Description := "Rising edge runs a move to Target. This is the go command",
			            RADIX := Decimal) := 0;
			DnAxis_CommandCurrent : DINT (Description := "Command current",
			            RADIX := Decimal) := 0;
