<Programs Use="Context">
<Program Use="Target" Name="Program080000_Station500_SprueCutter" TestEdits="false" MainRoutineName="Routine080100_Main" Disabled="false" Class="Standard" UseAsFolder="false">
<Tags/>
<Routines>
<Routine Name="Routine080100_Main" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[JSR(_01_SprueCutter_Faults,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[JSR(_04_Auto_Sequence,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="_01_SprueCutter_Faults" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[*****************************************************
Cutter System Fault Present
*****************************************************]]>
</Comment>
<Text>
<![CDATA[NEQ(Cutter_Alarms,0)OTE(Cutter_Fault_Present);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[RESETS ALARM FILE [0] FAULTS]]>
</Comment>
<Text>
<![CDATA[XIC(GlobalAck_TOF.TT)CLR(Cutter_Alarms);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Scrap Bin Full Please Empty]]>
</Comment>
<Text>
<![CDATA[XIC(System_InCycle)XIC(POWER_OK_24VC)XIC(POWER_OK_24VB)XIO(PE307)[TON(Cutter_Alarm_Delay[0],?,?) ,XIC(Cutter_Alarm_Delay[0].DN) OTL(Cutter_Alarms.0) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(Cutter_Alarms.0)ALMD(CUTTER_ALMD_00,HMI_FaultAck_All,HMI_FaultReset_All,0,0);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Please Reinstall the scrap bin]]>
</Comment>
<Text>
<![CDATA[XIC(POWER_OK_24VC)XIC(POWER_OK_24VB)XIO(PRX315)[TON(Cutter_Alarm_Delay[1],?,?) ,XIC(Cutter_Alarm_Delay[1].DN) OTL(Cutter_Alarms.1) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(Cutter_Alarms.1)ALMD(CUTTER_ALMD_01,HMI_FaultAck_All,HMI_FaultReset_All,0,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="_04_Auto_Sequence" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
</Programs>
</Controller>
