&ACCESS RVO1
&REL 8
&PARAM DISKPATH = KRC:\R1\Program
DEF Station500_SprueCutter()
   ;FOLD INI;%{PE}
      ;FOLD BASISTECH INI
         GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS == TRUE DO IR_STOPM()
         INTERRUPT ON 3
         BAS(#INITMOV, 0)
      ;ENDFOLD (BASISTECH INI)
      ;FOLD USER INI
         ;Make your modifications here
      ;ENDFOLD (USER INI)
   ;ENDFOLD (INI)
;FOLD SPTP SC_A1Turn Vel=100 % PDAT2 Tool[0] Base[0] ;%{PE}
;FOLD Parameters ;%{h}
;Params IlfProvider=kukaroboter.basistech.inlineforms.movement.spline; Kuka.IsGlobalPoint=False; Kuka.PointName=SC_A1Turn; Kuka.BlendingEnabled=False; Kuka.MoveDataPtpName=PDAT2; Kuka.VelocityPtp=100; Kuka.VelocityFieldEnabled=True; Kuka.ColDetectFieldEnabled=True; Kuka.CurrentCDSetIndex=0; Kuka.MovementParameterFieldEnabled=True; IlfCommand=SPTP
;ENDFOLD
SPTP XSC_A1Turn WITH $VEL_AXIS[1] = SVEL_JOINT(100.0), $TOOL = STOOL2(FSC_A1Turn), $BASE = SBASE(FSC_A1Turn.BASE_NO), $IPO_MODE = SIPO_MODE(FSC_A1Turn.IPO_FRAME), $LOAD = SLOAD(FSC_A1Turn.TOOL_NO), $ACC_AXIS[1] = SACC_JOINT(PPDAT2), $APO = SAPO_PTP(PPDAT2), $GEAR_JERK[1] = SGEAR_JERK(PPDAT2), $COLLMON_TOL_PRO[1] = USE_CM_PRO_VALUES(0)
;ENDFOLD
      
   ;FOLD SPTP SC_Cut1Appr Vel=100 % PDAT4 Tool[2]:TOOL_DATA[2] Base[4]:BASE_DATA[4] ;%{PE}
      ;FOLD Parameters ;%{h}
         ;Params IlfProvider=kukaroboter.basistech.inlineforms.movement.spline; Kuka.IsGlobalPoint=False; Kuka.PointName=SC_Cut1Appr; Kuka.BlendingEnabled=False; Kuka.MoveDataPtpName=PDAT4; Kuka.VelocityPtp=100; Kuka.VelocityFieldEnabled=True; Kuka.ColDetectFieldEnabled=True; Kuka.CurrentCDSetIndex=0; Kuka.MovementParameterFieldEnabled=True; IlfCommand=SPTP; SimId=
      ;ENDFOLD
      SPTP XSC_Cut1Appr WITH $VEL_AXIS[1] = SVEL_JOINT(100.0), $TOOL = STOOL2(FSC_Cut1Appr), $BASE = SBASE(FSC_Cut1Appr.BASE_NO), $IPO_MODE = SIPO_MODE(FSC_Cut1Appr.IPO_FRAME), $LOAD = SLOAD(FSC_Cut1Appr.TOOL_NO), $ACC_AXIS[1] = SACC_JOINT(PPDAT4), $APO = SAPO_PTP(PPDAT4), $GEAR_JERK[1] = SGEAR_JERK(PPDAT4), $COLLMON_TOL_PRO[1] = USE_CM_PRO_VALUES(0)
      ;ENDFOLD
      
   ;FOLD SLIN SC_Cut1FlushAppr Vel=0.2 m/s CPDAT8 Tool[2]:TOOL_DATA[2] Base[4]:BASE_DATA[4] ;%{PE}
      ;FOLD Parameters ;%{h}
         ;Params IlfProvider=kukaroboter.basistech.inlineforms.movement.spline; Kuka.IsGlobalPoint=False; Kuka.PointName=SC_Cut1FlushAppr; Kuka.BlendingEnabled=False; Kuka.MoveDataName=CPDAT8; Kuka.VelocityPath=0.2; Kuka.VelocityFieldEnabled=True; Kuka.ColDetectFieldEnabled=True; Kuka.CurrentCDSetIndex=0; Kuka.MovementParameterFieldEnabled=True; IlfCommand=SLIN; SimId=
      ;ENDFOLD
      SLIN XSC_Cut1FlushAppr WITH $VEL = SVEL_CP(0.2, , LCPDAT8), $TOOL = STOOL2(FSC_Cut1FlushAppr), $BASE = SBASE(FSC_Cut1FlushAppr.BASE_NO), $IPO_MODE = SIPO_MODE(FSC_Cut1FlushAppr.IPO_FRAME), $LOAD = SLOAD(FSC_Cut1FlushAppr.TOOL_NO), $ACC = SACC_CP(LCPDAT8), $ORI_TYPE = SORI_TYP(LCPDAT8), $APO = SAPO(LCPDAT8), $JERK = SJERK(LCPDAT8), $COLLMON_TOL_PRO[1] = USE_CM_PRO_VALUES(0)
      ;ENDFOLD
      
   ;FOLD SLIN SC_Cut1Flush Vel=0.1 m/s CPDAT5 Tool[2]:TOOL_DATA[2] Base[4]:BASE_DATA[4] ;%{PE}
      ;FOLD Parameters ;%{h}
         ;Params IlfProvider=kukaroboter.basistech.inlineforms.movement.spline; Kuka.IsGlobalPoint=False; Kuka.PointName=SC_Cut1Flush; Kuka.BlendingEnabled=False; Kuka.MoveDataName=CPDAT5; Kuka.VelocityPath=0.1; Kuka.VelocityFieldEnabled=True; Kuka.ColDetectFieldEnabled=True; Kuka.CurrentCDSetIndex=0; Kuka.MovementParameterFieldEnabled=True; IlfCommand=SLIN; SimId=
      ;ENDFOLD
