      ;ENDFOLD
      
   ;FOLD SLIN SC_Cut2FlushAppr Vel=0.2 m/s CPDAT10 Tool[2]:TOOL_DATA[2] Base[4]:BASE_DATA[4] ;%{PE}
      ;FOLD Parameters ;%{h}
         ;Params IlfProvider=kukaroboter.basistech.inlineforms.movement.spline; Kuka.IsGlobalPoint=False; Kuka.PointName=SC_Cut2FlushAppr; Kuka.BlendingEnabled=False; Kuka.MoveDataName=CPDAT10; Kuka.VelocityPath=0.2; Kuka.VelocityFieldEnabled=True; Kuka.ColDetectFieldEnabled=True; Kuka.CurrentCDSetIndex=0; Kuka.MovementParameterFieldEnabled=True; IlfCommand=SLIN; SimId=
      ;ENDFOLD
