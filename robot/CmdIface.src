&ACCESS RVP
&REL 1
&PARAM DISKPATH = KRC:\R1\Program
DEF CmdIface()
; ============================================================================
;  Command interface helpers. Container file -- call the GLOBAL DEFs below.
;
;  Kept deliberately small. The station programs are unmodified and do not
;  call any of this; only Main does. If a station is ever reworked to report
;  its own faults properly, CmdReportFault is what it should use.
; ============================================================================
END


; ----------------------------------------------------------------------------
;  Report normal completion. Only promotes Running -> Complete, so a routine
;  that already faulted cannot overwrite its own fault by falling through.
; ----------------------------------------------------------------------------
GLOBAL DEF CmdReportComplete()
   IF Robot_Sts_State==1 THEN
      Robot_Sts_State = 2
   ENDIF
END


; ----------------------------------------------------------------------------
;  Report a fault. Does not move -- Main decides about retreating, once, after
;  the routine has returned.
;
;    100  station set RobotCell_Error
;    101  unknown routine ID
;    103  stop asserted mid-routine
; ----------------------------------------------------------------------------
GLOBAL DEF CmdReportFault(FaultCode:IN)
   DECL INT FaultCode
   Robot_Sts_FaultCode = FaultCode
   Robot_Sts_State     = 3
END
