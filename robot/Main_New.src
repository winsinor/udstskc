&ACCESS RVP
&REL 1
&PARAM DISKPATH = KRC:\R1\Program
DEF Main()
; ============================================================================
;  PLC-AS-MASTER DISPATCHER  --  minimal change version
;
;  The ONLY thing this replaces is the priority-poll loop in the old Main.
;  Every station program is called exactly as it exists today, unmodified:
;  they keep their own condition bits, their own inline reject calls, their
;  own timers. Nothing inside a station changes.
;
;  What this adds is the command/status handshake with the PLC, so the PLC
;  decides WHICH station runs and WHEN, and gets a held answer back.
;
;  PROTOCOL
;    1  PLC writes Robot_Cmd_RoutineID, then increments Robot_Cmd_Seq.
;       The increment is the trigger.
;    2  Robot echoes the sequence into Robot_Sts_AckSeq, reports Running.
;    3  Robot calls the station program.
;    4  Robot reports Complete (2) or Faulted (3) AND HOLDS THERE.
;    5  PLC writes Robot_Cmd_RoutineID = 0 to consume it.
;    6  Robot returns to Idle (0).
;
;  IMPORTANT -- MODE BITS ARE STILL THE STATION'S BUSINESS
;  Station200 and Station300 each contain two behaviours selected by a
;  condition bit, and that is left alone. The PLC must set the bit BEFORE
;  issuing the command:
;
;     routine 20 PickUpstacker   -> UStoR_ReqToMoveLayer = FALSE
;     routine 80 LayerShift      -> UStoR_ReqToMoveLayer = TRUE
;     routine 30 PlaceTurntable  -> TTtoR_ReqToPlace = TRUE
;     routine 40 PickTurntable   -> TTtoR_ReqToPickGood or ...PickBad = TRUE
;
;  Tray row and column still arrive in UStoR_PickRowNumber / ColumnNumber
;  exactly as they do today. Nothing about that changes either.
;
;  The two status helpers live at the bottom of this file. They are local
;  DEFs, which is fine while only Main calls them. If a station is ever
;  reworked to report a real fault code instead of just setting
;  RobotCell_Error, promote them to GLOBAL DEF in their own file so the
;  station can reach them -- a local DEF here is not callable from
;  Station400_IMM.src.
; ============================================================================

;FOLD INI;%{PE}
   ;FOLD BASISTECH INI
      GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM()
      INTERRUPT ON 3
      BAS(#INITMOV,0)
   ;ENDFOLD (BASISTECH INI)
   ;FOLD USER INI
   ;ENDFOLD (USER INI)
;ENDFOLD (INI)

   $OV_PRO = 100

   ; ---- publish a clean idle state ----------------------------------------
   Robot_Sts_State     = 0
   Robot_Sts_RoutineID = 0
   Robot_Sts_FaultCode = 0
   Robot_Sts_SubStep   = 0

   ; Adopt whatever sequence number the PLC currently shows. Without this, a
   ; command left over from before the robot started would execute the instant
   ; this program does -- motion nobody asked for, on power-up.
   Robot_Sts_AckSeq = Robot_Cmd_Seq

   LOOP

      ; ---- wait for a new command -----------------------------------------
      WAIT FOR ((Robot_Cmd_Seq<>Robot_Sts_AckSeq) AND (Robot_Cmd_RoutineID<>0))

      Cmd_Routine = Robot_Cmd_RoutineID
      Cmd_P1      = Robot_Cmd_Param1
      Cmd_P2      = Robot_Cmd_Param2
      Cmd_P3      = Robot_Cmd_Param3
      Cmd_P4      = Robot_Cmd_Param4

      Robot_Sts_RoutineID = Cmd_Routine
      Robot_Sts_FaultCode = 0
      Robot_Sts_SubStep   = 0
      Robot_Sts_AckSeq    = Robot_Cmd_Seq
      Robot_Sts_State     = 1

      RobotCell_Error = FALSE

      ; ---- call the existing station program, unmodified -------------------
      SWITCH Cmd_Routine

         CASE 10
            Rtn_Home()

         CASE 20                              ; PLC sets UStoR_ReqToMoveLayer FALSE first
            Station200_UpStacker()

         CASE 30                              ; PLC sets TTtoR_ReqToPlace first
            Station300_LaserMarker()

         CASE 40                              ; PLC sets TTtoR_ReqToPickGood/Bad first
            Station300_LaserMarker()

         CASE 50
            Station400_IMM()

         CASE 60
            Station500_SprueCutter()

         CASE 70
            Station600_DownStacker()

         CASE 80                              ; PLC sets UStoR_ReqToMoveLayer TRUE first
            Station200_UpStacker()

         CASE 90
            Rjct_1Blnk_2Fin_3Both = Cmd_P1    ; 1 blank, 2 finished, 3 both
            Station500_Reject()

         DEFAULT
            CmdReportFault(101)               ; unknown routine ID

      ENDSWITCH

      ; ---- report ----------------------------------------------------------
      ; The stations already set RobotCell_Error on failure. That is the one
      ; hook we take from them, and it costs nothing: it turns a silent
      ; internal failure into a fault the PLC can see and hold on.
      IF RobotCell_Error==TRUE THEN
         CmdReportFault(100)                  ; station reported RobotCell_Error
      ENDIF

      CmdReportComplete()

      ; ---- hold until the PLC consumes --------------------------------------
      ; No timeout here, deliberately. If the PLC never consumes, the right
      ; behaviour is to sit still and be obviously stuck.
      WAIT FOR (Robot_Cmd_RoutineID==0)

      Robot_Sts_State     = 0
      Robot_Sts_RoutineID = 0
      Robot_Sts_FaultCode = 0
      Robot_Sts_SubStep   = 0

   ENDLOOP

END


; ============================================================================
;  10  HOME  --  the one genuinely new routine. Idempotent.
;  Lifted straight from the old Main's homing block.
; ============================================================================
DEF Rtn_Home()

   $OV_PRO = 100

   RtoIMM_MoldAreaFree    = TRUE
   RtoIMM_MoldCloseEnable = TRUE
   RtoIMM_MoldOpenEnable  = TRUE

   ;FOLD SPTP HOME Vel=100 % DEFAULT Tool[0] Base[0] ;%{PE}
   SPTP XHOME WITH $VEL_AXIS[1] = SVEL_JOINT(100.0), $TOOL = STOOL2(FHOME), $BASE = SBASE(FHOME.BASE_NO), $IPO_MODE = SIPO_MODE(FHOME.IPO_FRAME), $LOAD = SLOAD(FHOME.TOOL_NO), $ACC_AXIS[1] = SACC_JOINT(PDEFAULT), $APO = SAPO_PTP(PDEFAULT), $GEAR_JERK[1] = SGEAR_JERK(PDEFAULT), $COLLMON_TOL_PRO[1] = USE_CM_PRO_VALUES(0)
   ;ENDFOLD

   RobotCell_Error = FALSE

END


; ============================================================================
;  Status helpers. Local to this file -- only Main calls them.
; ============================================================================

; ----------------------------------------------------------------------------
;  Report normal completion.
;
;  The guard is the point: this only promotes Running -> Complete. Without it,
;  a routine that already faulted would have its fault silently overwritten
;  when Main falls through to the end of the SWITCH. One IF, and it is the
;  difference between a fault the PLC sees and a fault that vanishes.
; ----------------------------------------------------------------------------
DEF CmdReportComplete()
   IF Robot_Sts_State==1 THEN
      Robot_Sts_State = 2
   ENDIF
END


; ----------------------------------------------------------------------------
;  Report a fault. Sets the code and the state together so the two cannot get
;  out of step.
;
;    100  station set RobotCell_Error
;    101  unknown routine ID
; ----------------------------------------------------------------------------
DEF CmdReportFault(FaultCode:IN)
   DECL INT FaultCode
   Robot_Sts_FaultCode = FaultCode
   Robot_Sts_State     = 3
END
