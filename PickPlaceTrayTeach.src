&ACCESS RVO1
&REL 58
&PARAM DISKPATH = KRC:\R1\Program
DEF PickPlaceTrayTeach()

   ;FOLD INI;%{PE}
      ;FOLD BASISTECH INI
         GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS == TRUE DO IR_STOPM()
         INTERRUPT ON 3
         BAS(#INITMOV, 0)
      ;ENDFOLD (BASISTECH INI)
      ;FOLD USER INI
         ;Make your modifications here
      ;ENDFOLD (USER INI)
      ;ENDFOLD (INI)
      
            US_Pick[1,1]= XUS_TeachPick
            US_Pick[1,2]= XUS_TeachPick1_2
            US_Pick[1,3]= XUS_TeachPick1_3
            US_Pick[1,4]= XUS_TeachPick1_4
            US_Pick[2,1]= XUS_TeachPick2_1
            US_Pick[2,2]= XUS_TeachPick2_2
            US_Pick[2,3]= XUS_TeachPick2_3
            US_Pick[2,4]= XUS_TeachPick2_4



            DS_Pick[1,1]= XDS_TeachPick
            DS_Pick[1,2]= XDS_TeachPick1_2
            DS_Pick[1,3]= XDS_TeachPick1_3
            DS_Pick[1,4]= XDS_TeachPick1_4
            DS_Pick[2,1]= XDS_TeachPick2_1
            DS_Pick[2,2]= XDS_TeachPick2_2
            DS_Pick[2,3]= XDS_TeachPick2_3
            DS_Pick[2,4]= XDS_TeachPick2_4




            GOTO EndOfModule
            
 
        RtoIMM_SeqNumber=1





;move joint 1 to turn robot towards upstacker from home
   ;FOLD SPTP US_A1Turn Vel=100 % PDAT3 Tool[0] Base[0] ;%{PE}
      ;FOLD Parameters ;%{h}
         ;Params IlfProvider=kukaroboter.basistech.inlineforms.movement.spline; Kuka.IsGlobalPoint=False; Kuka.PointName=US_A1Turn; Kuka.BlendingEnabled=False; Kuka.MoveDataPtpName=PDAT3; Kuka.VelocityPtp=100; Kuka.VelocityFieldEnabled=True; Kuka.ColDetectFieldEnabled=True; Kuka.CurrentCDSetIndex=0; Kuka.MovementParameterFieldEnabled=True; IlfCommand=SPTP
      ;ENDFOLD
      SPTP XUS_A1Turn WITH $VEL_AXIS[1] = SVEL_JOINT(100.0), $TOOL = STOOL2(FUS_A1Turn), $BASE = SBASE(FUS_A1Turn.BASE_NO), $IPO_MODE = SIPO_MODE(FUS_A1Turn.IPO_FRAME), $LOAD = SLOAD(FUS_A1Turn.TOOL_NO), $ACC_AXIS[1] = SACC_JOINT(PPDAT3), $APO = SAPO_PTP(PPDAT3), $GEAR_JERK[1] = SGEAR_JERK(PPDAT3), $COLLMON_TOL_PRO[1] = USE_CM_PRO_VALUES(0)
      ;ENDFOLD
 


;FOLD SPTP US_TeachPickstart Vel=100 % PDAT8 Tool[1]:BlankPick Base[1]:UpStacker ;%{PE}
;FOLD Parameters ;%{h}
;Params IlfProvider=kukaroboter.basistech.inlineforms.movement.spline; Kuka.IsGlobalPoint=False; Kuka.PointName=US_TeachPickstart; Kuka.BlendingEnabled=False; Kuka.MoveDataPtpName=PDAT8; Kuka.VelocityPtp=100; Kuka.VelocityFieldEnabled=True; Kuka.ColDetectFieldEnabled=True; Kuka.CurrentCDSetIndex=0; Kuka.MovementParameterFieldEnabled=True; IlfCommand=SPTP
;ENDFOLD
SPTP XUS_TeachPickstart WITH $VEL_AXIS[1] = SVEL_JOINT(100.0), $TOOL = STOOL2(FUS_TeachPickstart), $BASE = SBASE(FUS_TeachPickstart.BASE_NO), $IPO_MODE = SIPO_MODE(FUS_TeachPickstart.IPO_FRAME), $LOAD = SLOAD(FUS_TeachPickstart.TOOL_NO), $ACC_AXIS[1] = SACC_JOINT(PPDAT8), $APO = SAPO_PTP(PPDAT8), $GEAR_JERK[1] = SGEAR_JERK(PPDAT8), $COLLMON_TOL_PRO[1] = USE_CM_PRO_VALUES(0)
;ENDFOLD
          
 US_PickApproach[1,1] = US_Pick[1,1]
 US_PickApproach[1,1].Z = US_PickApproach[1,1].Z + 100
 US_PickApproachSlow[1,1].Z = US_PickApproach[1,1].Z - 65                                                
 SLIN US_PickApproach[1,1] with $TOOL=TOOL_DATA[1],$BASE=BASE_DATA[1],$LOAD=LOAD_DATA[1],$VEL.CP = 2
 SLIN US_PickApproachSlow[1,1] with $TOOL=TOOL_DATA[1],$BASE=BASE_DATA[1],$LOAD=LOAD_DATA[1],$VEL.CP = 2 
;FOLD SLIN US_TeachPick Vel=1 m/s CPDAT15 Tool[1]:BlankPick Base[1]:UpStacker ;%{PE}
;FOLD Parameters ;%{h}
;Params IlfProvider=kukaroboter.basistech.inlineforms.movement.spline; Kuka.IsGlobalPoint=False; Kuka.PointName=US_TeachPick; Kuka.BlendingEnabled=False; Kuka.MoveDataName=CPDAT15; Kuka.VelocityPath=1; Kuka.VelocityFieldEnabled=True; Kuka.ColDetectFieldEnabled=True; Kuka.CurrentCDSetIndex=0; Kuka.MovementParameterFieldEnabled=True; IlfCommand=SLIN
;ENDFOLD
SLIN XUS_TeachPick WITH $VEL = SVEL_CP(1.0, , LCPDAT15), $TOOL = STOOL2(FUS_TeachPick), $BASE = SBASE(FUS_TeachPick.BASE_NO), $IPO_MODE = SIPO_MODE(FUS_TeachPick.IPO_FRAME), $LOAD = SLOAD(FUS_TeachPick.TOOL_NO), $ACC = SACC_CP(LCPDAT15), $ORI_TYPE = SORI_TYP(LCPDAT15), $APO = SAPO(LCPDAT15), $JERK = SJERK(LCPDAT15), $COLLMON_TOL_PRO[1] = USE_CM_PRO_VALUES(0)
;ENDFOLD
US_Pick[1,1]= XUS_TeachPick
SLIN US_Pick[1,1] with $TOOL=TOOL_DATA[1],$BASE=BASE_DATA[1],$LOAD=LOAD_DATA[1],$VEL.CP = 0.1
SLIN US_PickApproach[1,1] with $TOOL=TOOL_DATA[1],$BASE=BASE_DATA[1],$LOAD=LOAD_DATA[1],$VEL.CP = 2
 
US_PickApproach[1,2] = US_Pick[1,2]
 US_PickApproach[1,2].Z = US_PickApproach[1,2].Z + 100
 US_PickApproachSlow[1,2].Z = US_PickApproach[1,2].Z - 65                                                
