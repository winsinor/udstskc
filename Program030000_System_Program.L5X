<Programs Use="Context">
<Program Use="Target" Name="Program030000_System" TestEdits="false" MainRoutineName="Routine030100_Main" Disabled="false" Class="Standard" UseAsFolder="false">
<Description>
<![CDATA[This program manages start up fuctions, and overall systems status]]>
</Description>
<Tags/>
<Routines>
<Routine Name="Robot_IO_Mapping" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[robot status and start signals for starting different routines, for monitoring
]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Robot Start / Stop
]]>
</Comment>
<Text>
<![CDATA[XIC(PLCtoR_Start)XIC(PLCtoR_Stop)NOP();]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Robot Pick From Upstacker
]]>
</Comment>
<Text>
<![CDATA[XIC(UStoR_ReqToPick)MOV(UStoR_PickColumnNumber,UStoR_PickColumnNumber)MOV(UStoR_PickRowNumber,UStoR_PickRowNumber)MOV(UStoR_PickSeqNumber,UStoR_PickSeqNumber)NOP();]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Robot Slide Layer at Upstacker

]]>
</Comment>
<Text>
<![CDATA[XIC(UStoR_ReqToMoveLayer)NOP();]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Robot Place Part at Laser Table
]]>
</Comment>
<Text>
<![CDATA[XIC(TTtoR_ReqToPlace)NOP();]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Robot Pick Part from Laser Table
]]>
</Comment>
<Text>
<![CDATA[[XIC(TTtoR_ReqToPickGood) ,XIC(TTtoR_ReqToPickBad) ]NOP();]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Robot Pick in IMM

]]>
</Comment>
<Text>
<![CDATA[XIC(IMMtoR_OpEnable)XIO(RtoIMM_RobotWithIMM)XIC(IMMtoR_EjectPosBck)XIC(IMMtoR_MoldOpen)XIO(IMMtoR_MoldClosed)[XIC(IMMtoR_PartInjected) ,NEQ(RtoIMM_SeqNumber,0) ]NOP();]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(Good_Part_Pick_From_IMM)MOV(56,RtoIMM_SeqNumber);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(Place_In_IMM)MOV(0,RtoIMM_SeqNumber);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Robot Place in IMM

]]>
</Comment>
<Text>
<![CDATA[XIC(IMMtoR_OpEnable)XIO(RtoIMM_RobotWithIMM)XIC(IMMtoR_EjectPosBck)XIC(IMMtoR_MoldOpen)XIO(IMMtoR_MoldClosed)[XIO(IMMtoR_PartInjected) ,EQU(RtoIMM_SeqNumber,0) ]NOP();]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Routine030100_Main" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[JSR(Routine030700_Outputs,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[JSR(Routine030200_Mode_Control,0);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[JSR(_01_System_Faults,0);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[JSR(Robot_IO_Mapping,0);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[JSR(_03_Main_Inputs,0);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[JSR(_04_HMI_Animations,0);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Predefined pulses]]>
</Comment>
<Text>
<![CDATA[[Pulse(Pulse150c,150,150) OTE(Pulse_150) ,Pulse(Pulse500c,500,500) OTE(Pulse_500) ,Pulse(Pulse750c,750,750) OTE(Pulse_750) ,Pulse(Pulse1000c,1000,1000) OTE(Pulse_1000) ,Pulse(Pulse2000c,2000,2000) OTE(Pulse_2000) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[[[XIC(System_InCycle) ,] ,XIO(System_InCycle) XIC(System_CycleStop_Requested) XIO(CycleStopped) ]RTO(Machine_Overall_CycleTime,?,?);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIO(System_InCycle)XIO(System_CycleStop_Requested)XIC(amp_Test_Bits.29)RES(Machine_Overall_CycleTime);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(amp_Test_Bits.7)OTE(Finished_Part_Placed);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[DTOS(Machine_Overall_CycleTime.ACC,Machine_Overall_CycleTime_String)STOR(Machine_Overall_CycleTime_String,Machine_Overall_CycleTime_Real)CPT(Machine_Overall_CycleTime_Current,Machine_Overall_CycleTime_Real/1000);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(Finished_Part_Placed)ONS(ONS.0)[MOV(Machine_Overall_CycleTime.ACC,Machine_Overall_LastCycleTime_Real) DIV(Machine_Overall_CycleTime.ACC,1000,Machine_Last_CycleTime_DINT) CPT(Machine_Overall_LastCycleTime_Real,Machine_Overall_LastCycleTime_Real/1000) ,ADD(2,Machine_Total_Part_Counter,Machine_Total_Part_Counter) ,MOV(Machine_Overall_LastCycleTime_Real,Machine_Last_10_CycleTimes[CycleTimer_Increment]) ,ADD(1,CycleTimer_Increment,CycleTimer_Increment) ,GRT(CycleTimer_Increment,9) MOV(0,CycleTimer_Increment) ,DIV(Machine_Overall_CycleTime.ACC,1000,Machine_Overall_CycleTime.ACC) ,MOV(0,CycleTime_Min_FIFO[FIFO_Control.POS]) ,FFL(Machine_Overall_CycleTime.ACC,CycleTime_Sec_FIFO[0],FIFO_Control,?,?) ,XIC(FIFO_Control.DN) MOV(0,FIFO_Control.POS) ,RES(Machine_Overall_CycleTime) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Calculate average cycle time over last 10 parts
Add all of the cycle times and divide them by 10]]>
</Comment>
<Text>
<![CDATA[[MOV(0,CycleTime_AverageMin) ,CPT(CycleTime_TotalMin,CycleTime_Min_FIFO[0]+CycleTime_Min_FIFO[1]+CycleTime_Min_FIFO[2]+CycleTime_Min_FIFO[3]+CycleTime_Min_FIFO[4]+CycleTime_Min_FIFO[5]+CycleTime_Min_FIFO[6]+CycleTime_Min_FIFO[7]+CycleTime_Min_FIFO[8]+CycleTime_Min_FIFO[9]) ,CPT(CycleTime_TotalSec,CycleTime_Sec_FIFO[0]+CycleTime_Sec_FIFO[1]+CycleTime_Sec_FIFO[2]+CycleTime_Sec_FIFO[3]+CycleTime_Sec_FIFO[4]+CycleTime_Sec_FIFO[5]+CycleTime_Sec_FIFO[6]+CycleTime_Sec_FIFO[7]+CycleTime_Sec_FIFO[8]+CycleTime_Sec_FIFO[9]) ,CPT(CycleTime_AverageSec,(CycleTime_TotalMin*60+CycleTime_TotalSec)/10) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Convert raw cycle time in seconds to min/sec]]>
</Comment>
<Text>
<![CDATA[Pulse(CycleTime_Pulse,10,10)ONS(ONS.3)[GEQ(CycleTime_AverageSec,60) [ADD(CycleTime_AverageMin,1,CycleTime_AverageMin) ,SUB(CycleTime_AverageSec,60,CycleTime_AverageSec) ] ,GEQ(CycleTime_Sec_FIFO[0],60) [ADD(CycleTime_Min_FIFO[0],1,CycleTime_Min_FIFO[0]) ,SUB(CycleTime_Sec_FIFO[0],60,CycleTime_Sec_FIFO[0]) ] ,GEQ(CycleTime_Sec_FIFO[1],60) [ADD(CycleTime_Min_FIFO[1],1,CycleTime_Min_FIFO[1]) ,SUB(CycleTime_Sec_FIFO[1],60,CycleTime_Sec_FIFO[1]) ] ,GEQ(CycleTime_Sec_FIFO[2],60) [ADD(CycleTime_Min_FIFO[2],1,CycleTime_Min_FIFO[2]) ,SUB(CycleTime_Sec_FIFO[2],60,CycleTime_Sec_FIFO[2]) ] ,GEQ(CycleTime_Sec_FIFO[3],60) [ADD(CycleTime_Min_FIFO[3],1,CycleTime_Min_FIFO[3]) ,SUB(CycleTime_Sec_FIFO[3],60,CycleTime_Sec_FIFO[3]) ] ,GEQ(CycleTime_Sec_FIFO[4],60) [ADD(CycleTime_Min_FIFO[4],1,CycleTime_Min_FIFO[4]) ,SUB(CycleTime_Sec_FIFO[4],60,CycleTime_Sec_FIFO[4]) ] ,GEQ(CycleTime_Sec_FIFO[5],60) [ADD(CycleTime_Min_FIFO[5],1,CycleTime_Min_FIFO[5]) ,SUB(CycleTime_Sec_FIFO[5],60,CycleTime_Sec_FIFO[5]) ] ,GEQ(CycleTime_Sec_FIFO[6],60) [ADD(CycleTime_Min_FIFO[6],1,CycleTime_Min_FIFO[6]) ,SUB(CycleTime_Sec_FIFO[6],60,CycleTime_Sec_FIFO[6]) ] ,GEQ(CycleTime_Sec_FIFO[7],60) [ADD(CycleTime_Min_FIFO[7],1,CycleTime_Min_FIFO[7]) ,SUB(CycleTime_Sec_FIFO[7],60,CycleTime_Sec_FIFO[7]) ] ,GEQ(CycleTime_Sec_FIFO[8],60) [ADD(CycleTime_Min_FIFO[8],1,CycleTime_Min_FIFO[8]) ,SUB(CycleTime_Sec_FIFO[8],60,CycleTime_Sec_FIFO[8]) ] ,GEQ(CycleTime_Sec_FIFO[9],60) [ADD(CycleTime_Min_FIFO[9],1,CycleTime_Min_FIFO[9]) ,SUB(CycleTime_Sec_FIFO[9],60,CycleTime_Sec_FIFO[9]) ] ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[XIO(System_AutoMode)XIC(amp_Test_Bits.3)RES(Machine_Overall_CycleTime);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[MOV(10,RangeToAverage);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[CPT(Avg_Last_10_CycleTimes,(Machine_Last_10_CycleTimes[0]+Machine_Last_10_CycleTimes[1]+Machine_Last_10_CycleTimes[2]+Machine_Last_10_CycleTimes[3]+Machine_Last_10_CycleTimes[4]+Machine_Last_10_CycleTimes[5]+Machine_Last_10_CycleTimes[6]+Machine_Last_10_CycleTimes[7]+Machine_Last_10_CycleTimes[8]+Machine_Last_10_CycleTimes[9])/RangeToAverage);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[Keeping track of parts that the cell has made]]>
</Comment>
<Text>
<![CDATA[[NEQ(Index_Robot_Good_Part_Unload_Request,0) ONS(ONS.4) CTU(Good_Parts_Produced,?,?) ,NEQ(Index_Robot_Bad_Part_Unload_Request,0) ONS(ONS.5) CTU(Bad_Parts_Produced,?,?) ];]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[XIC(HMI_Reset_Counters)ONS(ONS.6)RES(Good_Parts_Produced)RES(Bad_Parts_Produced);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[Time spent in cycle
Time spent not in cycle with no fault 
Time in faulted state
Timer for a fault active in each station]]>
</Comment>
<Text>
<![CDATA[[XIC(System_InCycle) RTO(In_Cycle_Timer,?,?) ,[XIC(System_ManualMode) ,XIC(System_No_Mode) ] RTO(Manual_Timer,?,?) ,XIO(System_InCycle) XIC(System_Fault_Present) RTO(Not_In_Cycle_WithFault_Timer,?,?) ,XIO(System_InCycle) XIO(System_Fault_Present) RTO(Not_In_Cycle_WithoutFault_Timer,?,?) ,XIC(System_Fault_Present) RTO(FaultTimer_Main,?,?) ,XIC(Robot_Fault_Present) RTO(FaultTimer_Robot,?,?) ,XIC(Laser_Station_Fault_Present) RTO(FaultTimer_Laser_Station,?,?) ,XIC(Up_Stacker_Fault_Present) RTO(FaultTimer_UpStacker,?,?) ,XIC(Down_Stacker_Fault_Present) RTO(FaultTimer_DownStacker,?,?) ];]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Text>
<![CDATA[[XIC(S:FS) ,XIC(HMI_Reset_UpTime_Timers) ONS(ONS.7) ,XIC(NewDay_Flag) ONS(ONS.8) ]RES(In_Cycle_Timer)RES(Manual_Timer)RES(Not_In_Cycle_WithFault_Timer)RES(Not_In_Cycle_WithoutFault_Timer)RES(FaultTimer_Main)RES(FaultTimer_Robot)RES(FaultTimer_Laser_Station)RES(FaultTimer_UpStacker)RES(FaultTimer_DownStacker)OTU(NewDay_Flag);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Text>
<![CDATA[NEQ(LocDateTime.Day,PreviousScan_Day)OTL(NewDay_Flag);]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Text>
<![CDATA[XIC(NewDay_Flag)[TON(NewDay_Reset_TMR,?,?) ,XIC(NewDay_Reset_TMR.DN) OTU(NewDay_Flag) ];]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Text>
<![CDATA[MOV(LocDateTime.Day,PreviousScan_Day);]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Text>
<![CDATA[GSV(WallClockTime,?,LocalDateTime,LocDateTime.Year);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Routine030200_Mode_Control" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[*****************************************************************
MODE CONTROL & SAFETY MONITORING
*****************************************************************
]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[OTE(AlwaysOn);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIO(AlwaysOn)OTE(AlwaysOff);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Control Relay Secondary 
 
CRM_S  Engauges when Rung is TRUE and,  IMM ESTOP OK,  Reset PB Pressed
 
 ]]>
</Comment>
<Text>
<![CDATA[XIC(CRM_P)XIC(CRM_DS)XIO(DOOR_1)XIO(DOOR_2)XIO(DOOR_3)XIO(DOOR_4)NOP()XIC(CRM_S)NOP();]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(CRM_DS)XIO(DOOR_1)XIO(DOOR_2)XIO(DOOR_3)XIO(DOOR_4)OTE(All_Doors_AreClosed);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[[XIC(DOOR_1) ,XIC(DOOR_2) ]OTL(Stacker_Door_Opened);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[!!!!!!!!!!!!!!!!!   THIS NEEDS FINISHED AND CONNECTED TO THE SAFETY PROGRAM  !!!!!!!!!!!!!!!!!!!!!!!!!!!]]>
</Comment>
<Text>
<![CDATA[XIC(CRM_P)OTE(CR415)OTE(CR414)OTE(EStop_OK);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(CRM_S)OTE(Motion_Control_OK);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[This rung Acknowledges Faults
]]>
</Comment>
<Text>
<![CDATA[XIC(HMI_Reset)TOF(GlobalAck_TOF,?,?);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[System Manual Mode comes on with the HMI and the Safetys satisfied. On the operator HMIs. ]]>
</Comment>
<Text>
<![CDATA[EQU(HMI_System_Control_PB,1)XIO(System_CycleStop_Requested)XIC(EStop_OK)OTE(System_ManualMode);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[EQU(HMI_System_Control_PB,2)XIC(EStop_OK)OTE(System_AutoMode);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[[XIC(IndexTable_In_Position) EQU(Indexer_Auto.Routine_CurrentCycleStep,10) ,EQU(Indexer_Auto.Routine_CurrentCycleStep,0) ,EQU(Indexer_Auto.Routine_CurrentCycleStep,110) ,AFI() XIO(Weiss:I.Active) ]OTE(Weiss_Indexer_Stopped);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[XIO(UpStack_Inputs.Moving)XIC(Robot_Stopped)[XIO(System_CycleStop_Requested) ,XIC(System_CycleStop_Requested) [XIC(StackersAtBottom) ,XIC(UpStacker_NOT_Moving) ] ]XIO(MoveStackersToBottom)OTE(UpStacker_Stopped);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[[XIO(DwnStack_Inputs.Moving) ,XIC(DnStacker_NOT_Moving) ]XIO(MoveStackersToBottom)OTE(DownStacker_Stopped);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[[EQU(Laser_Marker_Auto.Routine_CurrentCycleStep,0) ,EQU(Laser_Marker_Auto.Routine_CurrentCycleStep,10) ]OTE(Laser_Stopped);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[[XIC(RtoPLC_RobotReachedStop) ,EQU(Robot_Auto.Routine_CurrentCycleStep,0) ,EQU(Robot_Auto.Routine_CurrentCycleStep,10) ,EQU(Robot_Auto.Routine_CurrentCycleStep,100) ]OTE(Robot_Stopped);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[XIO(System_ManualMode)XIO(System_AutoMode)OTE(System_No_Mode);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[THis rung needs to be finished add in stopped steps in each routine]]>
</Comment>
<Text>
<![CDATA[XIC(Robot_Stopped)XIC(Laser_Stopped)XIC(Weiss_Indexer_Stopped)XIC(UpStacker_Stopped)XIC(DownStacker_Stopped)TON(Machine_Stopped_Delay,?,?)XIC(Machine_Stopped_Delay.DN)OTE(System_At_Home);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[Cycle Stopped
]]>
</Comment>
<Text>
<![CDATA[XIC(System_CycleStop_Requested)[XIC(Robot_Stopped) XIC(Laser_Stopped) XIC(Weiss_Indexer_Stopped) XIC(UpStacker_Stopped) XIC(DownStacker_Stopped) ,XIC(System_No_Mode) ][OTE(CycleStopped) ,OTU(System_CycleStop_Requested) ];]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[System in Cycle]]>
</Comment>
<Text>
<![CDATA[XIC(System_AutoMode)[XIC(HMI_Reset) TON(HMI_Cycle_Start_Dly,?,?) XIC(HMI_Cycle_Start_Dly.DN) OTU(System_CycleStop_Requested) [XIO(System_Fault_Present) ,XIC(System_CycleStop_Requested) ] [XIC(System_At_Home) ,] ,XIC(System_InCycle) XIO(Sequence_Timeout_Timer.DN) ]XIO(CycleStopped)OTE(System_InCycle);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[Cycle Stop Request
]]>
</Comment>
<Text>
<![CDATA[[XIC(System_AutoMode) ,XIC(General_RTE) ][XIC(General_RTE) ,XIC(Station_Purge_Mode) XIC(Stations_Data_Empty) ,[XIC(System_Fault_Present) XIO(Machine_Stopped_Delay.DN) ,XIC(System_CycleStop_Requested) ] XIO(Wait_For_Laser_Marking_ToBe_Complete) TON(Sequence_Timeout_Timer,?,?) ONS(Cycle_Control_ONS.3) ,XIC(HMI_Cycle_Stop) ]OTL(System_CycleStop_Requested);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Text>
<![CDATA[XIC(HMI_Doors_Lock)XIC(All_Doors_AreClosed)OTL(HMI_Doors_Lock_Request);]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Text>
<![CDATA[XIC(HMI_Doors_Lock_Request)OTU(General_RTE)OTE(O0410);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Text>
<![CDATA[XIO(HMI_Doors_Lock)XIO(HMI_Reset)[[XIC(O0410) ,XIC(Reset_Hold_TMR2.TT) ] TON(Reset_Hold_TMR2,?,?) ,XIO(Reset_Hold_TMR2.TT) OTU(Optix_IMMDoorAknowledge) OTE(EM78_A4) ];]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Text>
<![CDATA[XIC(HMI_Doors_UnLock)XIC(IMMtoR_DrOpenEnable)[XIO(System_InCycle) OTU(HMI_Doors_Lock_Request) ,XIC(System_InCycle) OTL(General_RTE) ];]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Text>
<![CDATA[XIO(HMI_Doors_Lock_Request)[OTE(DR1_DR2) ,OTE(DR3_DR4) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Routine030700_Outputs" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Reset Safety Relays]]>
</Comment>
<Text>
<![CDATA[XIC(GlobalAck_TOF.TT)[OTE(CR411) ,OTE(CR412) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(CRM_DS)TON(POWER_TMR_24VC,?,?)XIC(POWER_TMR_24VC.DN)OTE(POWER_OK_24VC);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(CRM_S)TON(POWER_TMR_24VB,?,?)XIC(POWER_TMR_24VB.DN)OTE(POWER_OK_24VB);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(CRM_P)XIC(CRM_S)XIC(CRM)XIO(Door_Open_Request)OTE(System_Clear)OTE(Local:4:O.Data.5);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(System_Fault_Present)XIC(Pulse_1000)OTE(LT403);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[[XIC(Upstack_Complete) ,XIC(System_InCycle) ]TON(Horn_TMR,?,?)XIO(Horn_TMR.DN)OTE(AH402);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[[[TON(Flash_TMR,?,?) ,XIC(Flash_TMR.DN) RES(Flash_TMR) ] [XIC(Door_Open_Request) MOV(3000,Flash_TMR.PRE) GRT(Flash_TMR.ACC,1000) ,XIO(CRM) MOV(1000,Flash_TMR.PRE) GRT(Flash_TMR.ACC,500) ,XIO(CRM_S) MOV(500,Flash_TMR.PRE) GRT(Flash_TMR.ACC,250) ,XIO(CRM_P) MOV(250,Flash_TMR.PRE) GRT(Flash_TMR.ACC,125) ] OTE(LT404) ,XIC(System_Clear) ]OTE(LT400);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="_01_System_Faults" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[*****************************************************
Automation System Fault Present
*****************************************************]]>
</Comment>
<Text>
<![CDATA[[NEQ(Main_Alarms,0) ,XIC(Robot_Faulted) ,XIC(Laser_Station_Faulted) ,XIC(Cutter_Fault_Present) ,XIC(amp_Test_Bits.2) ]OTE(System_Fault_Present);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(amp_Test_Bits.5)OTE(System_Warning_Present);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[RESETS ALARM FILE [0] FAULTS]]>
</Comment>
<Text>
<![CDATA[XIC(GlobalAck_TOF.TT)CLR(Main_Alarms);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[AENTR communications fault]]>
</Comment>
<Text>
<![CDATA[XIC(Pulse_1000)XIC(POWER_OK_24VC)XIC(POWER_OK_24VB)GSV(Module,PLC25,FaultCode,HARDWARE_FAULTS[3])NEQ(HARDWARE_FAULTS[3],0)OTL(Main_Alarms.0);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[AENTR Communication Fault]]>
</Comment>
<Text>
<![CDATA[XIC(Main_Alarms.0)ALMD(MAIN_ALMD_00,HMI_FaultAck_All,HMI_FaultReset_All,0,0);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[MDX Laser communications fault]]>
</Comment>
<Text>
<![CDATA[XIC(Pulse_1000)XIC(POWER_OK_24VC)XIC(POWER_OK_24VB)GSV(Module,MDX2,FaultCode,HARDWARE_FAULTS[4])NEQ(HARDWARE_FAULTS[4],0)OTL(Main_Alarms.1);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[MDX Laser Communication Fault]]>
</Comment>
<Text>
<![CDATA[XIC(Main_Alarms.1)ALMD(MAIN_ALMD_01,HMI_FaultAck_All,HMI_FaultReset_All,0,0);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Weiss Drive communications fault]]>
</Comment>
<Text>
<![CDATA[XIC(Pulse_1000)XIC(POWER_OK_24VC)XIC(POWER_OK_24VB)GSV(Module,Weiss,FaultCode,HARDWARE_FAULTS[6])NEQ(HARDWARE_FAULTS[6],0)OTL(Main_Alarms.2);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Power Flex 525 Communication Fault (Weiss)]]>
</Comment>
<Text>
<![CDATA[XIC(Main_Alarms.2)ALMD(MAIN_ALMD_02,HMI_FaultAck_All,HMI_FaultReset_All,0,0);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Main system E_Stop CRM_P OFF]]>
</Comment>
<Text>
<![CDATA[XIO(CRM_P)[TON(Main_Alarm_Delay[0],?,?) ,XIC(Main_Alarm_Delay[0].DN) OTL(Main_Alarms.3) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[E-Stop CRM_P not reset Fault]]>
</Comment>
<Text>
<![CDATA[XIC(Main_Alarms.3)ALMD(MAIN_ALMD_03,HMI_FaultAck_All,HMI_FaultReset_All,0,0);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Main system CRM_S OFF (Motion) Doors not reset]]>
</Comment>
<Text>
<![CDATA[XIO(CRM_S)[TON(Main_Alarm_Delay[1],?,?) ,XIC(Main_Alarm_Delay[1].DN) OTL(Main_Alarms.4) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Main System CRM_S OFF Doors Not reset]]>
</Comment>
<Text>
<![CDATA[XIC(Main_Alarms.4)ALMD(MAIN_ALMD_04,HMI_FaultAck_All,HMI_FaultReset_All,0,0);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Main system Robot Safety CRM OFF ]]>
</Comment>
<Text>
<![CDATA[XIO(CRM)XIC(Robot_IN_Manual)[TON(Main_Alarm_Delay[2],?,?) ,XIC(Main_Alarm_Delay[2].DN) OTL(Main_Alarms.5) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[Robot Safety CRM Not Reset]]>
</Comment>
<Text>
<![CDATA[XIC(Main_Alarms.5)ALMD(MAIN_ALMD_05,HMI_FaultAck_All,HMI_FaultReset_All,0,0);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[Main system Laser Docking Station CRM-DS OFF ]]>
</Comment>
<Text>
<![CDATA[XIC(AlwaysOff)XIO(CRM_DS)[TON(Main_Alarm_Delay[3],?,?) ,XIC(Main_Alarm_Delay[3].DN) OTL(Main_Alarms.6) ];]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[Laser Docking Station CRM_DS Not Reset]]>
</Comment>
<Text>
<![CDATA[XIC(Main_Alarms.6)ALMD(MAIN_ALMD_06,HMI_FaultAck_All,HMI_FaultReset_All,0,0);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[Laser Station Hood Lowered CRM-JB OFF ]]>
</Comment>
<Text>
<![CDATA[XIC(Hood_Lowered)XIO(Weiss_Hood_Raised)XIO(CRM_JB)[TON(Main_Alarm_Delay[4],?,?) ,XIC(Main_Alarm_Delay[4].DN) OTL(Main_Alarms.7) ];]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[Laser Hood Safety CRM_JB Fault]]>
</Comment>
<Text>
<![CDATA[XIC(Main_Alarms.7)ALMD(MAIN_ALMD_07,HMI_FaultAck_All,HMI_FaultReset_All,0,0);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[Air Pressure Alarm]]>
</Comment>
<Text>
<![CDATA[XIC(CRM_P)XIC(CRM_S)XIO(Air_Pressure_Switch)[TON(Main_Alarm_Delay[5],?,?) ,XIC(Main_Alarm_Delay[5].DN) OTL(Main_Alarms.8) ];]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[Air Pressure Switch Fault]]>
</Comment>
<Text>
<![CDATA[XIC(Main_Alarms.8)ALMD(MAIN_ALMD_08,HMI_FaultAck_All,HMI_FaultReset_All,0,0);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[Doors Not Closed]]>
</Comment>
<Text>
<![CDATA[XIO(All_Doors_AreClosed)[TON(Main_Alarm_Delay[6],?,?) ,XIC(Main_Alarm_Delay[6].DN) OTL(Main_Alarms.9) ];]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Comment>
<![CDATA[Doors Not Closed]]>
</Comment>
<Text>
<![CDATA[XIC(Main_Alarms.9)ALMD(MAIN_ALMD_09,HMI_FaultAck_All,HMI_FaultReset_All,0,0);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Comment>
<![CDATA[Doors Not Locked]]>
</Comment>
<Text>
<![CDATA[XIC(All_Doors_AreClosed)XIO(O0410)[TON(Main_Alarm_Delay[7],?,?) ,XIC(Main_Alarm_Delay[7].DN) OTL(Main_Alarms.10) ];]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Comment>
<![CDATA[Doors Not Locked]]>
</Comment>
<Text>
<![CDATA[XIC(Main_Alarms.10)ALMD(MAIN_ALMD_10,HMI_FaultAck_All,HMI_FaultReset_All,0,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="_03_Main_Inputs" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Input Mapping]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(I0111)OTE(Air_Pressure_Switch);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="_04_HMI_Animations" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[HMI annimations]]>
</Comment>
<Text>
<![CDATA[[[XIO(Motion_Control_OK) XIC(System_InCycle) ,XIC(System_InCycle) XIO(System_Fault_Present) ] OTE(HMI_blink) ,XIO(System_Fault_Present) OTE(HMI_Cell_Color) ,[XIC(CRM_P) XIC(System_AutoMode) ,XIC(System_No_Mode) ] OTE(HMI_Visible) ,XIO(System_Fault_Present) [XIO(DOOR_1) OTE(PLC_To_PC_DINT[5].4) ,XIO(DOOR_2) OTE(PLC_To_PC_DINT[5].5) ,XIO(DOOR_3) OTE(PLC_To_PC_DINT[5].6) ,XIO(DOOR_4) OTE(PLC_To_PC_DINT[5].7) ] ,XIC(HMI_IMM_Visible) OTE(HMI_IMM_Visible) ,XIC(HMI_IMM_Blink) OTE(HMI_IMM_Blink) ,XIC(HMI_IMM_Color) OTE(HMI_IMM_Color) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
</Programs>
