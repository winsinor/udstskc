<Programs Use="Context">
<Program Use="Target" Name="Program030000_System" TestEdits="false" MainRoutineName="Routine030100_Main" Disabled="false" Class="Standard" UseAsFolder="false">
<Description>
<![CDATA[This program manages start up fuctions, and overall systems status]]>
</Description>
<Tags/>
<Routines>
<Routine Name="Routine030100_Main" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[JSR(Routine030300_InputStatus,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[JSR(Routine030400_Operation,0);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[JSR(Routine030600_RobotAutoSequence,0);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[JSR(Routine030700_OutputActions,0);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[JSR(Routine039999_Alarms,0);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[JSR(Routine030200_Mode_Control,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Routine030200_Mode_Control" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[*****************************************************************
MODE CONTROL & SAFETY MONITORING
*****************************************************************
]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(CRM_P)OTE(System_Control_Power_ON);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[!!!!!!!!!!!!!!!!!   THIS NEEDS FINISHED AND CONNECTED TO THE SAFETY PROGRAM  !!!!!!!!!!!!!!!!!!!!!!!!!!!]]>
</Comment>
<Text>
<![CDATA[XIC(CRM_S)OTE(EStop_OK);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[This rung Acknowledges Faults
]]>
</Comment>
<Text>
<![CDATA[XIC(HMI_Reset)TOF(GlobalAck_TOF,?,?);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[System Manual Mode comes on with the HMI and the Safetys satisfied. On the operator HMIs. ]]>
</Comment>
<Text>
<![CDATA[EQU(HMI_System_Control_PB,1)XIO(System_CycleStop_Requested)XIC(EStop_OK)OTE(System_ManualMode);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[EQU(HMI_System_Control_PB,2)XIC(EStop_OK)OTE(System_AutoMode);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(RtoPLC_RobotReachedStop)OTE(Robot_Stopped);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIO(Weiss:I.Active)OTE(Weiss_Indexer_Stopped);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIO(UpStack_Inputs.Moving)OTE(UpStacker_Stopped);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIO(DwnStack_Inputs.Moving)OTE(DownStacker_Stopped);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIO(MDX2:I.Data[4].0)OTE(Laser_Stopped);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIO(System_ManualMode)XIO(System_AutoMode)OTE(System_No_Mode);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[THis rung needs to be finished add in stopped steps in each routine]]>
</Comment>
<Text>
<![CDATA[XIC(Robot_Stopped)XIC(Laser_Stopped)XIC(Weiss_Indexer_Stopped)XIC(UpStacker_Stopped)XIC(DownStacker_Stopped)TON(Machine_Stopped_Delay,?,?)XIC(Machine_Stopped_Delay.DN)OTE(System_At_Home);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Cycle Stopped
]]>
</Comment>
<Text>
<![CDATA[XIC(System_CycleStop_Requested)XIC(Robot_Stopped)XIC(Laser_Stopped)XIC(Weiss_Indexer_Stopped)XIC(UpStacker_Stopped)XIC(DownStacker_Stopped)[OTE(CycleStopped) ,OTU(System_CycleStop_Requested) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[System in Cycle]]>
</Comment>
<Text>
<![CDATA[XIC(System_AutoMode)[XIC(HMI_Reset) TON(HMI_Cycle_Start_Dly,?,?) XIC(HMI_Cycle_Start_Dly.DN) OTU(System_CycleStop_Requested) [XIO(System_Fault_Present) ,XIC(System_CycleStop_Requested) ] XIC(System_At_Home) ,XIC(System_InCycle) XIO(Sequence_Timeout_Timer.DN) ]XIO(CycleStopped)OTE(System_InCycle);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[Cycle Stop Request
]]>
</Comment>
<Text>
<![CDATA[[XIC(System_AutoMode) ,XIC(General_RTE) ][XIC(General_RTE) ,XIC(Station_Purge_Mode) XIC(Stations_Data_Empty) ,[XIC(System_Fault_Present) XIO(Machine_Stopped_Delay.DN) ,XIC(System_CycleStop_Requested) ] TON(Sequence_Timeout_Timer,?,?) ONS(Cycle_Control_ONS.3) ,XIC(HMI_Cycle_Stop) ]OTL(System_CycleStop_Requested);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Routine030300_InputStatus" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(amp_Test_Bits.0)[[XIC(PB109) ,XIC(PC_Door_Open_Request) ] OTL(Door_Open_Request) ,[[XIC(PB110) ,XIC(Optix_DoorLockRequest) ONS(Optix_DoorLockRequestONS) ,XIC(Reset_Hold_TMR.DN) ] [OTE(FaultReset) ,RES(Door_Open_Wait) ] ,XIC(Door_Reset_Delay.EN) XIO(Door_Reset_Delay.DN) ] XIC(CRM_S) XIO(PB109) XIO(PC_Door_Open_Request) OTU(Unlock_Doors) TON(Door_Reset_Delay,?,?) [XIC(Door_Reset_Delay.DN) OTU(Door_Open_Request) ,XIC(Door_Reset_Delay.TT) XIC(RtoPLC_InAuto) OTL(StartRobotCycle) ] ,[XIC(Station100Robot._Active_Fault) ,XIC(Door_Open_Request) ] XIC(RtoPLC_InAuto) OTE(PLCtoR_Stop) ,XIC(Door_Open_Request) XIC(Door_Open_Permission) TON(Door_Open_Wait,?,?) XIC(Door_Open_Wait.DN) OTL(Unlock_Doors) ,[XIC(EM78_C7_C1) ,] XIO(Weiss:I.Active) XIO(MDX2:I.Data[4].0) XIO(Hood_Lowered) XIO(UpStack_Inputs.Moving) XIO(DwnStack_Inputs.Moving) [XIC(RtoPLC_RobotReachedStop) ,XIO(RtoPLC_InAuto) ] OTE(Door_Open_Permission) ,XIC(Unlock_Doors) OTE(DR1_DR2) OTE(DR3_DR4) ,XIO(Unlock_Doors) OTU(Optix_DoorLockRequest) OTE(O0410) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[XIC(PB110) ,XIC(Optix_DoorLockRequest) ,XIC(Reset_Hold_TMR.TT) ]TON(Reset_Hold_TMR,?,?);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[[XIC(Optix_IMMDoorAknowledge) ,XIC(Reset_Hold_TMR2.TT) ] TON(Reset_Hold_TMR2,?,?) ,XIO(Reset_Hold_TMR2.TT) OTU(Optix_IMMDoorAknowledge) OTE(EM78_A4) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(EM78_C9_C3)NOP();]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Control Relay Master
 
CRM  Engauges when Rung is TRUE and IMM Doors are TRUE
 
 ]]>
</Comment>
<Text>
<![CDATA[XIC(CRM_S)NOP()XIC(CRM)NOP();]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Control Relay Secondary 
 
CRM_S  Engauges when Rung is TRUE and,  IMM ESTOP OK,  Reset PB Pressed
 
 ]]>
</Comment>
<Text>
<![CDATA[XIC(CRM_P)XIC(CRM_DS)XIO(DOOR_1)XIO(DOOR_2)XIO(DOOR_3)XIO(DOOR_4)NOP()XIC(CRM_S)NOP();]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Control Relay Primary
 
CRM_P  Engauges when Kuka Controller, Kuka Estop, and Panel Estop  is TRUE
 
 ]]>
</Comment>
<Text>
<![CDATA[XIO(ESPB104)NOP()XIC(CRM_P)NOP();]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Control Relay Docking Station
 
CRM_DS  Docking Station PRX is TRUE and Reset PB Pressed
 ]]>
</Comment>
<Text>
<![CDATA[XIC(CRM_DS)NOP();]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Routine030400_Operation" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Routine030600_RobotAutoSequence" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[*****************************
IMM ROBOT
*****************************]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Robot Auto Sequence

Moves The Next Sequence Cycle Step Into The Current Cycle Step. This Can Be Used To Step The Code Through The AutoCycle One Step At A Time.
This Can Be Done By Putting A Toggle Bit Infront Of The Move Instruction]]>
</Comment>
<Text>
<![CDATA[[[XIO(System_AutoMode) ,XIC(S:FS) ] [MOV(0,Robot_Auto.Routine_CurrentCycleStep) ,MOV(0,Robot_Auto.Routine_NextCycleStep) ] ,[XIC(System_InCycle) ,XIO(System_InCycle) [XIC(System_CycleStop_Requested) ,XIC(Auto_Initialization) ] ] MOV(Robot_Auto.Routine_NextCycleStep,Robot_Auto.Routine_CurrentCycleStep) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Robot Auto sequence Decision step
]]>
</Comment>
<Text>
<![CDATA[EQU(Robot_Auto.Routine_CurrentCycleStep,0)XIC(System_InCycle)XIC(IndexTable_In_Position)[XIC(IndexTable_New_Part_Requested) MOV(10,Robot_Auto.Routine_NextCycleStep) ,XIC(Robot_Good_Part_Unload_Request) MOV(100,Robot_Auto.Routine_NextCycleStep) ,XIC(IMM_Load_Request) MOV(200,Robot_Auto.Routine_NextCycleStep) ,XIC(Tray_Transfer_Request) MOV(300,Robot_Auto.Routine_NextCycleStep) ,XIC(Robot_Bad_Part_Unload_Request) MOV(1000,Robot_Auto.Routine_NextCycleStep) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Robot Auto sequence

Index table New Part Requested
]]>
</Comment>
<Text>
<![CDATA[EQU(Robot_Auto.Routine_CurrentCycleStep,10)XIC(System_InCycle)[OTE(Robot_Load_New_Part) ,XIC(IndexTable_In_Position) XIC(Index_Table_Part_Data[1].Part_Data_Present) MOV(0,Robot_Auto.Routine_NextCycleStep) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Robot Auto sequence

Unload good Part
]]>
</Comment>
<Text>
<![CDATA[EQU(Robot_Auto.Routine_CurrentCycleStep,100)XIC(System_InCycle)[OTE(Robot_Unload_Good_Part) ,XIC(IndexTable_In_Position) XIC(Index_Table_Part_Data[1].Part_Data_Present) MOV(0,Robot_Auto.Routine_NextCycleStep) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Robot Auto sequence

IMM Load / unload Parts
]]>
</Comment>
<Text>
<![CDATA[EQU(Robot_Auto.Routine_CurrentCycleStep,200)XIC(System_InCycle)[XIC(IMM_Open) OTE(Robot_LoadUnload_Imm_Parts) ,XIO(Robot_Blank_Side_Part_Data.Part_Data_Present) XIC(Robot_Finished_Side_Part_Data.Part_Data_Present) MOV(0,Robot_Auto.Routine_NextCycleStep) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Robot Auto sequence

Transfer trays from upsatacker to down stacker
]]>
</Comment>
<Text>
<![CDATA[EQU(Robot_Auto.Routine_CurrentCycleStep,300)XIC(System_InCycle)[OTE(Robot_Transfer_Trays) ,XIC(RtoUS_LayerMovedConfirm) MOV(0,Robot_Auto.Routine_NextCycleStep) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Routine030700_OutputActions" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Unswitch Power 24VA 

Timer may be necessary on First Scan]]>
</Comment>
<Text>
<![CDATA[[OTE(POWER_OK_24VA) ,OTE(CR414) ,OTE(CR415) XIC(CRM_S) XIO(CRM_JB) NOP() ,XIC(POWER_OK_24VC) OTE(CR508) OTE(CR512) ,XIC(POWER_OK_24VC) OTE(CR515) OTE(CR509) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[CELL LED LIGHTING STRIPS]]>
</Comment>
<Text>
<![CDATA[[OTE(CR411) ,XIO(DropInChuteLEDblink[2].DN) OTE(CR412) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(CRM_DS)TON(POWER_TMR_24VC,?,?)XIC(POWER_TMR_24VC.DN)OTE(POWER_OK_24VC);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(CRM_S)TON(POWER_TMR_24VB,?,?)XIC(POWER_TMR_24VB.DN)OTE(POWER_OK_24VB);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(CRM_P)XIC(CRM_S)XIC(CRM)XIO(Door_Open_Request)OTE(System_Clear)OTE(Local:4:O.Data.5);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIO(CRM)OTE(LT403);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[[XIC(Upstack_Complete) ,XIC(Josh_test.1) ]TON(Horn_TMR,?,?)XIO(Horn_TMR.DN)OTE(AH402);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[[[TON(Flash_TMR,?,?) ,XIC(Flash_TMR.DN) RES(Flash_TMR) ] [XIC(Door_Open_Request) MOV(3000,Flash_TMR.PRE) GRT(Flash_TMR.ACC,1000) ,XIO(CRM) MOV(1000,Flash_TMR.PRE) GRT(Flash_TMR.ACC,500) ,XIO(CRM_S) MOV(500,Flash_TMR.PRE) GRT(Flash_TMR.ACC,250) ,XIO(CRM_P) MOV(250,Flash_TMR.PRE) GRT(Flash_TMR.ACC,125) ] OTE(LT404) ,XIC(System_Clear) ]OTE(LT400);]]>
</Text>
</Rung>
</RLLContent>
