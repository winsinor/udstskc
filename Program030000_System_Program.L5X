<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(EnableIn)[MOV(TimeOn,PulseTimer.PRE) ,MOV(TimeOff,PulseTimer2.PRE) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(EnableIn)[XIO(PulseTimer2.DN) TON(PulseTimer,?,?) ,XIC(PulseTimer.DN) TON(PulseTimer2,?,?) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(PulseTimer.DN)OTE(EnableOut);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
