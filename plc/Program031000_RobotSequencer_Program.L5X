<DataType Name="Part_Pair" Family="NoFamily" Class="User">
<Description>
<![CDATA[One 2-up pair as it travels the cell. Locations hold this record's index (a sequence number), never a copy, so nothing can diverge.]]>
</Description>
<Members>
<Member Name="Seq_Num" DataType="DINT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Identity, 1..500. Same as the Part_Log index.]]>
</Description>
</Member>
<Member Name="State" DataType="DINT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[0 empty, 10 allocated, 20 on gripper unmarked, 30 in nest, 40 marked, 50 on gripper marked, 60 in mould, 70 on gripper moulded, 80 sprue cut, 90 delivered, 900 rejected.]]>
</Description>
</Member>
<Member Name="ZZZZZZZZZZPart_Pair0" DataType="SINT" Dimension="0" Radix="Decimal" Hidden="true" ExternalAccess="Read/Write"/>
<Member Name="A_Present" DataType="BIT" Dimension="0" Radix="Decimal" Hidden="false" Target="ZZZZZZZZZZPart_Pair0" BitNumber="0" ExternalAccess="Read/Write">
<Description>
<![CDATA[Cup A side holds a part.]]>
</Description>
</Member>
<Member Name="A_Good" DataType="BIT" Dimension="0" Radix="Decimal" Hidden="false" Target="ZZZZZZZZZZPart_Pair0" BitNumber="1" ExternalAccess="Read/Write">
<Description>
<![CDATA[Cup A part is good.]]>
</Description>
</Member>
<Member Name="A_Bad" DataType="BIT" Dimension="0" Radix="Decimal" Hidden="false" Target="ZZZZZZZZZZPart_Pair0" BitNumber="2" ExternalAccess="Read/Write">
<Description>
<![CDATA[Cup A part is scrap.]]>
</Description>
</Member>
<Member Name="B_Present" DataType="BIT" Dimension="0" Radix="Decimal" Hidden="false" Target="ZZZZZZZZZZPart_Pair0" BitNumber="3" ExternalAccess="Read/Write">
<Description>
<![CDATA[Cup B side holds a part.]]>
</Description>
</Member>
<Member Name="B_Good" DataType="BIT" Dimension="0" Radix="Decimal" Hidden="false" Target="ZZZZZZZZZZPart_Pair0" BitNumber="4" ExternalAccess="Read/Write">
<Description>
<![CDATA[Cup B part is good.]]>
</Description>
</Member>
<Member Name="B_Bad" DataType="BIT" Dimension="0" Radix="Decimal" Hidden="false" Target="ZZZZZZZZZZPart_Pair0" BitNumber="5" ExternalAccess="Read/Write">
<Description>
<![CDATA[Cup B part is scrap.]]>
</Description>
</Member>
