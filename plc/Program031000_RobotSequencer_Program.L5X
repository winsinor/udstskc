<Programs Use="Context">
<Program Use="Target" Name="Program031000_RobotSequencer" TestEdits="false" MainRoutineName="R000_Main" Disabled="false" Class="Standard" UseAsFolder="false">
<Description>
<![CDATA[PLC-as-master robot sequencer. Commands the KUKA to run one named routine at a time and reads back a HELD status. Self-contained: every external signal is an Ext_ stub mapped in R999_ExternalInterface, so this imports with no unresolved references and no module dependencies.]]>
</Description>
<Tags>
<Tag Name="Seq_ReqRoutineID" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Routine the sequencer or faceplate wants issued.]]>
</Description>
<Data Format="L5K">
<![CDATA[0]]>
</Data>
</Tag>
<Tag Name="Seq_ReqParam1" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
<Data Format="L5K">
<![CDATA[0]]>
</Data>
</Tag>
