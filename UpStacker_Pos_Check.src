&ACCESS RVP
&REL 3
&PARAM DISKPATH = KRC:\R1\Program
DEF UPSTACKER_POS_CHECK()
DECL INT r,c
;FOLD INI
BAS(#INITMOV,0)
;ENDFOLD
PickPlaceTrayTeach()
FOR r=1 TO 2
FOR c=1 TO 4
US_PickApproach[r,c] = US_Pick[r,c]
US_PickApproach[r,c].Z = US_PickApproach[r,c].Z + 100
SPTP US_PickApproach[r,c] WITH $TOOL=TOOL_DATA[1],$BASE=BASE_DATA[1],$LOAD=LOAD_DATA[1],$VEL.CP=2
SLIN US_Pick[r,c] WITH $TOOL=TOOL_DATA[1],$BASE=BASE_DATA[1],$LOAD=LOAD_DATA[1],$VEL.CP=0.05
RtoPLC_BlankCupAVac=TRUE
RtoPLC_BlankCupBVac=TRUE
HALT
SPTP US_PickApproach[r,c] WITH $TOOL=TOOL_DATA[1],$BASE=BASE_DATA[1],$LOAD=LOAD_DATA[1],$VEL.CP=2
HALT

RtoPLC_BlankCupAVac=FALSE
RtoPLC_BlankCupBVac=FALSE
RtoPLC_BlankCupABlow=TRUE
RtoPLC_BlankCupBBlow=TRUE
WAIT SEC 0.5
RtoPLC_BlankCupABlow=FALSE
RtoPLC_BlankCupBBlow=FALSE
ENDFOR
ENDFOR
END