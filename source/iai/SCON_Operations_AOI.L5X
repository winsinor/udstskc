<LocalTags/>
<Routines>
<Routine Name="EnableInFalse" Type="RLL">
<Description>
<![CDATA[Executes when the rung is false]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[OTU(EN);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[OTL(EN);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(Servo_On)OTE(Map_Axis_Outputs.Servo_On);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(Inch_Select)OTE(Map_Axis_Outputs.Inch_Select);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(Jog_Forward)OTE(Map_Axis_Outputs.Jog_Forward);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(Jog_Reverse)OTE(Map_Axis_Outputs.Jog_Reverse);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(Pause)OTE(Map_Axis_Outputs.Pause);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(Reset)OTE(Map_Axis_Outputs.Reset);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(Release_Brake)OTE(Map_Axis_Outputs.Release_Brake);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
