<Routines>
<Routine Name="EnableInFalse" Type="RLL">
<Description>
<![CDATA[Executes when the rung is false]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[OTU(EN);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[OTL(EN);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(Map_Axis_Inputs.Ready)OTE(Ready);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
