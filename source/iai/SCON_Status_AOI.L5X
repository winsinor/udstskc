</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(Map_Axis_Inputs.Homing)OTE(Homing);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(Map_Axis_Inputs.Home_Complete)OTE(Home_Complete);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(Map_Axis_Inputs.Moving)OTE(Moving);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(Map_Axis_Inputs.Position_Complete)OTE(Position_Complete);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(Map_Axis_Inputs.Manual_Mode)OTE(Manual_Mode);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
