</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(Map_Axis_Inputs.In_Zone_1)OTE(In_Zone_1);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
