</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[XIC(Map_Axis_Inputs.Push_Failed)OTE(Push_Failed);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[MOV(Map_Axis_Inputs.Actual_Position,Actual_Position)MOV(Map_Axis_Inputs.Actual_Speed,Actual_Speed)MOV(Map_Axis_Inputs.Command_Current,Command_Current)MOV(Map_Axis_Inputs.Alarm_Code,Alarm_Code);]]>
