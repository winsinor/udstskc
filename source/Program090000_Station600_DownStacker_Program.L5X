<Routines>
<Routine Name="Routine090100_Main" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[JSR(Routine090300_InputStatus,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[JSR(Routine090500_Operation,0);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
