# =====================================================================
# Program050000_Station200_UpStacker  --  up stacker axis
#
# Barebones. Two routines, six rungs: read the drive, turn the servo on,
# hand the move to IAI's instructions, write the drive.
#
# TO MOVE THE ACTUATOR
#     set    UpAxis_Target         where to go, in 0.01mm (12500 = 125.00mm)
#     pulse  UpAxis_Cmd_StartMove  SCON_Moves takes the rising edge
#
#     watch  UpAxis_Position          where it actually is, 0.01mm
#            UpAxis_Moving            running
#            UpAxis_PositionComplete  arrived  <-- the confirmation
#            UpAxis_AlarmActive       faulted, code in UpAxis_AlarmCode
#
# The three SCON_* instructions are IAI's own, imported unmodified.
# SCON_Moves owns the START handshake: it latches START with the move
# data on the rising edge and drops it when the drive acknowledges.
#
# Speed, accel and decel come from the existing controller tags
# UpStack_Target_Speed, UpStack_Output_Acceleration and UpStack_Output_Deceleration.
# =====================================================================


@ROUTINE R000_Main | Main.
JSR(R100_Axis,0);


@ROUTINE R100_Axis | The whole axis. Six rungs.
# ---------------------------------------------------------------------
# 1. Read the drive, and unpack it into the UpAxis_ status tags.
# ---------------------------------------------------------------------
CPS(IAI_UpStacker:I,UpStack_Inputs,1);

SCON_Status(UpAxis_Sts,UpAxis_Position,UpAxis_Speed,UpAxis_AlarmActive,UpAxis_AlarmCode,UpAxis_BatteryAlarm,UpAxis_CommandCurrent,UpAxis_HomeComplete,UpAxis_Homing,UpAxis_EStop,UpAxis_InPushZone,UpAxis_InPZone,UpAxis_InZone1,UpAxis_InZone2,UpAxis_LoadReached,UpAxis_DriveManualMode,UpAxis_Moving,UpAxis_PositionComplete,UpAxis_PushFailed,UpAxis_DriveReady,UpAxis_ServoOn,UpAxis_TorqueReached,UpAxis_TotalMoveCount,UpAxis_TotalMoveDistance,UpStack_Inputs);

# ---------------------------------------------------------------------
# 2. Servo permissive and the motor power contactor (CR614).
#    Unlocking the doors drops the servo, so nothing can move with the
#    doors open. This is the existing machine interlock, kept as it was.
# ---------------------------------------------------------------------
XIC(POWER_OK_24VB)XIO(Unlock_Doors)
[OTE(UpAxis_Cmd_ServoOn) ,OTE(CR614) ];

# ---------------------------------------------------------------------
# 3. Hand the commands to IAI's instructions.
#
#    Pulse UpAxis_Cmd_StartMove to run a move to UpAxis_Target.
#    UpAxis_Cmd_JogFwd / UpAxis_Cmd_JogRev jog while held.
#    UpAxis_Cmd_Home homes on a rising edge.
# ---------------------------------------------------------------------
SCON_Operations(UpAxis_Ops,UpAxis_Cmd_ServoOn,UpAxis_Cmd_Pause,UpAxis_Cmd_Inch,UpAxis_Cmd_JogFwd,UpAxis_Cmd_JogRev,UpAxis_Cmd_Reset,UpAxis_Cmd_BrakeRelease,UpStack_Outputs);

SCON_Moves(UpAxis_Mov,UpAxis_Cmd_Home,UpAxis_Cmd_StartMove,UpAxis_Target,UpStack_Target_Speed,UpStack_Output_Acceleration,UpStack_Output_Deceleration,UpAxis_Band,UpAxis_Increment_Select,UpAxis_Push_Select,UpAxis_Push_Direction,UpAxis_Push_Percent,UpAxis_Load_Threshold,UpAxis_PZone_Upper,UpAxis_PZone_Lower,UpStack_Inputs,UpStack_Outputs);

# ---------------------------------------------------------------------
# 4. Write the drive.
# ---------------------------------------------------------------------
CPS(UpStack_Outputs,IAI_UpStacker:O,1);
