# =====================================================================
# Program050000_Station200_UpStacker  --  refactored ladder
#
# Format of this file:
#   @ROUTINE <name> | <description>
#   # ...            rung comment lines, attached to the next rung
#   <rung text>;     one rung, may span lines, ends at the semicolon
# =====================================================================


@ROUTINE R000_Main | Main. Calls everything in scan order.
# Scan order matters:
#   R100 copies the drive image in, runs the axis, copies it back out
#   R200 and R300 produce the move requests R100 consumes next scan
#   R400 is the tray/robot data layer
#   R900 is alarms
JSR(R100_AxisControl,0);
JSR(R200_Manual,0);
JSR(R300_AutoSequence,0);
JSR(R400_TrayData,0);
JSR(R900_Alarms,0);


@ROUTINE R100_AxisControl | The only routine that talks to the actuator.
# ---------------------------------------------------------------------
# Copy the drive input image in.
# Everything downstream reads UpStack_Inputs, never the module tag.
# ---------------------------------------------------------------------
CPS(IAI_UpStacker:I,UpStack_Inputs,1);

# ---------------------------------------------------------------------
# Servo permissive and the motor power contactor.
#
# CR614 = UPSTACKER MOTOR POWER ON, PLC1602 slot 6, O0614.
# Unlocking the doors drops the servo, which is what makes it safe to
# leave the manual jog buttons live -- with the doors unlocked nothing
# can move regardless of what the operator presses.
# ---------------------------------------------------------------------
XIC(POWER_OK_24VB)XIO(Unlock_Doors)
[OTE(Axis.Cmd_ServoOn) ,OTE(CR614) ];

# ---------------------------------------------------------------------
# Load the axis configuration every scan, so an HMI edit to a travel
# limit or a speed takes effect on the next move without a download.
# ---------------------------------------------------------------------
[MOV(Cfg_UpStack_LowMax_POS,Axis.Cfg_Pos_Min)
,MOV(Cfg_UpStack_HighMax_POS,Axis.Cfg_Pos_Max)
,MOV(UpStack_Target_Speed,Axis.Cfg_Speed)
,MOV(UpStack_Output_Acceleration,Axis.Cfg_Accel)
,MOV(UpStack_Output_Deceleration,Axis.Cfg_Decel)
,MOV(Cfg_PosBand,Axis.Cfg_Band)
,MOV(Cfg_MoveTimeout,Axis.Cfg_Move_Timeout)
,XIC(Cfg_JogFast) OTE(Axis.Cfg_Jog_Fast) ];

# ---------------------------------------------------------------------
# Who owns the axis: manual or the auto sequence. One or the other,
# never both. This is the single arbitration point in the program.
# ---------------------------------------------------------------------
XIC(Man_Mode)MOV(Man_Target_Position,Axis.Set_Position);

XIO(Man_Mode)MOV(Auto_Target_Position,Axis.Set_Position);

# The move command itself. Both sources are one-scan pulses; the
# instruction takes the rising edge.
[XIC(Man_Mode) XIC(Man_Move_Cmd)
,XIO(Man_Mode) XIC(Auto_Move_Cmd) ]OTE(Axis.Cmd_MoveAbs);

# ---------------------------------------------------------------------
# Jog, home, stop and reset. Jog is manual-only by construction --
# R200 never sets Man_JogUp/Man_JogDn unless Man_Mode is on.
# ---------------------------------------------------------------------
XIC(Man_JogUp)OTE(Axis.Cmd_JogUp);

XIC(Man_JogDn)OTE(Axis.Cmd_JogDn);

XIC(Man_Mode)XIC(Man_Home_PB)OTE(Axis.Cmd_Home);

XIC(Man_Stop_PB)OTE(Axis.Cmd_Stop);

[XIC(FaultReset) ,XIC(Man_Reset_PB) ]OTE(Axis.Cmd_Reset);

# ---------------------------------------------------------------------
# The axis itself.
#
#   IAI_SCON_Axis( backing tag , input image , output image )
#
# Commands and status are on the backing tag: Axis.Cmd_MoveAbs,
# Axis.Sts_InPosition, Axis.Sts_Position, Axis.Sts_Step ...
# ---------------------------------------------------------------------
IAI_SCON_Axis(Axis,UpStack_Inputs,UpStack_Outputs);

# ---------------------------------------------------------------------
# Copy the drive output image back out.
# ---------------------------------------------------------------------
CPS(UpStack_Outputs,IAI_UpStacker:O,1);

# ---------------------------------------------------------------------
# Keep the existing controller-scoped target tag in step with the axis
# so the HMI screens that already point at it keep reading correctly.
# ---------------------------------------------------------------------
MOV(Axis.Sts_Target,UpStack_Target_Position);

# ---------------------------------------------------------------------
# Drive and camera communications faults.
# Broken out of the original rung 0, which mixed the I/O copy, the servo
# permissive, two GSVs and the reset logic into one rung.
# ---------------------------------------------------------------------
GSV(Module,IS3800,FaultCode,HARDWARE_FAULTS[0])NEQ(HARDWARE_FAULTS[0],0)
[XIO(Cognex_Bypass) OTL(Cognex_Com_Fault)
,XIC(Cognex_Bypass) OTU(Cognex_Com_Fault) ];

GSV(Module,IAI_UpStacker,FaultCode,HARDWARE_FAULTS[1])NEQ(HARDWARE_FAULTS[1],0)
OTL(Upstack_Com_Fault);

XIC(Reset_Hold_TMR.DN)
[OTU(Cognex_Com_Fault) ,OTU(Upstack_Com_Fault) ,OTU(Upstack_Jam) ];


@ROUTINE R200_Manual | Manual height control: set, confirm, go. Plus jog.
# =====================================================================
# MANUAL OPERATION
#
# Two-step, so a mistyped height cannot launch a move:
#
#   1. type a height into  Man_Position_Entry   (0.01mm, e.g. 12500 =
#      125.00mm), or type a layer into Man_Layer_Entry and press
#      GO TO LAYER to have the height filled in for you
#   2. press SET       -> the height is range-checked against the travel
#                         limits and armed.  Out of range sets
#                         Man_Rejected and arms nothing.
#   3. press GO        -> the move runs
#   4. Man_Move_Confirmed comes on when the drive confirms arrival
#      (PEND), not when the move was merely started
#
# JOG UP / JOG DN run while held and stop at the software travel limits.
# =====================================================================
# Manual commands are allowed when manual mode is selected, the axis is
# ready, and it is not already busy.
XIC(Man_Mode)XIC(Axis.Sts_Ready)XIO(Axis.Sts_Busy)XIO(Man_Stop_PB)
OTE(Man_Permit);

# Jogging has its own permissive: jogging makes the axis busy, so it
# cannot be gated on "not busy" -- it is gated on not running a
# positioning move instead.
XIC(Man_Mode)XIC(Axis.Sts_Ready)XIO(Man_Move_Active)XIO(Man_Stop_PB)
OTE(Man_Jog_Permit);

# ---------------------------------------------------------------------
# GO TO LAYER helper. Fills in the height for a layer number using the
# same arithmetic the auto sequence uses, so manual and auto agree.
# The operator still has to SET and GO -- this only fills the entry.
# ---------------------------------------------------------------------
XIC(Man_Permit)XIC(Man_GoToLayer_PB)ONS(Man_ONS.2)
GEQ(Man_Layer_Entry,0)LEQ(Man_Layer_Entry,Cfg_Layer_Max)
CPT(Man_Position_Entry,Cfg_UpStack_HighMax_POS-(Man_Layer_Entry*Cfg_UpStack_TrayHeight));

# ---------------------------------------------------------------------
# SET -- range-check and arm.
#
# The original program had no equivalent: an out-of-range target was
# silently dropped by a GEQ/LEQ gate and the machine just sat there.
# Here the operator gets Man_Rejected instead.
# ---------------------------------------------------------------------
XIC(Man_Permit)XIC(Man_Set_PB)ONS(Man_ONS.0)
[GEQ(Man_Position_Entry,Cfg_UpStack_LowMax_POS)
 LEQ(Man_Position_Entry,Cfg_UpStack_HighMax_POS)
 MOV(Man_Position_Entry,Man_Target_Position)
 [OTL(Man_Move_Armed) ,OTU(Man_Rejected) ,OTU(Man_Move_Confirmed) ]
,[LES(Man_Position_Entry,Cfg_UpStack_LowMax_POS)
 ,GRT(Man_Position_Entry,Cfg_UpStack_HighMax_POS) ]
 [OTL(Man_Rejected) ,OTU(Man_Move_Armed) ] ];

# ---------------------------------------------------------------------
# GO -- confirm the armed height and run the move.
# ---------------------------------------------------------------------
XIC(Man_Permit)XIC(Man_Move_Armed)XIC(Man_Go_PB)ONS(Man_ONS.1)
OTE(Man_Move_Cmd);

# ---------------------------------------------------------------------
# Track the armed move through to its confirmation.
# ---------------------------------------------------------------------
[XIC(Man_Move_Cmd) [OTL(Man_Move_Active) ,OTU(Man_Move_Armed) ]
,XIC(Man_Move_Active) XIC(Axis.Sts_MoveDone)
 [OTU(Man_Move_Active) ,OTL(Man_Move_Confirmed) ]
,XIC(Axis.Sts_Fault) [OTU(Man_Move_Active) ,OTU(Man_Move_Armed) ] ];

# ---------------------------------------------------------------------
# JOG, soft-limited.
#
# DIRECTION CHECK ON COMMISSIONING: this assumes extend (JOG+) raises
# the stacker, i.e. increasing position = up, which is consistent with
# the layer arithmetic (layer 0 is the top of travel). If the actuator
# is mounted the other way, swap the two output bits below.
# ---------------------------------------------------------------------
XIC(Man_Jog_Permit)XIC(Man_JogUp_PB)XIO(Man_JogDn_PB)
LES(Axis.Sts_Position,Cfg_UpStack_HighMax_POS)OTE(Man_JogUp);

XIC(Man_Jog_Permit)XIC(Man_JogDn_PB)XIO(Man_JogUp_PB)
GRT(Axis.Sts_Position,Cfg_UpStack_LowMax_POS)OTE(Man_JogDn);


@ROUTINE R300_AutoSequence | Layer height and the auto move request.
# ---------------------------------------------------------------------
# Door open: park at the load position and reset the layer pointer to
# one past the last layer.
#
# The original moved a literal 13 here; that is Cfg_Layer_Max + 1, so it
# is derived now and a tray-count change does not need a logic edit.
# ---------------------------------------------------------------------
XIC(Door_Open_Request)XIO(Man_Mode)ONS(Auto_ONS.0)
[MOV(Cfg_UpStack_LowMax_POS,Auto_Target_Position)
,ADD(Cfg_Layer_Max,1,Upstack_Layer_Current)
,RES(Data_Delay_TMR)
,OTU(UStoR_ReqToMoveLayer) ];

# ---------------------------------------------------------------------
# Height for the current layer. Layer 0 is the top of travel; each layer
# down is one tray height lower.
# ---------------------------------------------------------------------
XIO(Door_Open_Request)XIO(Man_Mode)
CPT(Auto_Target_Position,Cfg_UpStack_HighMax_POS-(Upstack_Layer_Current*Cfg_UpStack_TrayHeight));

# ---------------------------------------------------------------------
# Request a move whenever the layer pointer changes.
#
# This is the same trigger the original used, but the hold timer is
# gone: the axis instruction now edge-detects the request itself and
# confirms arrival with PEND, so the debounce is no longer load-bearing.
# ---------------------------------------------------------------------
XIO(Man_Mode)XIO(Axis.Sts_Busy)XIO(Axis.Sts_Fault)
NEQ(Upstack_Layer_Current,Auto_Layer_Last)ONS(Auto_ONS.1)
[MOV(Upstack_Layer_Current,Auto_Layer_Last) ,OTE(Auto_Move_Cmd) ];

# ---------------------------------------------------------------------
# Counting permission.
#
# CHANGED BEHAVIOUR, deliberately: the original allowed the count to
# advance on "not moving and not starting", which is also true in the
# scan before a move begins. It now requires a confirmed in-position.
# ---------------------------------------------------------------------
XIO(Door_Open_Request)XIC(Axis.Sts_InPosition)XIO(Axis.Sts_Busy)
XIO(UStoR_ReqToMoveLayer)XIO(Upstack_Jam)XIO(Upstack_Complete)
XIC(Data_Delay_TMR.DN)XIO(UStoR_ReqToPick)
OTE(Upstack_Count_Permission);

# ---------------------------------------------------------------------
# Count request: a fresh layer, a finished tray, or the turn table
# needing another part.
# ---------------------------------------------------------------------
[XIO(Turn_Table_Full)
,XIC(New_Layer_Cognex)
,XIC(RtoUS_PickConfirm) EQU(Upstack_Row_Current,Cfg_Row_Max)
 EQU(Upstack_Column_Current,Cfg_Column_Max)
,[XIC(TurnTable_Move_ONS) ,XIC(RtoTT_PickConfirm) ]
 [EQU(TurnTable[1].Seq_Num,0) ,EQU(TurnTable[4].Seq_Num,0) ] ]
OTE(Upstack_Count_Request);

# ---------------------------------------------------------------------
# Walk the tray: next hole, next row, next layer down.
#
# The original gated the completion branch with XIC(WinTest.0) -- a
# scratch tag left in from testing that had to be set by hand for the
# stack ever to report complete. That gate is removed.
# ---------------------------------------------------------------------
XIC(Upstack_Count_Permission)
[XIC(Upstack_Count_Request) ADD(Upstack_Column_Current,1,Upstack_Column_Current)
 LEQ(Upstack_Column_Current,Cfg_Column_Max)
 EQU(Upstack_Layer[Upstack_Layer_Current].Row[Upstack_Row_Current].Column[Upstack_Column_Current].Status,Cfg_Status_Ocupied)
 ADD(1,UStoR_PickSeqNumber,UStoR_PickSeqNumber)
 [OTL(UStoR_ReqToPick) ,OTU(New_Layer_Cognex) ]
,GRT(Upstack_Column_Current,Cfg_Column_Max)
 [ADD(Upstack_Row_Current,1,Upstack_Row_Current) LEQ(Upstack_Row_Current,Cfg_Row_Max)
  MOV(0,Upstack_Column_Current)
 ,GRT(Upstack_Row_Current,Cfg_Row_Max)
  [SUB(Upstack_Layer_Current,1,Upstack_Layer_Current) GEQ(Upstack_Layer_Current,0)
   OTL(UStoR_ReqToMoveLayer)
  ,LEQ(Upstack_Layer_Current,0) OTL(Upstack_Complete) ] ] ];

# ---------------------------------------------------------------------
# Robot has slid the tray over: clear the move-layer request.
# ---------------------------------------------------------------------
XIC(RtoUS_LayerMovedConfirm)ONS(Auto_ONS.5)OTU(UStoR_ReqToMoveLayer);

# ---------------------------------------------------------------------
# Stack complete: ask for the doors, then reload the tray counts from
# the HMI quantities once everything has stopped.
# ---------------------------------------------------------------------
XIO(UStoR_ReqToMoveLayer)XIC(Upstack_Complete)XIO(Axis.Sts_Busy)
XIO(DwnStack_Outputs.Start_Move)XIO(DwnStack_Inputs.Moving)
ONS(Auto_ONS.8)OTL(Door_Open_Request);

XIO(UStoR_ReqToMoveLayer)XIC(Upstack_Complete)
[XIO(Door_Open_Request) ONS(Auto_ONS.9)
,XIC(Upstack_Complete_TMR.EN) XIO(Upstack_Complete_TMR.DN) ]
TON(Upstack_Complete_TMR,?,?)XIC(Upstack_Complete_TMR.DN)
[MOV(UpStack_HMI_Tray_Qty,Upstack_Layer_Last)
,MOV(UpStack_HMI_Tray_Qty,Upstack_Layer_Current)
,MOV(DwnStack_HMI_Tray_Qty,DwnStack_Layer_Last)
,MOV(DwnStack_HMI_Tray_Qty,DwnStack_Layer_Current)
,OTU(Upstack_Complete) ];


@ROUTINE R400_TrayData | Cognex results into the tray array, and the robot handshake.
# =====================================================================
# This is the palletising data layer, carried across from the original
# rungs 4-13 with the same behaviour. It has been split into one rung
# per idea and the magic numbers pulled out into config tags, but the
# sequence itself is unchanged.
# =====================================================================
# Trigger request raised by the down stacker. Arm the camera.
XIC(Trigger_Cognex)
[OTL(IS3800:O.Control.TriggerEnable) ,RES(Data_Delay_TMR) ,OTU(Trigger_Cognex) ];

# Drop the arm once the hold time has expired.
XIC(Cognex_Hold_TMR.DN)OTU(IS3800:O.Control.TriggerEnable);

# ---------------------------------------------------------------------
# Fire the camera, but only with the axis confirmed stopped in position.
# The original tested "not moving and not starting a move"; this now
# waits for the drive's own in-position confirmation.
# ---------------------------------------------------------------------
XIC(Axis.Sts_InPosition)XIO(Axis.Sts_Busy)XIO(UStoR_ReqToMoveLayer)
XIC(IS3800:O.Control.TriggerEnable)TON(Cognex_Hold_TMR,?,?)
GRT(Cognex_Hold_TMR.ACC,500)OTE(IS3800:O.Control.Trigger);

# A new acquisition ID means fresh results: start the fill walk.
XIO(IS3800:O.Control.Trigger)NEQ(IS3800:I.Status.AcquisitionID,Cognex_Acc_ID)
[MOV(IS3800:I.Status.AcquisitionID,Cognex_Acc_ID)
,OTL(UpStack_Status_Fill) ,OTL(UpStack_Fill_Trays) ];

# ---------------------------------------------------------------------
# Once the results have settled: check both trays are actually present
# and reset the pick pointer to the first hole.
# The presence threshold was a literal 50; it is Cfg_TrayScoreMin now.
# ---------------------------------------------------------------------
XIC(Axis.Sts_InPosition)XIO(Axis.Sts_Busy)XIO(UStoR_ReqToMoveLayer)
TON(Data_Delay_TMR,?,?)XIC(Data_Delay_TMR.DN)ONS(ONS.2)
[[LES(IS3800:I.InspectionResults[96],Cfg_TrayScoreMin) NEQ(Upstack_Layer_Current,0)
  OTL(Upstack_Jam)
 ,LES(IS3800:I.InspectionResults[97],Cfg_TrayScoreMin) NEQ(DwnStack_Layer_Current,0)
  OTL(DwnStack_Jam) ]
,MOV(1,Upstack_Row_Current) ,MOV(0,Upstack_Column_Current)
,OTL(New_Layer_Cognex) ,OTU(UStoR_ReqToPick) ];

# ---------------------------------------------------------------------
# Walk every hole in the tray, either clearing it or filling it from the
# camera results.
# ---------------------------------------------------------------------
XIC(UpStack_Status_Fill)
[XIC(UpStack_Empty_Trays)
,XIC(UpStack_Fill_Trays) MOV(Upstack_Layer_Current,UpStack_Layer_Fill) ]
[ADD(UpStack_Column_Fill,1,UpStack_Column_Fill) LEQ(UpStack_Column_Fill,Cfg_Column_Max)
 [XIC(UpStack_Empty_Trays)
  COP(Data_Item_Initialize,Upstack_Layer[UpStack_Layer_Fill].Row[UpStack_Row_Fill].Column[UpStack_Column_Fill],1)
 ,XIC(UpStack_Fill_Trays) OTE(New_Fill_Item) ]
,GRT(UpStack_Column_Fill,Cfg_Column_Max)
 [ADD(UpStack_Row_Fill,1,UpStack_Row_Fill) LEQ(UpStack_Row_Fill,Cfg_Row_Max)
  CLR(UpStack_Column_Fill)
 ,GRT(UpStack_Row_Fill,Cfg_Row_Max)
  [[XIC(UpStack_Empty_Trays) ADD(UpStack_Layer_Fill,1,UpStack_Layer_Fill)
    LEQ(UpStack_Layer_Fill,Cfg_Layer_Max)
   ,XIC(UpStack_Fill_Trays) [OTU(UpStack_Status_Fill) ,OTU(UpStack_Fill_Trays) ] ]
   [CLR(UpStack_Column_Fill) ,MOV(1,UpStack_Row_Fill) ]
  ,XIC(UpStack_Empty_Trays) GRT(UpStack_Layer_Fill,Cfg_Layer_Max)
   OTU(UpStack_Status_Fill)
   [CLR(UpStack_Column_Fill) ,MOV(1,UpStack_Row_Fill) ,MOV(1,UpStack_Layer_Fill) ] ] ] ];

# ---------------------------------------------------------------------
# Where in the camera result block does this hole live?
#
# The original spelled this out as eight hard-coded MOVs (0, 6, 24, 30,
# 48, 54, 72, 78) nested two levels deep, which is why the tray layout
# was effectively frozen at 2 rows x 4 columns. It is a lookup now:
# fill Cfg_Cognex_Offset[row,column] and the layout is data, not logic.
# ---------------------------------------------------------------------
XIC(New_Fill_Item)XIC(UpStack_Fill_Trays)
MOV(Cfg_Cognex_Offset[UpStack_Row_Fill,UpStack_Column_Fill],Cognex_Control_X1);

# ---------------------------------------------------------------------
# Pull X, Y and angle for both inspections into the tray cell, and mark
# the hole occupied or empty from whether the camera found an X at all.
# ---------------------------------------------------------------------
XIC(New_Fill_Item)XIC(UpStack_Fill_Trays)
[CPT(Cognex_Control_X2,Cognex_Control_X1+12)
,CPT(Cognex_Control_Y1,Cognex_Control_X1+1)
,CPT(Cognex_Control_Y2,Cognex_Control_X1+13)
,CPT(Cognex_Control_A1,Cognex_Control_X1+2)
,CPT(Cognex_Control_A2,Cognex_Control_X1+14) ];

XIC(New_Fill_Item)XIC(UpStack_Fill_Trays)
[MOV(IS3800:I.InspectionResults[Cognex_Control_X1],Upstack_Layer[UpStack_Layer_Fill].Row[UpStack_Row_Fill].Column[UpStack_Column_Fill].Orig_X_1)
,MOV(IS3800:I.InspectionResults[Cognex_Control_X2],Upstack_Layer[UpStack_Layer_Fill].Row[UpStack_Row_Fill].Column[UpStack_Column_Fill].Orig_X_2)
,MOV(IS3800:I.InspectionResults[Cognex_Control_Y1],Upstack_Layer[UpStack_Layer_Fill].Row[UpStack_Row_Fill].Column[UpStack_Column_Fill].Orig_Y_1)
,MOV(IS3800:I.InspectionResults[Cognex_Control_Y2],Upstack_Layer[UpStack_Layer_Fill].Row[UpStack_Row_Fill].Column[UpStack_Column_Fill].Orig_Y_2)
,MOV(IS3800:I.InspectionResults[Cognex_Control_A1],Upstack_Layer[UpStack_Layer_Fill].Row[UpStack_Row_Fill].Column[UpStack_Column_Fill].Orig_Angle_1)
,MOV(IS3800:I.InspectionResults[Cognex_Control_A2],Upstack_Layer[UpStack_Layer_Fill].Row[UpStack_Row_Fill].Column[UpStack_Column_Fill].Orig_Angle_2) ];

XIC(New_Fill_Item)XIC(UpStack_Fill_Trays)
[[GRT(IS3800:I.InspectionResults[Cognex_Control_X1],0)
 ,GRT(IS3800:I.InspectionResults[Cognex_Control_X2],0) ]
 MOV(Cfg_Status_Ocupied,Upstack_Layer[UpStack_Layer_Fill].Row[UpStack_Row_Fill].Column[UpStack_Column_Fill].Status)
,EQU(IS3800:I.InspectionResults[Cognex_Control_X1],0)
 EQU(IS3800:I.InspectionResults[Cognex_Control_X2],0)
 COP(Data_Item_Initialize,Upstack_Layer[UpStack_Layer_Fill].Row[UpStack_Row_Fill].Column[UpStack_Column_Fill],1) ];

# Roll the pick sequence number before it runs off the end of Data_Item.
GEQ(UStoR_PickSeqNumber,490)MOV(1,UStoR_PickSeqNumber);

# Hand the robot the location of the part to pick.
XIC(UStoR_ReqToPick)
[MOV(Upstack_Row_Current,UStoR_PickRowNumber)
,MOV(Upstack_Column_Current,UStoR_PickColumnNumber)
,MOV(UStoR_PickSeqNumber,Upstack_Layer[Upstack_Layer_Current].Row[Upstack_Row_Current].Column[Upstack_Column_Current].Seq_Num) ];

# Robot has taken it: move the cell into the tracking record and clear
# the hole.
XIC(RtoUS_PickConfirm)ONS(ONS_STACK.1)
COP(Data_Item_Initialize,Data_Item[UStoR_PickSeqNumber],1)
[COP(Upstack_Layer[Upstack_Layer_Current].Row[Upstack_Row_Current].Column[Upstack_Column_Current],Data_Item[UStoR_PickSeqNumber],1)
,MOV(2,Data_Item[UStoR_PickSeqNumber].Status)
,MOV(Cfg_Status_Complete,Upstack_Layer[Upstack_Layer_Current].Row[Upstack_Row_Current].Column[Upstack_Column_Current].Status) ]
OTU(UStoR_ReqToPick);


@ROUTINE R900_Alarms | Station alarms.
# =====================================================================
# The original was 64 rungs of identical boilerplate, every one of them
# conditioned on PlaceHolderBit, so not a single alarm could ever be
# raised. They are replaced by the real conditions below, using the same
# Station200Upstacker._Fault / ._Warning words the HMI already reads.
# =====================================================================
# Fault 0 -- drive alarm. The alarm code is on Axis.Sts_AlarmCode.
[XIC(Axis.Sts_Fault_Drive)
,XIO(FaultReset) XIC(Station200Upstacker._Fault[0]) ]
OTE(Station200Upstacker._Fault[0]);

# Fault 1 -- the axis did not confirm arrival inside the move timeout.
[XIC(Axis.Sts_Fault_Timeout)
,XIO(FaultReset) XIC(Station200Upstacker._Fault[1]) ]
OTE(Station200Upstacker._Fault[1]);

# Fault 2 -- drive communications.
[XIC(Upstack_Com_Fault)
,XIO(FaultReset) XIC(Station200Upstacker._Fault[2]) ]
OTE(Station200Upstacker._Fault[2]);

# Fault 3 -- camera communications.
[XIC(Cognex_Com_Fault)
,XIO(FaultReset) XIC(Station200Upstacker._Fault[3]) ]
OTE(Station200Upstacker._Fault[3]);

# Fault 4 -- tray not seen where one was expected.
[XIC(Upstack_Jam)
,XIO(FaultReset) XIC(Station200Upstacker._Fault[4]) ]
OTE(Station200Upstacker._Fault[4]);

# Fault 5 -- drive E-stop.
[XIC(Axis.Sts_EStop)
,XIO(FaultReset) XIC(Station200Upstacker._Fault[5]) ]
OTE(Station200Upstacker._Fault[5]);

# Warning 0 -- a commanded height was outside the travel limits and was
# refused. Not a stopping fault; the operator just needs to re-enter it.
[XIC(Axis.Sts_Fault_Range)
,XIO(FaultReset) XIC(Station200Upstacker._Warning[0]) ]
OTE(Station200Upstacker._Warning[0]);

# Warning 1 -- the axis is not homed.
[XIO(Axis.Sts_Homed) XIC(Axis.Sts_ServoOn)
,XIO(FaultReset) XIC(Station200Upstacker._Warning[1]) ]
OTE(Station200Upstacker._Warning[1]);

# Warning 2 -- manual mode is selected, so the auto sequence is parked.
XIC(Man_Mode)OTE(Station200Upstacker._Warning[2]);

# Roll-up bits the rest of the machine reads.
[XIC(Station200Upstacker._Fault[0]) ,XIC(Station200Upstacker._Fault[1])
,XIC(Station200Upstacker._Fault[2]) ,XIC(Station200Upstacker._Fault[3])
,XIC(Station200Upstacker._Fault[4]) ,XIC(Station200Upstacker._Fault[5]) ]
OTE(Station200Upstacker._Active_Fault);

[XIC(Station200Upstacker._Warning[0]) ,XIC(Station200Upstacker._Warning[1])
,XIC(Station200Upstacker._Warning[2]) ]
OTE(Station200Upstacker._Active_Warning);
