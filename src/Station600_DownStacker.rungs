# =====================================================================
# Program090000_Station600_DownStacker  --  down stacker axis
#
# Barebones. Two routines, six rungs: read the drive, turn the servo on,
# hand the move to IAI's instructions, write the drive.
#
# TO MOVE THE ACTUATOR
#     set    DnAxis_Target         where to go, in 0.01mm (12500 = 125.00mm)
#     pulse  DnAxis_Cmd_StartMove  SCON_Moves takes the rising edge
#
#     watch  DnAxis_Position          where it actually is, 0.01mm
#            DnAxis_Moving            running
#            DnAxis_PositionComplete  arrived  <-- the confirmation
#            DnAxis_AlarmActive       faulted, code in DnAxis_AlarmCode
#
# The three SCON_* instructions are IAI's own, imported unmodified.
# SCON_Moves owns the START handshake: it latches START with the move
# data on the rising edge and drops it when the drive acknowledges.
#
# Speed, accel and decel come from the existing controller tags
# DwnStack_Target_Speed, DwnStack_Output_Acceleration and DwnStack_Output_Deceleration.
# =====================================================================


@ROUTINE R000_Main | Main.
JSR(R100_Axis,0);


@ROUTINE R100_Axis | The whole axis. Six rungs.
# ---------------------------------------------------------------------
# 1. Read the drive, and unpack it into the DnAxis_ status tags.
# ---------------------------------------------------------------------
CPS(IAI_DwnStacker:I,DwnStack_Inputs,1);

SCON_Status(DnAxis_Sts,DnAxis_Position,DnAxis_Speed,DnAxis_AlarmActive,DnAxis_AlarmCode,DnAxis_BatteryAlarm,DnAxis_CommandCurrent,DnAxis_HomeComplete,DnAxis_Homing,DnAxis_EStop,DnAxis_InPushZone,DnAxis_InPZone,DnAxis_InZone1,DnAxis_InZone2,DnAxis_LoadReached,DnAxis_DriveManualMode,DnAxis_Moving,DnAxis_PositionComplete,DnAxis_PushFailed,DnAxis_DriveReady,DnAxis_ServoOn,DnAxis_TorqueReached,DnAxis_TotalMoveCount,DnAxis_TotalMoveDistance,DwnStack_Inputs);

# ---------------------------------------------------------------------
# 2. Servo permissive and the motor power contactor (CR615).
#    Unlocking the doors drops the servo, so nothing can move with the
#    doors open. This is the existing machine interlock, kept as it was.
# ---------------------------------------------------------------------
XIC(POWER_OK_24VB)XIO(Unlock_Doors)
[OTE(DnAxis_Cmd_ServoOn) ,OTE(CR615) ];

# ---------------------------------------------------------------------
# 3. Hand the commands to IAI's instructions.
#
#    Pulse DnAxis_Cmd_StartMove to run a move to DnAxis_Target.
#    DnAxis_Cmd_JogFwd / DnAxis_Cmd_JogRev jog while held.
#    DnAxis_Cmd_Home homes on a rising edge.
# ---------------------------------------------------------------------
SCON_Operations(DnAxis_Ops,DnAxis_Cmd_ServoOn,DnAxis_Cmd_Pause,DnAxis_Cmd_Inch,DnAxis_Cmd_JogFwd,DnAxis_Cmd_JogRev,DnAxis_Cmd_Reset,DnAxis_Cmd_BrakeRelease,DwnStack_Outputs);

SCON_Moves(DnAxis_Mov,DnAxis_Cmd_Home,DnAxis_Cmd_StartMove,DnAxis_Target,DwnStack_Target_Speed,DwnStack_Output_Acceleration,DwnStack_Output_Deceleration,DnAxis_Band,DnAxis_Increment_Select,DnAxis_Push_Select,DnAxis_Push_Direction,DnAxis_Push_Percent,DnAxis_Load_Threshold,DnAxis_PZone_Upper,DnAxis_PZone_Lower,DwnStack_Inputs,DwnStack_Outputs);

# ---------------------------------------------------------------------
# 4. Write the drive.
# ---------------------------------------------------------------------
CPS(DwnStack_Outputs,IAI_DwnStacker:O,1);
