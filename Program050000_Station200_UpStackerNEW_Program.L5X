<Routines>
<Routine Name="R000_Main" Type="RLL">
<Description>
<![CDATA[Main.]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[JSR(R100_Axis,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R100_Axis" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[CPS(IAI_UpStacker:I,UpStack_Inputs,1);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[SCON_Status(UpAxis_Sts,UpAxis_Position,UpAxis_Speed,UpAxis_AlarmActive,UpAxis_AlarmCode,UpAxis_BatteryAlarm,UpAxis_CommandCurrent,UpAxis_HomeComplete,UpAxis_Homing,UpAxis_EStop,UpAxis_InPushZone,UpAxis_InPZone,UpAxis_InZone1,UpAxis_InZone2,UpAxis_LoadReached,UpAxis_DriveManualMode,UpAxis_Moving,UpAxis_PositionComplete,UpAxis_PushFailed,UpAxis_DriveReady,UpAxis_ServoOn,UpAxis_TorqueReached,UpAxis_TotalMoveCount,UpAxis_TotalMoveDistance,UpStack_Inputs);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(POWER_OK_24VB)XIO(Unlock_Doors)[OTE(UpAxis_Cmd_ServoOn) ,OTE(CR614) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[SCON_Operations(UpAxis_Ops,UpAxis_Cmd_ServoOn,UpAxis_Cmd_Pause,UpAxis_Cmd_Inch,UpAxis_Cmd_JogFwd,UpAxis_Cmd_JogRev,UpAxis_Cmd_Reset,UpAxis_Cmd_BrakeRelease,UpStack_Outputs);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[SCON_Moves(UpAxis_Mov,UpAxis_Cmd_Home,UpAxis_Cmd_StartMove,UpAxis_Target,UpStack_Target_Speed,UpStack_Output_Acceleration,UpStack_Output_Deceleration,UpAxis_Band,UpAxis_Increment_Select,UpAxis_Push_Select,UpAxis_Push_Direction,UpAxis_Push_Percent,UpAxis_Load_Threshold,UpAxis_PZone_Upper,UpAxis_PZone_Lower,UpStack_Inputs,UpStack_Outputs);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Write the Outputs
]]>
</Comment>
<Text>
<![CDATA[CPS(UpStack_Outputs,IAI_UpStacker:O,1);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(UpAxis_ServoOn)XIC(UpAxis_DriveReady)XIC(UpAxis_HomeComplete)XIO(UpAxis_AlarmActive)XIO(UpAxis_EStop)OTE(UpAxis_ReadyToMove);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[LIM(1,UpAxis_LayerRequest,13)MOV(UpAxis_LayerRequest,UpAxis_LayerTarget);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[[XIC(UpAxis_IncrementLayer) XIO(UpAxis_DecrementLayer) LES(UpAxis_CurrentLayer,13) ADD(UpAxis_CurrentLayer,1,UpAxis_LayerTarget) ,XIC(UpAxis_DecrementLayer) XIO(UpAxis_IncrementLayer) GRT(UpAxis_CurrentLayer,1) SUB(UpAxis_CurrentLayer,1,UpAxis_LayerTarget) ]OTE(UpAxis_MoveToLayerTarget);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[GEQ(UpAxis_CurrentLayer,11)OTU(UpAxis_IncrementLayer);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[LEQ(UpAxis_CurrentLayer,1)OTU(UpAxis_DecrementLayer);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Move to layer
]]>
</Comment>
<Text>
<![CDATA[[[XIC(UpAxis_MoveToLayerTarget) ,NEQ(UpAxis_LayerTarget,UpAxis_CurrentLayer) ] ,XIC(UpAxis_Cmd_StartMove) XIO(UpAxis_PositionComplete) ]XIO(UpAxis_Moving)XIC(UpAxis_ReadyToMove)XIO(UpAxis_MoveFailedTON.DN)[ONS(LayerMoveONS) ,]MOV(UpAxis_Positions[UpAxis_LayerTarget],UpAxis_Target)[OTE(UpAxis_Cmd_StartMove) ,TON(UpAxis_MoveFailedTON,?,?) ,OTU(UpAxis_IncrementLayer) OTU(UpAxis_DecrementLayer) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Confirm position move successful, update current position

]]>
</Comment>
<Text>
<![CDATA[[XIC(UpAxis_PositionComplete) ONS(PositionCompleteONS) ,XIC(UpdateCurrentPosition) ][ADD(UpAxis_Positions[1],PosLim,UpAxis_PositionsPosLim[1]) SUB(UpAxis_Positions[1],NegLim,UpAxis_PositionsNegLim[1]) LIM(UpAxis_PositionsNegLim[1],UpAxis_Position,UpAxis_PositionsPosLim[1]) MOV(1,UpAxis_CurrentLayer) ,ADD(UpAxis_Positions[2],PosLim,UpAxis_PositionsPosLim[2]) SUB(UpAxis_Positions[2],NegLim,UpAxis_PositionsNegLim[2]) LIM(UpAxis_PositionsNegLim[2],UpAxis_Position,UpAxis_PositionsPosLim[2]) MOV(2,UpAxis_CurrentLayer) ,ADD(UpAxis_Positions[3],PosLim,UpAxis_PositionsPosLim[3]) SUB(UpAxis_Positions[3],NegLim,UpAxis_PositionsNegLim[3]) LIM(UpAxis_PositionsNegLim[3],UpAxis_Position,UpAxis_PositionsPosLim[3]) MOV(3,UpAxis_CurrentLayer) ,ADD(UpAxis_Positions[4],PosLim,UpAxis_PositionsPosLim[4]) SUB(UpAxis_Positions[4],NegLim,UpAxis_PositionsNegLim[4]) LIM(UpAxis_PositionsNegLim[4],UpAxis_Position,UpAxis_PositionsPosLim[4]) MOV(4,UpAxis_CurrentLayer) ,ADD(UpAxis_Positions[5],PosLim,UpAxis_PositionsPosLim[5]) SUB(UpAxis_Positions[5],NegLim,UpAxis_PositionsNegLim[5]) LIM(UpAxis_PositionsNegLim[5],UpAxis_Position,UpAxis_PositionsPosLim[5]) MOV(5,UpAxis_CurrentLayer) ,ADD(UpAxis_Positions[6],PosLim,UpAxis_PositionsPosLim[6]) SUB(UpAxis_Positions[6],NegLim,UpAxis_PositionsNegLim[6]) LIM(UpAxis_PositionsNegLim[6],UpAxis_Position,UpAxis_PositionsPosLim[6]) MOV(6,UpAxis_CurrentLayer) ,ADD(UpAxis_Positions[7],PosLim,UpAxis_PositionsPosLim[7]) SUB(UpAxis_Positions[7],NegLim,UpAxis_PositionsNegLim[7]) LIM(UpAxis_PositionsNegLim[7],UpAxis_Position,UpAxis_PositionsPosLim[7]) MOV(7,UpAxis_CurrentLayer) ,ADD(UpAxis_Positions[8],PosLim,UpAxis_PositionsPosLim[8]) SUB(UpAxis_Positions[8],NegLim,UpAxis_PositionsNegLim[8]) LIM(UpAxis_PositionsNegLim[8],UpAxis_Position,UpAxis_PositionsPosLim[8]) MOV(8,UpAxis_CurrentLayer) ,ADD(UpAxis_Positions[9],PosLim,UpAxis_PositionsPosLim[9]) SUB(UpAxis_Positions[9],NegLim,UpAxis_PositionsNegLim[9]) LIM(UpAxis_PositionsNegLim[9],UpAxis_Position,UpAxis_PositionsPosLim[9]) MOV(9,UpAxis_CurrentLayer) ,ADD(UpAxis_Positions[10],PosLim,UpAxis_PositionsPosLim[10]) SUB(UpAxis_Positions[10],NegLim,UpAxis_PositionsNegLim[10]) LIM(UpAxis_PositionsNegLim[10],UpAxis_Position,UpAxis_PositionsPosLim[10]) MOV(10,UpAxis_CurrentLayer) ,ADD(UpAxis_Positions[11],PosLim,UpAxis_PositionsPosLim[11]) SUB(UpAxis_Positions[11],NegLim,UpAxis_PositionsNegLim[11]) LIM(UpAxis_PositionsNegLim[11],UpAxis_Position,UpAxis_PositionsPosLim[11]) MOV(11,UpAxis_CurrentLayer) ,ADD(UpAxis_Positions[12],PosLim,UpAxis_PositionsPosLim[12]) SUB(UpAxis_Positions[12],NegLim,UpAxis_PositionsNegLim[12]) LIM(UpAxis_PositionsNegLim[12],UpAxis_Position,UpAxis_PositionsPosLim[12]) MOV(12,UpAxis_CurrentLayer) ,ADD(UpAxis_Positions[13],PosLim,UpAxis_PositionsPosLim[13]) SUB(UpAxis_Positions[13],NegLim,UpAxis_PositionsNegLim[13]) LIM(UpAxis_PositionsNegLim[13],UpAxis_Position,UpAxis_PositionsPosLim[13]) MOV(13,UpAxis_CurrentLayer) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R200_Tray_Positions_and_Data" Type="RLL">
<Description>
<![CDATA[Data and memory for parts on the trays]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Reset memory after picking
]]>
</Comment>
<Text>
<![CDATA[XIC(RobotPickComplete)[OTU(UpAxis_Memory[UpAxis_CurrentLayer].[UpAxis_NextValidPos]) ,ONS(CheckNextPosONS) OTE(CheckNextPos) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Find next valid position
]]>
</Comment>
<Text>
<![CDATA[XIC(CheckNextPos)[XIC(UpAxis_Memory[UpAxis_CurrentLayer].0) MOV(0,UpAxis_NextValidPos) ,XIO(UpAxis_Memory[UpAxis_CurrentLayer].0) XIC(UpAxis_Memory[UpAxis_CurrentLayer].1) MOV(1,UpAxis_NextValidPos) ,XIO(UpAxis_Memory[UpAxis_CurrentLayer].0) XIO(UpAxis_Memory[UpAxis_CurrentLayer].1) XIC(UpAxis_Memory[UpAxis_CurrentLayer].2) MOV(2,UpAxis_NextValidPos) ,XIO(UpAxis_Memory[UpAxis_CurrentLayer].0) XIO(UpAxis_Memory[UpAxis_CurrentLayer].1) XIO(UpAxis_Memory[UpAxis_CurrentLayer].2) XIC(UpAxis_Memory[UpAxis_CurrentLayer].3) MOV(3,UpAxis_NextValidPos) ,XIO(UpAxis_Memory[UpAxis_CurrentLayer].0) XIO(UpAxis_Memory[UpAxis_CurrentLayer].1) XIO(UpAxis_Memory[UpAxis_CurrentLayer].2) XIO(UpAxis_Memory[UpAxis_CurrentLayer].3) XIC(UpAxis_Memory[UpAxis_CurrentLayer].4) MOV(4,UpAxis_NextValidPos) ,XIO(UpAxis_Memory[UpAxis_CurrentLayer].0) XIO(UpAxis_Memory[UpAxis_CurrentLayer].1) XIO(UpAxis_Memory[UpAxis_CurrentLayer].2) XIO(UpAxis_Memory[UpAxis_CurrentLayer].3) XIO(UpAxis_Memory[UpAxis_CurrentLayer].4) XIC(UpAxis_Memory[UpAxis_CurrentLayer].5) MOV(5,UpAxis_NextValidPos) ,XIO(UpAxis_Memory[UpAxis_CurrentLayer].0) XIO(UpAxis_Memory[UpAxis_CurrentLayer].1) XIO(UpAxis_Memory[UpAxis_CurrentLayer].2) XIO(UpAxis_Memory[UpAxis_CurrentLayer].3) XIO(UpAxis_Memory[UpAxis_CurrentLayer].4) XIO(UpAxis_Memory[UpAxis_CurrentLayer].5) XIC(UpAxis_Memory[UpAxis_CurrentLayer].6) MOV(6,UpAxis_NextValidPos) ,XIO(UpAxis_Memory[UpAxis_CurrentLayer].0) XIO(UpAxis_Memory[UpAxis_CurrentLayer].1) XIO(UpAxis_Memory[UpAxis_CurrentLayer].2) XIO(UpAxis_Memory[UpAxis_CurrentLayer].3) XIO(UpAxis_Memory[UpAxis_CurrentLayer].4) XIO(UpAxis_Memory[UpAxis_CurrentLayer].5) XIO(UpAxis_Memory[UpAxis_CurrentLayer].6) XIC(UpAxis_Memory[UpAxis_CurrentLayer].7) MOV(7,UpAxis_NextValidPos) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIO(UpAxis_Memory[UpAxis_CurrentLayer].0)XIO(UpAxis_Memory[UpAxis_CurrentLayer].1)XIO(UpAxis_Memory[UpAxis_CurrentLayer].2)XIO(UpAxis_Memory[UpAxis_CurrentLayer].3)XIO(UpAxis_Memory[UpAxis_CurrentLayer].4)XIO(UpAxis_Memory[UpAxis_CurrentLayer].5)XIO(UpAxis_Memory[UpAxis_CurrentLayer].6)XIO(UpAxis_Memory[UpAxis_CurrentLayer].7)OTE(RequestLayerShift);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Send Position + global offset to Robot
]]>
</Comment>
<Text>
<![CDATA[XIC(RobotPickStart)ADD(UpAxis_PickPos[UpAxis_NextValidPos].x,UpAxis_RobotOffset.x,UpAxis_CurrentPos.x)ADD(UpAxis_PickPos[UpAxis_NextValidPos].y,UpAxis_RobotOffset.y,UpAxis_CurrentPos.y)ADD(UpAxis_PickPos[UpAxis_NextValidPos].r,UpAxis_RobotOffset.r,UpAxis_CurrentPos.r);]]>
</Text>
</Rung>
<Rung Number="4" Type="e">
<Text>
<![CDATA[FOR(R201_Data_Fill_Loop,UpAxis_Memory[0],?,?,?);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R201_Data_Fill_Loop" Type="RLL"/>
<Routine Name="R202_Data_Clear_Loop" Type="RLL"/>
</Routines>
</Program>
</Programs>
</Controller>
</RSLogix5000Content>
