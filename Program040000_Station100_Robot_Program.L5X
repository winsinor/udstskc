<Rung Number="64" Type="N">
<Text>
<![CDATA[[XIC(Station100Robot._Warning[0]) ,XIC(Station100Robot._Warning[1]) ,XIC(Station100Robot._Warning[2]) ,XIC(Station100Robot._Warning[3]) ,XIC(Station100Robot._Warning[4]) ,XIC(Station100Robot._Warning[5]) ,XIC(Station100Robot._Warning[6]) ,XIC(Station100Robot._Warning[7]) ,XIC(Station100Robot._Warning[8]) ,XIC(Station100Robot._Warning[9]) ,XIC(Station100Robot._Warning[10]) ,XIC(Station100Robot._Warning[11]) ,XIC(Station100Robot._Warning[12]) ,XIC(Station100Robot._Warning[13]) ,XIC(Station100Robot._Warning[14]) ,XIC(Station100Robot._Warning[15]) ,XIC(Station100Robot._Warning[16]) ,XIC(Station100Robot._Warning[17]) ,XIC(Station100Robot._Warning[18]) ,XIC(Station100Robot._Warning[19]) ,XIC(Station100Robot._Warning[20]) ,XIC(Station100Robot._Warning[21]) ,XIC(Station100Robot._Warning[22]) ,XIC(Station100Robot._Warning[23]) ,XIC(Station100Robot._Warning[24]) ,XIC(Station100Robot._Warning[25]) ,XIC(Station100Robot._Warning[26]) ,XIC(Station100Robot._Warning[27]) ,XIC(Station100Robot._Warning[28]) ,XIC(Station100Robot._Warning[29]) ,XIC(Station100Robot._Warning[30]) ,XIC(Station100Robot._Warning[31]) ]OTE(Station100Robot._Active_Warning);]]>
</Text>
