<Routine Name="Routine040600_Robot_Startup" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[[LES(PLCtoR_MoveAccel,10) MOV(10,PLCtoR_MoveAccel) ,GRT(PLCtoR_MoveAccel,100) MOV(100,PLCtoR_MoveAccel) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[XIC(StartRobotCycle) ,XIC(System_InCycle) XIC(RtoPLC_InAuto) XIO(RtoPLC_Started) ][XIO(StartRobotCycleRepeatTimer1[1].DN) [TON(StartRobotCycleRepeatTimer1[0],?,?) ,XIC(StartRobotCycleRepeatTimer1[0].DN) [TON(StartRobotCycleRepeatTimer1[1],?,?) ,CTU(StartRobotCycleRepeatCounter,?,?) ,OTE(PLCtoR_Start) ] ] ,XIC(StartRobotCycleRepeatCounter.DN) RES(StartRobotCycleRepeatCounter) OTU(StartRobotCycle) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(RtoPLC_Started)OTU(PLCtoR_ExtStart);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(PLCtoR_MoveEnable)OTE(PLCtoR_DrivesOff);]]>
</Text>
</Rung>
