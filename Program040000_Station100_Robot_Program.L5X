</Routine>
<Routine Name="_01_Robot_Comms" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[PLC <-> Robot 
Communication
]]>
</Comment>
<Text>
<![CDATA[COP(Robot_Cmd_RoutineID,Station100_Robot:O.Data[64],4);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[COP(Station100_Robot:I.Data[52],Robot_Sts_State,1)COP(Station100_Robot:I.Data[56],Robot_Sts_RoutineID,1);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Robot position workspace monitoring
]]>
</Comment>
<Text>
<![CDATA[COP(Station100_Robot:I.Data[64],Robot_Workspace_Loc,1);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="_02_Robot_Faults" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[*****************************************************
Robot System Fault Present
*****************************************************]]>
</Comment>
<Text>
<![CDATA[NEQ(Robot_Alarms,0)OTE(Robot_Fault_Present);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[RESETS ALARM FILE [0] FAULTS]]>
</Comment>
<Text>
<![CDATA[XIC(GlobalAck_TOF.TT)CLR(Robot_Alarms);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Robot NOT IN Auto (EXT mode)]]>
</Comment>
<Text>
<![CDATA[XIC(System_InCycle)XIO(RtoPLC_InAuto)XIO(System_CycleStop_Requested)[TON(Robot_Alarm_Delay[0],?,?) ,XIC(Robot_Alarm_Delay[0].DN) OTL(Robot_Alarms.0) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(Robot_Alarms.0)ALMD(ROBOT_ALMD_00,HMI_FaultAck_All,HMI_FaultReset_All,0,0);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Robot Drives NOT ON]]>
</Comment>
<Text>
<![CDATA[XIC(POWER_OK_24VC)XIC(RtoPLC_InAuto)XIC(PLCtoR_Start)XIO(PLCtoR_DrivesOn)[TON(Robot_Alarm_Delay[1],?,?) ,XIC(Robot_Alarm_Delay[1].DN) OTL(Robot_Alarms.1) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(Robot_Alarms.1)ALMD(ROBOT_ALMD_01,HMI_FaultAck_All,HMI_FaultReset_All,0,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="_03_RobotSequencer_OLD" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[ROBOT COMMAND HANDSHAKE: the only logic that writes Robot_Cmd_RoutineID. The sequencer below talks to it through Cmd_Request / Cmd_Done only.]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(Good_Part_Pick_From_IMM)XIC(Bad_Part_Pick_From_IMM)XIC(Place_In_IMM)XIO(amp_Test_Bits.6)XIC(RejectBlankRequest)XIC(RejectFinishedRequest)XIC(RejectBothSidesRequest)NOP();]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[IMM SIM
]]>
</Comment>
<Text>
<![CDATA[AFI()XIC(Good_Part_Pick_From_IMM)ONS(goodONS)OTU(Bad_Part_Pick_From_IMM)OTU(Place_In_IMM);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[IMM SIM
]]>
</Comment>
<Text>
<![CDATA[AFI()XIC(Bad_Part_Pick_From_IMM)ONS(badONS)OTU(Good_Part_Pick_From_IMM)OTU(Place_In_IMM);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[AFI()XIC(Place_In_IMM)ONS(placeONS)OTU(Good_Part_Pick_From_IMM)OTU(Bad_Part_Pick_From_IMM);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(SimulateIMM)[XIC(RtoPLC_ToolBlnkMrked) ,XIC(amp_Test_Bits.13) ]XIO(Bad_Part_Pick_From_IMM)AFI()OTU(Good_Part_Pick_From_IMM);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[tie HMI reset into robot reset and sequence reset
]]>
</Comment>
<Text>
<![CDATA[XIC(HMI_Reset)OTE(Seq_Reset);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[tie AutoMode into robot sequence run
]]>
</Comment>
<Text>
<![CDATA[XIC(System_AutoMode)XIC(System_InCycle)XIC(amp_Test_Bits.22)XIO(System_CycleStop_Requested)OTE(Seq_Run);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(System_AutoMode)XIC(System_CycleStop_Requested)XIC(Robot_Parked)EQU(HS_Step,0)EQU(Cmd_Request,0)MOV(10,Cmd_Request);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[EQU(HS_Step,30)EQU(Cmd_Request,10)OTL(Robot_Parked);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[EQU(HS_Step,10)NEQ(Cmd_Request,10)OTU(Robot_Parked);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[[XIC(RtoPLC_RobotReachedStop) XIC(Robot_Parked) EQU(HS_Step,0) ,EQU(HS_Step,90) ]OTE(Robot_Stopped);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[[EQU(Robot_Sts_State,0) ,EQU(HS_Step,90) ]XIC(WinComeBack)OTE(RobotAutoSequenceFault);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Robot must be idle before a new command goes out.]]>
</Comment>
<Text>
<![CDATA[EQU(HS_Step,0)NEQ(Cmd_Request,0)EQU(Robot_Sts_State,0)MOV(Cmd_Request,Robot_Cmd_RoutineID)MOV(10,HS_Step);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[Accept routine timer set to 5 sec
]]>
</Comment>
<Text>
<![CDATA[EQU(HS_Step,10)TON(HS_AcceptTmr,?,?);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[Robot accepted the command and is running it.]]>
</Comment>
<Text>
<![CDATA[EQU(HS_Step,10)EQU(Robot_Sts_State,1)EQU(Robot_Sts_RoutineID,Cmd_Request)MOV(20,HS_Step);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[Robot never accepted.
Main is not selected or
not in external auto (EXT)
or drives are off
check pendant!
]]>
</Comment>
<Text>
<![CDATA[EQU(HS_Step,10)XIC(HS_AcceptTmr.DN)MOV(90,HS_Step);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[Run timer]]>
</Comment>
<Text>
<![CDATA[EQU(HS_Step,20)TON(HS_RunTmr,?,?);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[Routine complete]]>
</Comment>
<Text>
<![CDATA[EQU(HS_Step,20)EQU(Robot_Sts_State,2)MOV(30,HS_Step);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[Robot faulted, should rehome itself (hopefully)
]]>
</Comment>
<Text>
<![CDATA[EQU(HS_Step,20)EQU(Robot_Sts_State,3)MOV(90,HS_Step);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[Routine stuck or ran too long
]]>
</Comment>
<Text>
<![CDATA[EQU(HS_Step,20)XIC(HS_RunTmr.DN)MOV(90,HS_Step);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[Release. The robot holds state 2 or 3 until the command goes to 0.]]>
</Comment>
<Text>
<![CDATA[EQU(HS_Step,30)MOV(0,Robot_Cmd_RoutineID);]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Comment>
<![CDATA[Routine COmplete
]]>
</Comment>
<Text>
<![CDATA[EQU(HS_Step,30)EQU(Robot_Sts_State,0)OTE(Cmd_Done)MOV(0,Cmd_Request)MOV(0,HS_Step);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Comment>
<![CDATA[Faulted. Hold here until Seq_Reset]]>
</Comment>
<Text>
<![CDATA[EQU(HS_Step,90)MOV(0,Robot_Cmd_RoutineID);]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Comment>
<![CDATA[ROUTINES: Rearrange to set priority
]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Comment>
<![CDATA[0: Idle
]]>
</Comment>
<Text>
<![CDATA[XIC(Seq_Reset)MOV(0,HS_Step)MOV(0,Cmd_Request)MOV(0,Robot_Cmd_RoutineID);]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Comment>
<![CDATA[71: Reject Blank
]]>
</Comment>
<Text>
<![CDATA[XIC(Seq_Run)EQU(HS_Step,0)EQU(Cmd_Request,0)XIC(RejectBlankRequest)MOV(71,Cmd_Request);]]>
</Text>
</Rung>
<Rung Number="27" Type="N">
<Comment>
<![CDATA[72: Reject Finished Side
]]>
</Comment>
<Text>
<![CDATA[XIC(Seq_Run)EQU(HS_Step,0)EQU(Cmd_Request,0)XIC(RejectFinishedRequest)MOV(72,Cmd_Request);]]>
</Text>
</Rung>
<Rung Number="28" Type="N">
<Comment>
<![CDATA[73: Reject both Blank and Finished Side

]]>
</Comment>
<Text>
<![CDATA[XIC(Seq_Run)EQU(HS_Step,0)EQU(Cmd_Request,0)XIC(RejectBothSidesRequest)MOV(73,Cmd_Request);]]>
</Text>
</Rung>
<Rung Number="29" Type="N">
<Comment>
<![CDATA[60: Downstacker / Drop Finished Parts in Chute
]]>
</Comment>
<Text>
<![CDATA[XIC(Seq_Run)EQU(HS_Step,0)EQU(Cmd_Request,0)XIC(RtoPLC_ToolFinHasParts)XIC(SprueCutDone)[XIC(DStoR_DropInShoot) ,XIC(DStoR_PlaceInTray) ]MOV(60,Cmd_Request);]]>
</Text>
</Rung>
<Rung Number="30" Type="N">
<Comment>
<![CDATA[50: Sprue Cut
]]>
</Comment>
<Text>
<![CDATA[XIC(Seq_Run)EQU(HS_Step,0)EQU(Cmd_Request,0)XIC(RtoPLC_ToolFinHasParts)XIO(SprueCutDone)MOV(50,Cmd_Request);]]>
</Text>
</Rung>
<Rung Number="31" Type="N">
<Comment>
<![CDATA[Replace the below cmd 40 line wth this one to interface with the actual IMM
]]>
</Comment>
<Text>
<![CDATA[[AFI() ,XIC(amp_Test_Bits.8) ]XIC(Seq_Run)EQU(HS_Step,0)EQU(Cmd_Request,0)XIC(IMMtoR_MoldOpen)XIC(IMMtoR_OpEnable)XIC(IMMtoR_EjectPosBck)[XIC(IMMtoR_PartInjected) XIO(RtoPLC_ToolFinHasParts) ,XIO(IMMtoR_PartInjected) XIC(RtoPLC_ToolBlnkMrked) ]MOV(40,Cmd_Request);]]>
</Text>
</Rung>
<Rung Number="32" Type="N">
<Comment>
<![CDATA[40: IMM (Do not split pick/place)
]]>
</Comment>
<Text>
<![CDATA[XIC(Seq_Run)EQU(HS_Step,0)EQU(Cmd_Request,0)[[XIC(Good_Part_Pick_From_IMM) ,XIC(Bad_Part_Pick_From_IMM) ] XIO(RtoPLC_ToolFinHasParts) [XIC(IMMtoR_PartInjected) ,XIC(Win_Test.20) ] ,XIC(Place_In_IMM) XIC(RtoPLC_ToolBlnkMrked) XIO(IMMtoR_PartInjected) ][XIO(RtoPLC_ToolBlnkMrked) XIO(TTtoR_ReqToPickGood) XIO(TTtoR_ReqToPickBad) ,XIC(RtoPLC_ToolBlnkMrked) ]XIC(IMMtoR_MoldOpen)XIC(IMMtoR_OpEnable)MOV(40,Cmd_Request);]]>
</Text>
</Rung>
<Rung Number="33" Type="N">
<Comment>
<![CDATA[30: LaserMarker (still need to split up pick/place)
]]>
</Comment>
<Text>
<![CDATA[XIC(Seq_Run)EQU(HS_Step,0)EQU(Cmd_Request,0)XIC(TTtoR_ReqToPlace)XIC(RtoPLC_ToolBlnkHasParts)XIO(RtoPLC_ToolBlnkMrked)MOV(30,Cmd_Request);]]>
</Text>
</Rung>
<Rung Number="34" Type="N">
<Comment>
<![CDATA[30: LaserMarker (still need to split up pick/place)
]]>
</Comment>
<Text>
<![CDATA[XIC(Seq_Run)EQU(HS_Step,0)EQU(Cmd_Request,0)[XIC(TTtoR_ReqToPickGood) ,XIC(TTtoR_ReqToPickBad) ]MOV(30,Cmd_Request);]]>
</Text>
</Rung>
<Rung Number="35" Type="N">
<Comment>
<![CDATA[20: UpStacker (Pick / Slide Request)

]]>
</Comment>
<Text>
<![CDATA[XIC(Seq_Run)EQU(HS_Step,0)EQU(Cmd_Request,0)[XIC(UStoR_ReqToMoveLayer) ,XIC(UStoR_ReqToPick) XIO(RtoPLC_ToolBlnkHasParts) ]MOV(20,Cmd_Request);]]>
</Text>
</Rung>
<Rung Number="36" Type="N">
<Text>
<![CDATA[EQU(HS_Step,30)EQU(Robot_Sts_RoutineID,50)OTL(SprueCutDone);]]>
</Text>
</Rung>
<Rung Number="37" Type="N">
<Text>
<![CDATA[[EQU(HS_Step,30) EQU(Robot_Sts_RoutineID,60) ,XIO(RtoPLC_ToolFinHasParts) ]OTU(SprueCutDone);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="_03_Robot_Outputs" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Robot Output mapping]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(Robot_Workspace_Loc.0)OTE(RobotAtLaser);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(Robot_Workspace_Loc.1)OTE(RobotAtStacker);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(Robot_Workspace_Loc.2)OTE(RobotAtIMM);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(System_AutoMode)XIC(Robot_Unload_Good_Part_Req)ONS(Robot_Auto.ONS_Dint.2)OTL(TTtoR_ReqToPickGood);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(System_AutoMode)XIC(Robot_Unload_Bad_Part_Req)OTL(TTtoR_ReqToPickBad);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(System_AutoMode)XIC(Robot_LoadUnload_IMM_Parts)ONS(Robot_Auto.ONS_Dint.1)NOP();]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(System_AutoMode)[XIC(Robot_Load_New_Part_Req) ONS(Robot_Auto.ONS_Dint.0) OTL(TTtoR_ReqToPlace) ,XIC(TTtoR_ReqToPlace) XIC(Index_Table_Part_Data[1].Inside_Part_Data_Present) XIC(Index_Table_Part_Data[1].Outside_Part_Data_Present) OTU(TTtoR_ReqToPlace) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(RtoTT_PickConfirm)OTU(TTtoR_ReqToPickGood)OTU(TTtoR_ReqToPickBad)OTU(Index_Table_Part_Data[1].Inside_Part_Data_Present)OTU(Index_Table_Part_Data[1].Outside_Part_Data_Present)OTU(Index_Table_Part_Data[1].Inside_Good_Part)OTU(Index_Table_Part_Data[1].Outside_Good_Part)OTU(Index_Table_Part_Data[1].Inside_Bad_Part)OTU(Index_Table_Part_Data[1].Outside_Bad_Part)OTU(Index_Table_Part_Data[1].Laser_Marking_Started)OTU(Index_Table_Part_Data[1].Laser_Marking_Finished);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(RtoTT_PlacedConfirm)OTL(Index_Table_Part_Data[1].Inside_Part_Data_Present)OTL(Index_Table_Part_Data[1].Outside_Part_Data_Present);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(System_AutoMode)XIO(RequestLayerShift)[XIO(TTtoR_ReqToPickBad) XIO(TTtoR_ReqToPickGood) ,]XIO(Index_Table_Part_Data[1].Inside_Part_Data_Present)XIO(Index_Table_Part_Data[1].Outside_Part_Data_Present)XIO(TraySlideAutoSeq_Start)XIO(CheckStackerTrays)OTE(UStoR_ReqToPick);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(System_AutoMode)NEQ(Robot_Drop_IN_Chute,0)OTE(DStoR_DropInShoot);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[XIC(System_AutoMode)NEQ(Robot_Place_In_Tray,0)OTE(DStoR_PlaceInTray);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="_04_Robot_Auto_Sequence" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[*****************************
IMM ROBOT
*****************************]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[!!!!!!!!! This NEEDS TO BE REMOVED AFTER TESTING !!!!!!!!]]>
</Comment>
<Text>
<![CDATA[XIC(amp_Test_Bits.4)XIC(RtoPLC_FinishCupAVac)XIC(RtoPLC_FinishCupBVac)OTE(amp_Test_Bits.6);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Robot Auto Sequence

Moves The Next Sequence Cycle Step Into The Current Cycle Step. This Can Be Used To Step The Code Through The AutoCycle One Step At A Time.
This Can Be Done By Putting A Toggle Bit Infront Of The Move Instruction]]>
</Comment>
<Text>
<![CDATA[[[XIO(System_AutoMode) ,XIC(S:FS) ] [MOV(0,Robot_Auto.Routine_CurrentCycleStep) ,MOV(0,Robot_Auto.Routine_NextCycleStep) ,MOV(0,Robot_Cmd_RoutineID) ] ,[XIC(System_InCycle) ,XIO(System_InCycle) [XIC(System_CycleStop_Requested) ,XIC(Auto_Initialization) ] ] MOV(Robot_Auto.Routine_NextCycleStep,Robot_Auto.Routine_CurrentCycleStep) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[!!!!!!!!!!   Information only   !!!!!!!!!!]]>
</Comment>
<Text>
<![CDATA[MOV(UpAxis_LayerTarget,UpAxis_LayerTarget)MOV(DnAxis_LayerTarget,DnAxis_LayerTarget);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[!!!!!!!!!    Information only   !!!!!!!!!]]>
</Comment>
<Text>
<![CDATA[XIC(Robot_Blank_Side_Part_Data.Inside_Part_Data_Present)XIC(Robot_Finished_Side_Part_Data.Inside_Part_Data_Present)XIC(IMM_Blanks_Part_Data.Outside_Part_Data_Present)XIC(IMM_Blanks_Part_Data.Inside_Part_Data_Present)XIC(IMM_Blanks_Part_Data.Inside_Bad_Part)XIC(IMM_Blanks_Part_Data.Outside_Bad_Part)XIC(IMM_Finished_Part_Data.Outside_Part_Data_Present)XIC(IMM_Finished_Part_Data.Inside_Part_Data_Present)XIC(IMM_Finished_Part_Data.Inside_Bad_Part)XIC(IMM_Finished_Part_Data.Outside_Bad_Part)NOP();]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Clear out part data from IMM]]>
</Comment>
<Text>
<![CDATA[XIC(HMI_Clear_Part_Data_From_IMM)OTU(IMM_Blanks_Part_Data.Inside_Part_Data_Present)OTU(IMM_Blanks_Part_Data.Outside_Part_Data_Present)OTU(IMM_Blanks_Part_Data.Inside_Good_Part)OTU(IMM_Blanks_Part_Data.Outside_Good_Part)OTU(IMM_Blanks_Part_Data.Inside_Bad_Part)OTU(IMM_Blanks_Part_Data.Outside_Bad_Part)OTU(IMM_Finished_Part_Data.Inside_Part_Data_Present)OTU(IMM_Finished_Part_Data.Outside_Part_Data_Present)OTU(IMM_Finished_Part_Data.Inside_Good_Part)OTU(IMM_Finished_Part_Data.Outside_Good_Part)OTU(IMM_Finished_Part_Data.Inside_Bad_Part)OTU(IMM_Finished_Part_Data.Outside_Bad_Part);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[This updates the part status inside of the IMM]]>
</Comment>
<Text>
<![CDATA[XIC(IMM_Open)[XIC(IMMtoR_PartInjected) XIO(IMMtoR_PartRejected) OTU(IMM_Blanks_Part_Data.Inside_Part_Data_Present) OTU(IMM_Blanks_Part_Data.Outside_Part_Data_Present) OTU(IMM_Blanks_Part_Data.Inside_Good_Part) OTU(IMM_Blanks_Part_Data.Outside_Good_Part) OTU(IMM_Blanks_Part_Data.Inside_Bad_Part) OTU(IMM_Blanks_Part_Data.Outside_Bad_Part) OTL(IMM_Finished_Part_Data.Inside_Part_Data_Present) OTL(IMM_Finished_Part_Data.Outside_Part_Data_Present) OTL(IMM_Finished_Part_Data.Inside_Good_Part) OTL(IMM_Finished_Part_Data.Outside_Good_Part) OTU(IMM_Finished_Part_Data.Inside_Bad_Part) OTU(IMM_Finished_Part_Data.Outside_Bad_Part) ,[XIC(IMMtoR_PartRejected) XIO(IMMtoR_PartInjected) ,XIC(IMMtoR_EjectPosFrw) ] OTU(IMM_Blanks_Part_Data.Inside_Part_Data_Present) OTU(IMM_Blanks_Part_Data.Outside_Part_Data_Present) OTU(IMM_Blanks_Part_Data.Inside_Good_Part) OTU(IMM_Blanks_Part_Data.Outside_Good_Part) OTU(IMM_Blanks_Part_Data.Inside_Bad_Part) OTU(IMM_Blanks_Part_Data.Outside_Bad_Part) OTL(IMM_Finished_Part_Data.Inside_Part_Data_Present) OTL(IMM_Finished_Part_Data.Outside_Part_Data_Present) OTL(IMM_Finished_Part_Data.Inside_Bad_Part) OTL(IMM_Finished_Part_Data.Outside_Bad_Part) OTU(IMM_Finished_Part_Data.Inside_Good_Part) OTU(IMM_Finished_Part_Data.Outside_Good_Part) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Robot Wait for Idle state]]>
</Comment>
<Text>
<![CDATA[EQU(Robot_Auto.Routine_CurrentCycleStep,0)XIC(System_InCycle)XIC(IndexTable_In_Position)[XIC(IMMtoR_OpEnable) ,]MOV(0,Robot_Cmd_RoutineID)EQU(Robot_Sts_State,0)TON(Robot_Delay,?,?)XIC(Robot_Delay.DN)MOV(5,Robot_Auto.Routine_NextCycleStep);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Robot Auto sequence Decision step

Robot needs to pick Blank Part Step: 10

Index table New Part Requested Step: 20

Unload Good Part from Index table Step: 100

Robot Load Parts into IMM Step: 200

Robot Spru Cut Step: 300

Unload Bad Part from Index table step: 1000

Robot Rejecting Bad Injected Finished Pqarts Step: 2000

Robot Move to home position Step:

Robot Upstacker Step:
]]>
</Comment>
<Text>
<![CDATA[EQU(Robot_Auto.Routine_CurrentCycleStep,5)XIC(System_InCycle)XIC(IndexTable_In_Position)[EQU(Robot_Sts_State,0) [XIO(RtoPLC_ToolBlnkMrked) [XIO(RtoPLC_ToolFinHasParts) XIO(Robot_Blank_Side_Part_Data.Inside_Part_Data_Present) XIO(Robot_Blank_Side_Part_Data.Outside_Part_Data_Present) [XIO(RtoPLC_ToolBlnkHasParts) NEQ(Index_Table_New_Part_Requested,0) MOV(10,Robot_Auto.Routine_NextCycleStep) ,XIC(RtoPLC_ToolBlnkHasParts) NEQ(Index_Table_New_Part_Requested,0) MOV(20,Robot_Auto.Routine_NextCycleStep) ,NEQ(Index_Robot_Good_Part_Unload_Request,0) MOV(100,Robot_Auto.Routine_NextCycleStep) ,NEQ(Index_Robot_Bad_Part_Unload_Request,0) MOV(1000,Robot_Auto.Routine_NextCycleStep) ] ,XIC(RtoPLC_ToolFinHasParts) XIO(RtoPLC_ToolFinReject) MOV(300,Robot_Auto.Routine_NextCycleStep) ,XIC(IMMtoR_OpEnable) XIC(RtoPLC_ToolFinReject) MOV(2000,Robot_Auto.Routine_NextCycleStep) ] ,XIC(IMMtoR_OpEnable) [XIC(RtoPLC_ToolBlnkMrked) ,XIC(Robot_Blank_Side_Part_Data.Inside_Part_Data_Present) XIC(Robot_Blank_Side_Part_Data.Outside_Part_Data_Present) ] XIC(RtoPLC_ToolBlnkHasParts) XIO(RtoPLC_ToolFinHasParts) XIC(IMMtoR_MoldOpen) [XIO(IMM_Blanks_Part_Data.Inside_Part_Data_Present) XIO(IMM_Blanks_Part_Data.Outside_Part_Data_Present) ,XIC(IMM_Finished_Part_Data.Inside_Part_Data_Present) XIC(IMM_Finished_Part_Data.Outside_Part_Data_Present) ,[XIC(IMMtoR_PartInjected) ,XIC(IMMtoR_PartRejected) ] ] MOV(200,Robot_Auto.Routine_NextCycleStep) ] ,EQU(Robot_Sts_State,3) MOV(3000,Robot_Auto.Routine_NextCycleStep) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Robot Auto sequence

Index table New Part Requested

Request a layer shift if top level tray is empty
]]>
</Comment>
<Text>
<![CDATA[EQU(Robot_Auto.Routine_CurrentCycleStep,10)XIC(System_InCycle)[XIO(Top_Tray_Is_Empty) MOV(20,Robot_Cmd_RoutineID) ,XIC(Top_Tray_Is_Empty) OTE(RequestLayerShift) ,[XIC(IndexTable_In_Position) XIC(Index_Table_Part_Data[1].Inside_Part_Data_Present) XIC(Index_Table_Part_Data[1].Outside_Part_Data_Present) ,XIC(TraySlideAutoSeq_Start) XIO(Top_Tray_Is_Empty) EQU(Robot_Sts_State,2) ,XIC(RtoPLC_ToolBlnkHasParts) ] MOV(0,Robot_Auto.Routine_NextCycleStep) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Robot Auto sequence

Index table New Part Requested]]>
</Comment>
<Text>
<![CDATA[EQU(Robot_Auto.Routine_CurrentCycleStep,20)XIC(System_InCycle)[ONS(Robot_Auto.ONS_Dint.5) MOV(30,Robot_Cmd_RoutineID) OTE(Robot_Load_New_Part_Req) ,XIC(IndexTable_In_Position) XIC(Index_Table_Part_Data[1].Inside_Part_Data_Present) XIC(Index_Table_Part_Data[1].Outside_Part_Data_Present) XIO(RtoPLC_ToolBlnkHasParts) MOV(0,Robot_Auto.Routine_NextCycleStep) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Robot Auto sequence

Index part received reset robot command]]>
</Comment>
<Text>
<![CDATA[EQU(Robot_Auto.Routine_CurrentCycleStep,30)XIC(System_InCycle)[MOV(0,Robot_Cmd_RoutineID) ,EQU(Robot_Cmd_RoutineID,0) EQU(Robot_Sts_State,0) MOV(0,Robot_Auto.Routine_NextCycleStep) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Robot Auto sequence

Unload good Part from Index table
]]>
</Comment>
<Text>
<![CDATA[EQU(Robot_Auto.Routine_CurrentCycleStep,100)XIC(System_InCycle)[MOV(30,Robot_Cmd_RoutineID) OTE(Robot_Unload_Good_Part_Req) ,XIC(IndexTable_In_Position) XIO(Index_Table_Part_Data[1].Inside_Part_Data_Present) XIO(Index_Table_Part_Data[1].Outside_Part_Data_Present) XIO(Index_Table_Part_Data[1].Inside_Good_Part) XIO(Index_Table_Part_Data[1].Outside_Good_Part) OTL(Robot_Blank_Side_Part_Data.Inside_Part_Data_Present) OTL(Robot_Blank_Side_Part_Data.Outside_Part_Data_Present) MOV(0,Robot_Auto.Routine_NextCycleStep) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Robot Auto sequence

IMM Load / unload good injected Parts

Transfer part tracking data to the IMM and reset data in the Robot
]]>
</Comment>
<Text>
<![CDATA[EQU(Robot_Auto.Routine_CurrentCycleStep,200)XIC(System_InCycle)[XIC(IMM_Open) MOV(40,Robot_Cmd_RoutineID) OTE(Robot_LoadUnload_IMM_Parts) ,XIC(Robot_LoadUnload_IMM_Parts) [EQU(Robot_Sts_State,2) ,] XIO(IMMtoR_PartInjected) XIO(RtoIMM_PickErrorVG530) XIO(RtoIMM_PickErrorVG528) OTL(IMM_Blanks_Part_Data.Inside_Part_Data_Present) OTL(IMM_Blanks_Part_Data.Outside_Part_Data_Present) OTU(Robot_Blank_Side_Part_Data.Inside_Part_Data_Present) OTU(Robot_Blank_Side_Part_Data.Outside_Part_Data_Present) MOV(0,Robot_Auto.Routine_NextCycleStep) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[Robot Auto sequence

Robot Cut Sprus from Good IMM parts
]]>
</Comment>
<Text>
<![CDATA[EQU(Robot_Auto.Routine_CurrentCycleStep,300)XIC(System_InCycle)[MOV(50,Robot_Cmd_RoutineID) OTE(Robot_Cut_Spru_Req) ,XIC(Robot_Cut_Spru_Req) EQU(Robot_Sts_State,2) MOV(310,Robot_Auto.Routine_NextCycleStep) ];]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[Robot Auto sequence

Reset robot request]]>
</Comment>
<Text>
<![CDATA[EQU(Robot_Auto.Routine_CurrentCycleStep,310)XIC(System_InCycle)[MOV(0,Robot_Cmd_RoutineID) ,EQU(Robot_Sts_State,0) MOV(320,Robot_Auto.Routine_NextCycleStep) ];]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[Robot Auto sequence

Robot Place parts In Chute or Tray (trays are NOT ready at this time)]]>
</Comment>
<Text>
<![CDATA[EQU(Robot_Auto.Routine_CurrentCycleStep,320)XIC(System_InCycle)MOV(60,Robot_Cmd_RoutineID)[XIO(AlwaysOff) OTE(Robot_Drop_IN_Chute.0) ,XIC(AlwaysOff) OTE(Robot_Place_In_Tray.0) ,XIC(Robot_Drop_IN_Chute.0) [XIC(RtoDS_PlacedConfirm) ,] EQU(Robot_Sts_State,2) OTU(Robot_Finished_Side_Part_Data.Inside_Part_Data_Present) OTU(Robot_Finished_Side_Part_Data.Outside_Part_Data_Present) OTU(Robot_Finished_Side_Part_Data.Outside_Good_Part) OTU(Robot_Finished_Side_Part_Data.Inside_Good_Part) MOV(0,Robot_Auto.Routine_NextCycleStep) ];]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[Robot Auto sequence

Unload BAD Part from Index table
]]>
</Comment>
<Text>
<![CDATA[EQU(Robot_Auto.Routine_CurrentCycleStep,1000)XIC(System_InCycle)[OTE(Robot_Unload_Bad_Part_Req) ,XIC(IndexTable_In_Position) XIO(Index_Table_Part_Data[1].Inside_Part_Data_Present) XIO(Index_Table_Part_Data[1].Inside_Bad_Part) XIO(Index_Table_Part_Data[1].Outside_Part_Data_Present) XIO(Index_Table_Part_Data[1].Outside_Bad_Part) MOV(1010,Robot_Auto.Routine_NextCycleStep) ];]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[Robot Auto sequence

Throw away the bad laser part
]]>
</Comment>
<Text>
<![CDATA[EQU(Robot_Auto.Routine_CurrentCycleStep,1010)XIC(System_InCycle)[ONS(Robot_Auto.ONS_Dint.3) MOV(71,Robot_Cmd_RoutineID) ,XIC(RtoTT_PlacedConfirm) EQU(Robot_Sts_State,0) MOV(0,Robot_Auto.Routine_NextCycleStep) ];]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[Robot Auto sequence

Throw away the Bad Injected Finished part
]]>
</Comment>
<Text>
<![CDATA[EQU(Robot_Auto.Routine_CurrentCycleStep,2000)XIC(System_InCycle)[MOV(72,Robot_Cmd_RoutineID) OTE(Robot_Rejecting_Bad_Injected_Part) ,XIC(Robot_Rejecting_Bad_Injected_Part) EQU(Robot_Sts_State,2) OTU(Robot_Finished_Side_Part_Data.Inside_Part_Data_Present) OTU(Robot_Finished_Side_Part_Data.Outside_Part_Data_Present) OTU(Robot_Finished_Side_Part_Data.Outside_Good_Part) OTU(Robot_Finished_Side_Part_Data.Outside_Bad_Part) OTU(Robot_Finished_Side_Part_Data.Inside_Good_Part) OTU(Robot_Finished_Side_Part_Data.Inside_Bad_Part) MOV(0,Robot_Auto.Routine_NextCycleStep) ];]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[Robot Auto sequence

Robot Faulted Recovery

!!!!!!!!     NEEDS FINISHED   !!!!!!!!!!]]>
</Comment>
<Text>
<![CDATA[EQU(Robot_Auto.Routine_CurrentCycleStep,3000)XIC(System_InCycle)[NOP() ,NEQ(Robot_Sts_State,3) MOV(0,Robot_Auto.Routine_NextCycleStep) ];]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[Robot Start / Stop
]]>
</Comment>
<Text>
<![CDATA[XIC(PLCtoR_Start)XIC(PLCtoR_Stop)NOP();]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Comment>
<![CDATA[Robot Pick From Upstacker
]]>
</Comment>
<Text>
<![CDATA[XIC(UStoR_ReqToPick)MOV(UStoR_PickColumnNumber,UStoR_PickColumnNumber)MOV(UStoR_PickRowNumber,UStoR_PickRowNumber)MOV(UStoR_PickSeqNumber,UStoR_PickSeqNumber)NOP();]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="_08_HMI_Animations" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Change the Robot Blank side vacuum buttons Colors]]>
</Comment>
<Text>
<![CDATA[[XIO(Rob_Permit_Vac_A_Blank) [XIO(PLCtoR_BlankCupAVacOn) [XIO(CR700) MOV(0,Rob_Vac_Blank_A.Button_Color) ,XIO(CR701) MOV(0,Rob_Blow_Blank_A.Button_Color) ] ,XIO(PLCtoR_BlankCupBVacOn) [XIO(CR702) MOV(0,Rob_Vac_Blank_B.Button_Color) ,XIO(CR703) MOV(0,Rob_Blow_Blank_B.Button_Color) ] ] ,XIC(Rob_Permit_Vac_A_Blank) [[XIO(PLCtoR_BlankCupAVacOn) MOV(1,Rob_Vac_Blank_A.Button_Color) ,XIO(PLCtoR_BlankCupBVacOn) MOV(1,Rob_Vac_Blank_B.Button_Color) ,XIO(CR701) MOV(1,Rob_Blow_Blank_A.Button_Color) ,XIO(CR703) MOV(1,Rob_Blow_Blank_B.Button_Color) ] ,[XIC(CR700) MOV(3,Rob_Vac_Blank_A.Button_Color) ,XIC(CR702) MOV(3,Rob_Vac_Blank_B.Button_Color) ,AFI() MOV(3,Rob_Blow_Blank_A.Button_Color) ,AFI() MOV(3,Rob_Blow_Blank_B.Button_Color) ] ,AFI() [MOV(2,Rob_Vac_Blank_A.Button_Color) ,MOV(2,Rob_Vac_Blank_B.Button_Color) ,MOV(2,Rob_Blow_Blank_A.Button_Color) ,MOV(2,Rob_Blow_Blank_B.Button_Color) ] ,[XIC(PLCtoR_BlankCupAVacOn) MOV(4,Rob_Vac_Blank_A.Button_Color) ,XIC(PLCtoR_BlankCupBVacOn) MOV(4,Rob_Vac_Blank_B.Button_Color) ,XIC(CR701) MOV(4,Rob_Blow_Blank_A.Button_Color) ,XIC(CR703) MOV(4,Rob_Blow_Blank_B.Button_Color) ] ] ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Change the Robot Finished side vacuum buttons Colors]]>
</Comment>
<Text>
<![CDATA[[XIO(Rob_Permit_Vac_A_Finished) [XIO(PLCtoR_FinishCupAVacOn) [XIO(CR704) MOV(0,Rob_Vac_Finished_A.Button_Color) ,XIO(CR705) MOV(0,Rob_Blow_Finished_A.Button_Color) ] ,XIO(PLCtoR_FinishCupBVacOn) [XIO(CR706) MOV(0,Rob_Vac_Finished_B.Button_Color) ,XIO(CR707) MOV(0,Rob_Blow_Finished_B.Button_Color) ] ] ,XIC(Rob_Permit_Vac_A_Finished) [[XIO(PLCtoR_FinishCupAVacOn) MOV(1,Rob_Vac_Finished_A.Button_Color) ,XIO(PLCtoR_FinishCupBVacOn) MOV(1,Rob_Vac_Finished_B.Button_Color) ,XIO(CR705) MOV(1,Rob_Blow_Finished_A.Button_Color) ,XIO(CR707) MOV(1,Rob_Blow_Finished_B.Button_Color) ] ,[XIC(CR704) MOV(3,Rob_Vac_Finished_A.Button_Color) ,XIC(CR706) MOV(3,Rob_Vac_Finished_B.Button_Color) ,AFI() MOV(3,Rob_Blow_Finished_A.Button_Color) ,AFI() MOV(3,Rob_Blow_Finished_B.Button_Color) ] ,AFI() [MOV(2,Rob_Vac_Finished_A.Button_Color) ,MOV(2,Rob_Vac_Finished_B.Button_Color) ,MOV(2,Rob_Blow_Finished_A.Button_Color) ,MOV(2,Rob_Blow_Finished_B.Button_Color) ] ,[XIC(PLCtoR_FinishCupAVacOn) MOV(4,Rob_Vac_Finished_A.Button_Color) ,XIC(PLCtoR_FinishCupBVacOn) MOV(4,Rob_Vac_Finished_B.Button_Color) ,XIC(CR705) MOV(4,Rob_Blow_Finished_A.Button_Color) ,XIC(CR707) MOV(4,Rob_Blow_Finished_B.Button_Color) ] ] ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Change the Spru Cutter buttons Colors]]>
</Comment>
<Text>
<![CDATA[[XIO(Spru_Cutter_Permit) [XIO(CR408) MOV(0,Spru_Cutter_Close.Button_Color) ,XIO(CR409) MOV(0,Spru_Cutter_Open.Button_Color) ] ,XIC(Spru_Cutter_Permit) [[XIO(CR408) MOV(1,Spru_Cutter_Close.Button_Color) ,XIO(CR409) MOV(1,Spru_Cutter_Open.Button_Color) ] ,XIC(CR408) MOV(3,Spru_Cutter_Close.Button_Color) ,XIC(CR409) MOV(3,Spru_Cutter_Open.Button_Color) ,AFI() MOV(2,Spru_Cutter_Close.Button_Color) ,AFI() MOV(2,Spru_Cutter_Open.Button_Color) ,XIC(CR408) MOV(4,Spru_Cutter_Close.Button_Color) ,XIC(CR409) MOV(4,Spru_Cutter_Open.Button_Color) ] ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Color and Status of Robot]]>
</Comment>
<Text>
<![CDATA[[EQU(Robot_Sts_State,0) [MOV(0,Robot_Status.Button_Color) ,COP(Robot_Status_String[0],Robot_Status_Current,1) ] ,EQU(Robot_Sts_State,2) [MOV(1,Robot_Status.Button_Color) ,COP(Robot_Status_String[1],Robot_Status_Current,1) ] ,EQU(Robot_Sts_State,3) [MOV(2,Robot_Status.Button_Color) ,COP(Robot_Status_String[2],Robot_Status_Current,1) ] ,EQU(Robot_Sts_State,4) [MOV(3,Robot_Status.Button_Color) ,COP(Robot_Status_String[3],Robot_Status_Current,1) ] ,EQU(Robot_Sts_State,1) [MOV(4,Robot_Status.Button_Color) ,COP(Robot_Status_String[4],Robot_Status_Current,1) ] ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Robot Running routine]]>
</Comment>
<Text>
<![CDATA[[EQU(Robot_Sts_State,1) [EQU(0,Robot_Cmd_RoutineID) COP(Robot_Routine_String[0],HMI_Robot_Routine_Current,1) ,EQU(10,Robot_Cmd_RoutineID) COP(Robot_Routine_String[1],HMI_Robot_Routine_Current,1) ,EQU(20,Robot_Cmd_RoutineID) COP(Robot_Routine_String[2],HMI_Robot_Routine_Current,1) ,EQU(30,Robot_Cmd_RoutineID) COP(Robot_Routine_String[3],HMI_Robot_Routine_Current,1) ,EQU(40,Robot_Cmd_RoutineID) COP(Robot_Routine_String[4],HMI_Robot_Routine_Current,1) ,EQU(50,Robot_Cmd_RoutineID) COP(Robot_Routine_String[5],HMI_Robot_Routine_Current,1) ,EQU(60,Robot_Cmd_RoutineID) COP(Robot_Routine_String[6],HMI_Robot_Routine_Current,1) ,EQU(71,Robot_Cmd_RoutineID) COP(Robot_Routine_String[7],HMI_Robot_Routine_Current,1) ,EQU(72,Robot_Cmd_RoutineID) COP(Robot_Routine_String[8],HMI_Robot_Routine_Current,1) ,EQU(73,Robot_Cmd_RoutineID) COP(Robot_Routine_String[9],HMI_Robot_Routine_Current,1) ] ,EQU(Robot_Sts_State,0) EQU(0,Robot_Cmd_RoutineID) COP(Robot_Idle_Str,HMI_Robot_Routine_Current,1) ,EQU(Robot_Sts_State,3) EQU(0,Robot_Cmd_RoutineID) COP(Faulted_Str,HMI_Robot_Routine_Current,1) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Color of IMM Parts]]>
</Comment>
<Text>
<![CDATA[[XIO(IMM_Blanks_Part_Data.Inside_Part_Data_Present) XIO(IMM_Blanks_Part_Data.Outside_Part_Data_Present) XIO(IMM_Finished_Part_Data.Inside_Part_Data_Present) XIO(IMM_Finished_Part_Data.Outside_Part_Data_Present) MOV(0,IMM_Part_Status.Button_Color) ,XIC(IMM_Finished_Part_Data.Inside_Part_Data_Present) XIC(IMM_Finished_Part_Data.Outside_Part_Data_Present) MOV(1,IMM_Part_Status.Button_Color) ,[XIC(IMM_Blanks_Part_Data.Inside_Bad_Part) ,XIC(IMM_Blanks_Part_Data.Outside_Bad_Part) ,XIC(IMM_Finished_Part_Data.Inside_Bad_Part) ,XIC(IMM_Finished_Part_Data.Outside_Bad_Part) ] MOV(2,IMM_Part_Status.Button_Color) ,XIC(IMM_Blanks_Part_Data.Inside_Part_Data_Present) XIC(IMM_Blanks_Part_Data.Outside_Part_Data_Present) MOV(3,IMM_Part_Status.Button_Color) ,XIC(HMI_Clear_Part_Data_From_IMM) MOV(4,IMM_Part_Status.Button_Color) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="_09_Euromap_Signals" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[This is for removing a reject fromn the IMM
swapped aliases part rejected and part injected.
win sinor 9/25/26
]]>
</Comment>
<Text>
<![CDATA[[XIC(EM67_ZC8) ,XIC(amp_Test_Bits.28) ]OTE(IMMtoR_PartInjected);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[

Injectiojn molding machine to robot EuroMap signals 

]]>
</Comment>
<Text>
<![CDATA[XIC(EM67_ZA6)OTE(IMMtoR_MoldClosed);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(EM67_ZA7)OTE(IMM_Open)OTE(IMMtoR_MoldOpen);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(EM67_ZA8)OTE(IMMtoR_MoldInterOpen);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(EM67_ZB2)OTE(IMMtoR_OpEnable);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[[XIC(EM67_ZB3) ,XIC(amp_Test_Bits.20) ]OTE(IMMtoR_EjectPosBck);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[[XIC(EM67_ZB4) ,XIC(amp_Test_Bits.6) ]OTE(IMMtoR_EjectPosFrw);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(EM67_ZB5)OTE(IMMtoR_CorePL1Pos1);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(EM67_ZB6)OTE(IMMtoR_CorePL1Pos2);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(EM67_ZB7)OTE(IMMtoR_CorePL2Pos1);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(EM67_ZB8)OTE(IMMtoR_CorePL2Pos2);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[swapped aliases for part rejected and part injected.
win sinor 9/25/26
]]>
</Comment>
<Text>
<![CDATA[[XIC(EM67_ZA5) ,XIC(amp_Test_Bits.30) ]OTE(IMMtoR_PartRejected);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[XIC(EM78_C9_C3)OTE(IMMtoR_InidicateDrReq);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[XIC(EM78_C7_C1)OTE(IMMtoR_DrOpenEnable);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[

Robot to injectiojn molding machine EuroMap signals 

]]>
</Comment>
<Text>
<![CDATA[[XIO(RobotAtIMM) ,XIC(RtoIMM_MoldAreaFree) XIC(AlwaysOff) ]OTE(IEM67_A3_C3);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[XIC(RtoIMM_MoldCloseEnable)OTE(IEM67_A6);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[XIC(RtoIMM_MoldOpenEnable)OTE(IEM67_A7);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[[XIC(RtoIMM_RobotWithIMM) ,XIO(RobotAtIMM) ,XIC(amp_Test_Bits.14) ]OTE(IEM67_B2);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[XIC(RtoIMM_MoldEjectBack)OTE(IEM67_B3);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Text>
<![CDATA[XIC(RtoIMM_MoldEjectFrw)OTE(IEM67_B4);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Text>
<![CDATA[XIC(RtoIMM_MoldCorePL1Pos1)OTE(IEM67_B5);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Text>
<![CDATA[XIC(RtoIMM_MoldCorePL1Pos2)OTE(IEM67_B6);]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Text>
<![CDATA[XIC(RtoIMM_MoldCorePL2Pos1)OTE(IEM67_B7);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Text>
<![CDATA[XIC(RtoIMM_MoldCorePL2Pos2)OTE(IEM67_B8);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
</Programs>
</Controller>
</RSLogix5000Content>
