<Routines>
<Routine Name="PC_to_PLC" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(PC_TT_Clear_Data)[COP(Data_Item_Initialize,TurnTable[0],1) ,COP(Data_Item_Initialize,TurnTable[1],1) ,COP(Data_Item_Initialize,TurnTable[2],1) ,COP(Data_Item_Initialize,TurnTable[3],1) ,COP(Data_Item_Initialize,TurnTable[4],1) ][CLR(TurnTable_1_SeqNum) ,CLR(TurnTable_2_SeqNum) ,CLR(TurnTable_3_SeqNum) ,CLR(TurnTable_4_SeqNum) ][OTU(Turn_Table_Full) ,OTU(TTtoR_ReqToPickGood) ,OTU(TTtoR_ReqToPickBad) ]OTU(Fire_The_Laser)OTU(PC_TT_Clear_Data);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(PC_TT_Run)ONS(ONS_DOCK.0)OTL(VFD_Index_REQUEST)OTU(PC_TT_Run);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(PC_Trigger_Cognex)OTL(Trigger_Cognex);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(PC_Door_Open_Request)ONS(PC_Door_Open_RequestONS)OTL(Door_Open_Request);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[[XIO(DStoR_DropInShoot) OTE(DStoR_PlaceInTray) ,[XIC(PC_Part_to_Chute) ,XIC(Optix_AlwaysDropInShootTimer.DN) ] [OTL(DStoR_DropInShoot) ,TON(Optix_AlwaysDropInShootTimer,?,?) ] ,XIC(Optix_AlwaysDropInShootReset) RES(Optix_AlwaysDropInShootTimer) OTU(DStoR_DropInShoot) ,[XIO(DStoR_DropInShoot) XIO(Optix_AlwaysDropInShootTimer.DN) MOV(1,Optix_AlwaysDropInShootStatusCode) ,XIC(DStoR_DropInShoot) XIO(Optix_AlwaysDropInShootTimer.DN) MOV(2,Optix_AlwaysDropInShootStatusCode) ,XIC(DStoR_DropInShoot) XIC(Optix_AlwaysDropInShootTimer.DN) MOV(3,Optix_AlwaysDropInShootStatusCode) ] ,XIO(Optix_AlwaysDropInShootTimer.DN) XIC(RtoDS_PlacedConfirm) OTU(DStoR_DropInShoot) ,[XIC(DStoR_DropInShoot) XIC(RtoDS_PlacedConfirm) ,XIC(DropInChuteLEDblink[0].TT) ] [TON(DropInChuteLEDblink[0],?,?) ,XIO(DropInChuteLEDblink[2].DN) [TON(DropInChuteLEDblink[1],?,?) ,XIC(DropInChuteLEDblink[1].DN) TON(DropInChuteLEDblink[2],?,?) ] ] ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIO(PC_Stacker_Cmd)MOV(PC_Upstack_Layer_Cmd,UpStack_HMI_Tray_Qty)MOV(PC_DwnStack_Layer_Cmd,DwnStack_HMI_Tray_Qty);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[[XIO(Upstack_Complete) XIO(PC_Stacker_Cmd) MOV(0,Optix_LayerEntryEnable) ,XIC(Upstack_Complete) MOV(1,Optix_LayerEntryEnable) ,[XIC(PC_Stacker_Cmd) XIO(Upstack_Complete) ,XIC(PC_Stacker_Cmd) XIC(Upstack_Complete) ] MOV(2,Optix_LayerEntryEnable) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(PC_Stacker_Cmd)[NEQ(PC_Upstack_Layer_Cmd,Upstack_Layer_Current) MOV(PC_Upstack_Layer_Cmd,Upstack_Layer_Current) ,NEQ(PC_Upstack_Row_Cmd,Upstack_Row_Current) MOV(PC_Upstack_Row_Cmd,Upstack_Row_Current) ,NEQ(PC_Upstack_Column_Cmd,Upstack_Column_Current) MOV(PC_Upstack_Column_Cmd,Upstack_Column_Current) ,NEQ(PC_DwnStack_Layer_Cmd,DwnStack_Layer_Current) MOV(PC_DwnStack_Layer_Cmd,DwnStack_Layer_Current) ,NEQ(PC_DwnStack_Row_Cmd,DwnStack_Row_Current) MOV(PC_DwnStack_Row_Cmd,DwnStack_Row_Current) ,NEQ(PC_DwnStack_Column_Cmd,DwnStack_Column_Current) MOV(PC_DwnStack_Column_Cmd,DwnStack_Column_Current) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="PLC_to_PC" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[[XIC(UpStack_Inputs.Moving) OTE(PLC_To_PC_DINT[10].0) ,XIC(UpStack_Inputs.Alarm_Active) OTE(PLC_To_PC_DINT[10].1) ,XIC(Upstack_Com_Fault) OTE(PLC_To_PC_DINT[10].2) ,XIC(Upstack_Jam) OTE(PLC_To_PC_DINT[10].3) ,XIC(UStoR_ReqToPick) OTE(PLC_To_PC_DINT[10].5) ,XIC(UStoR_ReqToMoveLayer) OTE(PLC_To_PC_DINT[10].6) ,XIC(RtoUS_PickConfirm) OTE(PLC_To_PC_DINT[10].7) ,XIC(RtoUS_LayerMovedConfirm) OTE(PLC_To_PC_DINT[10].8) ,MOV(Upstack_Layer_Current,PLC_To_PC_DINT[50]) MOV(Upstack_Column_Current,PLC_To_PC_DINT[51]) MOV(Upstack_Row_Current,PLC_To_PC_DINT[52]) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[XIC(DwnStack_Inputs.Moving) OTE(PLC_To_PC_DINT[11].0) ,XIC(DwnStack_Inputs.Alarm_Active) OTE(PLC_To_PC_DINT[11].1) ,XIC(DwnStack_Com_Fault) OTE(PLC_To_PC_DINT[11].2) ,XIC(DwnStack_Jam) OTE(PLC_To_PC_DINT[11].3) ,XIC(DStoR_OpenLocation) OTE(PLC_To_PC_DINT[11].5) ,XIC(DStoR_PlaceInTray) OTE(PLC_To_PC_DINT[11].6) ,XIC(DStoR_DropInShoot) OTE(PLC_To_PC_DINT[11].7) ,XIC(RtoDS_PlacedConfirm) OTE(PLC_To_PC_DINT[11].8) ,MOV(DwnStack_Layer_Current,PLC_To_PC_DINT[53]) MOV(DwnStack_Column_Current,PLC_To_PC_DINT[54]) MOV(DwnStack_Row_Current,PLC_To_PC_DINT[55]) ];]]>
