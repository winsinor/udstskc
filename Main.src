&ACCESS RVP
&COMMENT PLC-commanded routine dispatcher
DEF Main ( )
;--------------------------------------------------------------------------
; Main -- runs the routine the PLC asks for, then reports the result.
;
;   PLC writes Robot_Cmd_RoutineID, then increments Robot_Cmd_Seq.
;   The INCREMENT is the trigger, which is what makes "run 20 again"
;   different from "still running 20".
;
;   Robot_Sts_State:  0 idle   1 running   2 complete   3 faulted
;
;   State 2 and 3 are HELD. The PLC releases them by writing
;   Robot_Cmd_RoutineID = 0. Nothing else does.
;
; Signals live in $config.dat, USER GLOBALS fold.
;--------------------------------------------------------------------------

;FOLD INIT
  ; Snapshot of the command. The Robot_Cmd_* words are live network data and
  ; can change mid-routine; these are taken once, at dispatch.
  DECL INT Cmd_Routine
  DECL INT Cmd_P1
;ENDFOLD (INIT)
;FOLD BASISTECH INI
  GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
  INTERRUPT ON 3
  BAS (#INITMOV,0 )
;ENDFOLD (BASISTECH INI)
;FOLD PTP HOME  Vel= 100 % DEFAULT;%{PE}%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:HOME, 3:, 5:100, 7:DEFAULT
  PDAT_ACT=PDEFAULT
  FDAT_ACT=FHOME
  BAS (#PTP_PARAMS,100 )
  $H_POS=XHOME
  PTP  XHOME
;ENDFOLD

; Publish idle, and adopt the PLC's current sequence number. Without the
; adopt, a command left over from before this program started would execute
; the instant it does.
Robot_Sts_State     = 0
Robot_Sts_RoutineID = 0
Robot_Sts_FaultCode = 0
Robot_Sts_AckSeq    = Robot_Cmd_Seq

LOOP

  WAIT FOR ((Robot_Cmd_Seq<>Robot_Sts_AckSeq) AND (Robot_Cmd_RoutineID<>0))

  Cmd_Routine = Robot_Cmd_RoutineID
  Cmd_P1      = Robot_Cmd_Param1

  Robot_Sts_RoutineID = Cmd_Routine
  Robot_Sts_FaultCode = 0
  Robot_Sts_AckSeq    = Robot_Cmd_Seq
  Robot_Sts_State     = 1
  RobotCell_Error     = FALSE

  SWITCH Cmd_Routine

  CASE 10 ; Home
    PDAT_ACT=PDEFAULT
    FDAT_ACT=FHOME
    BAS (#PTP_PARAMS,100 )
    $H_POS=XHOME
    PTP  XHOME
    RtoIMM_MoldAreaFree=TRUE
    RtoIMM_MoldCloseEnable=TRUE
    RtoIMM_MoldOpenEnable=TRUE

  CASE 20 ; PickUpstacker   -- PLC clears UStoR_ReqToMoveLayer first
    Station200_UpStacker ( )

  CASE 30 ; PlaceTurntable  -- PLC sets TTtoR_ReqToPlace first
    Station300_LaserMarker ( )

  CASE 40 ; PickTurntable   -- PLC sets TTtoR_ReqToPickGood or ...PickBad first
    Station300_LaserMarker ( )

  CASE 50 ; IMMExchange
    Station400_IMM ( )

  CASE 60 ; SprueCut
    Station500_SprueCutter ( )

  CASE 70 ; DropChute
    Station600_DownStacker ( )

  CASE 80 ; LayerShift      -- PLC sets UStoR_ReqToMoveLayer first
    Station200_UpStacker ( )

  CASE 90 ; Reject          -- 1 blank side, 2 finished side, 3 both
    Rjct_1Blnk_2Fin_3Both = Cmd_P1
    Station500_Reject ( )

  DEFAULT
    Robot_Sts_FaultCode = 101 ; unknown routine ID
    Robot_Sts_State     = 3
  ENDSWITCH

  ; The station programs already set RobotCell_Error when they fail. Reading
  ; it here turns a silent internal failure into a fault the PLC can see.
  IF RobotCell_Error==TRUE THEN
    Robot_Sts_FaultCode = 100 ; station reported RobotCell_Error
    Robot_Sts_State     = 3
  ENDIF
  IF Robot_Sts_State==1 THEN
    Robot_Sts_State     = 2 ; complete
  ENDIF

  ; Hold until the PLC consumes the result. No timeout on purpose -- if the
  ; PLC never consumes, the right behaviour is to sit still and be obviously
  ; stuck, not to quietly go idle and accept new work.
  WAIT FOR (Robot_Cmd_RoutineID==0)
  Robot_Sts_State     = 0
  Robot_Sts_RoutineID = 0
  Robot_Sts_FaultCode = 0

ENDLOOP
END
