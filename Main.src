&ACCESS RVP
&REL 6
DEF Main()
DECL INT Cmd
DECL INT OvSave
GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==True DO IR_STOPM()
INTERRUPT ON 3
BAS(#INITMOV,0)
;Robot_Cmd_RoutineID   from PLC   0 = idle, anything else = run that routine
;Robot_Sts_State       to PLC     0 idle   1 running   2 done   3 faulted
;Robot_Sts_RoutineID   to PLC     echo of the routine being run
;
;10 Home          20 UpStacker    30 LaserMarker   40 IMM
;50 SprueCutter   60 DownStacker  71 72 73 Reject blank / finished / both
BeginningOfModule:
RobotCell_Error=False
RtoPLC_RobotReachedStop=False
Robot_Sts_State=0
Robot_Sts_RoutineID=0
OvSave=$OV_PRO
$OV_PRO=30
PDAT_ACT=PDEFAULT
FDAT_ACT=FHOME
BAS(#PTP_PARAMS,100)
$H_POS=XHOME
PTP XHOME
$OV_PRO=OvSave
RtoIMM_RobotWithIMM=True
RtoIMM_MoldAreaFree=True
RtoIMM_MoldCloseEnable=True
RtoIMM_MoldOpenEnable=True
RtoPLC_ToolBlnkMrked=False
LOOP
IF ((PLCtoR_Stop==True) OR (PLCtoR_DrawerInPos==False)) THEN
  PDAT_ACT=PDEFAULT
  FDAT_ACT=FHOME
  BAS(#PTP_PARAMS,100)
  $H_POS=XHOME
  PTP XHOME
  RtoIMM_MoldAreaFree=True
  RtoIMM_MoldCloseEnable=True
  RtoIMM_MoldOpenEnable=True
  Robot_Sts_State=0
  Robot_Sts_RoutineID=0
  RtoPLC_RobotReachedStop=True
  WAIT FOR $EXT_START
  RtoPLC_RobotReachedStop=False
ENDIF
WAIT FOR ((Robot_Cmd_RoutineID<>0) OR (PLCtoR_Stop==True) OR (PLCtoR_DrawerInPos==False))
IF Robot_Cmd_RoutineID<>0 THEN
  Cmd=Robot_Cmd_RoutineID
  Robot_Sts_RoutineID=Cmd
  Robot_Sts_State=1
  SWITCH Cmd
  CASE 10
     PDAT_ACT=PDEFAULT
     FDAT_ACT=FHOME
     BAS(#PTP_PARAMS,100)
     $H_POS=XHOME
     PTP XHOME
  CASE 20
     Station200_UpStacker()
  CASE 30
     Station300_LaserMarker()
  CASE 40
     Station400_IMM()
  CASE 50
     Station500_SprueCutter()
  CASE 60
     Station600_DownStacker()
  CASE 71
     Rjct_1Blnk_2Fin_3Both=1
     Station500_Reject()
  CASE 72
     Rjct_1Blnk_2Fin_3Both=2
     Station500_Reject()
  CASE 73
     Rjct_1Blnk_2Fin_3Both=3
     Station500_Reject()
  DEFAULT
     RobotCell_Error=True
  ENDSWITCH
  IF RobotCell_Error==True THEN
     Robot_Sts_State=3
  ELSE
     Robot_Sts_State=2
  ENDIF
  WAIT FOR (Robot_Cmd_RoutineID==0)
  IF RobotCell_Error==True THEN
     GOTO BeginningOfModule
  ENDIF
  Robot_Sts_State=0
  Robot_Sts_RoutineID=0
ENDIF
ENDLOOP
END