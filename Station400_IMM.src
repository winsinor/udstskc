;FOLD Parameters ;%{h}
;Params IlfProvider=kukaroboter.basistech.inlineforms.movement.spline; Kuka.IsGlobalPoint=False; Kuka.PointName=IMM_PickApprFault; Kuka.BlendingEnabled=False; Kuka.MoveDataName=CPDAT31; Kuka.VelocityPath=0.5; Kuka.VelocityFieldEnabled=True; Kuka.ColDetectFieldEnabled=True; Kuka.CurrentCDSetIndex=0; Kuka.MovementParameterFieldEnabled=True; IlfCommand=SLIN
;ENDFOLD
SLIN XIMM_PickApprFault WITH $VEL = SVEL_CP(0.5, , LCPDAT31), $TOOL = STOOL2(FIMM_PickApprFault), $BASE = SBASE(FIMM_PickApprFault.BASE_NO), $IPO_MODE = SIPO_MODE(FIMM_PickApprFault.IPO_FRAME), $LOAD = SLOAD(FIMM_PickApprFault.TOOL_NO), $ACC = SACC_CP(LCPDAT31), $ORI_TYPE = SORI_TYP(LCPDAT31), $APO = SAPO(LCPDAT31), $JERK = SJERK(LCPDAT31), $COLLMON_TOL_PRO[1] = USE_CM_PRO_VALUES(0)
;ENDFOLD
