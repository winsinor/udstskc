EndIf

PlaceInMold:     
$TIMER_STOP[2]=True ;stop timer
$TIMER[2]=0 ;reset timer
$TIMER_STOP[2]=False ;stop timer

Loop
       If $TIMER[2]>=5000 Then
              $TIMER_STOP[2]=True ;stop timer
              $TIMER[2]=0 ;reset timer
              
              If PLCtoR_BlankCupAVacOn==False Then
                     RtoIMM_PlaceErrorVG524=True
                     
              EndIf
              If PLCtoR_BlankCupBVacOn==False Then
                     RtoIMM_PlaceErrorVG526=True
                     
              EndIf 
              Wait Sec .15
              RtoIMM_PlaceErrorVG524=False
              RtoIMM_PlaceErrorVG526=False
              Wait For IMMtoR_OpEnable==False      
              $OV_PRO=30   
