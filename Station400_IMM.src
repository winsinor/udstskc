;ENDFOLD
RtoIMM_MoldAreaFree=True
              Rjct_1Blnk_2Fin_3Both=2
              Station500_Reject()
              RtoIMM_SeqNumber=0
              GOTO EndOfModule
       Endif      
       If IMMtoR_EjectPosFrw==True Then

;FOLD SLIN IMM_PickReturn2 Vel=0.05 m/s CPDAT22 Tool[2]:FinishedPlace Base[3]:IMM ;%{PE}
;FOLD Parameters ;%{h}
