;ENDFOLD
              RtoPLC_FinishGripClose=True
              Wait Sec .15

              RtoIMM_MoldEjectFrw=False
              Wait Sec .15
              RtoIMM_MoldEjectBack=True
                  ;FOLD SLIN IMM_PickReturn Vel=0.2 m/s CPDAT6 Tool[2]:TOOL_DATA[2] Base[3]:BASE_DATA[3] ;%{PE}
      ;FOLD Parameters ;%{h}
         ;Params IlfProvider=kukaroboter.basistech.inlineforms.movement.spline; Kuka.IsGlobalPoint=False; Kuka.PointName=IMM_PickReturn; Kuka.BlendingEnabled=False; Kuka.MoveDataName=CPDAT6; Kuka.VelocityPath=0.2; Kuka.VelocityFieldEnabled=True; Kuka.ColDetectFieldEnabled=True; Kuka.CurrentCDSetIndex=0; Kuka.MovementParameterFieldEnabled=True; IlfCommand=SLIN; SimId=
      ;ENDFOLD
