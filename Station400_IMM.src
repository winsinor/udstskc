      ;ENDFOLD

              RtoPLC_ToolFinHasParts=True
              RtoPLC_ToolFinSeqNumber=RtoIMM_SeqNumber
              RtoIMM_SeqNumber=0
Exit
      EndIf
EndLoop                
      ;ENDFOLD
      
   

;FOLD Wait for ejector backward signals, fault after 10 seconds of waiting (and back out of mold), Lift away part and send ejector backward 
$TIMER_STOP[2]=True ;stop timer
$TIMER[2]=0 ;reset timer
$TIMER_STOP[2]=False ;stop timer
Loop
       If $TIMER[2]>=5000 Then
              $TIMER_STOP[2]=True ;stop timer
              $TIMER[2]=0 ;reset timer
              IMMtoR_PlaceErrorEjBck=True
              RtoIMM_MoldEjectBack=False
              Exit              
       EndIf   
  
       If IMMtoR_EjectPosBck==True Then
              Exit
       EndIf
EndLoop                
 ;ENDFOLD      
      
;FOLD if parts are in blank side of tooling, fault after 10 seconds of waiting (and back out of mold), if no fault, flip inside of mold and place parts, backout,

If ((RtoPLC_ToolBlnkHasParts==False) Or (IMMtoR_PlaceErrorEjBck==True)) Then
       Wait Sec .15
      IMMtoR_PlaceErrorEjBck=False
