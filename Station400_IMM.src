RtoIMM_MoldAreaFree=True
       RtoIMM_MoldAreaFree=True  
       RtoIMM_MoldCloseEnable=True
       If RtoPLC_ToolFinReject==True Then
              Rjct_1Blnk_2Fin_3Both=2
              Station500_Reject()
              GOTO EndOfModule
       EndIf       
       GOTO EndOfModule
EndIf

If RtoPLC_ToolBlnkHasParts==True Then

