&ACCESS RVO1
&REL 170
&PARAM DISKPATH = KRC:\R1\Program
DEF Station400_IMM()
   ;FOLD INI;%{PE}
      ;FOLD BASISTECH INI
         GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS == TRUE DO IR_STOPM()
         INTERRUPT ON 3
         BAS(#INITMOV, 0)
      ;ENDFOLD (BASISTECH INI)
      ;FOLD USER INI
         ;Make your modifications here
      ;ENDFOLD (USER INI)
      ;ENDFOLD (INI)
 RetryEntry:      
 RtoIMM_MoldOpenEnable=True
 RtoPLC_FinishGripClose=False
 RtoPLC_FinishGripOpen=True
 wait sec .25
 RtoPLC_FinishGripOpen=False
 RobotCell_Error=False
 
 
;FOLD SPTP IMM_A1turn Vel=100 % PDAT4 Tool[0] Base[0] ;%{PE}
;FOLD Parameters ;%{h}
;Params IlfProvider=kukaroboter.basistech.inlineforms.movement.spline; Kuka.IsGlobalPoint=False; Kuka.PointName=IMM_A1turn; Kuka.BlendingEnabled=False; Kuka.MoveDataPtpName=PDAT4; Kuka.VelocityPtp=100; Kuka.VelocityFieldEnabled=True; Kuka.ColDetectFieldEnabled=True; Kuka.CurrentCDSetIndex=0; Kuka.MovementParameterFieldEnabled=True; IlfCommand=SPTP
;ENDFOLD
SPTP XIMM_A1turn WITH $VEL_AXIS[1] = SVEL_JOINT(100.0), $TOOL = STOOL2(FIMM_A1turn), $BASE = SBASE(FIMM_A1turn.BASE_NO), $IPO_MODE = SIPO_MODE(FIMM_A1turn.IPO_FRAME), $LOAD = SLOAD(FIMM_A1turn.TOOL_NO), $ACC_AXIS[1] = SACC_JOINT(PPDAT4), $APO = SAPO_PTP(PPDAT4), $GEAR_JERK[1] = SGEAR_JERK(PPDAT4), $COLLMON_TOL_PRO[1] = USE_CM_PRO_VALUES(0)
;ENDFOLD

Wait For IMMtoR_OpEnable==True 
 Wait For RtoIMM_RobotWithIMM==False


;FOLD Wait for ejector backward signals, 
$TIMER_STOP[2]=True ;stop timer
$TIMER[2]=0 ;reset timer
$TIMER_STOP[2]=False ;stop timer
Loop
       If $TIMER[2]>=5000 Then
              $TIMER_STOP[2]=True ;stop timer
              $TIMER[2]=0 ;reset timer
              IMMtoR_PreEntrErrorEjBck=True
              wait sec 0.25
              IMMtoR_PreEntrErrorEjBck=False
              Wait For IMMtoR_OpEnable==False
              GOTO RetryEntry 
       EndIf          
       If IMMtoR_EjectPosBck==True Then
              Exit      
       EndIf
EndLoop                
 ;ENDFOLD      

;FOLD Wait for mold open signal, fault after 10 seconds of waiting, then move in over sprue, down and into mold pick position, turn on suction cups
$TIMER_STOP[2]=True ;stop timer
$TIMER[2]=0 ;reset timer
$TIMER_STOP[2]=False ;stop timer

Loop   
       
       If $TIMER[2]>=5000 Then
              $TIMER_STOP[2]=True ;stop timer
              $TIMER[2]=0 ;reset timer
              IMMtoR_PlaceErrorMoldOpn=True
              wait sec 0.5      
              IMMtoR_PlaceErrorMoldOpn=False
              Wait For IMMtoR_OpEnable==False              
              GOTO RetryEntry 
       EndIF
       
       If ((IMMtoR_MoldOpen==True) AND ((IMMtoR_PartInjected==True) Or (RtoIMM_SeqNumber<>0)))  Then       
              If IMMtoR_Rejected==True Then
                     RtoPLC_ToolFinReject=True
              EndIf
              RtoIMM_MoldCloseEnable=False
              RtoIMM_MoldAreaFree=False
   ;FOLD SPTP IMM_PickMoldPreEnter CONT Vel=100 % PDAT1 Tool[2]:FinishedPlace Base[3]:IMM ;%{PE}
      ;FOLD Parameters ;%{h}
         ;Params IlfProvider=kukaroboter.basistech.inlineforms.movement.spline; Kuka.IsGlobalPoint=False; Kuka.PointName=IMM_PickMoldPreEnter; Kuka.BlendingEnabled=True; Kuka.MoveDataPtpName=PDAT1; Kuka.VelocityPtp=100; Kuka.VelocityFieldEnabled=True; Kuka.ColDetectFieldEnabled=True; Kuka.CurrentCDSetIndex=0; Kuka.MovementParameterFieldEnabled=True; IlfCommand=SPTP
      ;ENDFOLD
      SPTP XIMM_PickMoldPreEnter WITH $VEL_AXIS[1] = SVEL_JOINT(100.0), $TOOL = STOOL2(FIMM_PickMoldPreEnter), $BASE = SBASE(FIMM_PickMoldPreEnter.BASE_NO), $IPO_MODE = SIPO_MODE(FIMM_PickMoldPreEnter.IPO_FRAME), $LOAD = SLOAD(FIMM_PickMoldPreEnter.TOOL_NO), $ACC_AXIS[1] = SACC_JOINT(PPDAT1), $APO = SAPO_PTP(PPDAT1), $GEAR_JERK[1] = SGEAR_JERK(PPDAT1), $COLLMON_TOL_PRO[1] = USE_CM_PRO_VALUES(0) C_Spl
      ;ENDFOLD
;FOLD SLIN IMM_PickApprOvrSpru CONT Vel=1.5 m/s CPDAT01 Tool[1]:BlankPick Base[4]:SprueCutter ;%{PE}
;FOLD Parameters ;%{h}
;Params IlfProvider=kukaroboter.basistech.inlineforms.movement.spline; Kuka.IsGlobalPoint=False; Kuka.PointName=IMM_PickApprOvrSpru; Kuka.BlendingEnabled=True; Kuka.MoveDataName=CPDAT01; Kuka.VelocityPath=1.5; Kuka.VelocityFieldEnabled=True; Kuka.ColDetectFieldEnabled=True; Kuka.CurrentCDSetIndex=0; Kuka.MovementParameterFieldEnabled=True; IlfCommand=SLIN
;ENDFOLD
SLIN XIMM_PickApprOvrSpru WITH $VEL = SVEL_CP(1.5, , LCPDAT01), $TOOL = STOOL2(FIMM_PickApprOvrSpru), $BASE = SBASE(FIMM_PickApprOvrSpru.BASE_NO), $IPO_MODE = SIPO_MODE(FIMM_PickApprOvrSpru.IPO_FRAME), $LOAD = SLOAD(FIMM_PickApprOvrSpru.TOOL_NO), $ACC = SACC_CP(LCPDAT01), $ORI_TYPE = SORI_TYP(LCPDAT01), $APO = SAPO(LCPDAT01), $JERK = SJERK(LCPDAT01), $COLLMON_TOL_PRO[1] = USE_CM_PRO_VALUES(0) C_Spl
;ENDFOLD
;FOLD SLIN IMM_PickAppr Vel=1 m/s CPDAT2 Tool[2]:FinishedPlace Base[3]:IMM ;%{PE}
;FOLD Parameters ;%{h}
;Params IlfProvider=kukaroboter.basistech.inlineforms.movement.spline; Kuka.IsGlobalPoint=False; Kuka.PointName=IMM_PickAppr; Kuka.BlendingEnabled=False; Kuka.MoveDataName=CPDAT2; Kuka.VelocityPath=1; Kuka.VelocityFieldEnabled=True; Kuka.ColDetectFieldEnabled=True; Kuka.CurrentCDSetIndex=0; Kuka.MovementParameterFieldEnabled=True; IlfCommand=SLIN
;ENDFOLD
SLIN XIMM_PickAppr WITH $VEL = SVEL_CP(1.0, , LCPDAT2), $TOOL = STOOL2(FIMM_PickAppr), $BASE = SBASE(FIMM_PickAppr.BASE_NO), $IPO_MODE = SIPO_MODE(FIMM_PickAppr.IPO_FRAME), $LOAD = SLOAD(FIMM_PickAppr.TOOL_NO), $ACC = SACC_CP(LCPDAT2), $ORI_TYPE = SORI_TYP(LCPDAT2), $APO = SAPO(LCPDAT2), $JERK = SJERK(LCPDAT2), $COLLMON_TOL_PRO[1] = USE_CM_PRO_VALUES(0)
;ENDFOLD
;FOLD SLIN IMM_Pick Vel=0.05 m/s CPDAT1 Tool[2]:FinishedPlace Base[3]:IMM ;%{PE}
;FOLD Parameters ;%{h}
;Params IlfProvider=kukaroboter.basistech.inlineforms.movement.spline; Kuka.IsGlobalPoint=False; Kuka.PointName=IMM_Pick; Kuka.BlendingEnabled=False; Kuka.MoveDataName=CPDAT1; Kuka.VelocityPath=0.05; Kuka.VelocityFieldEnabled=True; Kuka.ColDetectFieldEnabled=True; Kuka.CurrentCDSetIndex=0; Kuka.MovementParameterFieldEnabled=True; IlfCommand=SLIN
;ENDFOLD
SLIN XIMM_Pick WITH $VEL = SVEL_CP(0.05, , LCPDAT1), $TOOL = STOOL2(FIMM_Pick), $BASE = SBASE(FIMM_Pick.BASE_NO), $IPO_MODE = SIPO_MODE(FIMM_Pick.IPO_FRAME), $LOAD = SLOAD(FIMM_Pick.TOOL_NO), $ACC = SACC_CP(LCPDAT1), $ORI_TYPE = SORI_TYP(LCPDAT1), $APO = SAPO(LCPDAT1), $JERK = SJERK(LCPDAT1), $COLLMON_TOL_PRO[1] = USE_CM_PRO_VALUES(0)
;ENDFOLD
              RtoPLC_FinishCupAVac=True
              RtoPLC_FinishCupBVac=True
              $TIMER_STOP[2]=True ;stop timer
              $TIMER[2]=0 ;reset timer
              Exit
       EndIf
       
       If ((IMMtoR_MoldOpen==True) AND ((IMMtoR_PartInjected==False) And (RtoIMM_SeqNumber==0)))  Then 
              RtoIMM_MoldCloseEnable=False
              RtoIMM_MoldAreaFree=False
   ;FOLD SPTP IMM_PickMoldPreEnter CONT Vel=100 % PDAT1 Tool[2]:FinishedPlace Base[3]:IMM ;%{PE}
      ;FOLD Parameters ;%{h}
         ;Params IlfProvider=kukaroboter.basistech.inlineforms.movement.spline; Kuka.IsGlobalPoint=False; Kuka.PointName=IMM_PickMoldPreEnter; Kuka.BlendingEnabled=True; Kuka.MoveDataPtpName=PDAT1; Kuka.VelocityPtp=100; Kuka.VelocityFieldEnabled=True; Kuka.ColDetectFieldEnabled=True; Kuka.CurrentCDSetIndex=0; Kuka.MovementParameterFieldEnabled=True; IlfCommand=SPTP
      ;ENDFOLD
      SPTP XIMM_PickMoldPreEnter WITH $VEL_AXIS[1] = SVEL_JOINT(100.0), $TOOL = STOOL2(FIMM_PickMoldPreEnter), $BASE = SBASE(FIMM_PickMoldPreEnter.BASE_NO), $IPO_MODE = SIPO_MODE(FIMM_PickMoldPreEnter.IPO_FRAME), $LOAD = SLOAD(FIMM_PickMoldPreEnter.TOOL_NO), $ACC_AXIS[1] = SACC_JOINT(PPDAT1), $APO = SAPO_PTP(PPDAT1), $GEAR_JERK[1] = SGEAR_JERK(PPDAT1), $COLLMON_TOL_PRO[1] = USE_CM_PRO_VALUES(0) C_Spl
      ;ENDFOLD
;FOLD SPTP IMM_PlaceMoldReturn Vel=100 % PDAT15 Tool[1]:BlankPick Base[3]:IMM ;%{PE}
;FOLD Parameters ;%{h}
;Params IlfProvider=kukaroboter.basistech.inlineforms.movement.spline; Kuka.IsGlobalPoint=False; Kuka.PointName=IMM_PlaceMoldReturn; Kuka.BlendingEnabled=False; Kuka.MoveDataPtpName=PDAT15; Kuka.VelocityPtp=100; Kuka.VelocityFieldEnabled=True; Kuka.ColDetectFieldEnabled=True; Kuka.CurrentCDSetIndex=0; Kuka.MovementParameterFieldEnabled=True; IlfCommand=SPTP
;ENDFOLD
SPTP XIMM_PlaceMoldReturn WITH $VEL_AXIS[1] = SVEL_JOINT(100.0), $TOOL = STOOL2(FIMM_PlaceMoldReturn), $BASE = SBASE(FIMM_PlaceMoldReturn.BASE_NO), $IPO_MODE = SIPO_MODE(FIMM_PlaceMoldReturn.IPO_FRAME), $LOAD = SLOAD(FIMM_PlaceMoldReturn.TOOL_NO), $ACC_AXIS[1] = SACC_JOINT(PPDAT15), $APO = SAPO_PTP(PPDAT15), $GEAR_JERK[1] = SGEAR_JERK(PPDAT15), $COLLMON_TOL_PRO[1] = USE_CM_PRO_VALUES(0)
;ENDFOLD

;FOLD SLIN IMM_PlaceReturn Vel=2 m/s CPDAT23 Tool[1]:BlankPick Base[3]:IMM ;%{PE}
;FOLD Parameters ;%{h}
;Params IlfProvider=kukaroboter.basistech.inlineforms.movement.spline; Kuka.IsGlobalPoint=False; Kuka.PointName=IMM_PlaceReturn; Kuka.BlendingEnabled=False; Kuka.MoveDataName=CPDAT23; Kuka.VelocityPath=2; Kuka.VelocityFieldEnabled=True; Kuka.ColDetectFieldEnabled=True; Kuka.CurrentCDSetIndex=0; Kuka.MovementParameterFieldEnabled=True; IlfCommand=SLIN
;ENDFOLD
SLIN XIMM_PlaceReturn WITH $VEL = SVEL_CP(2.0, , LCPDAT23), $TOOL = STOOL2(FIMM_PlaceReturn), $BASE = SBASE(FIMM_PlaceReturn.BASE_NO), $IPO_MODE = SIPO_MODE(FIMM_PlaceReturn.IPO_FRAME), $LOAD = SLOAD(FIMM_PlaceReturn.TOOL_NO), $ACC = SACC_CP(LCPDAT23), $ORI_TYPE = SORI_TYP(LCPDAT23), $APO = SAPO(LCPDAT23), $JERK = SJERK(LCPDAT23), $COLLMON_TOL_PRO[1] = USE_CM_PRO_VALUES(0)
;ENDFOLD
              $TIMER_STOP[2]=True ;stop timer
              $TIMER[2]=0 ;reset timer
              GoTo PlaceInMold
       EndIf
EndLoop 
;ENDFOLD 

;FOLD Wait for suction cup vacuum signals, fault after 10 seconds of waiting (and back out of mold), move ejector forward, 
$TIMER_STOP[2]=True ;stop timer
$TIMER[2]=0 ;reset timer
$TIMER_STOP[2]=False ;stop timer
Loop

       If $TIMER[2]>=5000 Then
              $TIMER_STOP[2]=True ;stop timer
              $TIMER[2]=0 ;reset timer
              If PLCtoR_FinishCupAVacOn==False Then
                     RtoIMM_PickErrorVG528=True
                     
              EndIf
              If PLCtoR_FinishCupBVacOn==False Then
                     RtoIMM_PickErrorVG530=True
             
              EndIf 
              Wait Sec .15
              RtoPLC_FinishCupAVac=False
              RtoPLC_FinishCupBVac=False
              RtoPLC_FinishCupABlow=True
              RtoPLC_FinishCupBBlow=True
              Wait Sec .15
              RtoPLC_FinishCupABlow=False
              RtoPLC_FinishCupBBlow=False
              RtoIMM_PickErrorVG528=False
              RtoIMM_PickErrorVG530=False
              Wait For IMMtoR_OpEnable==False            
              $OV_PRO=30         
              ;FOLD SLIN IMM_Pick Vel=0.05 m/s CPDAT1 Tool[2]:FinishedPlace Base[3]:IMM ;%{PE}
;FOLD Parameters ;%{h}
;Params IlfProvider=kukaroboter.basistech.inlineforms.movement.spline; Kuka.IsGlobalPoint=False; Kuka.PointName=IMM_Pick; Kuka.BlendingEnabled=False; Kuka.MoveDataName=CPDAT1; Kuka.VelocityPath=0.05; Kuka.VelocityFieldEnabled=True; Kuka.ColDetectFieldEnabled=True; Kuka.CurrentCDSetIndex=0; Kuka.MovementParameterFieldEnabled=True; IlfCommand=SLIN
;ENDFOLD
SLIN XIMM_Pick WITH $VEL = SVEL_CP(0.05, , LCPDAT1), $TOOL = STOOL2(FIMM_Pick), $BASE = SBASE(FIMM_Pick.BASE_NO), $IPO_MODE = SIPO_MODE(FIMM_Pick.IPO_FRAME), $LOAD = SLOAD(FIMM_Pick.TOOL_NO), $ACC = SACC_CP(LCPDAT1), $ORI_TYPE = SORI_TYP(LCPDAT1), $APO = SAPO(LCPDAT1), $JERK = SJERK(LCPDAT1), $COLLMON_TOL_PRO[1] = USE_CM_PRO_VALUES(0)
;ENDFOLD
;FOLD SLIN IMM_PickAppr Vel=1 m/s CPDAT2 Tool[2]:FinishedPlace Base[3]:IMM ;%{PE}
;FOLD Parameters ;%{h}
;Params IlfProvider=kukaroboter.basistech.inlineforms.movement.spline; Kuka.IsGlobalPoint=False; Kuka.PointName=IMM_PickAppr; Kuka.BlendingEnabled=False; Kuka.MoveDataName=CPDAT2; Kuka.VelocityPath=1; Kuka.VelocityFieldEnabled=True; Kuka.ColDetectFieldEnabled=True; Kuka.CurrentCDSetIndex=0; Kuka.MovementParameterFieldEnabled=True; IlfCommand=SLIN
;ENDFOLD
SLIN XIMM_PickAppr WITH $VEL = SVEL_CP(1.0, , LCPDAT2), $TOOL = STOOL2(FIMM_PickAppr), $BASE = SBASE(FIMM_PickAppr.BASE_NO), $IPO_MODE = SIPO_MODE(FIMM_PickAppr.IPO_FRAME), $LOAD = SLOAD(FIMM_PickAppr.TOOL_NO), $ACC = SACC_CP(LCPDAT2), $ORI_TYPE = SORI_TYP(LCPDAT2), $APO = SAPO(LCPDAT2), $JERK = SJERK(LCPDAT2), $COLLMON_TOL_PRO[1] = USE_CM_PRO_VALUES(0)
;ENDFOLD
;FOLD SLIN IMM_PickApprOvrSpru CONT Vel=1.5 m/s CPDAT01 Tool[1]:BlankPick Base[4]:SprueCutter ;%{PE}
;FOLD Parameters ;%{h}
;Params IlfProvider=kukaroboter.basistech.inlineforms.movement.spline; Kuka.IsGlobalPoint=False; Kuka.PointName=IMM_PickApprOvrSpru; Kuka.BlendingEnabled=True; Kuka.MoveDataName=CPDAT01; Kuka.VelocityPath=1.5; Kuka.VelocityFieldEnabled=True; Kuka.ColDetectFieldEnabled=True; Kuka.CurrentCDSetIndex=0; Kuka.MovementParameterFieldEnabled=True; IlfCommand=SLIN
;ENDFOLD
SLIN XIMM_PickApprOvrSpru WITH $VEL = SVEL_CP(1.5, , LCPDAT01), $TOOL = STOOL2(FIMM_PickApprOvrSpru), $BASE = SBASE(FIMM_PickApprOvrSpru.BASE_NO), $IPO_MODE = SIPO_MODE(FIMM_PickApprOvrSpru.IPO_FRAME), $LOAD = SLOAD(FIMM_PickApprOvrSpru.TOOL_NO), $ACC = SACC_CP(LCPDAT01), $ORI_TYPE = SORI_TYP(LCPDAT01), $APO = SAPO(LCPDAT01), $JERK = SJERK(LCPDAT01), $COLLMON_TOL_PRO[1] = USE_CM_PRO_VALUES(0) C_Spl
;ENDFOLD
;FOLD SLIN IMM_PickMoldPreEnter Vel=2 m/s CPDAT29 Tool[2]:FinishedPlace Base[3]:IMM ;%{PE}
;FOLD Parameters ;%{h}
;Params IlfProvider=kukaroboter.basistech.inlineforms.movement.spline; Kuka.IsGlobalPoint=False; Kuka.PointName=IMM_PickMoldPreEnter; Kuka.BlendingEnabled=False; Kuka.MoveDataName=CPDAT29; Kuka.VelocityPath=2; Kuka.VelocityFieldEnabled=True; Kuka.ColDetectFieldEnabled=True; Kuka.CurrentCDSetIndex=0; Kuka.MovementParameterFieldEnabled=True; IlfCommand=SLIN
;ENDFOLD
SLIN XIMM_PickMoldPreEnter WITH $VEL = SVEL_CP(2.0, , LCPDAT29), $TOOL = STOOL2(FIMM_PickMoldPreEnter), $BASE = SBASE(FIMM_PickMoldPreEnter.BASE_NO), $IPO_MODE = SIPO_MODE(FIMM_PickMoldPreEnter.IPO_FRAME), $LOAD = SLOAD(FIMM_PickMoldPreEnter.TOOL_NO), $ACC = SACC_CP(LCPDAT29), $ORI_TYPE = SORI_TYP(LCPDAT29), $APO = SAPO(LCPDAT29), $JERK = SJERK(LCPDAT29), $COLLMON_TOL_PRO[1] = USE_CM_PRO_VALUES(0)
;ENDFOLD
;FOLD SPTP IMM_A1Return Vel=100 % PDAT5 Tool[0] Base[0] ;%{PE}
;FOLD Parameters ;%{h}
;Params IlfProvider=kukaroboter.basistech.inlineforms.movement.spline; Kuka.IsGlobalPoint=False; Kuka.PointName=IMM_A1Return; Kuka.BlendingEnabled=False; Kuka.MoveDataPtpName=PDAT5; Kuka.VelocityPtp=100; Kuka.VelocityFieldEnabled=True; Kuka.ColDetectFieldEnabled=True; Kuka.CurrentCDSetIndex=0; Kuka.MovementParameterFieldEnabled=True; IlfCommand=SPTP
;ENDFOLD
SPTP XIMM_A1Return WITH $VEL_AXIS[1] = SVEL_JOINT(100.0), $TOOL = STOOL2(FIMM_A1Return), $BASE = SBASE(FIMM_A1Return.BASE_NO), $IPO_MODE = SIPO_MODE(FIMM_A1Return.IPO_FRAME), $LOAD = SLOAD(FIMM_A1Return.TOOL_NO), $ACC_AXIS[1] = SACC_JOINT(PPDAT5), $APO = SAPO_PTP(PPDAT5), $GEAR_JERK[1] = SGEAR_JERK(PPDAT5), $COLLMON_TOL_PRO[1] = USE_CM_PRO_VALUES(0)
;ENDFOLD
RtoIMM_MoldAreaFree=True
              Rjct_1Blnk_2Fin_3Both=2
              Station500_Reject()
              RtoIMM_SeqNumber=0
              GOTO EndOfModule
       EndIf 
 
       If ((PLCtoR_FinishCupAVacOn==True) And (PLCtoR_FinishCupBVacOn==True)) Then
              $TIMER_STOP[2]=True ;stop timer
              $TIMER[2]=0 ;reset timer
              RtoIMM_MoldEjectFrw=True

              Exit
       EndIf          
       
EndLoop
;ENDFOLD

;FOLD Wait for ejector forward signals, fault after 10 seconds of waiting (and back out of mold), Lift away part and send ejector backward 
$TIMER_STOP[2]=True ;stop timer
$TIMER[2]=0 ;reset timer
$TIMER_STOP[2]=False ;stop timer
Loop
       If $TIMER[2]>=5000 Then
              $TIMER_STOP[2]=True ;stop timer
              $TIMER[2]=0 ;reset timer
              IMMtoR_PlaceErrorEjFrw=True
              Wait Sec .15
              IMMtoR_PlaceErrorEjFrw=False
              RtoIMM_MoldEjectFrw=False
              RtoPLC_FinishCupAVac=False
              RtoPLC_FinishCupBVac=False
              RtoPLC_FinishCupABlow=True
              RtoPLC_FinishCupBBlow=True
              Wait Sec .15
              RtoPLC_FinishCupABlow=False
              RtoPLC_FinishCupBBlow=False
              Wait For IMMtoR_OpEnable==False         
              $OV_PRO=30              
              ;FOLD SLIN IMM_Pick Vel=0.05 m/s CPDAT1 Tool[2]:FinishedPlace Base[3]:IMM ;%{PE}
;FOLD Parameters ;%{h}
;Params IlfProvider=kukaroboter.basistech.inlineforms.movement.spline; Kuka.IsGlobalPoint=False; Kuka.PointName=IMM_Pick; Kuka.BlendingEnabled=False; Kuka.MoveDataName=CPDAT1; Kuka.VelocityPath=0.05; Kuka.VelocityFieldEnabled=True; Kuka.ColDetectFieldEnabled=True; Kuka.CurrentCDSetIndex=0; Kuka.MovementParameterFieldEnabled=True; IlfCommand=SLIN
;ENDFOLD
SLIN XIMM_Pick WITH $VEL = SVEL_CP(0.05, , LCPDAT1), $TOOL = STOOL2(FIMM_Pick), $BASE = SBASE(FIMM_Pick.BASE_NO), $IPO_MODE = SIPO_MODE(FIMM_Pick.IPO_FRAME), $LOAD = SLOAD(FIMM_Pick.TOOL_NO), $ACC = SACC_CP(LCPDAT1), $ORI_TYPE = SORI_TYP(LCPDAT1), $APO = SAPO(LCPDAT1), $JERK = SJERK(LCPDAT1), $COLLMON_TOL_PRO[1] = USE_CM_PRO_VALUES(0)
;ENDFOLD
