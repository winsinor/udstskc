<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="SINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
</LocalTags>
<Routines>
<Routine Name="EnableInFalse" Type="RLL">
<Description>
<![CDATA[Executes when the rung is false]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[OTU(EN);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[OTL(EN);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(Increment_Select)OTE(Map_Axis_Outputs.Increment_Select);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(Push_Select)OTE(Map_Axis_Outputs.Push_Select);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(Push_Direction)OTE(Map_Axis_Outputs.Push_Direction);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(Home)ONS(One_shot.0)XIC(Map_Axis_Inputs.Servo_is_On)XIO(Map_Axis_Outputs.Start_Move)OTL(Map_Axis_Outputs.Home);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(Map_Axis_Outputs.Home)XIC(Map_Axis_Inputs.Homing)OTU(Map_Axis_Outputs.Home);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[When The AOI is told to Go to Position all the data that relates to the move will be read in and the move request will be started]]>
</Comment>
<Text>
<![CDATA[XIC(Start_Move)ONS(One_shot.1)[MOV(Target_Position,Map_Axis_Outputs.Target_Position) MOV(Target_Speed,Map_Axis_Outputs.Target_Speed) ,MOV(Accel,Map_Axis_Outputs.Acceleration) MOV(Decel,Map_Axis_Outputs.Deceleration) MOV(Position_Band,Map_Axis_Outputs.Position_Band) ,MOV(PZone_Lower_Limit,Map_Axis_Outputs.Zone_Boundary_Neg) MOV(PZone_Upper_Limit,Map_Axis_Outputs.Zone_Boundary_Pos) ,XIC(Push_Select) CPT(Map_Axis_Outputs.Push_Percent,(Push_Percent * 255) * .01) CPT(Map_Axis_Outputs.Load_Threshold_Percent,(Load_Threshold_Percent * 255) * .01) ,XIO(Push_Select) CLR(Map_Axis_Outputs.Push_Percent) CLR(Map_Axis_Outputs.Load_Threshold_Percent) ]OTL(Map_Axis_Outputs.Start_Move);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[[XIC(Map_Axis_Outputs.Start_Move) XIO(Map_Axis_Inputs.Position_Complete) XIO(Map_Axis_Inputs.Push_Failed) ,XIO(Map_Axis_Inputs.Home_Complete) ,XIC(Map_Axis_Inputs.Alarm_Active) ]OTU(Map_Axis_Outputs.Start_Move);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
<Dependencies>
<Dependency Type="DataType" Name="SCON_Inputs"/>
<Dependency Type="DataType" Name="SCON_Outputs"/>
</Dependencies>
</AddOnInstructionDefinition>
