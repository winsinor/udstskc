<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Color of  Upstacker Tray Parts]]>
</Comment>
<Text>
<![CDATA[[XIO(UpAxis_Memory[UpAxis_CurrentLayer].0) MOV(0,UpStacker_Part_1_Status.Button_Color) ,XIC(AlwaysOff) MOV(1,UpStacker_Part_1_Status.Button_Color) ,XIC(AlwaysOff) MOV(2,UpStacker_Part_1_Status.Button_Color) ,XIC(AlwaysOff) MOV(3,UpStacker_Part_1_Status.Button_Color) ,XIC(UpAxis_Memory[UpAxis_CurrentLayer].0) MOV(4,UpStacker_Part_1_Status.Button_Color) ];]]>
