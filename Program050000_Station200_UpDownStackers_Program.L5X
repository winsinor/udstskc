</Text>
</Rung>
<Rung Number="30" Type="N">
<Text>
<![CDATA[XIC(IAI_Alarms.12)ALMD(IAI_ALMD_12,HMI_FaultAck_All,HMI_FaultReset_All,0,0);]]>
</Text>
</Rung>
<Rung Number="31" Type="N">
<Text>
<![CDATA[XIC(System_AutoMode)XIC(DnAxis_DriveManualMode)TON(StkAlmDly[7],?,?)XIC(StkAlmDly[7].DN)OTL(IAI_Alarms.13);]]>
</Text>
</Rung>
<Rung Number="32" Type="N">
<Text>
<![CDATA[XIC(IAI_Alarms.13)ALMD(IAI_ALMD_13,HMI_FaultAck_All,HMI_FaultReset_All,0,0);]]>
</Text>
</Rung>
<Rung Number="33" Type="N">
<Text>
<![CDATA[XIC(UpAxis_MoveFailedTON.DN)OTL(IAI_Alarms.14);]]>
</Text>
</Rung>
<Rung Number="34" Type="N">
<Text>
<![CDATA[XIC(IAI_Alarms.14)ALMD(IAI_ALMD_14,HMI_FaultAck_All,HMI_FaultReset_All,0,0);]]>
</Text>
</Rung>
<Rung Number="35" Type="N">
<Text>
<![CDATA[XIC(DnAxis_MoveFailedTON.DN)OTL(IAI_Alarms.15);]]>
</Text>
</Rung>
<Rung Number="36" Type="N">
<Text>
<![CDATA[XIC(IAI_Alarms.15)ALMD(IAI_ALMD_15,HMI_FaultAck_All,HMI_FaultReset_All,0,0);]]>
