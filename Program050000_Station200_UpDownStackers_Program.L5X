</Rung>
<Rung Number="37" Type="N">
<Text>
<![CDATA[XIC(UpAxis_PushFailed)OTL(IAI_Alarms.16);]]>
</Text>
</Rung>
<Rung Number="38" Type="N">
<Text>
<![CDATA[XIC(IAI_Alarms.16)ALMD(IAI_ALMD_16,HMI_FaultAck_All,HMI_FaultReset_All,0,0);]]>
