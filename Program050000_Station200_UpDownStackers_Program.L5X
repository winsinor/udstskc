<Routines>
<Routine Name="OLD_CODE_DELETE" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Check Upstacker Tray Count Auto Sequence
0/1: Decide jog direction
2/3: jog until sensor changes state
4: move to flush level

]]>
</Comment>
<Text>
<![CDATA[[XIC(EnableUpDownStackerCheck) XIC(System_AutoMode) XIC(CheckStackerTrays) ,XIC(WinTest.5) ]XIO(UpAxis_AlarmActive)XIO(RequestReload)XIO(RobotAtStacker)[XIC(UpStacker_Within_Soft_Limits) ,XIC(UpstackCheckAutoSeq_Start) ][XIC(CheckUpstackerTrays) XIC(CheckStackerTrays_YesPB) ,XIC(UpstackCheckAutoSeq_Start) XIO(UpstackCheckAutoSeqMov_req.5) ][LIM(0,UpAxis_CurrentLayer,12) [OTE(UpstackCheckAutoSeq_Start) ,ONS(FillStartLevelONS) [ADD(UpAxis_CurrentLayer,1,UpStackCheck_FillStartLevel) ,OTU(UpAxis_ClosestLayerFound) ] ] ,[LES(UpAxis_CurrentLayer,1) ,GRT(UpAxis_CurrentLayer,11) ,XIO(UpStacker_Within_Soft_Limits) ] XIC(WinComeBack) OTE(UpStack_Level_Alarm) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(UpstackCheckAutoSeq_Start)[[XIO(UpStack_TraySensorTON.DN) ,XIC(UpstackCheckAutoSeqMov_req.0) ] XIO(UpstackCheckAutoSeqMov_req.1) OTE(UpstackCheckAutoSeqMov_req.0) ,[XIC(UpStack_TraySensorTON.DN) ,XIC(UpstackCheckAutoSeqMov_req.1) ] XIO(UpstackCheckAutoSeqMov_req.0) OTE(UpstackCheckAutoSeqMov_req.1) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[jog axis up until sensor changes, get closest position
]]>
</Comment>
<Text>
<![CDATA[XIC(UpstackCheckAutoSeqMov_req.0)[XIO(UpStack_TraySensorTON.DN) XIO(UpstackCheckAutoSeqMov_req.2) OTE(UpStack_Auto_Jog_Up) ,[XIC(UpStack_TraySensorTON.DN) ,XIC(UpstackCheckAutoSeqMov_req.2) ] OTE(UpstackCheckAutoSeqMov_req.2) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[jog axis until sensor changes, get closest position
]]>
</Comment>
<Text>
<![CDATA[XIC(UpstackCheckAutoSeqMov_req.1)[XIC(UpStack_TraySensorTON.DN) XIO(UpstackCheckAutoSeqMov_req.3) OTE(UpStack_Auto_Jog_Down) ,[XIO(UpStack_TraySensorTON.DN) ,XIC(UpstackCheckAutoSeqMov_req.3) ] OTE(UpstackCheckAutoSeqMov_req.3) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Run closest tray level check and fill memory to that point
]]>
</Comment>
<Text>
<![CDATA[[XIC(UpstackCheckAutoSeqMov_req.2) ,XIC(UpstackCheckAutoSeqMov_req.3) ]XIC(UpAxis_ClosestLayerFound)[XIO(UpstackCheckAutoSeqMov_req.4) [FOR(R201_Data_Fill_Loop,R201_Index,UpStackCheck_FillStartLevel,UpAxis_ClosestLayer,1) ,ADD(UpAxis_ClosestLayer,1,R202_Init) ,FOR(R202_Data_Clear_Loop,R202_Index,R202_Init,12,1) ] ,OTE(UpstackCheckAutoSeqMov_req.4) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Go to correct level
]]>
</Comment>
<Text>
<![CDATA[XIC(UpstackCheckAutoSeqMov_req.4)TON(UpDataSendDelay,?,?)XIC(UpDataSendDelay.DN)MOV(UpAxis_ClosestLayer,UpAxis_LayerTarget)[OTU(CheckUpstackerTrays) ,OTU(UpstackCheckAutoSeq_Start) ,OTE(UpstackCheckAutoSeqMov_req.5) ,OTU(UpAxis_ClosestLayerFound) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Check Downstacker Tray Count Auto Sequence
0/1: Decide jog direction
2/3: jog until sensor changes state
4: move to flush level

]]>
</Comment>
<Text>
<![CDATA[XIC(EnableUpDownStackerCheck)XIC(System_AutoMode)XIO(DnAxis_AlarmActive)[XIC(DnStacker_Within_Soft_Limits) ,XIC(DownStackCheckAutoSeq_Start) ]XIO(RobotAtStacker)[XIC(CheckDownStackerTrays) XIC(CheckStackerTrays_YesPB) ,XIC(DownStackCheckAutoSeq_Start) XIO(DnStackCheckAutoSeqMov_Req.4) ][LIM(1,DnAxis_CurrentLayer,12) [OTE(DownStackCheckAutoSeq_Start) ,ONS(FillStartLevelDownONS) [ADD(DnAxis_CurrentLayer,1,DnStackCheck_FillStartLevel) ,OTU(DnAxis_ClosestLayerFound) ] ] ,[LES(DnAxis_CurrentLayer,1) ,GRT(DnAxis_CurrentLayer,11) ,XIO(DnStacker_Within_Soft_Limits) ] XIC(WinComeBack) OTE(DnStack_Level_Alarm) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(DownStackCheckAutoSeq_Start)[[XIC(DnStack_TraySensorTON.DN) ,XIC(DnStackCheckAutoSeqMov_Req.0) ] XIO(DnStackCheckAutoSeqMov_Req.1) OTE(DnStackCheckAutoSeqMov_Req.0) ,[XIO(DnStack_TraySensorTON.DN) ,XIC(DnStackCheckAutoSeqMov_Req.1) ] XIO(DnStackCheckAutoSeqMov_Req.0) OTE(DnStackCheckAutoSeqMov_Req.1) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[jog axis until sensor changes, get closest position
]]>
</Comment>
<Text>
<![CDATA[XIC(DnStackCheckAutoSeqMov_Req.0)[XIC(DnStack_TraySensorTON.DN) XIO(DnStackCheckAutoSeqMov_Req.2) OTE(DnStack_Auto_Jog_Down) ,[XIO(DnStack_TraySensorTON.DN) ,XIC(DnStackCheckAutoSeqMov_Req.2) ] OTE(DnStackCheckAutoSeqMov_Req.2) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[jog axis until sensor changes, get closest position
]]>
</Comment>
<Text>
<![CDATA[XIC(DnStackCheckAutoSeqMov_Req.1)[XIO(DnStack_TraySensorTON.DN) XIO(DnStackCheckAutoSeqMov_Req.3) OTE(DnStack_Auto_Jog_Up) ,[XIC(DnStack_TraySensorTON.DN) ,XIC(DnStackCheckAutoSeqMov_Req.3) ] OTE(DnStackCheckAutoSeqMov_Req.3) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Go to correct level
]]>
</Comment>
<Text>
<![CDATA[[XIC(DnStackCheckAutoSeqMov_Req.2) ,XIC(DnStackCheckAutoSeqMov_Req.3) ]XIC(DnAxis_ClosestLayerFound)TON(DownDataSendDelay,?,?)XIC(DownDataSendDelay.DN)MOV(DnAxis_ClosestLayer,DnAxis_LayerTarget)[OTE(DnStackCheckAutoSeqMov_Req.4) ,OTU(CheckDownStackerTrays) ,OTU(DownStackCheckAutoSeq_Start) ,OTU(DnAxis_ClosestLayerFound) ,OTU(CheckDownStackerTrays) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R000_Main" Type="RLL">
<Description>
<![CDATA[Main.]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[JSR(R100_UpAxis,0)JSR(R101_DownAxis,0)JSR(R200_Tray_Positions_and_Data,0)JSR(R300_Auto_Sequence,0)JSR(_01_IAI_Faults,0)JSR(_08_HMI_Animations,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R100_UpAxis" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[CPS(IAI_UpStacker:I,UpStack_Inputs,1);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[SCON_Status(UpAxis_Sts,UpAxis_Position,UpAxis_Speed,UpAxis_AlarmActive,UpAxis_AlarmCode,UpAxis_BatteryAlarm,UpAxis_CommandCurrent,UpAxis_HomeComplete,UpAxis_Homing,UpAxis_EStop,UpAxis_InPushZone,UpAxis_InPZone,UpAxis_InZone1,UpAxis_InZone2,UpAxis_LoadReached,UpAxis_DriveManualMode,UpAxis_Moving,UpAxis_PositionComplete,UpAxis_PushFailed,UpAxis_DriveReady,UpAxis_ServoOn,UpAxis_TorqueReached,UpAxis_TotalMoveCount,UpAxis_TotalMoveDistance,UpStack_Inputs);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(POWER_OK_24VB)XIO(Unlock_Doors)[OTE(UpAxis_Cmd_ServoOn) ,OTE(CR614) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[limit was 2560 before changed to 1300
]]>
</Comment>
<Text>
<![CDATA[LEQ(UpAxis_Position,28604)GEQ(UpAxis_Position,1300)OTE(UpStacker_Within_Soft_Limits);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Need to add software limits to stop movement Up
]]>
</Comment>
<Text>
<![CDATA[XIC(Motion_Control_OK)XIC(System_ManualMode)XIC(UpAxis_Cmd_ServoOn)XIC(UpStacker_Within_Soft_Limits)OTE(UpStacker_Permit_Up);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Need to add software limits to stop movement Down]]>
</Comment>
<Text>
<![CDATA[XIC(Motion_Control_OK)XIC(System_ManualMode)XIC(UpAxis_Cmd_ServoOn)XIC(UpStacker_Within_Soft_Limits)OTE(UpStacker_Permit_Dn);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(UpStacker_Permit_Up)XIC(HMI_UpStack_GO_PB)OTE(IAI_UpStacker_CMD_Manual_Move);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Change the Up Stacker buttons Colors]]>
</Comment>
<Text>
<![CDATA[[[XIO(UpStacker_Permit_Up) XIO(UpAxis_Homing) XIO(UpAxis_Moving) XIO(UpAxis_AlarmActive) XIC(Motion_Control_OK) MOV(0,UpStacker_Raise.Button_Color) ,XIC(UpStacker_Permit_Up) [XIO(UpAxis_AlarmActive) XIC(UpAxis_DriveReady) MOV(1,UpStacker_Raise.Button_Color) ,XIC(UpAxis_PositionComplete) MOV(4,UpStacker_Raise.Button_Color) ,[XIC(UpAxis_Homing) ,XIC(UpAxis_Moving) ] MOV(3,UpStacker_Raise.Button_Color) ] ,[XIO(UpAxis_DriveReady) ,XIC(UpAxis_AlarmActive) ,XIO(Motion_Control_OK) ] MOV(2,UpStacker_Raise.Button_Color) ] ,[XIO(UpStacker_Permit_Dn) XIO(UpAxis_Homing) XIO(UpAxis_Moving) XIO(UpAxis_AlarmActive) XIC(Motion_Control_OK) MOV(0,UpStacker_Lower.Button_Color) ,XIC(UpStacker_Permit_Dn) [XIO(UpAxis_AlarmActive) XIC(UpAxis_DriveReady) MOV(1,UpStacker_Lower.Button_Color) ,[XIC(UpAxis_Homing) ,XIC(UpAxis_Moving) ] MOV(3,UpStacker_Lower.Button_Color) ,XIC(UpAxis_PositionComplete) MOV(4,UpStacker_Lower.Button_Color) ] ,[XIO(UpAxis_DriveReady) ,XIC(UpAxis_AlarmActive) ,XIO(Motion_Control_OK) ] MOV(2,UpStacker_Lower.Button_Color) ] ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[[[LEQ(UpAxis_Position,28604) [XIC(System_ManualMode) XIC(UpAxis_Cmd_JogFwd_HMI) ,XIC(UpStack_Auto_Jog_Up) ] ,XIC(force_upaxis_up) ] OTE(UpAxis_Cmd_JogFwd) ,[GEQ(UpAxis_Position,2560) [XIC(System_ManualMode) XIC(UpAxis_Cmd_JogRev_HMI) ,XIC(UpStack_Auto_Jog_Down) ] ,XIC(force_upaxis_down) ] OTE(UpAxis_Cmd_JogRev) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(HMI_Reset)OTE(UpAxis_Cmd_Reset);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[SCON_Operations(UpAxis_Ops,UpAxis_Cmd_ServoOn,UpAxis_Cmd_Pause,UpAxis_Cmd_Inch,UpAxis_Cmd_JogFwd,UpAxis_Cmd_JogRev,UpAxis_Cmd_Reset,UpAxis_Cmd_BrakeRelease,UpStack_Outputs);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[SCON_Moves(UpAxis_Mov,UpAxis_Cmd_Home,UpAxis_Cmd_StartMove,UpAxis_Target,UpStack_Target_Speed,UpStack_Output_Acceleration,UpStack_Output_Deceleration,UpAxis_Band,UpAxis_Increment_Select,UpAxis_Push_Select,UpAxis_Push_Direction,UpAxis_Push_Percent,UpAxis_Load_Threshold,UpAxis_PZone_Upper,UpAxis_PZone_Lower,UpStack_Inputs,UpStack_Outputs);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[unlatch the start bit when move command is off
]]>
</Comment>
<Text>
<![CDATA[XIO(UpAxis_Cmd_StartMove)OTU(UpStack_Outputs.Start_Move);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Write the Outputs
]]>
</Comment>
<Text>
<![CDATA[CPS(UpStack_Outputs,IAI_UpStacker:O,1);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[XIC(UpAxis_ServoOn)XIC(UpAxis_DriveReady)XIC(UpAxis_HomeComplete)XIO(UpAxis_AlarmActive)XIO(UpAxis_EStop)OTE(UpAxis_ReadyToMove);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[XIC(System_ManualMode)XIC(UpAxis_ReadyToMove)LIM(1,UpAxis_LayerRequest,12)XIC(IAI_UpStacker_CMD_Manual_Move)MOV(UpAxis_LayerRequest,UpAxis_LayerTarget);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[[XIC(UpStacker_Permit_Up) XIC(UpAxis_IncrementLayer) XIO(UpAxis_DecrementLayer) LES(UpAxis_CurrentLayer,13) ADD(UpAxis_CurrentLayer,1,UpAxis_LayerTarget) ,XIC(UpStacker_Permit_Dn) XIC(UpAxis_DecrementLayer) XIO(UpAxis_IncrementLayer) GRT(UpAxis_CurrentLayer,1) SUB(UpAxis_CurrentLayer,1,UpAxis_LayerTarget) ]OTE(UpAxis_MoveToLayerTarget);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[GEQ(UpAxis_CurrentLayer,11)OTU(UpAxis_IncrementLayer);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[LEQ(UpAxis_CurrentLayer,1)OTU(UpAxis_DecrementLayer);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[Confirm position move successful, update current position

]]>
</Comment>
<Text>
<![CDATA[[XIC(UpAxis_PositionComplete) [ONS(PositionCompleteONS) ,] ,][ADD(UpAxis_Positions[0],1300,UpAxis_PositionsPosLim[0]) SUB(UpAxis_Positions[0],NegLim,UpAxis_PositionsNegLim[0]) LIM(UpAxis_PositionsNegLim[0],UpAxis_Position,UpAxis_PositionsPosLim[0]) MOV(0,UpAxis_CurrentLayer) ,ADD(UpAxis_Positions[1],PosLim,UpAxis_PositionsPosLim[1]) SUB(UpAxis_Positions[1],NegLim,UpAxis_PositionsNegLim[1]) LIM(UpAxis_PositionsNegLim[1],UpAxis_Position,UpAxis_PositionsPosLim[1]) MOV(1,UpAxis_CurrentLayer) ,ADD(UpAxis_Positions[2],PosLim,UpAxis_PositionsPosLim[2]) SUB(UpAxis_Positions[2],NegLim,UpAxis_PositionsNegLim[2]) LIM(UpAxis_PositionsNegLim[2],UpAxis_Position,UpAxis_PositionsPosLim[2]) MOV(2,UpAxis_CurrentLayer) ,ADD(UpAxis_Positions[3],PosLim,UpAxis_PositionsPosLim[3]) SUB(UpAxis_Positions[3],NegLim,UpAxis_PositionsNegLim[3]) LIM(UpAxis_PositionsNegLim[3],UpAxis_Position,UpAxis_PositionsPosLim[3]) MOV(3,UpAxis_CurrentLayer) ,ADD(UpAxis_Positions[4],PosLim,UpAxis_PositionsPosLim[4]) SUB(UpAxis_Positions[4],NegLim,UpAxis_PositionsNegLim[4]) LIM(UpAxis_PositionsNegLim[4],UpAxis_Position,UpAxis_PositionsPosLim[4]) MOV(4,UpAxis_CurrentLayer) ,ADD(UpAxis_Positions[5],PosLim,UpAxis_PositionsPosLim[5]) SUB(UpAxis_Positions[5],NegLim,UpAxis_PositionsNegLim[5]) LIM(UpAxis_PositionsNegLim[5],UpAxis_Position,UpAxis_PositionsPosLim[5]) MOV(5,UpAxis_CurrentLayer) ,ADD(UpAxis_Positions[6],PosLim,UpAxis_PositionsPosLim[6]) SUB(UpAxis_Positions[6],NegLim,UpAxis_PositionsNegLim[6]) LIM(UpAxis_PositionsNegLim[6],UpAxis_Position,UpAxis_PositionsPosLim[6]) MOV(6,UpAxis_CurrentLayer) ,ADD(UpAxis_Positions[7],PosLim,UpAxis_PositionsPosLim[7]) SUB(UpAxis_Positions[7],NegLim,UpAxis_PositionsNegLim[7]) LIM(UpAxis_PositionsNegLim[7],UpAxis_Position,UpAxis_PositionsPosLim[7]) MOV(7,UpAxis_CurrentLayer) ,ADD(UpAxis_Positions[8],PosLim,UpAxis_PositionsPosLim[8]) SUB(UpAxis_Positions[8],NegLim,UpAxis_PositionsNegLim[8]) LIM(UpAxis_PositionsNegLim[8],UpAxis_Position,UpAxis_PositionsPosLim[8]) MOV(8,UpAxis_CurrentLayer) ,ADD(UpAxis_Positions[9],PosLim,UpAxis_PositionsPosLim[9]) SUB(UpAxis_Positions[9],NegLim,UpAxis_PositionsNegLim[9]) LIM(UpAxis_PositionsNegLim[9],UpAxis_Position,UpAxis_PositionsPosLim[9]) MOV(9,UpAxis_CurrentLayer) ,ADD(UpAxis_Positions[10],PosLim,UpAxis_PositionsPosLim[10]) SUB(UpAxis_Positions[10],NegLim,UpAxis_PositionsNegLim[10]) LIM(UpAxis_PositionsNegLim[10],UpAxis_Position,UpAxis_PositionsPosLim[10]) MOV(10,UpAxis_CurrentLayer) ,ADD(UpAxis_Positions[11],PosLim,UpAxis_PositionsPosLim[11]) SUB(UpAxis_Positions[11],NegLim,UpAxis_PositionsNegLim[11]) LIM(UpAxis_PositionsNegLim[11],UpAxis_Position,UpAxis_PositionsPosLim[11]) MOV(11,UpAxis_CurrentLayer) ,ADD(UpAxis_Positions[12],PosLim,UpAxis_PositionsPosLim[12]) SUB(UpAxis_Positions[12],NegLim,UpAxis_PositionsNegLim[12]) LIM(UpAxis_PositionsNegLim[12],UpAxis_Position,UpAxis_PositionsPosLim[12]) MOV(12,UpAxis_CurrentLayer) ,ADD(UpAxis_Positions[13],PosLim,UpAxis_PositionsPosLim[13]) SUB(UpAxis_Positions[13],NegLim,UpAxis_PositionsNegLim[13]) LIM(UpAxis_PositionsNegLim[13],UpAxis_Position,UpAxis_PositionsPosLim[13]) MOV(13,UpAxis_CurrentLayer) ];]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[Move to layer
]]>
</Comment>
<Text>
<![CDATA[[[XIC(UpAxis_MoveToLayerTarget) ,[NEQ(UpAxis_LayerTarget,UpAxis_CurrentLayer) XIO(UpstackCheckAutoSeq_Start) ,XIC(UpstackCheckAutoSeqMov_req.4) ] ,XIC(IAI_UpStacker_CMD_Manual_Move) ] ,XIC(UpAxis_Cmd_StartMove) XIO(UpAxis_PositionComplete) ]XIO(UpAxis_Moving)XIC(UpAxis_ReadyToMove)XIO(UpAxis_MoveFailedTON.DN)[ONS(LayerMoveONS) ,]MOV(UpAxis_Positions[UpAxis_LayerTarget],UpAxis_Target)[OTE(UpAxis_Cmd_StartMove) ,TON(UpAxis_MoveFailedTON,?,?) ,OTU(UpAxis_IncrementLayer) OTU(UpAxis_DecrementLayer) ];]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[Find Closest Position


]]>
</Comment>
<Text>
<![CDATA[[XIC(UpdateClosestPosition) ,XIC(UpstackCheckAutoSeqMov_req.2) ,XIC(UpstackCheckAutoSeqMov_req.3) ,NEQ(UpStack_Auto_Position_Update_Request,0) ]ONS(ClosestPosONS)[ADD(UpAxis_Positions[0],ClosestPosLim,UpAxis_PositionsClosestPosLim[0]) SUB(UpAxis_Positions[0],ClosestNegLim,UpAxis_PositionsClosestNegLim[0]) LIM(UpAxis_PositionsClosestNegLim[0],UpAxis_Position,UpAxis_PositionsClosestPosLim[0]) MOV(0,UpAxis_ClosestLayer) ,ADD(UpAxis_Positions[1],ClosestPosLim,UpAxis_PositionsClosestPosLim[1]) SUB(UpAxis_Positions[1],ClosestNegLim,UpAxis_PositionsClosestNegLim[1]) LIM(UpAxis_PositionsClosestNegLim[1],UpAxis_Position,UpAxis_PositionsClosestPosLim[1]) MOV(1,UpAxis_ClosestLayer) ,ADD(UpAxis_Positions[2],ClosestPosLim,UpAxis_PositionsClosestPosLim[2]) SUB(UpAxis_Positions[2],ClosestNegLim,UpAxis_PositionsClosestNegLim[2]) LIM(UpAxis_PositionsClosestNegLim[2],UpAxis_Position,UpAxis_PositionsClosestPosLim[2]) MOV(2,UpAxis_ClosestLayer) ,ADD(UpAxis_Positions[3],ClosestPosLim,UpAxis_PositionsClosestPosLim[3]) SUB(UpAxis_Positions[3],ClosestNegLim,UpAxis_PositionsClosestNegLim[3]) LIM(UpAxis_PositionsClosestNegLim[3],UpAxis_Position,UpAxis_PositionsClosestPosLim[3]) MOV(3,UpAxis_ClosestLayer) ,ADD(UpAxis_Positions[4],ClosestPosLim,UpAxis_PositionsClosestPosLim[4]) SUB(UpAxis_Positions[4],ClosestNegLim,UpAxis_PositionsClosestNegLim[4]) LIM(UpAxis_PositionsClosestNegLim[4],UpAxis_Position,UpAxis_PositionsClosestPosLim[4]) MOV(4,UpAxis_ClosestLayer) ,ADD(UpAxis_Positions[5],ClosestPosLim,UpAxis_PositionsClosestPosLim[5]) SUB(UpAxis_Positions[5],ClosestNegLim,UpAxis_PositionsClosestNegLim[5]) LIM(UpAxis_PositionsClosestNegLim[5],UpAxis_Position,UpAxis_PositionsClosestPosLim[5]) MOV(5,UpAxis_ClosestLayer) ,ADD(UpAxis_Positions[6],ClosestPosLim,UpAxis_PositionsClosestPosLim[6]) SUB(UpAxis_Positions[6],ClosestNegLim,UpAxis_PositionsClosestNegLim[6]) LIM(UpAxis_PositionsClosestNegLim[6],UpAxis_Position,UpAxis_PositionsClosestPosLim[6]) MOV(6,UpAxis_ClosestLayer) ,ADD(UpAxis_Positions[7],ClosestPosLim,UpAxis_PositionsClosestPosLim[7]) SUB(UpAxis_Positions[7],ClosestNegLim,UpAxis_PositionsClosestNegLim[7]) LIM(UpAxis_PositionsClosestNegLim[7],UpAxis_Position,UpAxis_PositionsClosestPosLim[7]) MOV(7,UpAxis_ClosestLayer) ,ADD(UpAxis_Positions[8],ClosestPosLim,UpAxis_PositionsClosestPosLim[8]) SUB(UpAxis_Positions[8],ClosestNegLim,UpAxis_PositionsClosestNegLim[8]) LIM(UpAxis_PositionsClosestNegLim[8],UpAxis_Position,UpAxis_PositionsClosestPosLim[8]) MOV(8,UpAxis_ClosestLayer) ,ADD(UpAxis_Positions[9],ClosestPosLim,UpAxis_PositionsClosestPosLim[9]) SUB(UpAxis_Positions[9],ClosestNegLim,UpAxis_PositionsClosestNegLim[9]) LIM(UpAxis_PositionsClosestNegLim[9],UpAxis_Position,UpAxis_PositionsClosestPosLim[9]) MOV(9,UpAxis_ClosestLayer) ,ADD(UpAxis_Positions[10],ClosestPosLim,UpAxis_PositionsClosestPosLim[10]) SUB(UpAxis_Positions[10],ClosestNegLim,UpAxis_PositionsClosestNegLim[10]) LIM(UpAxis_PositionsClosestNegLim[10],UpAxis_Position,UpAxis_PositionsClosestPosLim[10]) MOV(10,UpAxis_ClosestLayer) ,ADD(UpAxis_Positions[11],ClosestPosLim,UpAxis_PositionsClosestPosLim[11]) SUB(UpAxis_Positions[11],ClosestNegLim,UpAxis_PositionsClosestNegLim[11]) LIM(UpAxis_PositionsClosestNegLim[11],UpAxis_Position,UpAxis_PositionsClosestPosLim[11]) MOV(11,UpAxis_ClosestLayer) ,ADD(UpAxis_Positions[12],ClosestPosLim,UpAxis_PositionsClosestPosLim[12]) SUB(UpAxis_Positions[12],ClosestNegLim,UpAxis_PositionsClosestNegLim[12]) LIM(UpAxis_PositionsClosestNegLim[12],UpAxis_Position,UpAxis_PositionsClosestPosLim[12]) MOV(12,UpAxis_ClosestLayer) ,ADD(UpAxis_Positions[13],ClosestPosLim,UpAxis_PositionsClosestPosLim[13]) SUB(UpAxis_Positions[13],ClosestNegLim,UpAxis_PositionsClosestNegLim[13]) LIM(UpAxis_PositionsClosestNegLim[13],UpAxis_Position,UpAxis_PositionsClosestPosLim[13]) MOV(13,UpAxis_ClosestLayer) ]OTL(UpAxis_ClosestLayerFound);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R101_DownAxis" Type="RLL">
<Description>
<![CDATA[The whole axis. Six rungs.]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[CPS(IAI_DwnStacker:I,DwnStack_Inputs,1);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[SCON_Status(DnAxis_Sts,DnAxis_Position,DnAxis_Speed,DnAxis_AlarmActive,DnAxis_AlarmCode,DnAxis_BatteryAlarm,DnAxis_CommandCurrent,DnAxis_HomeComplete,DnAxis_Homing,DnAxis_EStop,DnAxis_InPushZone,DnAxis_InPZone,DnAxis_InZone1,DnAxis_InZone2,DnAxis_LoadReached,DnAxis_DriveManualMode,DnAxis_Moving,DnAxis_PositionComplete,DnAxis_PushFailed,DnAxis_DriveReady,DnAxis_ServoOn,DnAxis_TorqueReached,DnAxis_TotalMoveCount,DnAxis_TotalMoveDistance,DwnStack_Inputs);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(POWER_OK_24VB)XIO(Unlock_Doors)[OTE(DnAxis_Cmd_ServoOn) ,OTE(CR615) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[LEQ(DnAxis_Position,28304)GEQ(DnAxis_Position,2060)OTE(DnStacker_Within_Soft_Limits);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Need to add software limits to stop movement Up]]>
</Comment>
<Text>
<![CDATA[XIC(Motion_Control_OK)XIC(System_ManualMode)XIC(DnAxis_Cmd_ServoOn)OTE(DnStacker_Permit_Up);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Need to add software limits to stop movement Down]]>
</Comment>
<Text>
<![CDATA[XIC(Motion_Control_OK)XIC(System_ManualMode)XIC(DnAxis_Cmd_ServoOn)OTE(DnStacker_Permit_Dn);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(DnStacker_Permit_Dn)XIC(HMI_DnStack_GO_PB)OTE(IAI_DnStacker_CMD_Manual_Move);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Change the Down Stacker buttons Colors]]>
</Comment>
<Text>
<![CDATA[[[XIO(DnStacker_Permit_Dn) XIO(DnAxis_Homing) XIO(DnAxis_Moving) XIO(DnAxis_AlarmActive) XIC(Motion_Control_OK) MOV(0,DnStacker_Raise.Button_Color) ,XIC(DnStacker_Permit_Dn) [XIO(DnAxis_AlarmActive) XIC(DnAxis_DriveReady) MOV(1,DnStacker_Raise.Button_Color) ,[XIC(DnAxis_Homing) ,XIC(DnAxis_Moving) ] MOV(3,DnStacker_Raise.Button_Color) ,XIC(DnAxis_PositionComplete) MOV(4,DnStacker_Raise.Button_Color) ] ,[XIO(DnAxis_DriveReady) ,XIC(DnAxis_AlarmActive) ,XIO(Motion_Control_OK) ] MOV(2,DnStacker_Raise.Button_Color) ] ,[XIO(DnStacker_Permit_Up) XIO(DnAxis_Homing) XIO(DnAxis_Moving) XIO(DnAxis_AlarmActive) XIC(Motion_Control_OK) MOV(0,DnStacker_Lower.Button_Color) ,XIC(DnStacker_Permit_Up) [XIO(DnAxis_AlarmActive) XIC(DnAxis_DriveReady) MOV(1,DnStacker_Lower.Button_Color) ,[XIC(DnAxis_Homing) ,XIC(DnAxis_Moving) ] MOV(3,DnStacker_Lower.Button_Color) ,XIC(DnAxis_PositionComplete) MOV(4,DnStacker_Lower.Button_Color) ] ,[XIO(DnAxis_DriveReady) ,XIC(DnAxis_AlarmActive) ,XIO(Motion_Control_OK) ] MOV(2,DnStacker_Lower.Button_Color) ] ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[[LEQ(DnAxis_Position,28304) [XIC(System_ManualMode) XIC(DnAxis_Cmd_JogFwd_HMI) ,XIC(DnStack_Auto_Jog_Up) ] OTE(DnAxis_Cmd_JogFwd) ,GEQ(DnAxis_Position,2860) [XIC(System_ManualMode) XIC(DnAxis_Cmd_JogRev_HMI) ,XIC(DnStack_Auto_Jog_Down) ] OTE(DnAxis_Cmd_JogRev) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(HMI_Reset)OTE(DnAxis_Cmd_Reset);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[SCON_Operations(DnAxis_Ops,DnAxis_Cmd_ServoOn,DnAxis_Cmd_Pause,DnAxis_Cmd_Inch,DnAxis_Cmd_JogFwd,DnAxis_Cmd_JogRev,DnAxis_Cmd_Reset,DnAxis_Cmd_BrakeRelease,DwnStack_Outputs);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[SCON_Moves(DnAxis_Mov,DnAxis_Cmd_Home,DnAxis_Cmd_StartMove,DnAxis_Target,DwnStack_Target_Speed,DwnStack_Output_Acceleration,DwnStack_Output_Deceleration,DnAxis_Band,DnAxis_Increment_Select,DnAxis_Push_Select,DnAxis_Push_Direction,DnAxis_Push_Percent,DnAxis_Load_Threshold,DnAxis_PZone_Upper,DnAxis_PZone_Lower,DwnStack_Inputs,DwnStack_Outputs);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[unlatch the start bit when move command is off
]]>
</Comment>
<Text>
<![CDATA[XIO(DnAxis_Cmd_StartMove)OTU(DwnStack_Outputs.Start_Move);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[CPS(DwnStack_Outputs,IAI_DwnStacker:O,1);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[XIC(DnAxis_ServoOn)XIC(DnAxis_DriveReady)XIC(DnAxis_HomeComplete)XIO(DnAxis_AlarmActive)XIO(DnAxis_EStop)OTE(DnAxis_ReadyToMove);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[XIC(System_ManualMode)XIC(DnAxis_ReadyToMove)LIM(1,DnAxis_LayerRequest,12)XIC(IAI_DnStacker_CMD_Manual_Move)MOV(DnAxis_LayerRequest,DnAxis_LayerTarget);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[[XIC(DnStacker_Permit_Up) XIC(DnAxis_IncrementLayer) XIO(DnAxis_DecrementLayer) LES(DnAxis_CurrentLayer,12) ADD(DnAxis_CurrentLayer,1,DnAxis_LayerTarget) ,XIC(DnStacker_Permit_Dn) XIC(DnAxis_DecrementLayer) XIO(DnAxis_IncrementLayer) GRT(DnAxis_CurrentLayer,1) SUB(DnAxis_CurrentLayer,1,DnAxis_LayerTarget) ]OTE(DnAxis_MoveToLayerTarget);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[GRT(DnAxis_LayerTarget,12)ONS(ons_Trap)OTL(DnAxis_Layer_Trap_Bit);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[GEQ(DnAxis_CurrentLayer,11)OTU(DnAxis_IncrementLayer);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Text>
<![CDATA[LEQ(DnAxis_CurrentLayer,1)OTU(DnAxis_DecrementLayer);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[Confirm position move successful, update current position

]]>
</Comment>
<Text>
<![CDATA[[XIC(DnAxis_PositionComplete) [ONS(PositionCompleteONS) ,] ,][ADD(DnAxis_Positions[0],PosLim,DnAxis_PositionsPosLim[0]) SUB(DnAxis_Positions[0],NegLim,DnAxis_PositionsNegLim[0]) LIM(DnAxis_PositionsNegLim[0],DnAxis_Position,DnAxis_PositionsPosLim[0]) MOV(0,DnAxis_CurrentLayer) ,ADD(DnAxis_Positions[1],PosLim,DnAxis_PositionsPosLim[1]) SUB(DnAxis_Positions[1],NegLim,DnAxis_PositionsNegLim[1]) LIM(DnAxis_PositionsNegLim[1],DnAxis_Position,DnAxis_PositionsPosLim[1]) MOV(1,DnAxis_CurrentLayer) ,ADD(DnAxis_Positions[2],PosLim,DnAxis_PositionsPosLim[2]) SUB(DnAxis_Positions[2],NegLim,DnAxis_PositionsNegLim[2]) LIM(DnAxis_PositionsNegLim[2],DnAxis_Position,DnAxis_PositionsPosLim[2]) MOV(2,DnAxis_CurrentLayer) ,ADD(DnAxis_Positions[3],PosLim,DnAxis_PositionsPosLim[3]) SUB(DnAxis_Positions[3],NegLim,DnAxis_PositionsNegLim[3]) LIM(DnAxis_PositionsNegLim[3],DnAxis_Position,DnAxis_PositionsPosLim[3]) MOV(3,DnAxis_CurrentLayer) ,ADD(DnAxis_Positions[4],PosLim,DnAxis_PositionsPosLim[4]) SUB(DnAxis_Positions[4],NegLim,DnAxis_PositionsNegLim[4]) LIM(DnAxis_PositionsNegLim[4],DnAxis_Position,DnAxis_PositionsPosLim[4]) MOV(4,DnAxis_CurrentLayer) ,ADD(DnAxis_Positions[5],PosLim,DnAxis_PositionsPosLim[5]) SUB(DnAxis_Positions[5],NegLim,DnAxis_PositionsNegLim[5]) LIM(DnAxis_PositionsNegLim[5],DnAxis_Position,DnAxis_PositionsPosLim[5]) MOV(5,DnAxis_CurrentLayer) ,ADD(DnAxis_Positions[6],PosLim,DnAxis_PositionsPosLim[6]) SUB(DnAxis_Positions[6],NegLim,DnAxis_PositionsNegLim[6]) LIM(DnAxis_PositionsNegLim[6],DnAxis_Position,DnAxis_PositionsPosLim[6]) MOV(6,DnAxis_CurrentLayer) ,ADD(DnAxis_Positions[7],PosLim,DnAxis_PositionsPosLim[7]) SUB(DnAxis_Positions[7],NegLim,DnAxis_PositionsNegLim[7]) LIM(DnAxis_PositionsNegLim[7],DnAxis_Position,DnAxis_PositionsPosLim[7]) MOV(7,DnAxis_CurrentLayer) ,ADD(DnAxis_Positions[8],PosLim,DnAxis_PositionsPosLim[8]) SUB(DnAxis_Positions[8],NegLim,DnAxis_PositionsNegLim[8]) LIM(DnAxis_PositionsNegLim[8],DnAxis_Position,DnAxis_PositionsPosLim[8]) MOV(8,DnAxis_CurrentLayer) ,ADD(DnAxis_Positions[9],PosLim,DnAxis_PositionsPosLim[9]) SUB(DnAxis_Positions[9],NegLim,DnAxis_PositionsNegLim[9]) LIM(DnAxis_PositionsNegLim[9],DnAxis_Position,DnAxis_PositionsPosLim[9]) MOV(9,DnAxis_CurrentLayer) ,ADD(DnAxis_Positions[10],PosLim,DnAxis_PositionsPosLim[10]) SUB(DnAxis_Positions[10],NegLim,DnAxis_PositionsNegLim[10]) LIM(DnAxis_PositionsNegLim[10],DnAxis_Position,DnAxis_PositionsPosLim[10]) MOV(10,DnAxis_CurrentLayer) ,ADD(DnAxis_Positions[11],PosLim,DnAxis_PositionsPosLim[11]) SUB(DnAxis_Positions[11],NegLim,DnAxis_PositionsNegLim[11]) LIM(DnAxis_PositionsNegLim[11],DnAxis_Position,DnAxis_PositionsPosLim[11]) MOV(11,DnAxis_CurrentLayer) ,ADD(DnAxis_Positions[12],PosLim,DnAxis_PositionsPosLim[12]) SUB(DnAxis_Positions[12],NegLim,DnAxis_PositionsNegLim[12]) LIM(DnAxis_PositionsNegLim[12],DnAxis_Position,DnAxis_PositionsPosLim[12]) MOV(12,DnAxis_CurrentLayer) ];]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[Move to layer
]]>
</Comment>
<Text>
<![CDATA[[[XIC(DnAxis_MoveToLayerTarget) ,[NEQ(DnAxis_LayerTarget,DnAxis_CurrentLayer) XIO(DownStackCheckAutoSeq_Start) ,XIC(DnStackCheckAutoSeqMov_Req.4) ,XIC(amp_Test_Bits.25) ] ,XIC(IAI_DnStacker_CMD_Manual_Move) ] ,XIC(DnAxis_Cmd_StartMove) XIO(DnAxis_PositionComplete) ]XIO(DnAxis_Moving)XIC(DnAxis_ReadyToMove)XIO(DnAxis_MoveFailedTON.DN)[ONS(LayerMoveONS) ,]MOV(DnAxis_Positions[DnAxis_LayerTarget],DnAxis_Target)[OTE(DnAxis_Cmd_StartMove) ,TON(DnAxis_MoveFailedTON,?,?) ,OTU(DnAxis_IncrementLayer) OTU(DnAxis_DecrementLayer) ];]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Text>
<![CDATA[[XIC(UpdateDownAxisClosestPosition) ,XIC(DnStackCheckAutoSeqMov_Req.2) ,XIC(DnStackCheckAutoSeqMov_Req.3) ,NEQ(DnStack_Auto_Position_Update_Request,0) ][ONS(ClosestPosDownONS) ,][ADD(DnAxis_Positions[0],ClosestPosLim,DnAxis_PositionsClosestPosLim[0]) SUB(DnAxis_Positions[0],ClosestNegLim,DnAxis_PositionsClosestNegLim[0]) LIM(DnAxis_PositionsClosestNegLim[0],DnAxis_Position,DnAxis_PositionsClosestPosLim[0]) MOV(0,DnAxis_ClosestLayer) ,ADD(DnAxis_Positions[1],ClosestPosLim,DnAxis_PositionsClosestPosLim[1]) SUB(DnAxis_Positions[1],ClosestNegLim,DnAxis_PositionsClosestNegLim[1]) LIM(DnAxis_PositionsClosestNegLim[1],DnAxis_Position,DnAxis_PositionsClosestPosLim[1]) MOV(1,DnAxis_ClosestLayer) ,ADD(DnAxis_Positions[2],ClosestPosLim,DnAxis_PositionsClosestPosLim[2]) SUB(DnAxis_Positions[2],ClosestNegLim,DnAxis_PositionsClosestNegLim[2]) LIM(DnAxis_PositionsClosestNegLim[2],DnAxis_Position,DnAxis_PositionsClosestPosLim[2]) MOV(2,DnAxis_ClosestLayer) ,ADD(DnAxis_Positions[3],ClosestPosLim,DnAxis_PositionsClosestPosLim[3]) SUB(DnAxis_Positions[3],ClosestNegLim,DnAxis_PositionsClosestNegLim[3]) LIM(DnAxis_PositionsClosestNegLim[3],DnAxis_Position,DnAxis_PositionsClosestPosLim[3]) MOV(3,DnAxis_ClosestLayer) ,ADD(DnAxis_Positions[4],ClosestPosLim,DnAxis_PositionsClosestPosLim[4]) SUB(DnAxis_Positions[4],ClosestNegLim,DnAxis_PositionsClosestNegLim[4]) LIM(DnAxis_PositionsClosestNegLim[4],DnAxis_Position,DnAxis_PositionsClosestPosLim[4]) MOV(4,DnAxis_ClosestLayer) ,ADD(DnAxis_Positions[5],ClosestPosLim,DnAxis_PositionsClosestPosLim[5]) SUB(DnAxis_Positions[5],ClosestNegLim,DnAxis_PositionsClosestNegLim[5]) LIM(DnAxis_PositionsClosestNegLim[5],DnAxis_Position,DnAxis_PositionsClosestPosLim[5]) MOV(5,DnAxis_ClosestLayer) ,ADD(DnAxis_Positions[6],ClosestPosLim,DnAxis_PositionsClosestPosLim[6]) SUB(DnAxis_Positions[6],ClosestNegLim,DnAxis_PositionsClosestNegLim[6]) LIM(DnAxis_PositionsClosestNegLim[6],DnAxis_Position,DnAxis_PositionsClosestPosLim[6]) MOV(6,DnAxis_ClosestLayer) ,ADD(DnAxis_Positions[7],ClosestPosLim,DnAxis_PositionsClosestPosLim[7]) SUB(DnAxis_Positions[7],ClosestNegLim,DnAxis_PositionsClosestNegLim[7]) LIM(DnAxis_PositionsClosestNegLim[7],DnAxis_Position,DnAxis_PositionsClosestPosLim[7]) MOV(7,DnAxis_ClosestLayer) ,ADD(DnAxis_Positions[8],ClosestPosLim,DnAxis_PositionsClosestPosLim[8]) SUB(DnAxis_Positions[8],ClosestNegLim,DnAxis_PositionsClosestNegLim[8]) LIM(DnAxis_PositionsClosestNegLim[8],DnAxis_Position,DnAxis_PositionsClosestPosLim[8]) MOV(8,DnAxis_ClosestLayer) ,ADD(DnAxis_Positions[9],ClosestPosLim,DnAxis_PositionsClosestPosLim[9]) SUB(DnAxis_Positions[9],ClosestNegLim,DnAxis_PositionsClosestNegLim[9]) LIM(DnAxis_PositionsClosestNegLim[9],DnAxis_Position,DnAxis_PositionsClosestPosLim[9]) MOV(9,DnAxis_ClosestLayer) ,ADD(DnAxis_Positions[10],ClosestPosLim,DnAxis_PositionsClosestPosLim[10]) SUB(DnAxis_Positions[10],ClosestNegLim,DnAxis_PositionsClosestNegLim[10]) LIM(DnAxis_PositionsClosestNegLim[10],DnAxis_Position,DnAxis_PositionsClosestPosLim[10]) MOV(10,DnAxis_ClosestLayer) ,ADD(DnAxis_Positions[11],ClosestPosLim,DnAxis_PositionsClosestPosLim[11]) SUB(DnAxis_Positions[11],ClosestNegLim,DnAxis_PositionsClosestNegLim[11]) LIM(DnAxis_PositionsClosestNegLim[11],DnAxis_Position,DnAxis_PositionsClosestPosLim[11]) MOV(11,DnAxis_ClosestLayer) ,ADD(DnAxis_Positions[12],ClosestPosLim,DnAxis_PositionsClosestPosLim[12]) SUB(DnAxis_Positions[12],ClosestNegLim,DnAxis_PositionsClosestNegLim[12]) LIM(DnAxis_PositionsClosestNegLim[12],DnAxis_Position,DnAxis_PositionsClosestPosLim[12]) MOV(12,DnAxis_ClosestLayer) ]OTL(DnAxis_ClosestLayerFound);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R200_Tray_Positions_and_Data" Type="RLL">
<Description>
<![CDATA[Data and memory for parts on the trays]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[[XIC(S:FS) ,XIC(DOOR_1) ]OTL(CheckUpstackerTrays);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[XIC(S:FS) ,XIC(DOOR_2) ]OTL(CheckDownStackerTrays);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(CheckDownStackerTrays)ONS(DownAxisOldLayer_ONS)MOV(DnAxis_CurrentLayer,DownAxisOldLayer);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Reset memory after picking
]]>
</Comment>
<Text>
<![CDATA[[XIC(RtoUS_PickConfirm) ,XIC(RobotAtStacker) [XIC(RtoUS_PickErrorVG524) ,XIC(RtoUS_PickErrorVG526) ] ]OSF(PickCompleteOffsetONS,PickComplete);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(PickComplete)OTU(UpAxis_Memory[UpAxis_CurrentLayer].[UpAxis_NextValidPos]);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Find next valid position
]]>
</Comment>
<Text>
<![CDATA[[XIC(UpAxis_Memory[UpAxis_CurrentLayer].0) [MOV(0,UpAxis_NextValidPos) ,MOV(1,UStoR_PickColumnNumber) ,MOV(1,UStoR_PickRowNumber) ] ,XIO(UpAxis_Memory[UpAxis_CurrentLayer].0) XIC(UpAxis_Memory[UpAxis_CurrentLayer].1) [MOV(1,UpAxis_NextValidPos) ,MOV(2,UStoR_PickColumnNumber) ,MOV(1,UStoR_PickRowNumber) ] ,XIO(UpAxis_Memory[UpAxis_CurrentLayer].0) XIO(UpAxis_Memory[UpAxis_CurrentLayer].1) XIC(UpAxis_Memory[UpAxis_CurrentLayer].2) [MOV(2,UpAxis_NextValidPos) ,MOV(3,UStoR_PickColumnNumber) ,MOV(1,UStoR_PickRowNumber) ] ,XIO(UpAxis_Memory[UpAxis_CurrentLayer].0) XIO(UpAxis_Memory[UpAxis_CurrentLayer].1) XIO(UpAxis_Memory[UpAxis_CurrentLayer].2) XIC(UpAxis_Memory[UpAxis_CurrentLayer].3) [MOV(3,UpAxis_NextValidPos) ,MOV(4,UStoR_PickColumnNumber) ,MOV(1,UStoR_PickRowNumber) ] ,XIO(UpAxis_Memory[UpAxis_CurrentLayer].0) XIO(UpAxis_Memory[UpAxis_CurrentLayer].1) XIO(UpAxis_Memory[UpAxis_CurrentLayer].2) XIO(UpAxis_Memory[UpAxis_CurrentLayer].3) XIC(UpAxis_Memory[UpAxis_CurrentLayer].4) [MOV(4,UpAxis_NextValidPos) ,MOV(1,UStoR_PickColumnNumber) ,MOV(2,UStoR_PickRowNumber) ] ,XIO(UpAxis_Memory[UpAxis_CurrentLayer].0) XIO(UpAxis_Memory[UpAxis_CurrentLayer].1) XIO(UpAxis_Memory[UpAxis_CurrentLayer].2) XIO(UpAxis_Memory[UpAxis_CurrentLayer].3) XIO(UpAxis_Memory[UpAxis_CurrentLayer].4) XIC(UpAxis_Memory[UpAxis_CurrentLayer].5) [MOV(5,UpAxis_NextValidPos) ,MOV(2,UStoR_PickColumnNumber) ,MOV(2,UStoR_PickRowNumber) ] ,XIO(UpAxis_Memory[UpAxis_CurrentLayer].0) XIO(UpAxis_Memory[UpAxis_CurrentLayer].1) XIO(UpAxis_Memory[UpAxis_CurrentLayer].2) XIO(UpAxis_Memory[UpAxis_CurrentLayer].3) XIO(UpAxis_Memory[UpAxis_CurrentLayer].4) XIO(UpAxis_Memory[UpAxis_CurrentLayer].5) XIC(UpAxis_Memory[UpAxis_CurrentLayer].6) [MOV(6,UpAxis_NextValidPos) ,MOV(3,UStoR_PickColumnNumber) ,MOV(2,UStoR_PickRowNumber) ] ,XIO(UpAxis_Memory[UpAxis_CurrentLayer].0) XIO(UpAxis_Memory[UpAxis_CurrentLayer].1) XIO(UpAxis_Memory[UpAxis_CurrentLayer].2) XIO(UpAxis_Memory[UpAxis_CurrentLayer].3) XIO(UpAxis_Memory[UpAxis_CurrentLayer].4) XIO(UpAxis_Memory[UpAxis_CurrentLayer].5) XIO(UpAxis_Memory[UpAxis_CurrentLayer].6) XIC(UpAxis_Memory[UpAxis_CurrentLayer].7) [MOV(7,UpAxis_NextValidPos) ,MOV(4,UStoR_PickColumnNumber) ,MOV(2,UStoR_PickRowNumber) ] ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(Manual_Load_Tray_Data)ONS(Manual_Load_Tray_Data_ONS)COP(UpAxis_Memory_Load[0],UpAxis_Memory[0],13);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[MOV(0,UpAxis_Memory[0]);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIO(UpAxis_Memory[UpAxis_CurrentLayer].0)XIO(UpAxis_Memory[UpAxis_CurrentLayer].1)XIO(UpAxis_Memory[UpAxis_CurrentLayer].2)XIO(UpAxis_Memory[UpAxis_CurrentLayer].3)XIO(UpAxis_Memory[UpAxis_CurrentLayer].4)XIO(UpAxis_Memory[UpAxis_CurrentLayer].5)XIO(UpAxis_Memory[UpAxis_CurrentLayer].6)XIO(UpAxis_Memory[UpAxis_CurrentLayer].7)OTE(Top_Tray_Is_Empty);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R201_Data_Fill_Loop" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[MOV(255,UpAxis_Memory[R201_Index]);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R202_Data_Clear_Loop" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[MOV(0,UpAxis_Memory[R202_Index]);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R300_Auto_Sequence" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(System_AutoMode)XIO(RobotAtStacker)XIC(RtoUS_LayerMovedConfirm)XIC(RtoUS_PickConfirm)XIC(RtoUS_PickErrorVG524)XIC(RtoUS_PickErrorVG526)XIC(CheckUpstackerTrays)XIC(CheckDownStackerTrays)XIC(RequestLayerShift)NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[XIC(CheckUpstackerTrays) ,XIC(CheckDownStackerTrays) ]XIC(amp_Test_Bits.15)OTE(CheckStackerTrays);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(I0302)TON(UpStack_TraySensorTON,?,?);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(I0302)TOF(Upstack_TraySensorTOF,?,?);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(I0310)TON(DnStack_TraySensorTON,?,?);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(I0310)TOF(Downstack_TraySensorTOF,?,?);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Reset Door Opened Bit after acknolwedge from Operator]]>
</Comment>
<Text>
<![CDATA[[XIC(CheckStackerTrays_YesPB) ,XIC(CheckStackerTrays_NoPB) ]OTU(Stacker_Door_Opened);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Main Actions: 
Supply next Col/Row of Next part to pick
request tray slide
request reload
]]>
</Comment>
<Text>
<![CDATA[EQU(UpAxis_Memory[13],0)EQU(UpAxis_Memory[12],0)EQU(UpAxis_Memory[11],0)EQU(UpAxis_Memory[10],0)EQU(UpAxis_Memory[9],0)EQU(UpAxis_Memory[8],0)EQU(UpAxis_Memory[7],0)EQU(UpAxis_Memory[6],0)EQU(UpAxis_Memory[5],0)EQU(UpAxis_Memory[4],0)EQU(UpAxis_Memory[3],0)EQU(UpAxis_Memory[2],0)EQU(UpAxis_Memory[1],0)OTL(Upstacker_Reload_Needed);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Up Stacker Auto Sequence

Moves The Next Sequence Cycle Step Into The Current Cycle Step. This Can Be Used To Step The Code Through The AutoCycle One Step At A Time.
This Can Be Done By Putting A Toggle Bit Infront Of The Move Instruction]]>
</Comment>
<Text>
<![CDATA[[[XIO(System_AutoMode) ,XIC(S:FS) ] [MOV(0,Up_Stacker_Auto.Routine_CurrentCycleStep) ,MOV(0,Up_Stacker_Auto.Routine_NextCycleStep) ] ,[XIC(System_InCycle) ,XIO(System_InCycle) [XIC(System_CycleStop_Requested) ,XIC(Auto_Initialization) ] ] MOV(Up_Stacker_Auto.Routine_NextCycleStep,Up_Stacker_Auto.Routine_CurrentCycleStep) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Start Decision Step]]>
</Comment>
<Text>
<![CDATA[EQU(Up_Stacker_Auto.Routine_CurrentCycleStep,0)XIC(System_InCycle)XIC(EnableUpDownStackerCheck)[XIC(CheckStackerTrays) ,XIC(amp_Test_Bits.9) ]XIO(UpAxis_AlarmActive)XIO(RequestReload)XIO(RobotAtStacker)XIC(UpStacker_Within_Soft_Limits)[XIC(CheckUpstackerTrays) ,XIC(amp_Test_Bits.9) ]XIC(CheckStackerTrays_YesPB)[LIM(0,UpAxis_CurrentLayer,12) ONS(Up_Stacker_Auto.ONS_Dint.0) ADD(UpAxis_CurrentLayer,1,UpStackCheck_FillStartLevel) OTU(UpAxis_ClosestLayerFound) MOV(10,Up_Stacker_Auto.Routine_NextCycleStep) ,[LES(UpAxis_CurrentLayer,1) ,GRT(UpAxis_CurrentLayer,11) ,XIO(UpStacker_Within_Soft_Limits) ] XIC(WinComeBack) OTE(UpStack_Level_Alarm) MOV(1000,Up_Stacker_Auto.Routine_NextCycleStep) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Which Direction to move Decision Step]]>
</Comment>
<Text>
<![CDATA[EQU(Up_Stacker_Auto.Routine_CurrentCycleStep,10)XIC(System_InCycle)[XIO(UpStack_TraySensorTON.DN) MOV(20,Up_Stacker_Auto.Routine_NextCycleStep) ,XIC(UpStack_TraySensorTON.DN) MOV(30,Up_Stacker_Auto.Routine_NextCycleStep) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[jog axis up until sensor changes, get closest position
]]>
</Comment>
<Text>
<![CDATA[EQU(Up_Stacker_Auto.Routine_CurrentCycleStep,20)TON(Up_Seq_Dly_1,?,?)XIC(Up_Seq_Dly_1.DN)[XIO(UpStack_TraySensorTON.DN) OTE(UpStack_Auto_Jog_Up) ,XIC(UpStack_TraySensorTON.DN) MOV(40,Up_Stacker_Auto.Routine_NextCycleStep) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[jog axis until sensor changes, get closest position
]]>
</Comment>
<Text>
<![CDATA[EQU(Up_Stacker_Auto.Routine_CurrentCycleStep,30)[XIC(UpStack_TraySensorTON.DN) OTE(UpStack_Auto_Jog_Down) ,XIO(UpStack_TraySensorTON.DN) MOV(10,Up_Stacker_Auto.Routine_NextCycleStep) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Search for closest Position]]>
</Comment>
<Text>
<![CDATA[EQU(Up_Stacker_Auto.Routine_CurrentCycleStep,40)[OTE(UpStack_Auto_Position_Update_Request.0) ,XIC(UpAxis_ClosestLayerFound) MOV(50,Up_Stacker_Auto.Routine_NextCycleStep) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[Calculating positions while taking into account the potential position error
]]>
</Comment>
<Text>
<![CDATA[SUB(UpAxis_Position,UpAxis_Target,UpAxis_PosError)SUB(DnAxis_Position,DnAxis_Target,DnAxis_PosError)MOV(-50,PosErrorLL)MOV(50,PosErrorHL);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[Run closest tray level check and fill memory to that point
]]>
</Comment>
<Text>
<![CDATA[EQU(Up_Stacker_Auto.Routine_CurrentCycleStep,50)[[NEQ(UpAxis_Position,UpAxis_Target) XIC(Pulse_150) OTE(UpstackCheckAutoSeqMov_req.4) ,XIC(UpAxis_ClosestLayerFound) [FOR(R201_Data_Fill_Loop,R201_Index,UpStackCheck_FillStartLevel,UpAxis_ClosestLayer,1) ,ADD(UpAxis_ClosestLayer,1,R202_Init) ,FOR(R202_Data_Clear_Loop,R202_Index,R202_Init,12,1) ] [LIM(PosErrorLL,UpAxis_PosError,PosErrorHL) ,AFI() EQU(UpAxis_Positions[UpAxis_LayerTarget],UpAxis_Target) ] MOV(60,Up_Stacker_Auto.Routine_NextCycleStep) ] ,XIO(UpAxis_ClosestLayerFound) XIC(amp_Test_Bits.19) MOV(3000,Up_Stacker_Auto.Routine_NextCycleStep) ];]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[Go to correct level
]]>
</Comment>
<Text>
<![CDATA[EQU(Up_Stacker_Auto.Routine_CurrentCycleStep,60)MOV(UpAxis_ClosestLayer,UpAxis_LayerTarget)[OTU(CheckUpstackerTrays) ,OTU(UpstackCheckAutoSeq_Start) ,OTE(UpstackCheckAutoSeqMov_req.5) ,OTU(UpAxis_ClosestLayerFound) ,OTU(CheckStackerTrays_YesPB) OTU(CheckStackerTrays_NoPB) ,OTU(RequestReload) ,OTU(amp_Test_Bits.9) ]MOV(0,Up_Stacker_Auto.Routine_NextCycleStep);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[This is the stat of the Down Stacker Auto Sequence]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[Down Stacker Auto Sequence

Moves The Next Sequence Cycle Step Into The Current Cycle Step. This Can Be Used To Step The Code Through The AutoCycle One Step At A Time.
This Can Be Done By Putting A Toggle Bit Infront Of The Move Instruction]]>
</Comment>
<Text>
<![CDATA[[[XIO(System_AutoMode) ,XIC(S:FS) ] [MOV(0,Dn_Stacker_Auto.Routine_CurrentCycleStep) ,MOV(0,Dn_Stacker_Auto.Routine_NextCycleStep) ] ,[XIC(System_InCycle) ,XIO(System_InCycle) [XIC(System_CycleStop_Requested) ,XIC(Auto_Initialization) ] ] MOV(Dn_Stacker_Auto.Routine_NextCycleStep,Dn_Stacker_Auto.Routine_CurrentCycleStep) ];]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[Start Decision Step]]>
</Comment>
<Text>
<![CDATA[EQU(Dn_Stacker_Auto.Routine_CurrentCycleStep,0)XIC(System_InCycle)XIC(EnableUpDownStackerCheck)[XIC(CheckStackerTrays) ,XIC(amp_Test_Bits.10) ]XIO(DnAxis_AlarmActive)XIO(RequestReload)XIO(RobotAtStacker)XIC(DnStacker_Within_Soft_Limits)[XIC(CheckDownStackerTrays) ,XIC(amp_Test_Bits.10) ]XIC(CheckStackerTrays_YesPB)[LIM(0,DnAxis_CurrentLayer,12) ONS(Dn_Stacker_Auto.ONS_Dint.0) ADD(DnAxis_CurrentLayer,1,DnStackCheck_FillStartLevel) OTU(DnAxis_ClosestLayerFound) MOV(10,Dn_Stacker_Auto.Routine_NextCycleStep) ,[LES(DnAxis_CurrentLayer,1) ,GRT(DnAxis_CurrentLayer,11) ,XIO(DnStacker_Within_Soft_Limits) ] XIC(WinComeBack) OTE(DnStack_Level_Alarm) MOV(1000,Dn_Stacker_Auto.Routine_NextCycleStep) ];]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[Which Direction to move Decision Step]]>
</Comment>
<Text>
<![CDATA[EQU(Dn_Stacker_Auto.Routine_CurrentCycleStep,10)XIC(System_InCycle)[XIO(DnStack_TraySensorTON.DN) MOV(20,Dn_Stacker_Auto.Routine_NextCycleStep) ,XIC(DnStack_TraySensorTON.DN) MOV(30,Dn_Stacker_Auto.Routine_NextCycleStep) ];]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[jog axis up until sensor changes, get closest position
]]>
</Comment>
<Text>
<![CDATA[EQU(Dn_Stacker_Auto.Routine_CurrentCycleStep,20)TON(Dn_Seq_Dly_1,?,?)XIC(Dn_Seq_Dly_1.DN)[XIO(DnStack_TraySensorTON.DN) XIC(DnStacker_Within_Soft_Limits) OTE(DnStack_Auto_Jog_Up) ,XIC(DnStack_TraySensorTON.DN) MOV(40,Dn_Stacker_Auto.Routine_NextCycleStep) ];]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Comment>
<![CDATA[jog axis until sensor changes, get closest position
]]>
</Comment>
<Text>
<![CDATA[EQU(Dn_Stacker_Auto.Routine_CurrentCycleStep,30)[XIC(DnStack_TraySensorTON.DN) OTE(DnStack_Auto_Jog_Down) ,XIO(DnStack_TraySensorTON.DN) MOV(10,Dn_Stacker_Auto.Routine_NextCycleStep) ];]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Comment>
<![CDATA[Search for closest Position]]>
</Comment>
<Text>
<![CDATA[EQU(Dn_Stacker_Auto.Routine_CurrentCycleStep,40)[OTE(DnStack_Auto_Position_Update_Request.0) ,XIC(DnAxis_ClosestLayerFound) MOV(50,Dn_Stacker_Auto.Routine_NextCycleStep) ];]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Comment>
<![CDATA[Run closest tray level
]]>
</Comment>
<Text>
<![CDATA[EQU(Dn_Stacker_Auto.Routine_CurrentCycleStep,50)[[NEQ(DnAxis_Position,DnAxis_Target) XIC(Pulse_150) OTE(DnStackCheckAutoSeqMov_Req.4) ,LIM(PosErrorLL,DnAxis_PosError,PosErrorHL) MOV(60,Dn_Stacker_Auto.Routine_NextCycleStep) ] ,XIO(DnAxis_ClosestLayerFound) XIC(amp_Test_Bits.19) MOV(3000,Dn_Stacker_Auto.Routine_NextCycleStep) ];]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Comment>
<![CDATA[Go to correct level
]]>
</Comment>
<Text>
<![CDATA[EQU(Dn_Stacker_Auto.Routine_CurrentCycleStep,60)MOV(DnAxis_ClosestLayer,DnAxis_LayerTarget)[OTU(CheckDownStackerTrays) ,OTU(DownStackCheckAutoSeq_Start) ,OTE(DnStackCheckAutoSeqMov_Req.5) ,OTU(DnAxis_ClosestLayerFound) ,OTU(CheckStackerTrays_YesPB) OTU(CheckStackerTrays_NoPB) ,OTU(amp_Test_Bits.10) ,OTU(RequestReload) ]MOV(0,Dn_Stacker_Auto.Routine_NextCycleStep);]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Comment>
<![CDATA[Tray Slide Auto Sequence
conditions: robot not at up/down stack, auto, memory empty for current layer, more parts below, room for empty tray, slide request on, down stack at correct position


0: raise up stacker
1: set slide request on
2: slide complete -> lower downstacker
3. turn pick request from upstacker back on 
]]>
</Comment>
<Text>
<![CDATA[XIO(RequestReload)[XIC(System_AutoMode) XIC(RequestLayerShift) GEQ(UpAxis_CurrentLayer,0) LEQ(DnAxis_CurrentLayer,12) [XIO(RobotAtStacker) ,XIC(RobotAtIMM) ,XIC(RobotAtLaser) ,EQU(Robot_Sts_State,0) ] ,XIC(TraySlideAutoSeq_Start) ][OTE(TraySlideAutoSeq_Start) ,ONS(LayerOldONS) [GEQ(UpAxis_CurrentLayer,1) SUB(UpAxis_CurrentLayer,1,UpAxis_LayerNeeded) ,LES(DnAxis_CurrentLayer,12) ADD(DnAxis_CurrentLayer,1,DownAxis_LayerNeeded) ] ];]]>
</Text>
</Rung>
<Rung Number="27" Type="N">
<Text>
<![CDATA[XIC(TraySlideAutoSeq_Start)[OTE(TraySlideAutoSeq.0) ,[ONS(trayslideons0) ,] MOV(UpAxis_LayerNeeded,UpAxis_LayerTarget) ];]]>
</Text>
</Rung>
<Rung Number="28" Type="N">
<Text>
<![CDATA[XIC(TraySlideAutoSeq.0)EQU(UpAxis_LayerNeeded,UpAxis_CurrentLayer)[XIO(TraySlideAutoSeq.2) OTE(UStoR_ReqToMoveLayer) ,OTE(TraySlideAutoSeq.1) ];]]>
</Text>
</Rung>
<Rung Number="29" Type="N">
<Text>
<![CDATA[[EQU(UpAxis_LayerNeeded,UpAxis_CurrentLayer) OTE(UpStacker_NOT_Moving) ,EQU(DownAxis_LayerNeeded,DnAxis_CurrentLayer) OTE(DnStacker_NOT_Moving) ];]]>
</Text>
</Rung>
<Rung Number="30" Type="N">
<Text>
<![CDATA[XIC(TraySlideAutoSeq.1)[XIC(RtoUS_LayerMovedConfirm) ,XIC(TraySlideAutoSeq.2) ][OTE(TraySlideAutoSeq.2) ,[ONS(trayslideons2) ,] MOV(DownAxis_LayerNeeded,DnAxis_LayerTarget) ];]]>
</Text>
</Rung>
<Rung Number="31" Type="N">
<Text>
<![CDATA[XIC(TraySlideAutoSeq.2)EQU(DownAxis_LayerNeeded,DnAxis_CurrentLayer)OTU(TraySlideAutoSeq_Start);]]>
</Text>
</Rung>
<Rung Number="32" Type="N">
<Text>
<![CDATA[XIC(CheckStackerTrays_NoPB)[OTU(CheckDownStackerTrays) OTU(CheckUpstackerTrays) OTU(CheckStackerTrays_NoPB) OTU(RequestReload) ,ONS(DownAxisOldLayerONS) MOV(DownAxisOldLayer,DnAxis_LayerTarget) ];]]>
</Text>
</Rung>
<Rung Number="33" Type="N">
<Comment>
<![CDATA[Request Reload Auto "Sequence"
]]>
</Comment>
<Text>
<![CDATA[XIC(amp_Test_Bits.24)[XIC(System_AutoMode) EQU(UpAxis_CurrentLayer,0) ,XIC(HMI_Force_Reload_Trays) ]XIO(TraySlideAutoSeq_Start)ONS(RequestReloadONS)[MOV(12,DnAxis_LayerTarget) ,MOV(12,UpAxis_LayerTarget) ,OTL(RequestReload) ];]]>
</Text>
</Rung>
<Rung Number="34" Type="N">
<Text>
<![CDATA[XIC(System_CycleStop_Requested)[XIC(RobotStopped) ,XIO(RobotAtStacker) ]ONS(CycleStopONS)MOV(12,UpAxis_LayerTarget)MOV(12,DnAxis_LayerTarget);]]>
</Text>
</Rung>
<Rung Number="35" Type="N">
<Text>
<![CDATA[EQU(UpAxis_CurrentLayer,12)EQU(DnAxis_CurrentLayer,12)OTE(StackersAtBottom);]]>
</Text>
</Rung>
<Rung Number="36" Type="N">
<Comment>
<![CDATA[Check for the highest layer that has memory at beginning of auto cycle start and move to that layer
will need to match the down axis position with sensor as well at this time
]]>
</Comment>
<Text>
<![CDATA[XIO(RequestReload)XIC(System_AutoMode)XIC(System_InCycle)ONS(AutoStartONS)[NEQ(UpAxis_Memory[1],0) MOV(1,UpAxis_LayerTarget) ,NEQ(UpAxis_Memory[2],0) MOV(2,UpAxis_LayerTarget) ,NEQ(UpAxis_Memory[3],0) MOV(3,UpAxis_LayerTarget) ,NEQ(UpAxis_Memory[4],0) MOV(4,UpAxis_LayerTarget) ,NEQ(UpAxis_Memory[5],0) MOV(5,UpAxis_LayerTarget) ,NEQ(UpAxis_Memory[6],0) MOV(6,UpAxis_LayerTarget) ,NEQ(UpAxis_Memory[7],0) MOV(7,UpAxis_LayerTarget) ,NEQ(UpAxis_Memory[8],0) MOV(8,UpAxis_LayerTarget) ,NEQ(UpAxis_Memory[9],0) MOV(9,UpAxis_LayerTarget) ,NEQ(UpAxis_Memory[10],0) MOV(10,UpAxis_LayerTarget) ,NEQ(UpAxis_Memory[11],0) MOV(11,UpAxis_LayerTarget) ,MOV(DownAxisOldLayer,DnAxis_LayerTarget) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="_01_IAI_Faults" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[*****************************************************
Robot System Fault Present
*****************************************************]]>
</Comment>
<Text>
<![CDATA[NEQ(IAI_Alarms,0)OTE(IAI_Fault_Present);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[RESETS ALARM FILE [0] FAULTS]]>
</Comment>
<Text>
<![CDATA[XIC(GlobalAck_TOF.TT)CLR(IAI_Alarms);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[IAI UpAxis Battery Alarm]]>
</Comment>
<Text>
<![CDATA[XIC(System_InCycle)XIC(UpAxis_BatteryAlarm)[TON(IAI_Alarm_Delay[0],?,?) ,XIC(IAI_Alarm_Delay[0].DN) OTL(IAI_Alarms.0) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(IAI_Alarms.0)ALMD(IAI_ALMD_00,HMI_FaultAck_All,HMI_FaultReset_All,0,0);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[IAI Down Axis Battery Alarm]]>
</Comment>
<Text>
<![CDATA[XIC(System_InCycle)XIC(DnAxis_BatteryAlarm)[TON(IAI_Alarm_Delay[1],?,?) ,XIC(IAI_Alarm_Delay[1].DN) OTL(IAI_Alarms.1) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(IAI_Alarms.1)ALMD(IAI_ALMD_01,HMI_FaultAck_All,HMI_FaultReset_All,0,0);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Up Axis Homing Required]]>
</Comment>
<Text>
<![CDATA[XIC(POWER_OK_24VC)XIC(POWER_OK_24VB)XIO(UpAxis_HomeComplete)[TON(IAI_Alarm_Delay[2],?,?) ,XIC(IAI_Alarm_Delay[2].DN) OTL(IAI_Alarms.2) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(IAI_Alarms.2)ALMD(IAI_ALMD_02,HMI_FaultAck_All,HMI_FaultReset_All,0,0);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Down Axis Homing Required]]>
</Comment>
<Text>
<![CDATA[XIC(POWER_OK_24VC)XIC(POWER_OK_24VB)XIO(DnAxis_HomeComplete)[TON(IAI_Alarm_Delay[3],?,?) ,XIC(IAI_Alarm_Delay[3].DN) OTL(IAI_Alarms.3) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(IAI_Alarms.3)ALMD(IAI_ALMD_03,HMI_FaultAck_All,HMI_FaultReset_All,0,0);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[MCR();]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[latches into IAI_Alarms, reset clears it in _01_IAI_Faults]]>
</Comment>
<Text>
<![CDATA[GSV(Module,IAI_UpStacker,EntryStatus,UpEntryStatus)GSV(Module,IAI_DwnStacker,EntryStatus,DnEntryStatus);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[[MEQ(UpEntryStatus,61440,16384) OTE(UpCommOK) ,MEQ(DnEntryStatus,61440,16384) OTE(DnCommOK) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[XIC(UpAxis_AlarmActive)TON(StkAlmDly[0],?,?)XIC(StkAlmDly[0].DN)OTL(IAI_Alarms.4);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[XIC(IAI_Alarms.4)ALMD(IAI_ALMD_04,HMI_FaultAck_All,HMI_FaultReset_All,0,0);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[XIC(DnAxis_AlarmActive)TON(StkAlmDly[1],?,?)XIC(StkAlmDly[1].DN)OTL(IAI_Alarms.5);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[XIC(IAI_Alarms.5)ALMD(IAI_ALMD_05,HMI_FaultAck_All,HMI_FaultReset_All,0,0);]]>
