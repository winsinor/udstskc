<Tag Name="DnAxis_Target" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Where to go, 0.01mm. Set this before pulsing Cmd_StartMove]]>
</Description>
<Data Format="L5K">
<![CDATA[28302]]>
</Data>
<Data Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="28302"/>
</Data>
</Tag>
<Tag Name="DnAxis_TorqueReached" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Torque level reached (TRQS)]]>
</Description>
<Data Format="L5K">
<![CDATA[0]]>
</Data>
<Data Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</Data>
</Tag>
<Tag Name="DnAxis_TotalMoveCount" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Total moving count]]>
</Description>
<Data Format="L5K">
<![CDATA[0]]>
</Data>
<Data Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</Data>
</Tag>
<Tag Name="DnAxis_TotalMoveDistance" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Total moving distance]]>
</Description>
<Data Format="L5K">
<![CDATA[0]]>
</Data>
<Data Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</Data>
</Tag>
</Tags>
<Routines>
<Routine Name="R000_Main" Type="RLL">
<Description>
<![CDATA[Main.]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[JSR(R100_Axis,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R100_Axis" Type="RLL">
<Description>
<![CDATA[The whole axis. Six rungs.]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[CPS(IAI_DwnStacker:I,DwnStack_Inputs,1);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[SCON_Status(DnAxis_Sts,DnAxis_Position,DnAxis_Speed,DnAxis_AlarmActive,DnAxis_AlarmCode,DnAxis_BatteryAlarm,DnAxis_CommandCurrent,DnAxis_HomeComplete,DnAxis_Homing,DnAxis_EStop,DnAxis_InPushZone,DnAxis_InPZone,DnAxis_InZone1,DnAxis_InZone2,DnAxis_LoadReached,DnAxis_DriveManualMode,DnAxis_Moving,DnAxis_PositionComplete,DnAxis_PushFailed,DnAxis_DriveReady,DnAxis_ServoOn,DnAxis_TorqueReached,DnAxis_TotalMoveCount,DnAxis_TotalMoveDistance,DwnStack_Inputs);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(POWER_OK_24VB)XIO(Unlock_Doors)[OTE(DnAxis_Cmd_ServoOn) ,OTE(CR615) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Need to add software limits to stop movement Up]]>
</Comment>
<Text>
<![CDATA[XIC(Motion_Control_OK)XIC(System_ManualMode)XIC(DnAxis_Cmd_ServoOn)OTE(DnStacker_Permit_Up);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Need to add software limits to stop movement Down]]>
</Comment>
<Text>
<![CDATA[XIC(Motion_Control_OK)XIC(System_ManualMode)XIC(DnAxis_Cmd_ServoOn)OTE(DnStacker_Permit_Dn);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(DnStacker_Permit_Dn)XIC(HMI_DnStack_GO_PB)OTE(IAI_DnStacker_CMD_Manual_Move);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Change the Down Stacker buttons Colors]]>
</Comment>
<Text>
<![CDATA[[[XIO(DnStacker_Permit_Dn) XIO(DnAxis_Homing) XIO(DnAxis_Moving) XIO(DnAxis_AlarmActive) XIC(Motion_Control_OK) MOV(0,DnStacker_Raise.Button_Color) ,XIC(DnStacker_Permit_Dn) [XIO(DnAxis_AlarmActive) XIC(DnAxis_DriveReady) MOV(1,DnStacker_Raise.Button_Color) ,[XIC(DnAxis_Homing) ,XIC(DnAxis_Moving) ] MOV(3,DnStacker_Raise.Button_Color) ,XIC(DnAxis_PositionComplete) MOV(4,DnStacker_Raise.Button_Color) ] ,[XIO(DnAxis_DriveReady) ,XIC(DnAxis_AlarmActive) ,XIO(Motion_Control_OK) ] MOV(2,DnStacker_Raise.Button_Color) ] ,[XIO(DnStacker_Permit_Up) XIO(DnAxis_Homing) XIO(DnAxis_Moving) XIO(DnAxis_AlarmActive) XIC(Motion_Control_OK) MOV(0,DnStacker_Lower.Button_Color) ,XIC(DnStacker_Permit_Up) [XIO(DnAxis_AlarmActive) XIC(DnAxis_DriveReady) MOV(1,DnStacker_Lower.Button_Color) ,[XIC(DnAxis_Homing) ,XIC(DnAxis_Moving) ] MOV(3,DnStacker_Lower.Button_Color) ,XIC(DnAxis_PositionComplete) MOV(4,DnStacker_Lower.Button_Color) ] ,[XIO(DnAxis_DriveReady) ,XIC(DnAxis_AlarmActive) ,XIO(Motion_Control_OK) ] MOV(2,DnStacker_Lower.Button_Color) ] ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[SCON_Operations(DnAxis_Ops,DnAxis_Cmd_ServoOn,DnAxis_Cmd_Pause,DnAxis_Cmd_Inch,DnAxis_Cmd_JogFwd,DnAxis_Cmd_JogRev,DnAxis_Cmd_Reset,DnAxis_Cmd_BrakeRelease,DwnStack_Outputs);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[SCON_Moves(DnAxis_Mov,DnAxis_Cmd_Home,DnAxis_Cmd_StartMove,DnAxis_Target,DwnStack_Target_Speed,DwnStack_Output_Acceleration,DwnStack_Output_Deceleration,DnAxis_Band,DnAxis_Increment_Select,DnAxis_Push_Select,DnAxis_Push_Direction,DnAxis_Push_Percent,DnAxis_Load_Threshold,DnAxis_PZone_Upper,DnAxis_PZone_Lower,DwnStack_Inputs,DwnStack_Outputs);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[CPS(DwnStack_Outputs,IAI_DwnStacker:O,1);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(DnAxis_ServoOn)XIC(DnAxis_DriveReady)XIC(DnAxis_HomeComplete)XIO(DnAxis_AlarmActive)XIO(DnAxis_EStop)OTE(DnAxis_ReadyToMove);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(System_ManualMode)XIC(DnAxis_ReadyToMove)LIM(1,DnAxis_LayerRequest,13)XIC(IAI_DnStacker_CMD_Manual_Move)MOV(DnAxis_LayerRequest,DnAxis_LayerTarget);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[[XIC(DnStacker_Permit_Up) XIC(DnAxis_IncrementLayer) XIO(DnAxis_DecrementLayer) LES(DnAxis_CurrentLayer,13) ADD(DnAxis_CurrentLayer,1,DnAxis_LayerTarget) ,XIC(DnStacker_Permit_Dn) XIC(DnAxis_DecrementLayer) XIO(DnAxis_IncrementLayer) GRT(DnAxis_CurrentLayer,1) SUB(DnAxis_CurrentLayer,1,DnAxis_LayerTarget) ]OTE(DnAxis_MoveToLayerTarget);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[GEQ(DnAxis_CurrentLayer,11)OTU(DnAxis_IncrementLayer);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[LEQ(DnAxis_CurrentLayer,1)OTU(DnAxis_DecrementLayer);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[Move to layer
]]>
</Comment>
<Text>
<![CDATA[[[XIC(DnAxis_MoveToLayerTarget) ,NEQ(DnAxis_LayerTarget,DnAxis_CurrentLayer) ,XIC(IAI_DnStacker_CMD_Manual_Move) ] ,XIC(DnAxis_Cmd_StartMove) XIO(DnAxis_PositionComplete) ]XIO(DnAxis_Moving)XIC(DnAxis_ReadyToMove)XIO(DnAxis_MoveFailedTON.DN)[ONS(LayerMoveONS) ,]MOV(DnAxis_Positions[DnAxis_LayerTarget],DnAxis_Target)[OTE(DnAxis_Cmd_StartMove) ,TON(DnAxis_MoveFailedTON,?,?) ,OTU(DnAxis_IncrementLayer) OTU(DnAxis_DecrementLayer) ];]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[Confirm position move successful, update current position

]]>
</Comment>
<Text>
<![CDATA[[XIC(DnAxis_PositionComplete) ONS(PositionCompleteONS) ,XIC(DnStackerUpdateCurrentPosition) ][ADD(DnAxis_Positions[1],PosLim,DnAxis_PositionsPosLim[1]) SUB(DnAxis_Positions[1],NegLim,DnAxis_PositionsNegLim[1]) LIM(DnAxis_PositionsNegLim[1],DnAxis_Position,DnAxis_PositionsPosLim[1]) MOV(1,DnAxis_CurrentLayer) ,ADD(DnAxis_Positions[2],PosLim,DnAxis_PositionsPosLim[2]) SUB(DnAxis_Positions[2],NegLim,DnAxis_PositionsNegLim[2]) LIM(DnAxis_PositionsNegLim[2],DnAxis_Position,DnAxis_PositionsPosLim[2]) MOV(2,DnAxis_CurrentLayer) ,ADD(DnAxis_Positions[3],PosLim,DnAxis_PositionsPosLim[3]) SUB(DnAxis_Positions[3],NegLim,DnAxis_PositionsNegLim[3]) LIM(DnAxis_PositionsNegLim[3],DnAxis_Position,DnAxis_PositionsPosLim[3]) MOV(3,DnAxis_CurrentLayer) ,ADD(DnAxis_Positions[4],PosLim,DnAxis_PositionsPosLim[4]) SUB(DnAxis_Positions[4],NegLim,DnAxis_PositionsNegLim[4]) LIM(DnAxis_PositionsNegLim[4],DnAxis_Position,DnAxis_PositionsPosLim[4]) MOV(4,DnAxis_CurrentLayer) ,ADD(DnAxis_Positions[5],PosLim,DnAxis_PositionsPosLim[5]) SUB(DnAxis_Positions[5],NegLim,DnAxis_PositionsNegLim[5]) LIM(DnAxis_PositionsNegLim[5],DnAxis_Position,DnAxis_PositionsPosLim[5]) MOV(5,DnAxis_CurrentLayer) ,ADD(DnAxis_Positions[6],PosLim,DnAxis_PositionsPosLim[6]) SUB(DnAxis_Positions[6],NegLim,DnAxis_PositionsNegLim[6]) LIM(DnAxis_PositionsNegLim[6],DnAxis_Position,DnAxis_PositionsPosLim[6]) MOV(6,DnAxis_CurrentLayer) ,ADD(DnAxis_Positions[7],PosLim,DnAxis_PositionsPosLim[7]) SUB(DnAxis_Positions[7],NegLim,DnAxis_PositionsNegLim[7]) LIM(DnAxis_PositionsNegLim[7],DnAxis_Position,DnAxis_PositionsPosLim[7]) MOV(7,DnAxis_CurrentLayer) ,ADD(DnAxis_Positions[8],PosLim,DnAxis_PositionsPosLim[8]) SUB(DnAxis_Positions[8],NegLim,DnAxis_PositionsNegLim[8]) LIM(DnAxis_PositionsNegLim[8],DnAxis_Position,DnAxis_PositionsPosLim[8]) MOV(8,DnAxis_CurrentLayer) ,ADD(DnAxis_Positions[9],PosLim,DnAxis_PositionsPosLim[9]) SUB(DnAxis_Positions[9],NegLim,DnAxis_PositionsNegLim[9]) LIM(DnAxis_PositionsNegLim[9],DnAxis_Position,DnAxis_PositionsPosLim[9]) MOV(9,DnAxis_CurrentLayer) ,ADD(DnAxis_Positions[10],PosLim,DnAxis_PositionsPosLim[10]) SUB(DnAxis_Positions[10],NegLim,DnAxis_PositionsNegLim[10]) LIM(DnAxis_PositionsNegLim[10],DnAxis_Position,DnAxis_PositionsPosLim[10]) MOV(10,DnAxis_CurrentLayer) ,ADD(DnAxis_Positions[11],PosLim,DnAxis_PositionsPosLim[11]) SUB(DnAxis_Positions[11],NegLim,DnAxis_PositionsNegLim[11]) LIM(DnAxis_PositionsNegLim[11],DnAxis_Position,DnAxis_PositionsPosLim[11]) MOV(11,DnAxis_CurrentLayer) ,ADD(DnAxis_Positions[12],PosLim,DnAxis_PositionsPosLim[12]) SUB(DnAxis_Positions[12],NegLim,DnAxis_PositionsNegLim[12]) LIM(DnAxis_PositionsNegLim[12],DnAxis_Position,DnAxis_PositionsPosLim[12]) MOV(12,DnAxis_CurrentLayer) ,ADD(DnAxis_Positions[13],PosLim,DnAxis_PositionsPosLim[13]) SUB(DnAxis_Positions[13],NegLim,DnAxis_PositionsNegLim[13]) LIM(DnAxis_PositionsNegLim[13],DnAxis_Position,DnAxis_PositionsPosLim[13]) MOV(13,DnAxis_CurrentLayer) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
<Program Name="Program980000_HumanMachineInterface" TestEdits="false" MainRoutineName="Routine980100_Main" Disabled="false" Class="Standard" UseAsFolder="false">
<Description>
