<Routines>
<Routine Name="EnableInFalse" Type="RLL">
<Description>
<![CDATA[Executes when the rung is false]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[OTU(EN);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[OTL(EN);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(Map_Axis_Inputs.Ready)OTE(Ready);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(Map_Axis_Inputs.E_Stop_Active)OTE(E_Stop_Active);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(Map_Axis_Inputs.Alarm_Active)OTE(Alarm_Active);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(Map_Axis_Inputs.Servo_is_On)OTE(Servo_On);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(Map_Axis_Inputs.Homing)OTE(Homing);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(Map_Axis_Inputs.Home_Complete)OTE(Home_Complete);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(Map_Axis_Inputs.Moving)OTE(Moving);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(Map_Axis_Inputs.Position_Complete)OTE(Position_Complete);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(Map_Axis_Inputs.Manual_Mode)OTE(Manual_Mode);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(Map_Axis_Inputs.In_PZone)OTE(In_PZone);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(Map_Axis_Inputs.In_Zone_1)OTE(In_Zone_1);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[XIC(Map_Axis_Inputs.In_Zone_2)OTE(In_Zone_2);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[XIC(Map_Axis_Inputs.Torque_Level_Reached)OTE(Torque_Reached);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[XIC(Map_Axis_Inputs.Load_Output_Reached)OTE(Load_Output_Reached);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[XIC(Map_Axis_Inputs.In_Push_Zone)OTE(In_Push_Zone);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[XIC(Map_Axis_Inputs.Push_Failed)OTE(Push_Failed);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[MOV(Map_Axis_Inputs.Actual_Position,Actual_Position)MOV(Map_Axis_Inputs.Actual_Speed,Actual_Speed)MOV(Map_Axis_Inputs.Command_Current,Command_Current)MOV(Map_Axis_Inputs.Alarm_Code,Alarm_Code);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
</AddOnInstructionDefinitions>
