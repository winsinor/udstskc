<![CDATA[COP(Station100_Robot:I.Data[64],Robot_Sts_State,4)COP(Station100_Robot:I.Data[68],Robot_Sts_RoutineID,4)COP(Station100_Robot:I.Data[72],Robot_Sts_AckSeq,4)COP(Station100_Robot:I.Data[76],Robot_Sts_FaultCode,4)COP(Station100_Robot:I.Data[80],Robot_Sts_RetryCount,4)COP(Station100_Robot:I.Data[84],Robot_Sts_SubStep,4);]]>
