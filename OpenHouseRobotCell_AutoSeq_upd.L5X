<![CDATA[[XIC(PlaceHolderBit) XIC(Station300LaserMarker._Fault[0]) ,XIC(PlaceHolderBit) XIC(Station300LaserMarker._Fault[1]) ,XIC(PlaceHolderBit) XIC(Station300LaserMarker._Fault[2]) ,XIC(PlaceHolderBit) XIC(Station300LaserMarker._Fault[3]) ,XIC(PlaceHolderBit) XIC(Station300LaserMarker._Fault[4]) ,XIC(PlaceHolderBit) XIC(Station300LaserMarker._Fault[5]) ,XIC(PlaceHolderBit) XIC(Station300LaserMarker._Fault[6]) ,XIC(PlaceHolderBit) XIC(Station300LaserMarker._Fault[7]) ,XIC(PlaceHolderBit) XIC(Station300LaserMarker._Fault[8]) ,XIC(PlaceHolderBit) XIC(Station300LaserMarker._Fault[9]) ,XIC(PlaceHolderBit) XIC(Station300LaserMarker._Fault[10]) ,XIC(PlaceHolderBit) XIC(Station300LaserMarker._Fault[11]) ,XIC(PlaceHolderBit) XIC(Station300LaserMarker._Fault[12]) ,XIC(PlaceHolderBit) XIC(Station300LaserMarker._Fault[13]) ,XIC(PlaceHolderBit) XIC(Station300LaserMarker._Fault[14]) ,XIC(PlaceHolderBit) XIC(Station300LaserMarker._Fault[15]) ,XIC(PlaceHolderBit) XIC(Station300LaserMarker._Fault[16]) ,XIC(PlaceHolderBit) XIC(Station300LaserMarker._Fault[17]) ,XIC(PlaceHolderBit) XIC(Station300LaserMarker._Fault[18]) ,XIC(PlaceHolderBit) XIC(Station300LaserMarker._Fault[19]) ,XIC(PlaceHolderBit) XIC(Station300LaserMarker._Fault[20]) ,XIC(PlaceHolderBit) XIC(Station300LaserMarker._Fault[21]) ,XIC(PlaceHolderBit) XIC(Station300LaserMarker._Fault[22]) ,XIC(PlaceHolderBit) XIC(Station300LaserMarker._Fault[23]) ,XIC(PlaceHolderBit) XIC(Station300LaserMarker._Fault[24]) ,XIC(PlaceHolderBit) XIC(Station300LaserMarker._Fault[25]) ,XIC(PlaceHolderBit) XIC(Station300LaserMarker._Fault[26]) ,XIC(PlaceHolderBit) XIC(Station300LaserMarker._Fault[27]) ,XIC(PlaceHolderBit) XIC(Station300LaserMarker._Fault[28]) ,XIC(PlaceHolderBit) XIC(Station300LaserMarker._Fault[29]) ,XIC(PlaceHolderBit) XIC(Station300LaserMarker._Fault[30]) ,XIC(PlaceHolderBit) XIC(Station300LaserMarker._Fault[31]) ]OTE(Station300LaserMarker._ShutdownSystem_Fault);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="_03_Inputs" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(PRX102)OTE(Weiss_Hood_Raised);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(PRX200)OTE(IndexTable_In_Position);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(PRX103)OTE(Hood_Lowered);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(MDX2:I.Data[0].0)OTE(Laser_Marker_Ready);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[[XIC(MDX2:I.Data[0].1) ,XIC(MDX2:I.Data[0].3) ,XIC(MDX2:I.Data[0].5) ,XIC(MDX2:I.Data[0].10) ,XIC(MDX2:I.Data[0].11) ,NEQ(HARDWARE_FAULTS[4],0) ]OTE(Laser_Error);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(MDX2:I.Data[0].2)OTE(Laser_Warning);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(MDX2:I.Data[0].6)OTE(Laser_Ready_For_Job_Change);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(MDX2:I.Data[0].8)OTE(MDX2:I.Data[0].8);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(MDX2:I.Data[0].9)OTE(Laser_Shutter_Control_Status);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(MDX2:I.Data[0].12)OTE(MDX2:I.Data[0].12);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
