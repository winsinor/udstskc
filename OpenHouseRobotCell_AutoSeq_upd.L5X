<Routine Name="_08_HMI_Animations" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Change the Robot Blank side vacuum buttons Colors]]>
</Comment>
<Text>
<![CDATA[[XIO(Rob_Permit_Vac_A_Blank) [XIO(PLCtoR_BlankCupAVacOn) [XIO(CR700) MOV(0,Rob_Vac_Blank_A.Button_Color) ,XIO(CR701) MOV(0,Rob_Blow_Blank_A.Button_Color) ] ,XIO(PLCtoR_BlankCupBVacOn) [XIO(CR702) MOV(0,Rob_Vac_Blank_B.Button_Color) ,XIO(CR703) MOV(0,Rob_Blow_Blank_B.Button_Color) ] ] ,XIC(Rob_Permit_Vac_A_Blank) [[XIO(PLCtoR_BlankCupAVacOn) MOV(1,Rob_Vac_Blank_A.Button_Color) ,XIO(PLCtoR_BlankCupBVacOn) MOV(1,Rob_Vac_Blank_B.Button_Color) ,XIO(CR701) MOV(1,Rob_Blow_Blank_A.Button_Color) ,XIO(CR703) MOV(1,Rob_Blow_Blank_B.Button_Color) ] ,[XIC(CR700) MOV(3,Rob_Vac_Blank_A.Button_Color) ,XIC(CR702) MOV(3,Rob_Vac_Blank_B.Button_Color) ,AFI() MOV(3,Rob_Blow_Blank_A.Button_Color) ,AFI() MOV(3,Rob_Blow_Blank_B.Button_Color) ] ,AFI() [MOV(2,Rob_Vac_Blank_A.Button_Color) ,MOV(2,Rob_Vac_Blank_B.Button_Color) ,MOV(2,Rob_Blow_Blank_A.Button_Color) ,MOV(2,Rob_Blow_Blank_B.Button_Color) ] ,[XIC(PLCtoR_BlankCupAVacOn) MOV(4,Rob_Vac_Blank_A.Button_Color) ,XIC(PLCtoR_BlankCupBVacOn) MOV(4,Rob_Vac_Blank_B.Button_Color) ,XIC(CR701) MOV(4,Rob_Blow_Blank_A.Button_Color) ,XIC(CR703) MOV(4,Rob_Blow_Blank_B.Button_Color) ] ] ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Change the Robot Finished side vacuum buttons Colors]]>
</Comment>
<Text>
<![CDATA[[XIO(Rob_Permit_Vac_A_Finished) [XIO(PLCtoR_FinishCupAVacOn) [XIO(CR704) MOV(0,Rob_Vac_Finished_A.Button_Color) ,XIO(CR705) MOV(0,Rob_Blow_Finished_A.Button_Color) ] ,XIO(PLCtoR_FinishCupBVacOn) [XIO(CR706) MOV(0,Rob_Vac_Finished_B.Button_Color) ,XIO(CR707) MOV(0,Rob_Blow_Finished_B.Button_Color) ] ] ,XIC(Rob_Permit_Vac_A_Finished) [[XIO(PLCtoR_FinishCupAVacOn) MOV(1,Rob_Vac_Finished_A.Button_Color) ,XIO(PLCtoR_FinishCupBVacOn) MOV(1,Rob_Vac_Finished_B.Button_Color) ,XIO(CR705) MOV(1,Rob_Blow_Finished_A.Button_Color) ,XIO(CR707) MOV(1,Rob_Blow_Finished_B.Button_Color) ] ,[XIC(CR704) MOV(3,Rob_Vac_Finished_A.Button_Color) ,XIC(CR706) MOV(3,Rob_Vac_Finished_B.Button_Color) ,AFI() MOV(3,Rob_Blow_Finished_A.Button_Color) ,AFI() MOV(3,Rob_Blow_Finished_B.Button_Color) ] ,AFI() [MOV(2,Rob_Vac_Finished_A.Button_Color) ,MOV(2,Rob_Vac_Finished_B.Button_Color) ,MOV(2,Rob_Blow_Finished_A.Button_Color) ,MOV(2,Rob_Blow_Finished_B.Button_Color) ] ,[XIC(PLCtoR_FinishCupAVacOn) MOV(4,Rob_Vac_Finished_A.Button_Color) ,XIC(PLCtoR_FinishCupBVacOn) MOV(4,Rob_Vac_Finished_B.Button_Color) ,XIC(CR705) MOV(4,Rob_Blow_Finished_A.Button_Color) ,XIC(CR707) MOV(4,Rob_Blow_Finished_B.Button_Color) ] ] ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Change the Spru Cutter buttons Colors]]>
</Comment>
<Text>
<![CDATA[[XIO(Spru_Cutter_Permit) [XIO(CR409) MOV(0,Spru_Cutter_Close.Button_Color) ,XIO(CR409) MOV(0,Spru_Cutter_Open.Button_Color) ] ,XIC(Spru_Cutter_Permit) [[XIO(CR409) MOV(1,Spru_Cutter_Close.Button_Color) ,XIO(CR409) MOV(1,Spru_Cutter_Open.Button_Color) ] ,XIO(CR409) MOV(3,Spru_Cutter_Close.Button_Color) ,XIC(CR409) MOV(3,Spru_Cutter_Open.Button_Color) ,AFI() MOV(2,Spru_Cutter_Close.Button_Color) ,AFI() MOV(2,Spru_Cutter_Open.Button_Color) ,XIC(CR409) MOV(4,Spru_Cutter_Close.Button_Color) ,XIO(CR409) MOV(4,Spru_Cutter_Open.Button_Color) ] ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
<Program Name="Program050000_Station200_UpStacker" TestEdits="false" MainRoutineName="Routine050100_Main" Disabled="false" Class="Standard" UseAsFolder="false">
<Tags/>
<Routines>
<Routine Name="Routine050100_Main" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[JSR(Routine050300_InputStatus,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[JSR(Routine050500_Operation,0);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[JSR(Routine050600_AutoSequence1,0);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[JSR(Routine050700_OutputActions,0);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[JSR(Routine059999_Alarms,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Routine050300_InputStatus" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Routine050500_Operation" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[[CPS(IAI_UpStacker:I,UpStack_Inputs,1) CPS(UpStack_Outputs,IAI_UpStacker:O,1) XIC(POWER_OK_24VB) XIO(Unlock_Doors) OTE(UpStack_Outputs.Servo_On) OTE(CR614) ,GSV(Module,IS3800,FaultCode,HARDWARE_FAULTS[0]) NEQ(HARDWARE_FAULTS[0],0) [XIO(Cognex_Bypass) OTL(Cognex_Com_Fault) ,XIC(Cognex_Bypass) OTU(Cognex_Com_Fault) ] ,GSV(Module,IAI_UpStacker,FaultCode,HARDWARE_FAULTS[1]) NEQ(HARDWARE_FAULTS[1],0) OTL(Upstack_Com_Fault) ,XIC(Reset_Hold_TMR.DN) OTU(Cognex_Com_Fault) OTU(Upstack_Com_Fault) OTU(Upstack_Jam) XIC(UpStack_Inputs.Alarm_Active) OTE(UpStack_Outputs.Reset) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[MOV(UpStack_HMI_Tray_Qty,UpStack_HMI_Tray_Qty) ,MOV(Cfg_UpStack_LowMax_POS,Cfg_UpStack_LowMax_POS) ,MOV(Cfg_UpStack_HighMax_POS,Cfg_UpStack_HighMax_POS) ,MOV(Cfg_UpStack_TrayHeight,Cfg_UpStack_TrayHeight) ]XIO(UpStack_Inputs.Alarm_Active)XIO(DwnStack_Inputs.Alarm_Active)[XIC(Door_Open_Request) RES(Data_Delay_TMR) MOV(Cfg_UpStack_LowMax_POS,UpStack_Target_Position) MOV(13,Upstack_Layer_Current) AFI() OTU(UStoR_ReqToMoveLayer) ,XIO(Door_Open_Request) TON(Layer_Last_TMR,?,?) XIC(Layer_Last_TMR.DN) [ONS(ONS_STACK.0) XIO(Upstack_Complete) MOV(Upstack_Layer_Last,Upstack_Layer_Current) ,CPT(UpStack_Target_Position,Cfg_UpStack_HighMax_POS-(Upstack_Layer_Current*Cfg_UpStack_TrayHeight)) MOV(Upstack_Layer_Current,Upstack_Layer_Last) ] ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[GEQ(UpStack_Target_Position,Cfg_UpStack_LowMax_POS)LEQ(UpStack_Target_Position,Cfg_UpStack_HighMax_POS)[MOV(UpStack_Target_Position,UpStack_Outputs.Target_Position) ,MOV(UpStack_Target_Speed,UpStack_Outputs.Target_Speed) ][MOV(UpStack_Output_Acceleration,UpStack_Outputs.Acceleration) ,MOV(UpStack_Output_Deceleration,UpStack_Outputs.Deceleration) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[***********************************************
Moves IAI Upstack

*********************************************]]>
</Comment>
<Text>
<![CDATA[XIO(UpStack_Inputs.Alarm_Active)[NEQ(Upstack_Layer_Current,Upstack_Layer_Temp) MOV(Upstack_Layer_Current,Upstack_Layer_Temp) TOF(Upstack_Start_HLD_TMR,?,?) ,XIC(Upstack_Start_HLD_TMR.DN) ]XIO(UpStack_Inputs.Moving)OTE(UpStack_Outputs.Start_Move);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[***********************************************
Cognex Trigger Logic

Triggers on Downstack Move and Jam Clear

Monitors If Trays are in position based on 0-100 score. Anything les than 50 will flag Jam

Resets the Tigger Request and Item Location count on new trigger

*********************************************]]>
</Comment>
<Text>
<![CDATA[[XIC(Trigger_Cognex) OTL(IS3800:O.Control.TriggerEnable) RES(Data_Delay_TMR) OTU(Trigger_Cognex) ,XIC(Cognex_Hold_TMR.DN) OTU(IS3800:O.Control.TriggerEnable) ,XIO(IS3800:O.Control.Trigger) NEQ(IS3800:I.Status.AcquisitionID,Cognex_Acc_ID) MOV(IS3800:I.Status.AcquisitionID,Cognex_Acc_ID) OTL(UpStack_Status_Fill) OTL(UpStack_Fill_Trays) ,XIO(UpStack_Inputs.Moving) XIO(UpStack_Outputs.Start_Move) XIO(UStoR_ReqToMoveLayer) [XIC(IS3800:O.Control.TriggerEnable) TON(Cognex_Hold_TMR,?,?) GRT(Cognex_Hold_TMR.ACC,500) OTE(IS3800:O.Control.Trigger) ,TON(Data_Delay_TMR,?,?) XIC(Data_Delay_TMR.DN) ONS(ONS.2) [[LES(IS3800:I.InspectionResults[96],50) NEQ(Upstack_Layer_Current,0) OTL(Upstack_Jam) ,LES(IS3800:I.InspectionResults[97],50) NEQ(DwnStack_Layer_Current,0) OTL(DwnStack_Jam) ] ,MOV(1,Upstack_Row_Current) MOV(0,Upstack_Column_Current) OTL(New_Layer_Cognex) OTU(UStoR_ReqToPick) ] ] ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[***********************************************
Positions to Fill the Arrays either Ocupied or Empty

***********************************************]]>
</Comment>
<Text>
<![CDATA[XIC(UpStack_Status_Fill)[XIC(UpStack_Empty_Trays) ,XIC(UpStack_Fill_Trays) MOV(Upstack_Layer_Current,UpStack_Layer_Fill) ][ADD(UpStack_Column_Fill,1,UpStack_Column_Fill) LEQ(UpStack_Column_Fill,Cfg_Column_Max) [XIC(UpStack_Empty_Trays) COP(Data_Item_Initialize,Upstack_Layer[UpStack_Layer_Fill].Row[UpStack_Row_Fill].Column[UpStack_Column_Fill],1) ,XIC(UpStack_Fill_Trays) OTE(New_Fill_Item) ] ,GRT(UpStack_Column_Fill,Cfg_Column_Max) [ADD(UpStack_Row_Fill,1,UpStack_Row_Fill) LEQ(UpStack_Row_Fill,Cfg_Row_Max) CLR(UpStack_Column_Fill) ,GRT(UpStack_Row_Fill,Cfg_Row_Max) [[XIC(UpStack_Empty_Trays) ADD(UpStack_Layer_Fill,1,UpStack_Layer_Fill) LEQ(UpStack_Layer_Fill,Cfg_Layer_Max) ,XIC(UpStack_Fill_Trays) OTU(UpStack_Status_Fill) OTU(UpStack_Fill_Trays) ] [CLR(UpStack_Column_Fill) ,MOV(1,UpStack_Row_Fill) ] ,XIC(UpStack_Empty_Trays) GRT(UpStack_Layer_Fill,Cfg_Layer_Max) OTU(UpStack_Status_Fill) [CLR(UpStack_Column_Fill) ,MOV(1,UpStack_Row_Fill) ,MOV(1,UpStack_Layer_Fill) ] ] ] ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[***********************************************
Moves Cognex X, Y, and Angle Calcs into Tray Locations

Fills an Ocupied status or clears based on an X value present

***********************************************]]>
</Comment>
<Text>
<![CDATA[XIC(New_Fill_Item)XIC(UpStack_Fill_Trays)[EQU(UpStack_Row_Fill,1) [EQU(UpStack_Column_Fill,1) MOV(0,Cognex_Control_X1) ,EQU(UpStack_Column_Fill,2) MOV(6,Cognex_Control_X1) ,EQU(UpStack_Column_Fill,3) MOV(24,Cognex_Control_X1) ,EQU(UpStack_Column_Fill,4) MOV(30,Cognex_Control_X1) ] ,EQU(UpStack_Row_Fill,2) [EQU(UpStack_Column_Fill,1) MOV(48,Cognex_Control_X1) ,EQU(UpStack_Column_Fill,2) MOV(54,Cognex_Control_X1) ,EQU(UpStack_Column_Fill,3) MOV(72,Cognex_Control_X1) ,EQU(UpStack_Column_Fill,4) MOV(78,Cognex_Control_X1) ] ,MOV(Cognex_Control_X1,Cognex_Control_X1) MOV(IS3800:I.InspectionResults[Cognex_Control_X1],Upstack_Layer[UpStack_Layer_Fill].Row[UpStack_Row_Fill].Column[UpStack_Column_Fill].Orig_X_1) ,CPT(Cognex_Control_X2,Cognex_Control_X1+12) MOV(IS3800:I.InspectionResults[Cognex_Control_X2],Upstack_Layer[UpStack_Layer_Fill].Row[UpStack_Row_Fill].Column[UpStack_Column_Fill].Orig_X_2) [[GRT(IS3800:I.InspectionResults[Cognex_Control_X1],0) ,GRT(IS3800:I.InspectionResults[Cognex_Control_X2],0) ] MOV(Cfg_Status_Ocupied,Upstack_Layer[UpStack_Layer_Fill].Row[UpStack_Row_Fill].Column[UpStack_Column_Fill].Status) ,EQU(IS3800:I.InspectionResults[Cognex_Control_X1],0) EQU(IS3800:I.InspectionResults[Cognex_Control_X2],0) COP(Data_Item_Initialize,Upstack_Layer[UpStack_Layer_Fill].Row[UpStack_Row_Fill].Column[UpStack_Column_Fill],1) ] ,CPT(Cognex_Control_Y1,Cognex_Control_X1+1) MOV(IS3800:I.InspectionResults[Cognex_Control_Y1],Upstack_Layer[UpStack_Layer_Fill].Row[UpStack_Row_Fill].Column[UpStack_Column_Fill].Orig_Y_1) ,CPT(Cognex_Control_Y2,Cognex_Control_Y1+12) MOV(IS3800:I.InspectionResults[Cognex_Control_Y2],Upstack_Layer[UpStack_Layer_Fill].Row[UpStack_Row_Fill].Column[UpStack_Column_Fill].Orig_Y_2) ,CPT(Cognex_Control_A1,Cognex_Control_X1+2) MOV(IS3800:I.InspectionResults[Cognex_Control_A1],Upstack_Layer[UpStack_Layer_Fill].Row[UpStack_Row_Fill].Column[UpStack_Column_Fill].Orig_Angle_1) ,CPT(Cognex_Control_A2,Cognex_Control_A1+12) MOV(IS3800:I.InspectionResults[Cognex_Control_A2],Upstack_Layer[UpStack_Layer_Fill].Row[UpStack_Row_Fill].Column[UpStack_Column_Fill].Orig_Angle_2) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[GEQ(UStoR_PickSeqNumber,490)MOV(1,UStoR_PickSeqNumber);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIO(Door_Open_Request)XIO(UpStack_Outputs.Start_Move)XIO(UpStack_Inputs.Moving)XIO(UStoR_ReqToMoveLayer)XIO(Upstack_Jam)XIO(Upstack_Complete)XIC(Data_Delay_TMR.DN)XIO(UStoR_ReqToPick)OTE(Upstack_Count_Permission);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[[XIO(Turn_Table_Full) ,XIC(New_Layer_Cognex) ,XIC(RtoUS_PickConfirm) EQU(Upstack_Row_Current,Cfg_Row_Max) EQU(Upstack_Column_Current,Cfg_Column_Max) ,[XIC(TurnTable_Move_ONS) ,XIC(RtoTT_PickConfirm) ] [EQU(TurnTable[1].Seq_Num,0) ,EQU(TurnTable[4].Seq_Num,0) ] ]OTE(Upstack_Count_Request);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[***********************************************
Requests to Pick based on first Ocupied status

Requests a layer move based on a finished tray

Requests to Open Door based on Upstack Complete

Cfg_Colum_Max, Cfg_Row_Max should be set to size of tray

***********************************************]]>
</Comment>
<Text>
<![CDATA[XIC(Upstack_Count_Permission)[XIC(Upstack_Count_Request) ADD(Upstack_Column_Current,1,Upstack_Column_Current) LEQ(Upstack_Column_Current,Cfg_Column_Max) EQU(Upstack_Layer[Upstack_Layer_Current].Row[Upstack_Row_Current].Column[Upstack_Column_Current].Status,1) ADD(1,UStoR_PickSeqNumber,UStoR_PickSeqNumber) [OTL(UStoR_ReqToPick) ,OTU(New_Layer_Cognex) ] ,GRT(Upstack_Column_Current,Cfg_Column_Max) [ADD(Upstack_Row_Current,1,Upstack_Row_Current) LEQ(Upstack_Row_Current,Cfg_Row_Max) MOV(0,Upstack_Column_Current) ,GRT(Upstack_Row_Current,Cfg_Row_Max) [SUB(Upstack_Layer_Current,1,Upstack_Layer_Current) GEQ(Upstack_Layer_Current,0) OTL(UStoR_ReqToMoveLayer) ,LEQ(Upstack_Layer_Current,0) XIC(WinTest.0) OTL(Upstack_Complete) ] ] ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[***********************************************
Clears MoveLayer based on LayerMovedConfirm from Robot

Clears MoveLayer based on Upstack complete and Reset of the Doors

Moves Upstack_HMI_Tray_Qty into set number of trays

***********************************************]]>
</Comment>
<Text>
<![CDATA[[XIC(RtoUS_LayerMovedConfirm) ONS(ONS_STACK.5) OTU(UStoR_ReqToMoveLayer) ,XIO(UStoR_ReqToMoveLayer) XIC(Upstack_Complete) [XIO(UpStack_Outputs.Start_Move) XIO(UpStack_Inputs.Moving) XIO(DwnStack_Outputs.Start_Move) XIO(DwnStack_Inputs.Moving) ONS(ONS_STACK.8) OTL(Door_Open_Request) ,[XIO(Door_Open_Request) ONS(ONS_STACK.9) ,XIC(Upstack_Complete_TMR.EN) XIO(Upstack_Complete_TMR.DN) ] TON(Upstack_Complete_TMR,?,?) XIC(Upstack_Complete_TMR.DN) [MOV(UpStack_HMI_Tray_Qty,Upstack_Layer_Last) ,MOV(UpStack_HMI_Tray_Qty,Upstack_Layer_Current) ] [MOV(DwnStack_HMI_Tray_Qty,DwnStack_Layer_Last) ,MOV(DwnStack_HMI_Tray_Qty,DwnStack_Layer_Current) ] OTU(Upstack_Complete) ] ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Passes Location of Part to Robot]]>
</Comment>
<Text>
<![CDATA[XIC(UStoR_ReqToPick)[MOV(Upstack_Layer_Current,Upstack_Layer_Current) MOV(Upstack_Row_Current,UStoR_PickRowNumber) MOV(Upstack_Column_Current,UStoR_PickColumnNumber) ,MOV(UStoR_PickSeqNumber,Upstack_Layer[Upstack_Layer_Current].Row[Upstack_Row_Current].Column[Upstack_Column_Current].Seq_Num) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Clears Part Present in Location from Robot
]]>
</Comment>
<Text>
<![CDATA[XIC(RtoUS_PickConfirm)ONS(ONS_STACK.1)COP(Data_Item_Initialize,Data_Item[UStoR_PickSeqNumber],1)[COP(Upstack_Layer[Upstack_Layer_Current].Row[Upstack_Row_Current].Column[Upstack_Column_Current],Data_Item[UStoR_PickSeqNumber],1) ,MOV(2,Data_Item[UStoR_PickSeqNumber].Status) ,MOV(Cfg_Status_Complete,Upstack_Layer[Upstack_Layer_Current].Row[Upstack_Row_Current].Column[Upstack_Column_Current].Status) ]OTU(UStoR_ReqToPick);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
