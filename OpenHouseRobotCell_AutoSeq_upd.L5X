<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[XIC(Fire_The_Laser) XIC(Josh_test.26) XIO(Run_VFD) XIC(PRX200) OTL(CR301) OTL(CR400) ,XIO(Fire_The_Laser) ONS(ONS_DOCK.5) OTU(CR301) OTU(CR400) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[NOP()[XIC(TurnTable_New_Seq_Num) OTL(VFD_Index_REQUEST) ,XIC(PRX200) ONS(ONS_DOCK.1) XIO(FIrst_Scan_TMR.TT) XIO(AENTR_Com_Fault) [OTU(VFD_Index_REQUEST) ,OTE(TurnTable_Move_ONS) ] ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[NOP()[XIC(VFD_Index_REQUEST) XIC(POWER_OK_24VC) XIO(Hood_Lowered) XIC(VFD_Weiss_READY) XIO(VFD_Weiss_FAULTED) OTE(Run_VFD) ,XIC(Run_VFD) OTE(CR504) OTE(VFD_Weiss_RUN) ,XIO(Run_VFD) OTE(VFD_Weiss_STOP) ,MOV(Weiss:O.FreqCommand,Weiss:O.FreqCommand) XIC(VFD_Weiss_AT_FREQ) NOP() ,XIC(Weiss:I.Active) OTE(TTtoR_TurnTableCycle) ,XIC(VFD_Weiss_FAULTED) [XIO(Reset_Hold_TMR.DN) XIC(CRM_S) ONS(ONS_DOCK.3) ,XIC(Reset_Hold_TMR.DN) ,XIC(RtoPLC_Started) ,XIC(GlobalAck_TOF.TT) ] OTE(VFD_Weiss_RESET) ];]]>
</Text>
</Rung>
