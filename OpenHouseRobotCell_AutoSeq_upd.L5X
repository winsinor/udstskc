<Routine Name="Routine060500_Operation" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[[[XIC(S:FS) ,XIC(POWER_OK_24VC) ONS(ONS.1) ] ,XIC(FIrst_Scan_TMR.TT) OTU(Fire_The_Laser) ]TON(FIrst_Scan_TMR,?,?);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(amp_Test_Bits.31)XIC(POWER_OK_24VC)XIC(POWER_OK_24VB)[GSV(Module,PLC25,FaultCode,HARDWARE_FAULTS[3]) NEQ(HARDWARE_FAULTS[3],0) OTL(AENTR_Com_Fault) ,GSV(Module,MDX2,FaultCode,HARDWARE_FAULTS[4]) NEQ(HARDWARE_FAULTS[4],0) OTL(Laser_Com_Fault) ,GSV(Module,IV3,FaultCode,HARDWARE_FAULTS[5]) NEQ(HARDWARE_FAULTS[5],0) OTL(Keyence_Com_Fault) ,GSV(Module,Weiss,FaultCode,HARDWARE_FAULTS[6]) NEQ(HARDWARE_FAULTS[6],0) OTL(Weiss_Com_Fault) ,XIC(Reset_Hold_TMR.DN) OTU(Weiss_Com_Fault) OTU(Keyence_Com_Fault) OTU(Laser_Com_Fault) OTU(AENTR_Com_Fault) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[***********************************************
NEW ITEM
IN TURN TABLE STATION 1
VFD and DATA  MOVE 

***********************************************]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(RtoTT_PlacedConfirm)ONS(ONS_DOCK.4)NEQ(RtoTT_PlaceSeqNumber,0)NEQ(RtoTT_PlaceSeqNumber,TurnTable[1].Seq_Num)COP(Data_Item[RtoTT_PlaceSeqNumber],TurnTable[1],1)OTE(TurnTable_New_Seq_Num);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[GRT(Data_Item[TurnTable_2_SeqNum].Status,0)GRT(Data_Item[TurnTable_3_SeqNum].Status,0)OTL(Turn_Table_Full);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[NOP()XIC(TurnTable_Move_ONS)COP(TurnTable[4],TurnTable[0],1)COP(TurnTable[3],TurnTable[4],1)COP(TurnTable[2],TurnTable[3],1)COP(TurnTable[1],TurnTable[2],1)COP(TurnTable[0],TurnTable[1],1);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[***********************************************
PART PRESENT LOGIC
TURN TABLE STATION 2

***********************************************]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(TurnTable_Move_ONS)GRT(TurnTable[2].Seq_Num,0)NEQ(TurnTable[2].Seq_Num,TurnTable_2_SeqNum)MOV(TurnTable[2].Seq_Num,TurnTable_2_SeqNum)[[OTU(Data_Item[TurnTable_2_SeqNum].TurnTable_1_Pres) XIO(PE202) OTL(Data_Item[TurnTable_2_SeqNum].TurnTable_1_Pres) ,OTU(Data_Item[TurnTable_2_SeqNum].TurnTable_2_Pres) XIO(PE203) OTL(Data_Item[TurnTable_2_SeqNum].TurnTable_2_Pres) ] COP(Data_Item[TurnTable_2_SeqNum],TurnTable[2],1) ,XIC(PE202) XIC(PE203) COP(Data_Item_Initialize,TurnTable[2],1) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[***********************************************
LASER LOGIC
TURN TABLE STATION 3

***********************************************]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(TurnTable_Move_ONS)GRT(TurnTable[3].Seq_Num,0)NEQ(TurnTable[3].Seq_Num,TurnTable_3_SeqNum)MOV(TurnTable[3].Seq_Num,TurnTable_3_SeqNum)COP(Data_Item[TurnTable_3_SeqNum],TurnTable[3],1)XIC(Data_Item[TurnTable_3_SeqNum].TurnTable_1_Pres)XIC(Data_Item[TurnTable_3_SeqNum].TurnTable_2_Pres)XIC(amp_Test_Bits.31)OTL(Fire_The_Laser);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[[XIC(Fire_The_Laser) XIC(MDX2:I.Data[4].0) TOF(Laser_Clear_TMR,?,?) ,XIC(Laser_Clear_TMR.DN) ]OTE(MDX2:O.Data[7].0)OTE(MDX2:O.Data[6].0)OTU(Fire_The_Laser);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[[XIC(MDX2:I.Data[0].1) TON(Laser_Error_TMR,?,?) XIC(Laser_Error_TMR.DN) RES(Laser_Error_TMR) ,GRT(Laser_Error_TMR.ACC,500) OTE(MDX2:O.Data[0].3) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[***********************************************
IV3 CAMERA LOGIC

***********************************************]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[XIC(TurnTable_Move_ONS)GRT(TurnTable[4].Seq_Num,0)NEQ(TurnTable[4].Seq_Num,TurnTable_4_SeqNum)MOV(TurnTable[4].Seq_Num,TurnTable_4_SeqNum)OTL(Trigger_IV3);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[XIC(IV3:I.Data[1].4)XIC(IV3:I.Data[1].5)XIO(IV3:I.Data[1].2)OTE(Keyence_IV3_Ready);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[Trigger Sequence]]>
</Comment>
<Text>
<![CDATA[[XIC(Trigger_IV3) ONS(ONS_DOCK.2) ,XIC(IV3:O.Data[0].0) XIO(IV3:I.Data[0].0) ]XIO(IV3:I.Data[0].0)XIO(IV3:I.Data[0].7)OTE(IV3:O.Data[0].0);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[Result Data for Alarms]]>
</Comment>
<Text>
<![CDATA[XIO(IV3:I.Data[1].2)XIC(IV3:I.Data[1].0)ONS(ONS_DOCK.6)OTU(Trigger_IV3)GRT(TurnTable_4_SeqNum,0)[OTU(Data_Item[TurnTable_4_SeqNum].Inspect_1_Status) XIC(IV3:I.Data[3].0) OTL(Data_Item[TurnTable_4_SeqNum].Inspect_1_Status) ,OTU(Data_Item[TurnTable_4_SeqNum].Inspect_2_Status) XIC(IV3:I.Data[3].1) OTL(Data_Item[TurnTable_4_SeqNum].Inspect_2_Status) ]COP(Data_Item[TurnTable_4_SeqNum],TurnTable[4],1);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[***********************************************
PICKUP LOGIC
TURN TABLE STATION 1

***********************************************]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[[XIC(RtoTT_PickConfirm) ,XIC(Optix_TTpickConfirmButton) ]ONS(ONS_DOCK.7)GRT(TurnTable[1].Seq_Num,0)ADD(TEST_DINT[1],1,TEST_DINT[1])OTU(Turn_Table_Full)OTU(TTtoR_ReqToPickGood)OTU(TTtoR_ReqToPickBad)OTU(Optix_TTpickConfirmButton)MOV(4,Data_Item[TurnTable_1_SeqNum].Status)[COP(Data_Item_Initialize,TurnTable[1],1) ,COP(Data_Item_Initialize,TurnTable[0],1) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
