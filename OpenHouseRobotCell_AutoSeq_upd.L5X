</RLLContent>
</Routine>
<Routine Name="_04_Outputs" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(Motion_Control_OK)XIC(PRX200)XIO(Weiss_Manual_Run_VFD)OTE(Laser_Hood_Lower_Permit);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(Motion_Control_OK)XIO(MDX2:I.Data[0].4)OTE(Laser_Hood_Raise_Permit);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(Motion_Control_OK)OTE(Fume_Permit);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(VFD_Weiss_FAULTED)[XIO(Reset_Hold_TMR.DN) XIC(CRM_S) ONS(ONS_DOCK.3) ,XIC(Reset_Hold_TMR.DN) ,XIC(RtoPLC_Started) ,XIC(GlobalAck_TOF.TT) ]OTE(VFD_Weiss_RESET);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[[XIC(System_ManualMode) XIC(Laser_Hood_Lower_Permit) XIC(HMI_Hood_Lower_PB) ,XIC(System_AutoMode) OTU(HMI_Hood_Lower_PB) NEQ(Weiss_Hood_Lower_Auto_Req,0) ]OTL(CR301);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[[XIC(System_ManualMode) XIC(Laser_Hood_Raise_Permit) XIC(HMI_Hood_Raise_PB) ,XIC(System_AutoMode) OTU(HMI_Hood_Raise_PB) NEQ(Weiss_Hood_Raise_Auto_Req,0) ]OTU(CR301);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[[XIC(System_ManualMode) XIC(Fume_Permit) XIC(HMI_Fume_ON_PB) ,XIC(System_AutoMode) OTU(HMI_Fume_ON_PB) XIC(Start_Fume_Extraction_Auto_Req) ]OTL(CR400);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Turn Fume extraction off after XXX time]]>
</Comment>
<Text>
<![CDATA[XIO(System_InCycle)XIC(Start_Fume_Extraction_Auto_Req)TON(Fume_Off_Idle_Tmr,?,?)XIC(Fume_Off_Idle_Tmr.DN)OTU(Start_Fume_Extraction_Auto_Req);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[[XIC(System_ManualMode) XIC(Fume_Permit) XIC(HMI_Fume_OFF_PB) ,XIC(System_AutoMode) OTU(HMI_Fume_ON_PB) XIO(Start_Fume_Extraction_Auto_Req) ]OTU(CR400);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(TurnTable_Move_ONS)GRT(TurnTable[1].Seq_Num,0)NEQ(TurnTable[1].Seq_Num,TurnTable_1_SeqNum)MOV(TurnTable[1].Seq_Num,TurnTable_1_SeqNum)MOV(TurnTable_1_SeqNum,TTtoR_PickSeqNumber)MOV(3,Data_Item[TurnTable_1_SeqNum].Status)[XIC(Data_Item[TurnTable_1_SeqNum].Inspect_1_Status) XIC(Data_Item[TurnTable_1_SeqNum].Inspect_2_Status) OTL(TTtoR_ReqToPickGood) ,[XIO(Data_Item[TurnTable_1_SeqNum].Inspect_1_Status) ,XIO(Data_Item[TurnTable_1_SeqNum].Inspect_2_Status) ] OTL(TTtoR_ReqToPickBad) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[NOP()OTE(TTtoR_ReqToPlace);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[[XIC(System_ManualMode) XIC(Laser_Marking_Permit) XIC(HMI_Start_Marking_PB) ,XIC(System_AutoMode) NEQ(Laser_Start_Auto_Req,0) ]OTE(MDX2:O.Data[0].0);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Manul index request]]>
</Comment>
<Text>
<![CDATA[XIC(System_ManualMode)[[XIC(HMI_Index_Request) XIC(Weiss_Index_Permit) OTL(Weiss_Manual_IndexRequest) ,XIC(Weiss_Manual_IndexRequest) XIC(POWER_OK_24VC) XIO(Hood_Lowered) XIC(VFD_Weiss_READY) XIO(VFD_Weiss_FAULTED) OTE(Weiss_Manual_Run_VFD) ] ,XIC(PRX200) ONS(Weiss_ONS.0) OTU(HMI_Index_Request) OTU(Weiss_Manual_IndexRequest) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Indexer brake release]]>
</Comment>
<Text>
<![CDATA[[XIC(System_ManualMode) [XIC(HMI_Indexer_Brake_OFF_PB) AFI() ,XIC(Weiss_Manual_Run_VFD) ] XIC(Weiss_Index_Permit) ,XIC(System_AutoMode) NEQ(Weiss_VFD_Break_Release_Auto_Req,0) ]OTL(CR504);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[Indexer brake Apply]]>
</Comment>
<Text>
<![CDATA[[XIC(System_ManualMode) [XIC(HMI_Indexer_Brake_ON_PB) AFI() ,XIO(Weiss_Manual_Run_VFD) ONS(Manual_RUN_ONS) ] XIC(Weiss_Index_Permit) ,XIC(System_AutoMode) NEQ(Weiss_VFD_Break_Apply_Auto_Req,0) ]OTU(CR504);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[Indexer Run]]>
</Comment>
<Text>
<![CDATA[[XIC(System_ManualMode) [XIC(HMI_Indexer_Jog_PB) XIO(Weiss_Manual_Run_VFD) ,XIC(Weiss_Manual_Run_VFD) ] XIC(Weiss_Index_Permit) ,XIC(System_AutoMode) NEQ(Weiss_VFD_Run_Auto_Req,0) ]OTL(VFD_Weiss_RUN);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[Indexer Run]]>
</Comment>
<Text>
<![CDATA[[XIC(System_ManualMode) [XIO(Weiss_Manual_Run_VFD) XIC(Weiss_Index_Permit) ,XIO(Weiss_Manual_Run_VFD) ] ,XIC(System_AutoMode) NEQ(Weiss_VFD_Stop_Auto_Req,0) ]OTU(VFD_Weiss_RUN);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[NOP()XIC(Weiss:I.Active)OTE(TTtoR_TurnTableCycle);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[XIC(Robot_Good_Part_Unload_Request)OTL(TTtoR_ReqToPickGood);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Text>
<![CDATA[XIC(Robot_Bad_Part_Unload_Request)OTL(TTtoR_ReqToPickBad);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="_05_Indexer_Auto_Sequence" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Indexer Auto Sequence
Moves The Next Sequence Cycle Step Into The Current Cycle Step. This Can Be Used To Step The Code Through The AutoCycle One Step At A Time.
This Can Be Done By Putting A Toggle Bit Infront Of The Move Instruction]]>
</Comment>
<Text>
<![CDATA[[[XIO(System_AutoMode) ,XIC(S:FS) ] [MOV(0,Indexer_Auto.Routine_CurrentCycleStep) ,MOV(0,Indexer_Auto.Routine_NextCycleStep) ] ,[XIC(System_InCycle) ,XIO(System_InCycle) [XIC(System_CycleStop_Requested) ,XIC(Auto_Initialization) ] ] MOV(Indexer_Auto.Routine_NextCycleStep,Indexer_Auto.Routine_CurrentCycleStep) ,XIO(System_InCycle) NOP() ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Set VFD move speed and Accel Rate]]>
</Comment>
<Text>
<![CDATA[MOV(Weiss:O.FreqCommand,Weiss:O.FreqCommand)OTE(Weiss:O.AccelRate1);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Indexer Auto sequence Decision step
]]>
</Comment>
<Text>
<![CDATA[EQU(Indexer_Auto.Routine_CurrentCycleStep,0)XIC(System_InCycle)[XIC(IndexTable_In_Position) [XIO(Weiss_Hood_Raised) XIC(Hood_Lowered) XIC(Index_Table_Part_Data[1].Part_Data_Present) MOV(10,Indexer_Auto.Routine_NextCycleStep) ,XIC(Weiss_Hood_Raised) XIO(Hood_Lowered) XIC(Index_Table_Part_Data[1].Part_Data_Present) MOV(20,Indexer_Auto.Routine_NextCycleStep) ,[XIC(Part_Present_At_Index_Load) ,XIC(Index_Table_Part_Data[1].Part_Data_Present) ] MOV(100,Indexer_Auto.Routine_NextCycleStep) ] ,COP(Indexer_Step_String[1],Indexer_Auto.Step_Description,1) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Indexer Auto sequence 

Raise the hood
]]>
</Comment>
<Text>
<![CDATA[EQU(Indexer_Auto.Routine_CurrentCycleStep,10)XIC(System_InCycle)[OTE(Weiss_Hood_Raise_Auto_Req.0) ,XIC(Weiss_Hood_Raised) XIO(Hood_Lowered) MOV(20,Indexer_Auto.Routine_NextCycleStep) ,COP(Indexer_Step_String[2],Indexer_Auto.Step_Description,1) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Indexer Auto sequence 

Release the Break and Index
]]>
</Comment>
<Text>
<![CDATA[EQU(Indexer_Auto.Routine_CurrentCycleStep,20)XIC(Weiss_OK_To_Index)[OTE(Weiss_VFD_Break_Release_Auto_Req.0) ,OTE(Weiss_VFD_Run_Auto_Req.0) ,XIC(Weiss_VFD_Break_Release_Auto_Req.0) XIC(Weiss_VFD_Run_Auto_Req.0) XIO(IndexTable_In_Position) MOV(30,Indexer_Auto.Routine_NextCycleStep) ,COP(Indexer_Step_String[3],Indexer_Auto.Step_Description,1) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Indexer Auto sequence 

Stop the indexer

Transfer data to next positions]]>
</Comment>
<Text>
<![CDATA[EQU(Indexer_Auto.Routine_CurrentCycleStep,30)XIC(IndexTable_In_Position)[OTE(Weiss_VFD_Stop_Auto_Req.0) OTE(Weiss_VFD_Break_Apply_Auto_Req.0) ,XIC(Weiss_VFD_Stop_Auto_Req.0) COP(Index_Table_Part_Data[4],Index_Table_Part_Data[0],1) COP(Index_Table_Part_Data[3],Index_Table_Part_Data[4],1) COP(Index_Table_Part_Data[2],Index_Table_Part_Data[3],1) COP(Index_Table_Part_Data[1],Index_Table_Part_Data[2],1) COP(Index_Table_Part_Data[0],Index_Table_Part_Data[1],1) MOV(40,Indexer_Auto.Routine_NextCycleStep) ,COP(Indexer_Step_String[4],Indexer_Auto.Step_Description,1) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Indexer Auto sequence 

Lower the hood
]]>
</Comment>
<Text>
<![CDATA[EQU(Indexer_Auto.Routine_CurrentCycleStep,40)XIC(System_InCycle)[OTE(Weiss_Hood_Lower_Auto_Req.0) ,OTL(Start_Fume_Extraction_Auto_Req) ,XIC(Hood_Lowered) XIO(Weiss_Hood_Raised) MOV(50,Indexer_Auto.Routine_NextCycleStep) ,COP(Indexer_Step_String[5],Indexer_Auto.Step_Description,1) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Indexer Auto sequence 
Check Laser Hood is lowered before starting Laser

]]>
</Comment>
<Text>
<![CDATA[EQU(Indexer_Auto.Routine_CurrentCycleStep,50)XIC(System_InCycle)[XIC(CRM_JB) TON(Laser_Hood_Lowered_Dly,?,?) ,XIC(Laser_Hood_Lowered_Dly.DN) MOV(60,Indexer_Auto.Routine_NextCycleStep) ,COP(Indexer_Step_String[6],Indexer_Auto.Step_Description,1) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Indexer Auto sequence 

Wait for Laser marking to be complete

]]>
</Comment>
<Text>
<![CDATA[EQU(Indexer_Auto.Routine_CurrentCycleStep,60)XIC(System_InCycle)[OTE(Indexer_Start_Laser_Marking_Auto_Req.0) ,XIC(Laser_Marking_Auto_Seq_Complete) MOV(70,Indexer_Auto.Routine_NextCycleStep) ,COP(Indexer_Step_String[7],Indexer_Auto.Step_Description,1) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Indexer Auto sequence 

Raise the hood
]]>
</Comment>
<Text>
<![CDATA[EQU(Indexer_Auto.Routine_CurrentCycleStep,70)XIC(System_InCycle)[OTE(Weiss_Hood_Raise_Auto_Req.1) ,XIC(Weiss_Hood_Raised) XIO(Hood_Lowered) MOV(0,Indexer_Auto.Routine_NextCycleStep) ,COP(Indexer_Step_String[8],Indexer_Auto.Step_Description,1) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Indexer Auto sequence 

Robot unload request

Is part a good part of a Bad Part]]>
</Comment>
<Text>
<![CDATA[EQU(Indexer_Auto.Routine_CurrentCycleStep,100)XIC(System_InCycle)[XIC(Part_Present_At_Index_Load) XIC(Index_Table_Part_Data[1].Part_Data_Present) [XIC(Index_Table_Part_Data[1].Good_Part) MOV(110,Indexer_Auto.Routine_NextCycleStep) ,XIC(Index_Table_Part_Data[1].Bad_Part) MOV(1000,Indexer_Auto.Routine_NextCycleStep) ] ,COP(Indexer_Step_String[10],Indexer_Auto.Step_Description,1) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Indexer Auto sequence 

Robot unload request

Good Part ready for robot unload

Transfer data to robot]]>
</Comment>
<Text>
<![CDATA[EQU(Indexer_Auto.Routine_CurrentCycleStep,110)XIC(System_InCycle)[OTE(Robot_Good_Part_Unload_Request) ,XIO(Part_Present_At_Index_Load) XIO(Index_Table_Part_Data[1].Part_Data_Present) COP(Index_Table_Part_Data[1],Robot_Part_Data[1],1) MOV(0,Indexer_Auto.Routine_NextCycleStep) ,COP(Indexer_Step_String[11],Indexer_Auto.Step_Description,1) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Indexer Auto sequence 

Robot unload request

Bad Part ready for robot unload

Transfer data to robot]]>
</Comment>
<Text>
<![CDATA[EQU(Indexer_Auto.Routine_CurrentCycleStep,1000)XIC(System_InCycle)[OTE(Robot_Bad_Part_Unload_Request) ,XIO(Part_Present_At_Index_Load) XIO(Index_Table_Part_Data[1].Part_Data_Present) COP(Index_Table_Part_Data[1],Robot_Part_Data[1],1) MOV(0,Indexer_Auto.Routine_NextCycleStep) ,COP(Indexer_Step_String[12],Indexer_Auto.Step_Description,1) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="_06_Laser_Auto_Sequence" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Indexer Auto Sequence
Moves The Next Sequence Cycle Step Into The Current Cycle Step. This Can Be Used To Step The Code Through The AutoCycle One Step At A Time.
This Can Be Done By Putting A Toggle Bit Infront Of The Move Instruction]]>
</Comment>
<Text>
<![CDATA[[[XIO(System_AutoMode) ,XIC(S:FS) ] [MOV(0,Laser_Marker_Auto.Routine_CurrentCycleStep) ,MOV(0,Laser_Marker_Auto.Routine_NextCycleStep) ] ,[XIC(System_InCycle) ,XIO(System_InCycle) [XIC(System_CycleStop_Requested) ,XIC(Auto_Initialization) ] ] MOV(Laser_Marker_Auto.Routine_NextCycleStep,Laser_Marker_Auto.Routine_CurrentCycleStep) ,XIO(System_InCycle) NOP() ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Indexer Auto sequence 

Generate data to be marked by laser

]]>
</Comment>
<Text>
<![CDATA[EQU(Laser_Marker_Auto.Routine_CurrentCycleStep,0)XIC(System_InCycle)NEQ(Indexer_Start_Laser_Marking_Auto_Req,0)[OTE(Generate_Laser_Marking_Data) ,XIC(Generate_Laser_Marking_Data) MOV(10,Laser_Marker_Auto.Routine_NextCycleStep) ,COP(Laser_Step_String[0],Laser_Marker_Auto.Step_Description,1) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Indexer Auto sequence 

Send Data to laser

]]>
</Comment>
<Text>
<![CDATA[EQU(Laser_Marker_Auto.Routine_CurrentCycleStep,10)XIC(System_InCycle)[OTE(Send_Laser_Marking_Data) ,XIC(Send_Laser_Marking_Data) MOV(20,Laser_Marker_Auto.Routine_NextCycleStep) ,COP(Laser_Step_String[1],Laser_Marker_Auto.Step_Description,1) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Indexer Auto sequence 

Open Laser Shutter

]]>
</Comment>
<Text>
<![CDATA[EQU(Laser_Marker_Auto.Routine_CurrentCycleStep,20)XIC(System_InCycle)[OTE(Open_Laser_Shutter_Auto_Req.0) ,XIC(Laser_Shutter_Open) MOV(30,Laser_Marker_Auto.Routine_NextCycleStep) ,COP(Laser_Step_String[2],Laser_Marker_Auto.Step_Description,1) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Indexer Auto sequence 

Start the laser marking

]]>
</Comment>
<Text>
<![CDATA[EQU(Laser_Marker_Auto.Routine_CurrentCycleStep,30)XIC(System_InCycle)NEQ(Indexer_Start_Laser_Marking_Auto_Req,0)[OTE(Laser_Start_Auto_Req.0) ,XIC(Laser_Marking_Complete) MOV(40,Laser_Marker_Auto.Routine_NextCycleStep) ,COP(Laser_Step_String[3],Laser_Marker_Auto.Step_Description,1) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Indexer Auto sequence 

Close the laser Shutter

]]>
</Comment>
<Text>
<![CDATA[EQU(Laser_Marker_Auto.Routine_CurrentCycleStep,40)XIC(System_InCycle)[OTE(Laser_Shutter_Close_Auto_Req.0) ,XIO(Laser_Shutter_Open) MOV(50,Laser_Marker_Auto.Routine_NextCycleStep) ,COP(Laser_Step_String[4],Laser_Marker_Auto.Step_Description,1) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Indexer Auto sequence 

LaserSequence complete to Index table sequence

]]>
</Comment>
<Text>
<![CDATA[EQU(Laser_Marker_Auto.Routine_CurrentCycleStep,50)XIC(System_InCycle)[OTE(Laser_Marking_Auto_Seq_Complete) ,EQU(Indexer_Start_Laser_Marking_Auto_Req,0) MOV(0,Laser_Marker_Auto.Routine_NextCycleStep) ,COP(Laser_Step_String[5],Laser_Marker_Auto.Step_Description,1) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="_07_Laser_Station_Faults" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[[XIC(HMI_Reset) ,XIC(GlobalAck_TOF.TT) ][MOV(0,Laser_Station_Alarm) MOV(0,Laser_Station_Notification) ,OTE(MDX2:O.Data[7].0) OTE(MDX2:O.Data[8].2) OTE(MDX2:O.Data[9].8) OTE(MDX2:O.Data[6].0) OTE(MDX2:O.Data[6].4) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[AFI()NEQ(Laser_Station_Alarm,0)OTE(Laser_Station_Faulted);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Laser Station Alarm #1 Weiss indexer is faulted

]]>
</Comment>
<Text>
<![CDATA[XIO(HMI_Reset)XIC(System_InCycle)XIC(EStop_OK)XIC(VFD_Weiss_FAULTED)[TON(Laser_Station_Alarm_Delay[0],?,?) ,XIC(Laser_Station_Alarm_Delay[0].DN) OTL(Laser_Station_Alarm.0) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Laser Station Alarm #2 Laser is faulted

]]>
</Comment>
<Text>
<![CDATA[XIO(HMI_Reset)XIC(System_InCycle)XIC(EStop_OK)XIC(Laser_Error)[TON(Laser_Station_Alarm_Delay[1],?,?) ,XIC(Laser_Station_Alarm_Delay[1].DN) OTL(Laser_Station_Alarm.1) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="_08_HMI_Animations" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Weiss Permits]]>
</Comment>
<Text>
<![CDATA[XIC(Motion_Control_OK)[XIC(System_ManualMode) ,XIC(System_AutoMode) ]XIO(Hood_Lowered)XIO(VFD_Weiss_FAULTED)XIC(Robot_Clear_Of_Indexer)OTE(Weiss_Index_Permit);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Change the Index buttons Colors]]>
</Comment>
<Text>
<![CDATA[[XIO(VFD_Weiss_FAULTED) [XIO(Weiss_Index_Permit) XIO(PRX200) XIO(VFD_Weiss_READY) XIO(Weiss_Manual_IndexRequest) MOV(0,Weiss_Index_Button.Button_Color) ,XIC(Weiss_Index_Permit) [XIC(VFD_Weiss_READY) XIC(Weiss_Manual_IndexRequest) MOV(1,Weiss_Index_Button.Button_Color) ,XIC(Weiss_Manual_IndexRequest) XIO(PRX200) MOV(3,Weiss_Index_Button.Button_Color) ,XIC(PRX200) XIO(Weiss_Manual_IndexRequest) MOV(4,Weiss_Index_Button.Button_Color) ] ] ,XIC(VFD_Weiss_FAULTED) MOV(2,Weiss_Index_Button.Button_Color) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Change the Indexer Brake buttons Colors]]>
</Comment>
<Text>
<![CDATA[[XIO(VFD_Weiss_FAULTED) [XIO(HMI_Indexer_Brake_OFF_PB) XIO(HMI_Indexer_Brake_ON_PB) XIO(Weiss_Manual_IndexRequest) XIC(CR504) MOV(0,Weiss_Brake_Button.Button_Color) ,[XIC(VFD_Weiss_READY) XIC(Weiss_Manual_IndexRequest) MOV(1,Weiss_Brake_Button.Button_Color) ,[XIC(CR504) ,XIC(Weiss_Manual_IndexRequest) XIC(CR504) ] MOV(3,Weiss_Brake_Button.Button_Color) ,XIO(CR504) MOV(4,Weiss_Brake_Button.Button_Color) ] ] ,XIC(VFD_Weiss_FAULTED) MOV(2,Weiss_Index_Button.Button_Color) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Change the Fume buttons Colors]]>
</Comment>
<Text>
<![CDATA[[XIO(Fume_Permit) XIO(CR400) XIC(Motion_Control_OK) MOV(0,Fume.Button_Color) ,XIC(Fume_Permit) XIC(Motion_Control_OK) [XIO(CR400) XIO(FUMEX_FAULT) MOV(1,Fume.Button_Color) ,AFI() XIO(CR400) MOV(3,Fume.Button_Color) ,XIC(CR400) MOV(4,Fume.Button_Color) ] ,[XIC(FUMEX_FAULT) ,XIO(Motion_Control_OK) ] MOV(2,Fume.Button_Color) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Change the Fume buttons Colors]]>
</Comment>
<Text>
<![CDATA[[XIO(Laser_Hood_Raise_Permit) XIO(CR301) [MOV(0,Laser_Hood_Raise.Button_Color) ,MOV(0,Laser_Hood_Lower.Button_Color) ] ,XIC(Laser_Hood_Raise_Permit) [[XIO(PRX102) MOV(1,Laser_Hood_Raise.Button_Color) ,XIO(PRX103) MOV(1,Laser_Hood_Lower.Button_Color) ] ,XIO(PRX102) XIO(PRX103) [MOV(3,Laser_Hood_Raise.Button_Color) ,MOV(3,Laser_Hood_Lower.Button_Color) ] ,AFI() [MOV(2,Laser_Hood_Raise.Button_Color) ,MOV(2,Laser_Hood_Lower.Button_Color) ] ,[XIC(PRX102) MOV(4,Laser_Hood_Raise.Button_Color) ,XIC(PRX103) MOV(4,Laser_Hood_Lower.Button_Color) ] ] ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
