<![CDATA[COP(Robot_Cmd_RoutineID,Station100_Robot:O.Data[64],4)COP(Robot_Cmd_Seq,Station100_Robot:O.Data[68],4)COP(Robot_Cmd_Param1,Station100_Robot:O.Data[72],4)COP(Robot_Cmd_Param2,Station100_Robot:O.Data[76],4)COP(Robot_Cmd_Param3,Station100_Robot:O.Data[80],4)COP(Robot_Cmd_Param4,Station100_Robot:O.Data[84],4)COP(Robot_Cmd_RetryLimit,Station100_Robot:O.Data[88],4);]]>
