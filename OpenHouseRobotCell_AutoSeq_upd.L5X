<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[[XIO(TurnTableCycleEndDelay.DN) [XIC(PLC_To_PC_DINT[13].11) ,XIC(TurnTableTurnTimer.EN) ] TON(TurnTableTurnTimer,?,?) ,XIC(TurnTableTurnTimer.DN) TON(CameraFlash,?,?) ,XIC(CameraFlash.DN) TON(TurnTableCycleEndDelay,?,?) ]NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[[XIO(PLC_To_PC_DINT[0].0) ,XIO(PLC_To_PC_DINT[0].1) ,XIO(PLC_To_PC_DINT[0].3) ,XIO(PLC_To_PC_DINT[0].5) ] MOV(0,Laser_StatusCode) ,XIC(PLC_To_PC_DINT[0].0) XIC(PLC_To_PC_DINT[0].1) XIC(PLC_To_PC_DINT[0].3) XIC(PLC_To_PC_DINT[0].5) XIC(PLC_To_PC_DINT[13].1) MOV(1,Laser_StatusCode) ,XIC(PLC_To_PC_DINT[0].0) XIC(PLC_To_PC_DINT[0].1) XIC(PLC_To_PC_DINT[0].3) XIC(PLC_To_PC_DINT[0].5) XIO(PLC_To_PC_DINT[13].1) XIC(PLC_To_PC_DINT[13].2) MOV(3,Laser_StatusCode) ,XIC(PLC_To_PC_DINT[0].0) XIC(PLC_To_PC_DINT[0].1) XIC(PLC_To_PC_DINT[0].3) XIC(PLC_To_PC_DINT[0].5) XIO(PLC_To_PC_DINT[13].1) XIO(PLC_To_PC_DINT[13].2) XIC(PLC_To_PC_DINT[13].0) MOV(4,Laser_StatusCode) ,XIC(PLC_To_PC_DINT[0].0) XIC(PLC_To_PC_DINT[0].1) XIC(PLC_To_PC_DINT[0].3) XIC(PLC_To_PC_DINT[0].5) XIO(PLC_To_PC_DINT[13].1) XIO(PLC_To_PC_DINT[13].2) XIO(PLC_To_PC_DINT[13].0) MOV(6,Laser_StatusCode) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[[XIO(PLC_To_PC_DINT[0].0) ,XIO(PLC_To_PC_DINT[0].1) ,XIO(PLC_To_PC_DINT[0].3) ,XIO(PLC_To_PC_DINT[0].5) ] MOV(0,LaserCamera_StatusCode) ,XIC(PLC_To_PC_DINT[0].0) XIC(PLC_To_PC_DINT[0].1) XIC(PLC_To_PC_DINT[0].3) XIC(PLC_To_PC_DINT[0].5) XIC(PLC_To_PC_DINT[13].9) MOV(1,LaserCamera_StatusCode) ,XIC(PLC_To_PC_DINT[0].0) XIC(PLC_To_PC_DINT[0].1) XIC(PLC_To_PC_DINT[0].3) XIC(PLC_To_PC_DINT[0].5) XIO(PLC_To_PC_DINT[13].9) XIC(CameraFlash.TT) MOV(5,LaserCamera_StatusCode) ,XIC(PLC_To_PC_DINT[0].0) XIC(PLC_To_PC_DINT[0].1) XIC(PLC_To_PC_DINT[0].3) XIC(PLC_To_PC_DINT[0].5) XIO(PLC_To_PC_DINT[13].9) XIO(CameraFlash.TT) XIC(PLC_To_PC_DINT[13].8) MOV(4,LaserCamera_StatusCode) ,XIC(PLC_To_PC_DINT[0].0) XIC(PLC_To_PC_DINT[0].1) XIC(PLC_To_PC_DINT[0].3) XIC(PLC_To_PC_DINT[0].5) XIO(PLC_To_PC_DINT[13].9) XIO(CameraFlash.TT) XIO(PLC_To_PC_DINT[13].8) MOV(6,LaserCamera_StatusCode) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[[[XIO(PLC_To_PC_DINT[0].0) ,XIO(PLC_To_PC_DINT[0].1) ,XIO(PLC_To_PC_DINT[0].3) ,XIO(PLC_To_PC_DINT[0].5) ] MOV(0,Station1_StatusCode) ,XIC(PLC_To_PC_DINT[0].0) XIC(PLC_To_PC_DINT[0].1) XIC(PLC_To_PC_DINT[0].3) XIC(PLC_To_PC_DINT[0].5) XIO(PLC_To_PC_DINT[13].16) XIO(PLC_To_PC_DINT[13].17) MOV(2,Station1_StatusCode) ,XIC(PLC_To_PC_DINT[0].0) XIC(PLC_To_PC_DINT[0].1) XIC(PLC_To_PC_DINT[0].3) XIC(PLC_To_PC_DINT[0].5) XIC(PLC_To_PC_DINT[13].16) XIO(PLC_To_PC_DINT[13].17) MOV(3,Station1_StatusCode) ,XIC(PLC_To_PC_DINT[0].0) XIC(PLC_To_PC_DINT[0].1) XIC(PLC_To_PC_DINT[0].3) XIC(PLC_To_PC_DINT[0].5) XIO(PLC_To_PC_DINT[13].16) XIC(PLC_To_PC_DINT[13].17) MOV(3,Station1_StatusCode) ,XIC(PLC_To_PC_DINT[0].0) XIC(PLC_To_PC_DINT[0].1) XIC(PLC_To_PC_DINT[0].3) XIC(PLC_To_PC_DINT[0].5) XIO(PLC_To_PC_DINT[13].15) XIC(PLC_To_PC_DINT[13].16) XIC(PLC_To_PC_DINT[13].17) MOV(4,Station1_StatusCode) ,XIC(PLC_To_PC_DINT[0].0) XIC(PLC_To_PC_DINT[0].1) XIC(PLC_To_PC_DINT[0].3) XIC(PLC_To_PC_DINT[0].5) XIC(PLC_To_PC_DINT[13].14) XIC(PLC_To_PC_DINT[13].16) XIC(PLC_To_PC_DINT[13].17) MOV(5,Station1_StatusCode) ,XIC(PLC_To_PC_DINT[0].0) XIC(PLC_To_PC_DINT[0].1) XIC(PLC_To_PC_DINT[0].3) XIC(PLC_To_PC_DINT[0].5) XIC(PLC_To_PC_DINT[13].15) XIC(PLC_To_PC_DINT[13].16) XIC(PLC_To_PC_DINT[13].17) MOV(6,Station1_StatusCode) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[[[XIO(PLC_To_PC_DINT[0].0) ,XIO(PLC_To_PC_DINT[0].1) ,XIO(PLC_To_PC_DINT[0].3) ,XIO(PLC_To_PC_DINT[0].5) ] MOV(0,Station2_StatusCode) ,XIC(PLC_To_PC_DINT[0].0) XIC(PLC_To_PC_DINT[0].1) XIC(PLC_To_PC_DINT[0].3) XIC(PLC_To_PC_DINT[0].5) XIO(PLC_To_PC_DINT[13].18) XIO(PLC_To_PC_DINT[13].19) MOV(2,Station2_StatusCode) ,XIC(PLC_To_PC_DINT[0].0) XIC(PLC_To_PC_DINT[0].1) XIC(PLC_To_PC_DINT[0].3) XIC(PLC_To_PC_DINT[0].5) XIC(PLC_To_PC_DINT[13].18) XIO(PLC_To_PC_DINT[13].19) MOV(3,Station2_StatusCode) ,XIC(PLC_To_PC_DINT[0].0) XIC(PLC_To_PC_DINT[0].1) XIC(PLC_To_PC_DINT[0].3) XIC(PLC_To_PC_DINT[0].5) XIO(PLC_To_PC_DINT[13].18) XIC(PLC_To_PC_DINT[13].19) MOV(3,Station2_StatusCode) ,XIC(PLC_To_PC_DINT[0].0) XIC(PLC_To_PC_DINT[0].1) XIC(PLC_To_PC_DINT[0].3) XIC(PLC_To_PC_DINT[0].5) XIC(PLC_To_PC_DINT[13].18) XIC(PLC_To_PC_DINT[13].19) MOV(4,Station2_StatusCode) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[ROBOT]]>
</Comment>
<Text>
<![CDATA[[[XIO(PLC_To_PC_DINT[0].0) ,XIO(PLC_To_PC_DINT[0].1) ,XIO(PLC_To_PC_DINT[0].3) ,XIO(PLC_To_PC_DINT[0].5) ] MOV(0,RobotBlank_StatusCode) ,XIC(PLC_To_PC_DINT[0].0) XIC(PLC_To_PC_DINT[0].1) XIC(PLC_To_PC_DINT[0].3) XIC(PLC_To_PC_DINT[0].5) XIC(RtoPLC_ToolBlnkHasParts) XIO(RtoPLC_ToolBlnkMrked) MOV(2,RobotBlank_StatusCode) ,XIC(PLC_To_PC_DINT[0].0) XIC(PLC_To_PC_DINT[0].1) XIC(PLC_To_PC_DINT[0].3) XIC(PLC_To_PC_DINT[0].5) XIC(RtoPLC_ToolBlnkHasParts) XIC(RtoPLC_ToolBlnkMrked) MOV(3,RobotBlank_StatusCode) ,XIC(PLC_To_PC_DINT[0].0) XIC(PLC_To_PC_DINT[0].1) XIC(PLC_To_PC_DINT[0].3) XIC(PLC_To_PC_DINT[0].5) XIO(RtoPLC_ToolBlnkHasParts) XIO(RtoPLC_ToolBlnkMrked) MOV(4,RobotBlank_StatusCode) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[[[XIO(PLC_To_PC_DINT[0].0) ,XIO(PLC_To_PC_DINT[0].1) ,XIO(PLC_To_PC_DINT[0].3) ,XIO(PLC_To_PC_DINT[0].5) ] MOV(0,RobotFinished_StatusCode) ,XIC(PLC_To_PC_DINT[0].0) XIC(PLC_To_PC_DINT[0].1) XIC(PLC_To_PC_DINT[0].3) XIC(PLC_To_PC_DINT[0].5) XIC(RtoPLC_ToolFinHasParts) XIC(RtoPLC_FinishGripClose) MOV(2,RobotFinished_StatusCode) ,XIC(PLC_To_PC_DINT[0].0) XIC(PLC_To_PC_DINT[0].1) XIC(PLC_To_PC_DINT[0].3) XIC(PLC_To_PC_DINT[0].5) XIC(RtoPLC_ToolBlnkMrked) XIO(RtoPLC_FinishGripClose) MOV(3,RobotFinished_StatusCode) ,XIC(PLC_To_PC_DINT[0].0) XIC(PLC_To_PC_DINT[0].1) XIC(PLC_To_PC_DINT[0].3) XIC(PLC_To_PC_DINT[0].5) XIO(RtoPLC_ToolBlnkMrked) XIO(RtoPLC_FinishGripClose) MOV(4,RobotFinished_StatusCode) ];]]>
</Text>
</Rung>
