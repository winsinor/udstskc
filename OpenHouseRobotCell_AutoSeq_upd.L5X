<Rung Number="65" Type="N">
<Text>
<![CDATA[[XIC(Station100Robot._Fault[0]) ,XIC(Station100Robot._Fault[1]) ,XIC(Station100Robot._Fault[2]) ,XIC(Station100Robot._Fault[3]) ,XIC(Station100Robot._Fault[4]) ,XIC(Station100Robot._Fault[5]) ,XIC(Station100Robot._Fault[6]) ,XIC(Station100Robot._Fault[7]) ,XIC(Station100Robot._Fault[8]) ,XIC(Station100Robot._Fault[9]) ,XIC(Station100Robot._Fault[10]) ,XIC(Station100Robot._Fault[11]) ,XIC(Station100Robot._Fault[12]) ,XIC(Station100Robot._Fault[13]) ,XIC(Station100Robot._Fault[14]) ,XIC(Station100Robot._Fault[15]) ,XIC(Station100Robot._Fault[16]) ,XIC(Station100Robot._Fault[17]) ,XIC(Station100Robot._Fault[18]) ,XIC(Station100Robot._Fault[19]) ,XIC(Station100Robot._Fault[20]) ,XIC(Station100Robot._Fault[21]) ,XIC(Station100Robot._Fault[22]) ,XIC(Station100Robot._Fault[23]) ,XIC(Station100Robot._Fault[24]) ,XIC(Station100Robot._Fault[25]) ,XIC(Station100Robot._Fault[26]) ,XIC(Station100Robot._Fault[27]) ,XIC(Station100Robot._Fault[28]) ,XIC(Station100Robot._Fault[29]) ,XIC(Station100Robot._Fault[30]) ,XIC(Station100Robot._Fault[31]) ]OTE(Station100Robot._Active_Fault);]]>
</Text>
</Rung>
<Rung Number="66" Type="N">
<Text>
<![CDATA[[XIC(PlaceHolderBit) XIC(Station100Robot._Fault[0]) ,XIC(PlaceHolderBit) XIC(Station100Robot._Fault[1]) ,XIC(PlaceHolderBit) XIC(Station100Robot._Fault[2]) ,XIC(PlaceHolderBit) XIC(Station100Robot._Fault[3]) ,XIC(PlaceHolderBit) XIC(Station100Robot._Fault[4]) ,XIC(PlaceHolderBit) XIC(Station100Robot._Fault[5]) ,XIC(PlaceHolderBit) XIC(Station100Robot._Fault[6]) ,XIC(PlaceHolderBit) XIC(Station100Robot._Fault[7]) ,XIC(PlaceHolderBit) XIC(Station100Robot._Fault[8]) ,XIC(PlaceHolderBit) XIC(Station100Robot._Fault[9]) ,XIC(PlaceHolderBit) XIC(Station100Robot._Fault[10]) ,XIC(PlaceHolderBit) XIC(Station100Robot._Fault[11]) ,XIC(PlaceHolderBit) XIC(Station100Robot._Fault[12]) ,XIC(PlaceHolderBit) XIC(Station100Robot._Fault[13]) ,XIC(PlaceHolderBit) XIC(Station100Robot._Fault[14]) ,XIC(PlaceHolderBit) XIC(Station100Robot._Fault[15]) ,XIC(PlaceHolderBit) XIC(Station100Robot._Fault[16]) ,XIC(PlaceHolderBit) XIC(Station100Robot._Fault[17]) ,XIC(PlaceHolderBit) XIC(Station100Robot._Fault[18]) ,XIC(PlaceHolderBit) XIC(Station100Robot._Fault[19]) ,XIC(PlaceHolderBit) XIC(Station100Robot._Fault[20]) ,XIC(PlaceHolderBit) XIC(Station100Robot._Fault[21]) ,XIC(PlaceHolderBit) XIC(Station100Robot._Fault[22]) ,XIC(PlaceHolderBit) XIC(Station100Robot._Fault[23]) ,XIC(PlaceHolderBit) XIC(Station100Robot._Fault[24]) ,XIC(PlaceHolderBit) XIC(Station100Robot._Fault[25]) ,XIC(PlaceHolderBit) XIC(Station100Robot._Fault[26]) ,XIC(PlaceHolderBit) XIC(Station100Robot._Fault[27]) ,XIC(PlaceHolderBit) XIC(Station100Robot._Fault[28]) ,XIC(PlaceHolderBit) XIC(Station100Robot._Fault[29]) ,XIC(PlaceHolderBit) XIC(Station100Robot._Fault[30]) ,XIC(PlaceHolderBit) XIC(Station100Robot._Fault[31]) ]OTE(Station100Robot._ShutdownSystem_Fault);]]>
