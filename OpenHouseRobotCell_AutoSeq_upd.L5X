<Routine Name="_01_System_Faults" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(amp_Test_Bits.31)XIC(POWER_OK_24VC)XIC(POWER_OK_24VB)[GSV(Module,IV3,FaultCode,HARDWARE_FAULTS[5]) NEQ(HARDWARE_FAULTS[5],0) OTL(Keyence_Com_Fault) ,XIC(Reset_Hold_TMR.DN) OTU(Weiss_Com_Fault) OTU(Keyence_Com_Fault) OTU(Laser_Com_Fault) OTU(AENTR_Com_Fault) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[*****************************************************
Automation System Fault Present
*****************************************************]]>
</Comment>
<Text>
<![CDATA[[NEQ(SYSTEM_ALARM_FILE[0],0) ,XIC(Robot_Faulted) ,XIC(Laser_Station_Faulted) ]OTE(System_Fault_Present);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[RESETS ALARM FILE [0] FAULTS]]>
</Comment>
<Text>
<![CDATA[XIC(GlobalAck_TOF.TT)CLR(SYSTEM_ALARM_FILE[0]);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[AENTR communications fault]]>
</Comment>
<Text>
<![CDATA[XIC(Pulse_1000)XIC(POWER_OK_24VC)XIC(POWER_OK_24VB)GSV(Module,PLC25,FaultCode,HARDWARE_FAULTS[3])NEQ(HARDWARE_FAULTS[3],0)OTL(SYSTEM_ALARM_FILE[0].0);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[MDX Laser communications fault]]>
</Comment>
<Text>
<![CDATA[XIC(Pulse_1000)XIC(POWER_OK_24VC)XIC(POWER_OK_24VB)GSV(Module,MDX2,FaultCode,HARDWARE_FAULTS[4])NEQ(HARDWARE_FAULTS[4],0)AFI()OTL(SYSTEM_ALARM_FILE[0].1);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Weiss Drive communications fault]]>
</Comment>
<Text>
<![CDATA[XIC(Pulse_1000)XIC(POWER_OK_24VC)XIC(POWER_OK_24VB)GSV(Module,Weiss,FaultCode,HARDWARE_FAULTS[6])NEQ(HARDWARE_FAULTS[6],0)OTL(SYSTEM_ALARM_FILE[0].2);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
